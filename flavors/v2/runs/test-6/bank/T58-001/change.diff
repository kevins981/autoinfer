+void gdn_replay_flush(torch::stable::Tensor const& state_ptrs,
+                      torch::stable::Tensor const& flag_ptrs,
+                      int64_t state_slot_stride, int64_t hv,
+                      torch::stable::Tensor const& bt,
+                      torch::stable::Tensor const& idx_mapping,
+                      torch::stable::Tensor const& p0,
+                      torch::stable::Tensor const& p1,
+                      torch::stable::Tensor const& p2, int64_t num_reqs,
+                      int64_t mode, int64_t block_size,
+                      int64_t use_idx_mapping,
+                      torch::stable::Tensor const& counters) {
+  using torch::headeronly::ScalarType;
+  if (num_reqs <= 0) return;
+  STD_TORCH_CHECK(state_ptrs.is_cuda() &&
+                      state_ptrs.scalar_type() == ScalarType::Long &&
+                      flag_ptrs.is_cuda() &&
+                      flag_ptrs.scalar_type() == ScalarType::Long &&
+                      state_ptrs.numel() == flag_ptrs.numel(),
+                  "pointer tables must be CUDA int64 of equal length");
+  STD_TORCH_CHECK(bt.is_cuda() && bt.scalar_type() == ScalarType::Int &&
+                      p0.is_cuda() && p0.scalar_type() == ScalarType::Int &&
+                      p1.is_cuda() && p1.scalar_type() == ScalarType::Int &&
+                      p2.is_cuda() && p2.scalar_type() == ScalarType::Int &&
+                      idx_mapping.is_cuda() &&
+                      idx_mapping.scalar_type() == ScalarType::Int,
+                  "index tensors must be CUDA int32");
+  // mode: bits 0-3 flush mode, bit 4 RED8 layout (must match the replay kernel).
+  const bool red8 = (mode >> 4) & 1;
+  const int64_t two_slot_bit = (mode >> 5) & 1;  // Route B
+  mode &= 0xF;
+  STD_TORCH_CHECK(mode >= 0 && mode <= 3, "bad mode");
+  const int64_t bt_stride = bt.dim() == 2 ? bt.stride(0) : 1;
+  torch::stable::accelerator::DeviceGuard const device_guard(
+      bt.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream(bt.get_device_index());
+  const dim3 grid(static_cast<unsigned>(num_reqs), static_cast<unsigned>(hv),
+                  static_cast<unsigned>(state_ptrs.numel()));
+  auto flush_kernel = red8 ? gdn_replay_flush_kernel<true> : gdn_replay_flush_kernel<false>;
+  flush_kernel<<<grid, kThreads, 0, stream>>>(
+      static_cast<const int64_t*>(state_ptrs.data_ptr()),
+      static_cast<const int64_t*>(flag_ptrs.data_ptr()), state_slot_stride,
+      static_cast<int>(hv), static_cast<const int*>(bt.data_ptr()), bt_stride,
+      use_idx_mapping ? static_cast<const int*>(idx_mapping.data_ptr())
+                      : nullptr,
+      static_cast<const int*>(p0.data_ptr()),
+      static_cast<const int*>(p1.data_ptr()),
+      static_cast<const int*>(p2.data_ptr()), static_cast<int>(num_reqs),
+      static_cast<int>(mode) | static_cast<int>(two_slot_bit << 8), static_cast<int>(block_size),
+      counters.numel() >= 4
+          ? static_cast<unsigned long long*>(counters.data_ptr())
+          : nullptr);
+  const cudaError_t error = cudaGetLastError();
+  STD_TORCH_CHECK(error == cudaSuccess, "GDN replay flush launch failed: ",
+                  cudaGetErrorString(error));
+}
