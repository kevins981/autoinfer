#!/usr/bin/env python3
"""gpu: the run's GPU job queue. Every GPU job of an AutoInfer run goes through it.

A job is one command that gets the GPUs exclusively until it exits or hits its timeout.
Jobs run one at a time, first come first served, and are charged (actual wall minutes) to the
submitting agent's team budget for the current round. Spec: design/infra/gpu_queue.md.

Usage:
  gpu run --timeout MIN [--label L] -- <command...>   # blocks until the job ends (run it in the
                                                      # background and get notified on exit)
  gpu status [--json]
  gpu wait <job id>                                   # blocks until that job ends (background too)
  gpu cancel <job id>

Team and agent come from AUTOINFER_TEAM / AUTOINFER_AGENT (set by `agent start`). No team =
unbudgeted (recorded, not charged), except brainstormers (AUTOINFER_ROLE=brainstormer): each has
its own cap per round, budget.json's "brainstormer" (default 15 GPU-min). Budgets:
$AUTOINFER_RUN/gpu/budget.json, written by the manager each round:
{"round": 3, "teams": {"T1": 40, "T2": 40}, "brainstormer": 15}.

Exit codes of `gpu run`: the job's own exit code; 124 = killed at its timeout; 76 = budget
exhausted (job not run); 2 = bad arguments (job not run); 75 = GPUs in use by someone outside this run (job not run: report this
to the manager).
`gpu <command> --help` explains each command, with examples.
"""
import argparse, fcntl, json, os, signal, subprocess, sys, time
from datetime import datetime, timezone
from pathlib import Path

EXIT_BUDGET, EXIT_FOREIGN, EXIT_TIMEOUT = 76, 75, 124   # (2 = usage error, from argparse)
FOREIGN_MEM_MIB = 1024        # GPU memory used with no process of ours = someone else is there
POLL = 2.0


def die(msg, code=1):
    print(f"gpu: {msg}", file=sys.stderr)
    sys.exit(code)


def now_iso(t=None):
    return datetime.fromtimestamp(t or time.time(), timezone.utc).astimezone().isoformat(timespec="seconds")


def gdir():
    r = os.environ.get("AUTOINFER_RUN")
    if not r:
        die("AUTOINFER_RUN is not set (the run folder)")
    d = Path(r).resolve() / "gpu"
    for sub in ("queue", "jobs"):
        (d / sub).mkdir(parents=True, exist_ok=True)
    return d


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        with open(f"/proc/{pid}/stat") as f:
            return f.read().split(")")[-1].split()[0] != "Z"
    except (ProcessLookupError, FileNotFoundError):
        return False
    except PermissionError:
        return True


def read_json(p, default=None):
    try:
        return json.loads(Path(p).read_text())
    except (OSError, ValueError):
        return default


def write_json(p, obj):
    p = Path(p)
    tmp = p.with_name(p.name + ".tmp")
    tmp.write_text(json.dumps(obj, indent=2) + "\n")
    tmp.replace(p)


# ---------------------------------------------------------------- budgets and the ledger
def budget():
    return read_json(gdir() / "budget.json", {}) or {}


def ledger():
    out = []
    p = gdir() / "ledger.jsonl"
    if p.exists():
        for line in p.read_text().splitlines():
            try:
                out.append(json.loads(line))
            except ValueError:
                pass
    return out


def used(team, rnd):
    return sum(e["gpu_minutes"] for e in ledger() if e.get("team") == team and e.get("round") == rnd)


def remaining(team):
    """None = no limit (unbudgeted agent, or no budget set for this team)."""
    b = budget()
    if not team or team not in b.get("teams", {}):
        return None
    return b["teams"][team] - used(team, b.get("round"))


BRAINSTORMER_DEFAULT = 15             # GPU-min per brainstormer per round if budget.json has none


def is_brainstormer(team):
    return not team and os.environ.get("AUTOINFER_ROLE") == "brainstormer"


def brainstormer_remaining(agent):
    b = budget()
    cap = b.get("brainstormer", BRAINSTORMER_DEFAULT)
    return cap - sum(e["gpu_minutes"] for e in ledger()
                     if e.get("agent") == agent and e.get("round") == b.get("round"))


def check_budget(team, timeout, agent=None):
    if is_brainstormer(team):
        rem = brainstormer_remaining(agent)
        if rem < timeout:
            die(f"budget exhausted: brainstormer {agent} has {rem:.1f} GPU-min left this round, "
                f"the job asks for up to {timeout:g} (lower --timeout, or do GPU-free work)",
                EXIT_BUDGET)
        return
    rem = remaining(team)
    if rem is not None and rem < timeout:
        die(f"budget exhausted: team {team} has {rem:.1f} GPU-min left this round, the job asks "
            f"for up to {timeout:g} (lower --timeout, or do GPU-free work)", EXIT_BUDGET)


# ---------------------------------------------------------------- GPU inspection
def gpu_state():
    """[(gpu index, memory used MiB)], [(pid, gpu uuid, used MiB)]"""
    try:
        mem = subprocess.run(["nvidia-smi", "--query-gpu=index,memory.used", "--format=csv,noheader,nounits"],
                             capture_output=True, text=True, timeout=30).stdout
        apps = subprocess.run(["nvidia-smi", "--query-compute-apps=pid,gpu_uuid,used_memory",
                               "--format=csv,noheader,nounits"], capture_output=True, text=True,
                              timeout=30).stdout
    except (OSError, subprocess.TimeoutExpired) as e:
        die(f"nvidia-smi failed: {e}")
    gpus = [tuple(int(x) for x in l.split(",")) for l in mem.strip().splitlines() if l.strip()]
    procs = []
    for l in apps.strip().splitlines():
        parts = [x.strip() for x in l.split(",")]
        if len(parts) == 3 and parts[0].isdigit():
            procs.append((int(parts[0]), parts[1], int(parts[2]) if parts[2].isdigit() else 0))
    return gpus, procs


def proc_owner(pid):
    try:
        return os.stat(f"/proc/{pid}").st_uid
    except OSError:
        return None


def proc_session(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            return int(f.read().split(")")[-1].split()[3])
    except (OSError, ValueError, IndexError):
        return None


def foreign_usage():
    """Anything on the GPUs while no job of ours runs = someone else (other users, or other work
    of the same user outside this run). Returns a description, or None if the GPUs are free."""
    gpus, procs = gpu_state()
    if procs:
        desc = []
        for pid, uuid, mib in procs:
            uid = proc_owner(pid)
            who = "unknown user" if uid is None else ("this user, outside this run" if uid == os.getuid()
                                                     else f"uid {uid}")
            desc.append(f"pid {pid} ({who}, {mib} MiB)")
        return "; ".join(desc)
    busy = [f"GPU {i}: {m} MiB used" for i, m in gpus if m > FOREIGN_MEM_MIB]
    return "; ".join(busy) + " (no visible process)" if busy else None


# ---------------------------------------------------------------- the queue
def next_job_id(g):
    with open(g / "seq.lock", "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        seq = g / "seq"
        n = int(seq.read_text()) + 1 if seq.exists() else 1
        seq.write_text(f"{n}\n")
    return n


def live_tickets(g):
    out = []
    for t in (g / "queue").glob("*.json"):
        info = read_json(t)
        if info and pid_alive(info["pid"]):
            out.append((info["id"], t, info))
        else:
            t.unlink(missing_ok=True)       # its `gpu run` died: drop the stale ticket
    return sorted(out)


class Stop(Exception):
    pass


def on_signal(signum, frame):
    raise Stop(signal.Signals(signum).name)


def group_members(pgid):
    """Live (non-zombie) processes in process group pgid."""
    out = []
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/stat") as f:
                fields = f.read().split(")")[-1].split()
            if int(fields[2]) == pgid and fields[0] != "Z":
                out.append(int(d))
        except (OSError, ValueError, IndexError):
            pass
    return out


def kill_job(proc, grace=15):
    """Kill the job's whole process group: SIGTERM, then SIGKILL after `grace` seconds."""
    pgid = proc.pid
    for sig, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, 10)):
        proc.poll()                                     # reap the leader if it already exited
        if not group_members(pgid):
            return
        try:
            os.killpg(pgid, sig)
        except ProcessLookupError:
            return
        t0 = time.time()
        while time.time() - t0 < wait:
            proc.poll()
            if not group_members(pgid):
                return
            time.sleep(0.2)


def cleanup_gpu(sid, log):
    """Kill GPU processes left behind by the job (same session), then wait for memory to free."""
    _, procs = gpu_state()
    for pid, _, _ in procs:
        if proc_session(pid) == sid:
            log.write(f"[gpu] killing leftover GPU process {pid}\n")
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    t0 = time.time()
    while time.time() - t0 < 60:
        _, procs = gpu_state()
        if not any(proc_session(p) == sid for p, _, _ in procs):
            return
        time.sleep(1)


def cmd_run(a):
    if not a.command:
        die("no command given (usage: gpu run --timeout MIN -- <command...>)")
    g = gdir()
    team = os.environ.get("AUTOINFER_TEAM") or None
    agent = os.environ.get("AUTOINFER_AGENT", "human")
    check_budget(team, a.timeout, agent)                # fail fast

    jid = next_job_id(g)
    jdir = g / "jobs" / str(jid)
    jdir.mkdir(parents=True)
    info = {"id": jid, "pid": os.getpid(), "team": team, "agent": agent, "label": a.label,
            "timeout_min": a.timeout, "command": a.command, "cwd": os.getcwd(),
            "submitted": now_iso()}
    write_json(jdir / "job.json", info)
    ticket = g / "queue" / f"{jid:08d}.json"
    write_json(ticket, info)
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, on_signal)

    lockf = open(g / "lock", "w")
    log_path = jdir / "output.log"
    proc = None
    try:
        # Wait for our turn: the oldest live ticket, and the lock is free.
        announced = False
        while True:
            tickets = live_tickets(g)
            if tickets and tickets[0][0] == jid:
                try:
                    fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    pass
            if not announced:
                ahead = [t for t in tickets if t[0] < jid]
                print(f"[gpu] job {jid} queued ({len(ahead)} ahead)", flush=True)
                announced = True
            time.sleep(POLL)

        check_budget(team, a.timeout, agent)            # exact now: only one job runs at a time
        foreign = foreign_usage()
        if foreign:
            msg = (f"GPUs in use by someone outside this run: {foreign}. The job was NOT run. "
                   f"Report this to the manager (other people may be using these GPUs; we must "
                   f"not compete).")
            info.update({"state": "refused", "reason": foreign, "ended": now_iso()})
            write_json(jdir / "job.json", info)
            die(msg, EXIT_FOREIGN)

        start = time.time()
        info.update({"state": "running", "started": now_iso(start)})
        write_json(jdir / "job.json", info)
        write_json(g / "running.json", info)
        print(f"[gpu] job {jid} started (timeout {a.timeout:g} min); output: {log_path}", flush=True)
        env = dict(os.environ, AUTOINFER_GPU_JOB=str(jid))
        with open(log_path, "w") as log:
            proc = subprocess.Popen(a.command, stdout=log, stderr=subprocess.STDOUT,
                                    stdin=subprocess.DEVNULL, env=env, start_new_session=True)
            timed_out = False
            try:
                rc = proc.wait(timeout=a.timeout * 60)
            except subprocess.TimeoutExpired:
                timed_out = True
                log.write(f"\n[gpu] timeout after {a.timeout:g} min: killing the job\n")
                log.flush()
                kill_job(proc)
                rc = EXIT_TIMEOUT
            kill_job(proc, grace=5)                 # anything the job left running
            cleanup_gpu(proc.pid, log)
        end = time.time()
        finish(g, info, jdir, start, end, rc, timed_out, team, agent, a.label)
        proc = None
        tail = log_path.read_text(errors="replace").splitlines()[-25:]
        print("\n".join(tail))
        rem = remaining(team)
        print(f"[gpu] job {jid} {'TIMED OUT' if timed_out else 'exited'} with code {rc} after "
              f"{(end - start) / 60:.1f} min" + (f"; team {team}: {rem:.1f} GPU-min left this round"
                                                if rem is not None else "") +
              f"\n[gpu] full output: {log_path}", flush=True)
        sys.exit(rc)
    except Stop as e:
        if proc is not None:                            # we were killed/cancelled mid-job: charge it
            with open(log_path, "a") as log:
                log.write(f"\n[gpu] cancelled ({e}): killing the job\n")
                kill_job(proc, grace=5)
                cleanup_gpu(proc.pid, log)
            finish(g, info, jdir, start, time.time(), 130, False, team, agent, a.label, cancelled=True)
        else:
            info.update({"state": "cancelled", "ended": now_iso()})
            write_json(jdir / "job.json", info)
        print(f"[gpu] job {jid} cancelled", file=sys.stderr)
        sys.exit(130)
    finally:
        ticket.unlink(missing_ok=True)
        r = read_json(g / "running.json")
        if r and r.get("id") == jid:
            (g / "running.json").unlink(missing_ok=True)
        lockf.close()


def finish(g, info, jdir, start, end, rc, timed_out, team, agent, label, cancelled=False):
    b = budget()
    entry = {"job": info["id"], "round": b.get("round"), "team": team, "agent": agent,
             "label": label, "start": now_iso(start), "end": now_iso(end),
             "gpu_minutes": round((end - start) / 60, 3), "exit_code": rc,
             "timed_out": timed_out, "cancelled": cancelled,
             "charged": bool(team and team in b.get("teams", {})) or is_brainstormer(team)}
    with open(g / "ledger.jsonl", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps(entry) + "\n")
    info.update({"state": "cancelled" if cancelled else ("timed out" if timed_out else "done"),
                 "ended": now_iso(end), "exit_code": rc, "gpu_minutes": entry["gpu_minutes"]})
    write_json(jdir / "job.json", info)


def cmd_status(a):
    g = gdir()
    b = budget()
    rnd = b.get("round")
    running = read_json(g / "running.json")
    if running and not pid_alive(running["pid"]):
        running = None
    waiting = [t[2] for t in live_tickets(g) if not running or t[0] != running["id"]]
    led = [e for e in ledger() if e.get("round") == rnd]
    teams = {}
    for e in led:
        k = e.get("team") or ("(brainstormers)" if e["agent"].startswith("bs-") else "(unbudgeted)")
        teams.setdefault(k, {}).setdefault(e["agent"], 0.0)
        teams[k][e["agent"]] += e["gpu_minutes"]
    for t in b.get("teams", {}):
        teams.setdefault(t, {})
    if a.json:
        print(json.dumps({"round": rnd, "running": running, "waiting": waiting,
                          "budgets": b.get("teams", {}),
                          "used": {t: round(sum(v.values()), 3) for t, v in teams.items()},
                          "by_agent": teams}, indent=2))
        return
    if running:
        el = (time.time() - datetime.fromisoformat(running["started"]).timestamp()) / 60
        print(f"RUNNING  job {running['id']}  {running['agent']} ({running['team'] or 'unbudgeted'})"
              f"  {running.get('label') or ''}  {el:.1f} / {running['timeout_min']:g} min")
    else:
        print("RUNNING  none")
    print(f"WAITING  {len(waiting)}" + "".join(
        f"\n  job {w['id']}  {w['agent']} ({w['team'] or 'unbudgeted'})  {w.get('label') or ''}"
        f"  timeout {w['timeout_min']:g} min" for w in waiting))
    print(f"\nROUND {rnd if rnd is not None else '- (no budget.json)'}   GPU-minutes")
    for t in sorted(teams):
        bud = b.get("teams", {}).get(t)
        u = sum(teams[t].values())
        line = f"  {t:<14} used {u:6.1f}"
        if bud is not None:
            line += f" / {bud:g}   remaining {bud - u:6.1f}"
        print(line + ("   " + ", ".join(f"{ag} {m:.1f}" for ag, m in sorted(teams[t].items()))
                      if teams[t] else ""))


def cmd_wait(a):
    jdir = gdir() / "jobs" / str(a.job)
    if not (jdir / "job.json").exists():
        die(f"no job {a.job} (job ids are in `gpu status`)")
    t0 = time.time()
    while True:
        info = read_json(jdir / "job.json") or {}
        if info.get("state") in ("done", "timed out", "cancelled", "refused"):
            break
        if a.max and time.time() - t0 > a.max * 60:
            print(f"[gpu] job {a.job} still {info.get('state', 'queued')} after {a.max:g} min of waiting")
            sys.exit(3)
        time.sleep(POLL)
    log = jdir / "output.log"
    if log.exists():
        print("\n".join(log.read_text(errors="replace").splitlines()[-25:]))
    rc = info.get("exit_code")
    print(f"[gpu] job {a.job} {info['state']}" + (f" with code {rc}" if rc is not None else "") +
          (f" after {info['gpu_minutes']:.1f} min" if info.get("gpu_minutes") is not None else "") +
          f"\n[gpu] full output: {log}")
    sys.exit(rc if isinstance(rc, int) else 1)


def cmd_cancel(a):
    g = gdir()
    info = read_json(g / "jobs" / str(a.job) / "job.json")
    if not info:
        die(f"no job {a.job}")
    if info.get("state") in ("done", "timed out", "cancelled", "refused"):
        die(f"job {a.job} already finished ({info['state']})")
    if not pid_alive(info["pid"]):
        die(f"job {a.job} is not active")
    os.kill(info["pid"], signal.SIGTERM)                # its `gpu run` kills the job and charges it
    print(f"cancelling job {a.job}")


def main():
    p = argparse.ArgumentParser(prog="gpu", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    R = argparse.RawDescriptionHelpFormatter
    s = sub.add_parser("run", formatter_class=R, help="run one GPU job (blocks until it ends)",
                       description="""Run one command with exclusive use of all GPUs of the machine.

Waits in the queue (first come, first served), then runs the command and blocks until it exits
or reaches --timeout. Run it as a BACKGROUND Bash command: you are notified when it ends, and
waiting can take a while. Your team is charged the actual minutes (queue time is free). The job
is admitted only if your team's remaining budget covers --timeout, checked when you submit and
again when it reaches the front of the queue.

One job = one script: start the server, wait until it is ready, run all your tests, stop it.
Everything the job started is killed when it ends or times out (don't detach anything with
setsid/nohup/daemons). The output is printed and also saved in $AUTOINFER_RUN/gpu/jobs/<id>/output.log.""",
                       epilog="""exit codes:
  <the command's own>   the job ran
  124                   killed at --timeout
  76                    your team's budget can't cover --timeout: not run (lower --timeout, or do
                        GPU-free work; `gpu status` shows what is left)
  75                    GPUs in use by someone outside this run: not run. Stop GPU work and tell
                        the manager (other people use these GPUs; we don't compete)
  130                   cancelled (gpu cancel)
  2                     bad arguments: not run

examples:
  gpu run --timeout 15 --label smoke-T1-003 -- bash $AUTOINFER_RUN/workspaces/x/smoke.sh
  gpu run --timeout 5 -- python microbench.py --m 16 --n 17408 --k 5120""")
    s.add_argument("--timeout", type=float, required=True, metavar="MIN",
                   help="minutes; the job is killed after this. Also what the budget check needs "
                        "to cover, so don't overestimate it wildly")
    s.add_argument("--label", default=None, help="short name shown in `gpu status` and the ledger")
    s.add_argument("command", nargs=argparse.REMAINDER,
                   help="after `--`: the command to run (a script path is easiest)")
    s.set_defaults(fn=cmd_run)
    s = sub.add_parser("status", formatter_class=R, help="running job, queue, budgets",
                       description="Show the running job, the waiting jobs, and each team's GPU budget "
                                   "for this round: budget, used, remaining (minutes).")
    s.add_argument("--json", action="store_true", help="machine-readable output")
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser("wait", formatter_class=R, help="wait until a job ends; print its result",
                       description="""Block until the job ends, then print the last lines of its output and exit with
its exit code. For a job you can't wait on otherwise (a teammate's, or one whose `gpu run` you
lost track of). For your own new jobs, just run `gpu run` itself as a background command: you are
notified when it ends. Like `gpu run`, run `gpu wait` as a background command: foreground Bash
commands are cut off after ~10 min.""",
                       epilog="""exit codes: the job's own exit code; 3 = --max reached and the job is still going

examples:
  gpu wait 12
  gpu wait 12 --max 5      (give up waiting after 5 minutes)""")
    s.add_argument("job", type=int, help="job id, from `gpu status` or the [gpu] line `gpu run` printed")
    s.add_argument("--max", type=float, default=None, metavar="MIN", help="stop waiting after this")
    s.set_defaults(fn=cmd_wait)
    s = sub.add_parser("cancel", formatter_class=R, help="cancel a waiting job or kill a running one",
                       description="Cancel a waiting job, or kill a running one (it is charged for the "
                                   "minutes it ran). The job's `gpu run` exits with 130.",
                       epilog="example: gpu cancel 12      (job ids are in `gpu status`)")
    s.add_argument("job", type=int, help="job id, from `gpu status`")
    s.set_defaults(fn=cmd_cancel)
    a = p.parse_args()
    if a.cmd == "run" and a.command and a.command[0] == "--":
        a.command = a.command[1:]
    if a.cmd == "run" and not a.command:
        p.error("gpu run: give the command after --, e.g. gpu run --timeout 10 -- bash job.sh")
    if a.cmd == "run" and a.timeout <= 0:
        die("--timeout must be > 0")
    a.fn(a)


if __name__ == "__main__":
    main()
