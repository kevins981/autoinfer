+        si = lm_head.shard_indices
+        width = logits.shape[-1]
+        # The full path concatenates the shards and cuts at org_vocab_size, so
+        # shard r owns ids [r * width, (r + 1) * width). Anything else: fall back.
+        if si.num_org_vocab_padding != 0 or si.org_vocab_start_index != (
+            lm_head.tp_rank * width
+        ):
+            return None
+        num_valid = max(0, min(width, self.org_vocab_size - si.org_vocab_start_index))
