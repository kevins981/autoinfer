diff --git a/csrc/quantization/marlin/marlin_e4m3.cu b/csrc/quantization/marlin/marlin_e4m3.cu
new file mode 100644
index 0000000000..6f9c62dc02
--- /dev/null
+++ b/csrc/quantization/marlin/marlin_e4m3.cu
@@ -0,0 +1,115 @@
+// T28 Marlin-e4m3: FP8-activation (e4m3, pi-permuted columns) x Marlin-repacked FP8 weights, block-scaled in fp32.
+// A separate translation unit with its own namespace (marlin_e4m3) so the stock Marlin kernels are untouched (bf16 path bitwise unchanged).
+// Template: marlin_e4m3_template.h = marlin_template.h + `a_fp8` (see agents/leader-28.w1/k/DESIGN.md).
+#define MARLIN_NAMESPACE_NAME marlin_e4m3
+#include <cstdlib>
+#include <cstring>
+#include <cstdio>
+#include "marlin_e4m3_template.h"
+
+#include <torch/csrc/stable/accelerator.h>
+#include <torch/csrc/stable/library.h>
+#include <torch/csrc/stable/ops.h>
+#include <torch/csrc/stable/tensor.h>
+#include <torch/headeronly/core/ScalarType.h>
+#include <torch/headeronly/util/Exception.h>
+
+#include "torch_utils.h"
+
+namespace marlin_e4m3 {
+
+#if !(defined(__CUDA_ARCH__) && __CUDA_ARCH__ < 750)
+
+typedef void (*KFn)(const int4*, const int4*, int4*, int4*, const int4*, const int4*, const float*, const int4*, int, int, int, int, int*,
+                    bool, bool, bool, int);
+
+template <int TMB, int TK, int TN, int TH, int ST>
+static KFn pick() {
+  return Marlin<vllm::kBFloat16.id(), vllm::kFE4M3fn.id(), vllm::kBFloat16.id(), vllm::kBFloat16.id(), TH, TMB, TN / 16, TK / 16, false, ST,
+                8, false, true>;
+}
+template <int TMB, int ST>
+static KFn pick_cfg(int tk, int tn, int th) {
+  if (tk == 64 && tn == 128 && th == 128) return pick<TMB, 64, 128, 128, ST>();
+  if (tk == 128 && tn == 128 && th == 256) return pick<TMB, 128, 128, 256, ST>();
+  if (tk == 64 && tn == 256 && th == 256) return pick<TMB, 64, 256, 256, ST>();
+  if (tk == 128 && tn == 64 && th == 128) return pick<TMB, 128, 64, 128, ST>();
+  return nullptr;
+}
+template <int TMB>
+static KFn pick_st(int tk, int tn, int th, int st) {
+  if (st == 4) return pick_cfg<TMB, 4>(tk, tn, th);
+  if (st == 3) return pick_cfg<TMB, 3>(tk, tn, th);
+  return nullptr;
+}
+static KFn pick_kernel(int tmb, int tk, int tn, int th, int st) {
+  switch (tmb) {
+    case 1: return pick_st<1>(tk, tn, th, st);
+    case 2: return pick_st<2>(tk, tn, th, st);
+    case 3: return pick_st<3>(tk, tn, th, st);
+    default: return nullptr;
+  }
+}
+
+// (N, K, M) -> best warm config from agents/leader-28.w1/mb/bench4b.json: {N,K,M, tk,tn,threads,stages,tmb}
+struct CfgRow { int N, K, M, tk, tn, th, st, tmb; };
+static const CfgRow kCfg[] = {
+#include "marlin_e4m3_cfg_table.inc"
+};
+
+static void choose(int N, int K, int M, int& tk, int& tn, int& th, int& st, int& tmb) {
+  const CfgRow* best = nullptr;
+  for (const CfgRow& r : kCfg)
+    if (r.N == N && r.K == K && r.M >= M && (!best || r.M < best->M)) best = &r;
+  if (!best)
+    for (const CfgRow& r : kCfg)
+      if (r.N == N && r.K == K && (!best || r.M > best->M)) best = &r;
+  if (best) { tk = best->tk; tn = best->tn; th = best->th; st = best->st; tmb = best->tmb; return; }
+  tk = 64; tn = 128; th = 128; st = 4; tmb = M <= 16 ? 1 : (M <= 32 ? 2 : 3);
+}
+
+#endif
+
+}  // namespace marlin_e4m3
+
+// a: fp8 e4m3 [M,K] (columns pi-permuted inside each 32-slab), a_scales: fp32 [M,K/128], b_q_weight: Marlin-repacked fp8 weight (int32 [K/16, 4N]),
+// b_scales: fp32 [N/128, K/128] (standard order), workspace: int32 zeros (>= 2*sms), c_tmp: fp32 >= sms*64*256; returns a new bf16 [M,N].
+// cfg: -1 auto, else packed tk | tn<<8 ... (unused: reserved)
+torch::stable::Tensor marlin_gemm_e4m3(torch::stable::Tensor& a, torch::stable::Tensor& a_scales, torch::stable::Tensor& b_q_weight,
+                                       torch::stable::Tensor& b_scales, torch::stable::Tensor& workspace, torch::stable::Tensor& c_tmp,
+                                       int64_t size_m, int64_t size_n, int64_t size_k, int64_t cfg) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ < 750
+  return a;
+#else
+  using namespace marlin_e4m3;
+  STD_TORCH_CHECK(a.scalar_type() == torch::headeronly::ScalarType::Float8_e4m3fn, "a must be float8_e4m3fn");
+  STD_TORCH_CHECK(a_scales.scalar_type() == torch::headeronly::ScalarType::Float && b_scales.scalar_type() == torch::headeronly::ScalarType::Float,
+                  "scales must be float32");
+  STD_TORCH_CHECK(a.stride(1) == 1 && a.stride(0) == size_k && a.size(0) == size_m && a.size(1) == size_k, "a must be contiguous [M,K]");
+  STD_TORCH_CHECK(size_k % 128 == 0 && size_n % 128 == 0, "K and N must be multiples of 128");
+  STD_TORCH_CHECK(a_scales.is_contiguous() && a_scales.size(0) == size_m && a_scales.size(1) == size_k / 128, "a_scales must be [M,K/128]");
+  STD_TORCH_CHECK(b_scales.is_contiguous() && b_scales.size(0) == size_n / 128 && b_scales.size(1) == size_k / 128, "b_scales must be [N/128,K/128]");
+  STD_TORCH_CHECK(b_q_weight.is_contiguous() && b_q_weight.numel() * 4 == size_n * size_k, "b_q_weight must be the Marlin repack of an unpadded [N,K] fp8 weight");
+  torch::stable::Tensor c = torch::stable::empty({size_m, size_n}, torch::headeronly::ScalarType::BFloat16, std::nullopt, a.device());
+  STD_TORCH_CHECK(size_m >= 1 && size_m <= 768, "M out of range (16 slabs x 48 rows)");
+  const int dev = a.get_device_index();
+  int sms = -1, max_shared_mem = 0;
+  cudaDeviceGetAttribute(&sms, cudaDevAttrMultiProcessorCount, dev);
+  cudaDeviceGetAttribute(&max_shared_mem, cudaDevAttrMaxSharedMemoryPerBlockOptin, dev);
+  STD_TORCH_CHECK(workspace.numel() >= 2 * sms, "workspace too small");
+  STD_TORCH_CHECK(c_tmp.numel() >= (int64_t)sms * 64 * 256, "c_tmp too small");
+  int tk, tn, th, st, tmb;
+  choose((int)size_n, (int)size_k, (int)size_m, tk, tn, th, st, tmb);
+  STD_TORCH_CHECK(size_n % tn == 0 && size_k % tk == 0, "N/K not divisible by the chosen thread tile");
+  KFn k = pick_kernel(tmb, tk, tn, th, st);
+  STD_TORCH_CHECK(k != nullptr, "no e4m3 kernel instantiated for this config");
+  cudaFuncSetAttribute(k, cudaFuncAttributeMaxDynamicSharedMemorySize, max_shared_mem);
+  k<<<sms, th, max_shared_mem, get_current_cuda_stream(dev)>>>(
+      (const int4*)a.const_data_ptr(), (const int4*)b_q_weight.const_data_ptr(), (int4*)c.mutable_data_ptr(), (int4*)c_tmp.mutable_data_ptr(),
+      nullptr, (const int4*)b_scales.const_data_ptr(), (const float*)a_scales.const_data_ptr(), nullptr, (int)size_m, (int)size_n, (int)size_k,
+      (int)size_k, (int*)workspace.mutable_data_ptr(), false, false, true, max_shared_mem);
+  return c;
+#endif
+}
+
+STABLE_TORCH_LIBRARY_IMPL(_C, CUDA, m) { m.impl("marlin_gemm_e4m3", TORCH_BOX(&marlin_gemm_e4m3)); }
