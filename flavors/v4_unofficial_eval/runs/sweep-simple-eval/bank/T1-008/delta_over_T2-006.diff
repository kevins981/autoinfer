+# --- Draft-metadata fast path (T1, leader-1.w1) -------------------------------
+# While the drafter builds its uniform decode metadata, the exact seq_lens only
+# exist on the GPU (rejections of the previous verify step). Reading them with
+# `.cpu()` blocks the host until the whole step has finished on the GPU and
+# leaves the GPU idle while the host prepares the next step. FlashInfer's
+# plan() only needs the lengths for scheduling (split-KV chunking); the kernel
+# reads the real indptr / last_page_len / indices from GPU buffers. So: plan
+# with the CPU upper bound and overwrite those GPU buffers with exact values
+# computed on the GPU. Checked bitwise-identical to an exact plan in
+# bench/test_plan_ub.py (workspace leader-1.draftmeta). Only the drafter path,
+# only the cuda-graph decode wrapper; everything else keeps the exact path.
+_draft_ub_state = threading.local()
+
+
+@contextlib.contextmanager
+def draft_upper_bound_planning():
+    prev = getattr(_draft_ub_state, "on", False)
+    _draft_ub_state.on = _DRAFT_UB_ENABLED
+    try:
+        yield
+    finally:
+        _draft_ub_state.on = prev
+
+
+def _draft_ub_active() -> bool:
+    if not getattr(_draft_ub_state, "on", False):
+        return False
+    mode = _DRAFT_UB_MODE
+    if mode.startswith("file:"):  # debug: old path while the file exists
+        return not os.path.exists(mode[5:])
+    return mode != "0"
+
+
+_DRAFT_UB_MODE = os.environ.get("VLLM_DRAFT_UB_PLAN", "1")
+_DRAFT_UB_ENABLED = _DRAFT_UB_MODE != "0"
+_DRAFT_UB_CHECK_FILE = os.environ.get("VLLM_DRAFT_UB_CHECK")  # debug: checks run while this path exists
+_draft_ub_check_stats = [0, 0, 0]  # steps checked, mismatching steps, rows
+
