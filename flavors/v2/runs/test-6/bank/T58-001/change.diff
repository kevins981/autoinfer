+# ---------------------------------------------------------------------------------------------
+# T30: two-wave layer-pipelined mixed steps (prototype). See vllm/t30_wave.py.
+# ---------------------------------------------------------------------------------------------
+_t30_aux: torch.cuda.Stream | None = None
+_t30_events: list = []
+_t30_aux_more: list = []
+_t30_check_n = [0]
+# T52_WAVE_PRI (default 1; used when T52_WAVE=1): link priority for the wave schedule. The waves' DMA ARs share
+# one D2H copy engine, which interleaves concurrent ARs so they all finish late (KB128). Wave c>0's AR k of layer L
+# waits for wave c-1's AR k of layer L; wave 0's AR1 of layer L+1 waits for the last wave's AR2 of layer L.
+# Stream order only: bitwise the same as without it.
+_T52_WAVE_PRI = os.environ.get("T52_WAVE_PRI", "1") == "1"
+_t52_ar_ev: list = []
+_T30_CAP_LAYERS = (0, 1, 2, 4, 8, 16, 32, 63)
+
+
+def _t32_shared() -> bool:
+    from vllm.model_executor.layers.mamba.gdn import t32_cap
+
+    return t32_cap.ENABLED
+
+
+def _t30_layer_ok(layer: "Qwen3_5DecoderLayer") -> bool:
+    return (
+        not layer.layer_scale
+        and layer.use_fused_allreduce_norm
+        and layer.mlp_output_is_partial
+        and not layer.use_attn_reduce_scatter_for_moe
+        and isinstance(layer.mlp, Qwen3NextMLP)
+    )
+
+
+def _t30_wave_layers(layers, hidden_states, residual, positions, plan, dma, capture=None, only=None):
+    """Two waves through all layers without a per-layer join. Wave 0 (rows [0,s)) runs on the
+    current stream + DMA lane 0, wave 1 (rows [s,n)) on an aux stream + lane 1. The only
+    cross-wave edge is core(B, L) after core(A, L) (GDN/conv state and KV of a split request)."""
+    global _split_aux_stream
+    from vllm.forward_context import get_forward_context
+
+    ctx = get_forward_context()
+    n = hidden_states.shape[0]
+    bnd = plan.bounds or [0, plan.split, n]
+    k = len(bnd) - 1
+    if only is None:
+        only = tuple(range(k))
+    rows = [(bnd[i], bnd[i + 1]) for i in range(k)]
+    cur = torch.cuda.current_stream()
+    if _split_aux_stream is None:
+        _split_aux_stream = torch.cuda.Stream(device=hidden_states.device)
+    while len(_t30_aux_more) < 3:
+        _t30_aux_more.append(torch.cuda.Stream(device=hidden_states.device))
+    aux = _split_aux_stream
+    streams = [cur, aux] + _t30_aux_more[: max(0, k - 2)]
+    while len(_t30_events) < len(layers):
+        _t30_events.append([])
+    for ev_ in _t30_events:
+        while len(ev_) < 3:
+            ev_.append(torch.cuda.Event())
+    first = residual is None
+    if first:
+        residual = hidden_states
+    out = torch.empty_like(hidden_states)
+    saved = (ctx.attn_metadata, ctx.slot_mapping)
+    for st_ in streams[1:]:
+        st_.wait_stream(cur)
+    pos_slices = [positions[..., a:b] for a, b in rows]
+    pri = _T52_WAVE_PRI and k > 1
+    if pri:
+        need = len(layers) * 2 * k
+        while len(_t52_ar_ev) < need:
+            _t52_ar_ev.append(torch.cuda.Event())
+
+    def _arw(li_, kk, c_):  # wait before AR kk (1/2) of wave c_ in layer li_
+        if not pri:
+            return
+        s_ = torch.cuda.current_stream()
+        if c_ > 0:
+            s_.wait_event(_t52_ar_ev[(li_ * 2 + kk - 1) * k + c_ - 1])
+        elif kk == 1 and li_ > 0:
+            s_.wait_event(_t52_ar_ev[((li_ - 1) * 2 + 1) * k + k - 1])
+
+    def _arr(li_, kk, c_):
+        if pri:
+            _t52_ar_ev[(li_ * 2 + kk - 1) * k + c_].record(torch.cuda.current_stream())
+    try:
+        for li, layer in enumerate(layers):
+            gdn = layer.layer_type == "linear_attention"
+            in_proj = layer.linear_attn.in_proj_qkvz if gdn else layer.self_attn.qkv_proj
+            out_proj = layer.linear_attn.out_proj if gdn else layer.self_attn.o_proj
+            gate_up = layer.mlp.gate_up_proj
+            for c in only:
+                a, b = rows[c]
+                with torch.cuda.stream(streams[c]):
+                    ctx.attn_metadata = plan.md[c]
+                    ctx.slot_mapping = plan.sm[c]
+                    x_in = hidden_states[a:b] if (first and li == 0) else out[a:b]
+                    qa, y, _ = layer.input_layernorm.forward_fused(
+                        x_in,
+                        None if (first and li == 0) else residual[a:b],
+                        in_proj,
+                        write_y=gdn,
+                        reduced=True,
+                    )
+                    src = qa if qa is not None else y
+                    if gdn:
+                        mq, _ = layer.linear_attn.in_proj_qkvz(src)
+                        ba, _ = layer.linear_attn.in_proj_ba(y)
+                    else:
+                        qkv, _ = layer.self_attn.qkv_proj(src)
+                    if c >= 1:
+                        torch.cuda.current_stream().wait_event(_t30_events[li][c - 1])
+                    elif li > 0 and k > 1 and _t32_shared():
+                        # T52: the captured GDN core (T32_GDN_CAP) uses one set of static buffers: wave 0's
+                        # core of layer li must not start before the last wave's core of layer li-1 is done
+                        torch.cuda.current_stream().wait_event(_t30_events[li - 1][k - 1])
+                    if gdn:
+                        core = layer.linear_attn.forward_cuda(
+                            y, defer_out_proj=True, preproj=(mq, ba)
+                        )
+                    else:
+                        core = layer.self_attn(
+                            hidden_states=src if qa is None else qa,
+                            positions=pos_slices[c],
+                            defer_out_proj=True,
+                            qkv_pre=qkv,
+                        )
+                    if c < k - 1 or _t32_shared():
+                        _t30_events[li][c].record(streams[c])
+                    p = out_proj(core)[0]
+                    _arw(li, 1, c)
+                    p = dma.all_reduce(p, None, lane=c)
+                    _arr(li, 1, c)
+                    st = capture is not None and li == 0
+                    if st:
+                        p_c = p.float().cpu()
+                    mlp_in, h, _ = layer.post_attention_layernorm.forward_fused(
+                        p, residual[a:b], gate_up, reduced=True
+                    )
+                    if st:
+                        res_c = residual[a:b].float().cpu()
+                    d = layer.mlp(h if mlp_in is None else mlp_in)
+                    if st:
+                        d_c = d.float().cpu()
+                    _arw(li, 2, c)
+                    dma.all_reduce(d, out[a:b], lane=c)
+                    _arr(li, 2, c)
+                    if st:
+                        out_c = out[a:b].float().cpu()
+                        capture.setdefault("st", {})[c] = {"p": p_c, "res": res_c, "d": d_c, "out": out_c}
+                    if capture is not None and li == 0:
+                        tt = core.data if hasattr(core, "data") and not isinstance(core, torch.Tensor) else core
+                        capture.setdefault("l0", {})[c] = {
+                            "mq": mq.float().cpu(), "ba": ba.float().cpu(), "core": tt.float().cpu(),
+                        }
+            if capture is not None and li in _T30_CAP_LAYERS:
+                for st_ in streams[1:]:
+                    cur.wait_stream(st_)
+                for st_ in streams[1:]:
+                    st_.wait_stream(cur)
+                capture[li] = (out.float() + residual.float()).cpu()
+    finally:
+        ctx.attn_metadata, ctx.slot_mapping = saved
+    for st_ in streams[1:]:
+        cur.wait_stream(st_)
+    return out, residual
+
+
+_t30_bench_done: dict = {}
+
+
+def _t30_run_joined(layers, h0, positions):
+    h, r, red, pre_ = h0.clone(), None, False, None
+    for li_, layer in enumerate(layers):
+        nxt = layers[li_ + 1] if _T9_PINGPONG and li_ + 1 < len(layers) else None
+        h, r = layer(
+            positions=positions, hidden_states=h, residual=r,
+            inputs_reduced=red, allow_split=True, pre=pre_, next_layer=nxt,
+        )
+        red = getattr(layer, "output_reduced", False)
+        pre_ = getattr(layer, "pre_for_next", None)
+        layer.pre_for_next = None
+    return h, r
+
+
+def _t30_hostfree_bench(layers, h_in, positions, plan, dma, wctx):
+    """Test-only (T30_WAVE_BENCH): GPU time of the same eligible step, host out of the way.
+    (a) CUDA-graph capture + replay of the whole eager forward (valid because the replayed step
+    is the same step: same metadata, buffers, state), (b) torch.profiler kernel-activity span and
+    busy-union of an eager run. Variants: joined chain (W2) and waves (W1), with and without the
+    all-reduces (DMA AR replaced by a copy)."""
+    import time as _time
+
+    rank0 = torch.distributed.get_rank() == 0
+    snap = _t30_snapshot(layers, wctx)
+    torch.cuda.synchronize()
+
+    def noar_on():
+        dma.all_reduce = lambda inp, out=None, lane=0: (inp if out is None else out.copy_(inp))
+
+    def noar_off():
+        if "all_reduce" in dma.__dict__:
+            del dma.all_reduce
+
+    fns = {
+        "W2": lambda: _t30_run_joined(layers, h_in, positions),
+        "W1": lambda: _t30_wave_layers(layers, h_in.clone(), None, positions, plan, dma),
+    }
+    res = {}
+    names = ("W1", "W1_noar", "W2") if t30_wave.TRACE_DIR else ("W2", "W1", "W2_noar", "W1_noar")
+    if os.environ.get("T30_WAVE_KBENCH", "0") == "1":
+        names = ["W2", "W2_noar"]
+        for k_ in (2, 3, 4):
+            if k_ == 2 or k_ in t30_wave.EXTRA_PLANS:
+                names += [f"W1k{k_}", f"W1k{k_}_noar"]
+        for k_ in (3, 4):
+            if k_ in t30_wave.EXTRA_PLANS:
+                pk = t30_wave.EXTRA_PLANS[k_]
+                fns[f"W1k{k_}"] = (lambda pk=pk: _t30_wave_layers(layers, h_in.clone(), None, positions, pk, dma))
+        fns["W1k2"] = fns["W1"]
+    for name in names:
+        fn = fns[name.replace("_noar", "") if name.startswith("W1k") else name[:2]]
+        if name.endswith("noar"):
+            noar_on()
+        try:
+            _t30_restore(layers, snap)
+            torch.cuda.synchronize()
+            t0 = _time.perf_counter()
+            fn()
+            torch.cuda.synchronize()
+            eager_wall = (_time.perf_counter() - t0) * 1e3
+            # (b) profiler: only for the real-AR variants
+            prof_txt = ""
+            if not name.endswith("noar") and not t30_wave.TRACE_DIR and os.environ.get("T30_WAVE_KBENCH", "0") != "1":
+                try:
+                    _t30_restore(layers, snap)
+                    torch.cuda.synchronize()
+                    with torch.profiler.profile(activities=[torch.profiler.ProfilerActivity.CUDA]) as pr:
+                        fn()
+                        torch.cuda.synchronize()
+                    iv = sorted(
+                        (e.time_range.start, e.time_range.end)
+                        for e in pr.events()
+                        if e.device_type == torch.autograd.DeviceType.CUDA
+                    )
+                    span = (iv[-1][1] if False else max(b for _, b in iv)) - iv[0][0]
+                    busy = 0.0
+                    cs, ce = iv[0]
+                    for a, b in iv[1:]:
+                        if a > ce:
+                            busy += ce - cs
+                            cs, ce = a, b
+                        else:
+                            ce = max(ce, b)
+                    busy += ce - cs
+                    prof_txt = f" prof span {span / 1e3:.1f} busy-union {busy / 1e3:.1f} ms ({len(iv)} activities)"
+                except Exception as ex:  # noqa: BLE001
+                    prof_txt = f" prof FAILED {type(ex).__name__}: {str(ex)[:120]}"
+            if rank0:
+                logger.info(
+                    "T30HOSTFREE n=%d split=%d %s eager wall %.1f ms |%s", plan.n, plan.split, name, eager_wall, prof_txt
+                )
+            # (a) graph
+            g_txt = ""
+            try:
+                _t30_restore(layers, snap)
+                torch.cuda.synchronize()
+                torch.cuda.empty_cache()
+                g = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(g):
+                    fn()
+                ts = []
+                for _ in range(4):
+                    e0 = torch.cuda.Event(enable_timing=True)
+                    e1 = torch.cuda.Event(enable_timing=True)
+                    torch.cuda.synchronize()
+                    e0.record()
+                    g.replay()
+                    e1.record()
+                    e1.synchronize()
+                    ts.append(e0.elapsed_time(e1))
+                if t30_wave.TRACE_DIR:
+                    torch.cuda.synchronize()
+                    with torch.profiler.profile(activities=[torch.profiler.ProfilerActivity.CUDA]) as pr2:
+                        g.replay()
+                        torch.cuda.synchronize()
+                    if rank0:
+                        pr2.export_chrome_trace(f"{t30_wave.TRACE_DIR}/trace_{name}_n{plan.n}.json")
+                del g
+                g_txt = f" graph replay ms {['%.1f' % t for t in ts]}"
+            except Exception as ex:  # noqa: BLE001
+                g_txt = f" graph FAILED {type(ex).__name__}: {str(ex)[:160]}"
+            if rank0:
+                logger.info(
+                    "T30HOSTFREE-GRAPH n=%d split=%d %s |%s", plan.n, plan.split, name, g_txt,
+                )
+        finally:
+            noar_off()
+            torch.cuda.synchronize()
+            _t30_restore(layers, snap)
+    torch.cuda.empty_cache()
+
+
+def _t30_snapshot(layers, ctx):
+    """Test-only: GDN/conv state at the active slots, KV blocks of attention layers."""
+    snap = {}
+    md = ctx.attn_metadata
+    for layer in layers:
+        if layer.layer_type == "linear_attention":
+            m = md[layer.linear_attn.prefix]
+            idx = []
+            for t in (m.spec_state_indices_tensor, m.non_spec_state_indices_tensor):
+                if t is not None:
+                    idx.append(t.reshape(-1))
+            idx = torch.unique(torch.cat(idx).to(torch.int64))
+            kv = layer.linear_attn.kv_cache
+            fl = layer.linear_attn._gdn_replay_flags
+            snap[layer.layer_idx] = (
+                idx, kv[0][idx].cpu(), kv[1][idx].cpu(),
+                None if fl is None else fl[idx].cpu(),
+            )
+        else:
+            attn = layer.self_attn.attn
+            kv = attn.kv_cache
+            sm = ctx.slot_mapping[attn.layer_name]
+            bs = kv.shape[2]
+            blk = torch.unique(sm[sm >= 0] // bs)
+            bd = 1 if (kv.shape[0] == 2 and kv.shape[1] != 2) else 0
+            snap[layer.layer_idx] = (blk, bd, kv.index_select(bd, blk).cpu())
+    return snap
+
+
+def _t30_restore(layers, snap):
+    for layer in layers:
+        if layer.layer_type == "linear_attention":
+            idx, conv, ssm, fl = snap[layer.layer_idx]
+            kv = layer.linear_attn.kv_cache
+            kv[0][idx] = conv.to(idx.device)
+            kv[1][idx] = ssm.to(idx.device)
+            if fl is not None:
+                layer.linear_attn._gdn_replay_flags[idx] = fl.to(idx.device)
+        else:
+            blk, bd, data = snap[layer.layer_idx]
+            layer.self_attn.attn.kv_cache.index_copy_(bd, blk, data.to(blk.device))
+
+
+def _t30_compare(layers, a, b):
+    rep = []
+    nbad = 0
+    for layer in layers:
+        x, y = a[layer.layer_idx], b[layer.layer_idx]
+        if layer.layer_type == "linear_attention":
+            pairs = [("conv", x[1], y[1]), ("ssm", x[2], y[2])]
+            if x[3] is not None:
+                pairs.append(("flags", x[3], y[3]))
+        else:
+            pairs = [("kv", x[2], y[2])]
+        for name, u, v in pairs:
+            u8 = u.view(torch.uint8) if u.dtype != torch.uint8 and u.element_size() == 1 else u
+            v8 = v.view(torch.uint8) if v.dtype != torch.uint8 and v.element_size() == 1 else v
+            neq = int((u8 != v8).sum().item()) if u8.dtype == torch.uint8 else int((u != v).sum().item())
+            if neq and layer.layer_idx == 0 and name in ("ssm", "conv"):
+                bad = (u != v).reshape(u.shape[0], -1).any(dim=1).nonzero().flatten()
+                rep.append(f"L0.{name} bad slots {x[0][bad].tolist()[:20]} of {x[0].numel()} (rows)")
+            if neq:
+                nbad += 1
+                d = (u.float() - v.float()).abs().max().item() if u.dtype != torch.uint8 else -1.0
+                rep.append(f"L{layer.layer_idx}.{name}: neq {neq}/{u.numel()} maxabs {d:.3g}")
+    return nbad, rep
+
