+# SPDX-License-Identifier: Apache-2.0
+"""T29_W8A8=2: W8A8 on the champion's Marlin-repacked FP8 weights, for M > 96 only.
+
+Weights stay exactly as the champion's Marlin layout (prepare_fp8_layer_for_marlin); each FP8
+block linear keeps an fp32 copy of weight_scale_inv [N/128, K/128] (taken before Marlin consumes
+it). Per call (inside one opaque custom op, so the dispatch is fixed per captured size and
+torch.compile never guards on M):
+  M <= T29_W8A8_MAX_MARLIN_M (96): the champion's Marlin call, same op and arguments (bitwise);
+  M >  96: quant_perm (dynamic per-token-group-128 e4m3, columns permuted by PI) +
+           bs_gemm_marlin (e4m3 MMA within each 128-K block, fp32 scale-and-accumulate across
+           blocks), leader-29.w2's kernel (agents/leader-29.w2/gemm/PI_SPEC.md). No split-K.
+"""
+
+import hashlib
+import os
+
+import torch
+
+from vllm.logger import init_logger
+from vllm.triton_utils import tl, triton
+from vllm.utils.torch_utils import direct_register_custom_op
+
+logger = init_logger(__name__)
+
+T29_MODE = os.environ.get("T29_W8A8", "2")
+ENABLED = T29_MODE == "2"
+MAX_MARLIN_M = int(os.environ.get("T29_W8A8_MAX_MARLIN_M", "96"))
+# T45 (leader-45): gate_up (17408x5120 per rank) on bs_gemm W8A8 for T45_GU_BS_MIN_M < M <= MAX_MARLIN_M.
+T45_GU_BS = os.environ.get("T45_GU_BS", "1") == "1"
+T45_GU_BS_MIN_M = int(os.environ.get("T45_GU_BS_MIN_M", "48"))
+T45_GU_BS_SHAPES = {(17408, 5120)}
+_CAPTURE = bool(os.environ.get("T29_CAPTURE", ""))
+
+# T31_E4M3 (default 1; T31_E4M3=0 together with T29_FUSED_ALL_M=0 restores the champion's path): for M <= 96 the target's FP8 linears run quant_perm + the register-direct e4m3 decode GEMM
+# (_C::t31_gemm_e4m3, leader-31.w1) instead of Marlin. Registry keyed by the Marlin qweight's data_ptr,
+# filled in warmup_layer (the custom op below only sees tensors). The drafter's linears (prefix has "mtp")
+# stay Marlin unless T31_E4M3_DRAFTER=1. T31_REGIME="NxK:regime,..." overrides the default regime per shape
+# (regimes of t31_cfg: cold | mid | r48 | warm). T31_MAX_M caps M (default 96).
+T31_ON = os.environ.get("T31_E4M3", "1") == "1"
+T31_MAX_M = int(os.environ.get("T31_MAX_M", "96"))
+_T31: dict = {}          # qweight data_ptr -> _T31Ent
+_t31_bufs: dict = {}     # (device, N, K) -> (ws fp32, cnt int32): shared by the layers of a shape; one stream at a time
+_t31_op = None           # torch.ops._C.t31_gemm_e4m3.default, resolved once
+
+
+class _T31Ent:
+    """Per-layer entry resolved once at registration: everything the hot path needs as plain attributes."""
+    __slots__ = ("regime", "N", "K", "cfgs", "ws", "cnt")
+
+    def __init__(self, regime: str, N: int, K: int, device) -> None:
+        from vllm.model_executor.layers.quantization.utils import t31_cfg
+
+        self.regime, self.N, self.K = regime, N, K
+        # cfg per M (index = M, 0..96): identical to t31_cfg.pick(N, K, M, regime)
+        self.cfgs = [t31_cfg.pick(N, K, m, regime) for m in range(97)]
+        key = (device, N, K)
+        b = _t31_bufs.get(key)
+        need = max(t31_cfg.ws_numel(N, K, m, c) for m in (16, 48, 64, 96) for c in
+                   {t31_cfg.pick(N, K, m, r) for r in ("cold", "mid", "r48", "warm")})
+        if b is None or b[0].numel() < need:
+            # allocated here (registration/warmup, outside graph capture)
+            b = (torch.zeros(max(need, 1), device=device, dtype=torch.float32),
+                 torch.zeros(4096, device=device, dtype=torch.int32))
+            _t31_bufs[key] = b
+        self.ws, self.cnt = b
+
+
+def _t31_regime(N: int, K: int) -> str:
+    ov = dict(kv.split(":") for kv in os.environ.get("T31_REGIME", "").split(",") if kv)
+    if f"{N}x{K}" in ov:
+        return ov[f"{N}x{K}"]
+    pf_on = os.environ.get("VLLM_HOSTAR_L2PF", "1") != "0"
+    if (N, K) in ((8192, 5120), (7168, 5120)) and pf_on:   # qkvz / attn_qkv: weight prefetched by the AR window
+        return "warm"
+    return "cold"                                          # down / gdn_out / attn_o / gate_up (w1: gate_up ~ Marlin)
+
+
+def _t31_run(xq: torch.Tensor, xs: torch.Tensor, qweight: torch.Tensor, w_scales_f32: torch.Tensor,
+             ent) -> torch.Tensor:
+    global _t31_op
+    op = _t31_op
+    if op is None:
+        from vllm import _custom_ops as _ops  # noqa: F401  (registers the fake impl)
+
+        op = _t31_op = torch.ops._C.t31_gemm_e4m3.default
+    M = xq.shape[0]
+    return op(xq, xs, qweight, w_scales_f32, ent.ws, ent.cnt, M, ent.N, ent.K, ent.cfgs[M])
+
+
+_D = os.path.join(os.path.dirname(os.path.abspath(__file__)), "t29_bs_gemm")
+
+# best split-free (mcfg_id, 1) per "NxK" and measured M bucket (GPU0 cold, job 209;
+# agents/leader-29.w2/gemm/sweep3_job209.json -> bs_gemm_marlin_configs_v2.py), in
+# t29_bs_gemm/configs.json. ids >= 100 = base tile id-100 with the smem-staged coalesced epilogue.
+# Split-K dropped: concurrent token-split chunks would share its workspace. Entry for the smallest measured M >=
+# actual M; above the largest, the largest.
+def _load_table():
+    import json
+
+    p = os.path.join(_D, "configs.json")
+    t = json.load(open(p))
+    return {k: {int(m): v[0] for m, v in d.items()} for k, d in t.items()}
+
+
+_TABLE = _load_table()
+
+
+def pick(N: int, K: int, M: int) -> int:
+    d = _TABLE.get(f"{N}x{K}")
+    if not d:
+        return 7
+    for m in sorted(d):
+        if M <= m:
+            return d[m]
+    return d[max(d)]
+
+
+def _load_cu(stem: str, fname: str):
+    """JIT-load t29_bs_gemm/<fname>, built under $TORCH_EXTENSIONS_DIR/<stem>_<sha1[:10]> from a copy
+    of the source at that content-hash path, so any copy of this workspace (e.g. the official eval's)
+    reuses the prebuilt library instead of rebuilding in the GPU job."""
+    from torch.utils.cpp_extension import load
+
+    code = open(os.path.join(_D, fname), "rb").read()
+    h = hashlib.sha1(code).hexdigest()[:10]
+    root = os.environ.get("TORCH_EXTENSIONS_DIR") or os.path.join(_D, "build")
+    bd = os.path.join(root, f"{stem}_{h}")
+    os.makedirs(bd, exist_ok=True)
+    src = os.path.join(bd, fname)
+    if not os.path.exists(src) or open(src, "rb").read() != code:
+        tmp = f"{src}.{os.getpid()}"
+        with open(tmp, "wb") as f:
+            f.write(code)
+        os.replace(tmp, src)
+    os.environ.setdefault("TORCH_CUDA_ARCH_LIST", "8.9")
+    return load(f"{stem}_{h}", [src], build_directory=bd, verbose=False,
+                extra_cuda_cflags=["-O3", "-lineinfo", "--expt-relaxed-constexpr", "-std=c++20"])
+
+
+_ext = None
+_nq_ext = None
+
+
+def ext():
+    global _ext
+    if _ext is None:
+        _ext = _load_cu("t29_bs_gemm", "bs_gemm.cu")
+    return _ext
+
+
+def nq_ext():
+    global _nq_ext
+    if _nq_ext is None:
+        _nq_ext = _load_cu("t29_norm_quant", "t29_norm_quant.cu")
+    return _nq_ext
+
+
+@triton.jit
+def _quant_perm_kernel(X, Q, S, K, stride_x, stride_q, stride_s, G: tl.constexpr):
+    # (leader-29.w2's kernel) one program = one row x G groups of 128.
+    # Q[:, blk*32+s] = quant(X[:, blk*32+PI[s]]), PI[s] = 16a+8b+2t+c for s = 16a+4t+2c+b
+    row = tl.program_id(0)
+    g0 = tl.program_id(1) * G
+    s = tl.arange(0, 128)
+    r = s % 32
+    pi = (s - r) + 16 * (r // 16) + 8 * (r % 2) + 2 * ((r % 16) // 4) + (r % 4) // 2
+    gi = tl.arange(0, G)
+    cols_in = (g0 + gi)[:, None] * 128 + pi[None, :]
+    cols_out = (g0 + gi)[:, None] * 128 + s[None, :]
+    x = tl.load(X + row * stride_x + cols_in).to(tl.float32)
+    amax = tl.maximum(tl.max(tl.abs(x), axis=1), 1e-10)
+    sc = tl.math.div_rn(amax, tl.full(amax.shape, 448.0, tl.float32))
+    inv = tl.math.div_rn(tl.full(sc.shape, 1.0, tl.float32), sc)
+    q = tl.clamp(x * inv[:, None], -448.0, 448.0)
+    # round to the e4m3 grid in fp32 (RNE) first: Triton's fp32->e4m3 goes via f16 on sm_89
+    e = ((q.to(tl.int32, bitcast=True) >> 23) & 0xFF) - 127
+    e = tl.maximum(e, -6)
+    quantum = ((e - 3 + 127) << 23).to(tl.float32, bitcast=True)
+    inv_quantum = ((127 - (e - 3)) << 23).to(tl.float32, bitcast=True)
+    q = tl.extra.cuda.libdevice.rint(q * inv_quantum) * quantum
+    q = q.to(Q.dtype.element_ty)
+    tl.store(Q + row * stride_q + cols_out, q)
+    tl.store(S + row * stride_s + g0 + gi, sc)
+
+
+def quant_perm(x: torch.Tensor, G: int = 4):
+    M, K = x.shape
+    assert x.stride(1) == 1 and K % 128 == 0
+    if K % (128 * G):
+        G = 1
+    q = torch.empty(M, K, device=x.device, dtype=torch.float8_e4m3fn)
+    s = torch.empty(M, K // 128, device=x.device, dtype=torch.float32)
+    _quant_perm_kernel[(M, K // 128 // G)](x, q, s, K, x.stride(0), q.stride(0), s.stride(0),
+                                            G=G, num_warps=4)
+    return q, s
+
+
+_dummy = {}
+
+
+def _dummies(dev):
+    d = _dummy.get(dev)
+    if d is None:
+        d = (torch.empty(1, device=dev, dtype=torch.float32),
+             torch.zeros(64, device=dev, dtype=torch.int32))
+        _dummy[dev] = d
+    return d
+
+
+def w8a8_marlin(x: torch.Tensor, qweight: torch.Tensor, w_scales_f32: torch.Tensor,
+                N: int, K: int) -> torch.Tensor:
+    xq, xs = quant_perm(x)
+    return gemm_q(xq, xs, qweight, w_scales_f32, N, K)
+
+
+def gemm_q(xq: torch.Tensor, xs: torch.Tensor, qweight: torch.Tensor,
+           w_scales_f32: torch.Tensor, N: int, K: int) -> torch.Tensor:
+    """bs_gemm_marlin on an already quantized (PI-permuted e4m3 + fp32 group scales) activation."""
+    if T31_ON and xq.shape[0] <= T31_MAX_M:
+        ent = _T31.get(qweight.data_ptr())
+        if ent is not None:
+            out = _t31_run(xq, xs, qweight, w_scales_f32, ent)
+            if (T31_CHECK and ("gq", N, K) not in _t31_checked and not torch.cuda.is_current_stream_capturing()
+                    and bool(xq.view(torch.uint8).any())):
+                _t31_checked.add(("gq", N, K))
+                ref = torch.empty_like(out)
+                ws_, cnt_ = _dummies(xq.device)
+                ext().bs_gemm_marlin(xq, qweight, xs, w_scales_f32, ref, pick(N, K, xq.shape[0]), 1, ws_, cnt_)
+                _t31_check("vs-bs_gemm_marlin(same quantized input)", N, K, out, ref)
+            return out
+    out = torch.empty(xq.shape[0], N, device=xq.device, dtype=torch.bfloat16)
+    ws, cnt = _dummies(xq.device)
+    ext().bs_gemm_marlin(xq, qweight, xs, w_scales_f32, out, pick(N, K, xq.shape[0]), 1, ws, cnt)
+    if _CAPTURE:
+        from vllm.model_executor.layers.quantization.utils import t29_fused
+
+        t29_fused.capture_gemm_compare(xq, xs, qweight, w_scales_f32, out, N, K)
+    return out
+
+
+def _t29_marlin_fp8_linear(
+    a: torch.Tensor,
+    b_q_weight: torch.Tensor,
+    b_scales: torch.Tensor,
+    w_scales_f32: torch.Tensor,
+    size_n: int,
+    size_k: int,
+    use_atomic_add: bool,
+    use_fp32_reduce: bool,
+) -> torch.Tensor:
+    M = a.shape[0]
+    if M > MAX_MARLIN_M:
+        return w8a8_marlin(a, b_q_weight, w_scales_f32, size_n, size_k)
+    if T45_GU_BS and M > T45_GU_BS_MIN_M and (size_n, size_k) in T45_GU_BS_SHAPES:
+        # T45: at decode widths above Marlin's M=48 step, gate_up runs on the same W8A8 bs_gemm path used for M > 96
+        return w8a8_marlin(a, b_q_weight, w_scales_f32, size_n, size_k)
+    if T31_ON and M <= T31_MAX_M:
+        ent = _T31.get(b_q_weight.data_ptr())
+        if ent is not None:
+            xq, xs = quant_perm(a)
+            out = _t31_run(xq, xs, b_q_weight, w_scales_f32, ent)
+            if (T31_CHECK and ("bf", size_n, size_k) not in _t31_checked and not torch.cuda.is_current_stream_capturing()
+                    and bool(a.any())):
+                _t31_checked.add(("bf", size_n, size_k))
+                from vllm.scalar_type import scalar_types
+
+                ref = torch.ops.vllm.marlin_gemm(
+                    a=a, b_q_weight=b_q_weight, b_bias=None, b_scales=b_scales, global_scale=None,
+                    b_zeros=None, workspace=None, b_q_type_id=scalar_types.float8_e4m3fn.id, size_m=M,
+                    size_n=size_n, size_k=size_k, use_atomic_add=use_atomic_add, use_fp32_reduce=use_fp32_reduce)
+                _t31_check("vs-bf16-Marlin", size_n, size_k, out, ref)
+            return out
+    # the champion's call, unchanged (apply_fp8_marlin_linear)
+    from vllm.scalar_type import scalar_types
+
+    return torch.ops.vllm.marlin_gemm(
+        a=a, b_q_weight=b_q_weight, b_bias=None, b_scales=b_scales, global_scale=None,
+        b_zeros=None, workspace=None, b_q_type_id=scalar_types.float8_e4m3fn.id, size_m=M,
+        size_n=size_n, size_k=size_k, use_atomic_add=use_atomic_add,
+        use_fp32_reduce=use_fp32_reduce)
+
+
+def _t29_marlin_fp8_linear_fake(a, b_q_weight, b_scales, w_scales_f32, size_n, size_k,
+                                use_atomic_add, use_fp32_reduce):
+    return torch.empty((a.shape[0], size_n), device=a.device, dtype=a.dtype)
+
+
+direct_register_custom_op("t29_marlin_fp8_linear", _t29_marlin_fp8_linear,
+                          fake_impl=_t29_marlin_fp8_linear_fake)
+
+_warmed: set = set()
+
+
+def prepare_layer(layer: torch.nn.Module, weight_scale: torch.Tensor) -> None:
+    """Before the Marlin repack: keep an fp32 copy of the [N/128, K/128] block scales."""
+    N, K = layer.output_size_per_partition, layer.input_size_per_partition
+    if N % 128 or K % 128 or tuple(weight_scale.shape) != (N // 128, K // 128):
+        layer.t29_ws_f32 = None
+        logger.warning("T29_W8A8=2: layer %dx%d not eligible (scales %s); stays Marlin",
+                       N, K, tuple(weight_scale.shape))
+        return
+    layer.t29_ws_f32 = weight_scale.detach().float().contiguous().clone()
+
+
+_t31_warmed: set = set()
+
+
+T31_SKIP = {x for x in os.environ.get("T31_SKIP", "17408x5120").split(",") if x}   # NxK shapes that stay bitwise Marlin (default: gate_up)
+T31_CHECK = os.environ.get("T31_CHECK", "0") == "1"
+_t31_checked: set = set()
+
+
+def _t31_check(tag: str, N: int, K: int, out: torch.Tensor, ref: torch.Tensor) -> None:
+    """T31_CHECK=1: on the first eager (non-capturing) call per (path, shape): max abs diff / relF of the e4m3 output vs the reference."""
+    d = (out.float() - ref.float())
+    logger.info("T31_CHECK %s %dx%d M=%d: max|diff|=%.4g  max|ref|=%.4g  relF=%.3e", tag, N, K, out.shape[0],
+                d.abs().max().item(), ref.float().abs().max().item(), (d.norm() / ref.float().norm().clamp_min(1e-30)).item())
+
+
+_t31_warmed: set = set()
+
+
+def _t31_register(layer: torch.nn.Module, qw: torch.Tensor, ws: torch.Tensor, N: int, K: int) -> None:
+    if not (T31_ON and N % 128 == 0 and K % 128 == 0):
+        return
+    pre = str(getattr(layer, "prefix", ""))
+    if f"{N}x{K}" in T31_SKIP:
+        logger.info("T31_E4M3 layer %s %dx%d: stays Marlin (T31_SKIP)", pre, N, K)
+        return
+    if ("mtp" in pre.lower() or "draft" in pre.lower()) and os.environ.get("T31_E4M3_DRAFTER", "0") != "1":
+        logger.info("T31_E4M3 layer %s %dx%d: stays Marlin (drafter)", pre, N, K)
+        return
+    ent = _T31Ent(_t31_regime(N, K), N, K, qw.device)
+    _T31[qw.data_ptr()] = ent
+    layer.t31_e4m3 = True      # read by t29_fused.wants_q: only these layers get PI-quantized activations at M <= 96
+    logger.info("T31_E4M3 layer %s %dx%d: e4m3 decode GEMM, regime %s", pre, N, K, ent.regime)
+    if (N, K) in _t31_warmed:
+        return
+    _t31_warmed.add((N, K))
+    dev = qw.device
+    # every (bucket, config) once, outside graph capture: allocates ws/cnt, no first-call work left for capture/bench
+    for m in (1, 16, 17, 32, 48, 49, 64, 65, 96):
+        _t31_run(torch.zeros(m, K, device=dev, dtype=torch.float8_e4m3fn),
+                 torch.ones(m, K // 128, device=dev, dtype=torch.float32), qw, ws, ent)
+    quant_perm(torch.zeros(48, K, device=dev, dtype=torch.bfloat16))     # Triton compile for this K
+    if (N, K) == (5120, 8704):                                            # down: the fused silu->quant producer
+        from vllm.model_executor.layers.quantization.utils import t29_fused
+
+        t29_fused.silu_mul_quant(torch.zeros(48, 2 * K, device=dev, dtype=torch.bfloat16))
+    torch.accelerator.synchronize()
+    logger.info_once("T31_E4M3=1: e4m3 decode GEMM for M <= %d on %s (regime %s)", T31_MAX_M, (N, K), ent.regime,
+                     scope="global")
+
+
+def warmup_layer(layer: torch.nn.Module) -> None:
+    """After the repack: build/load the extension, check the layout, compile quant_perm per K and
+    run the GEMM once per table config, so no JIT happens while serving."""
+    ws = getattr(layer, "t29_ws_f32", None)
+    if ws is None:
+        return
+    N, K = layer.output_size_per_partition, layer.input_size_per_partition
+    qw = layer.weight
+    if qw.numel() * qw.element_size() != N * K:
+        layer.t29_ws_f32 = None
+        logger.warning("T29_W8A8=2: Marlin qweight %dx%d padded; stays Marlin", N, K)
+        return
+    _t31_register(layer, qw, ws, N, K)
+    key = (N, K)
+    if key in _warmed:
+        return
+    _warmed.add(key)
+    ms = sorted({MAX_MARLIN_M + 1, *(m for m in _TABLE.get(f"{N}x{K}", {})), 2048})
+    for m in ms:
+        x = torch.zeros(m, K, device=qw.device, dtype=torch.bfloat16)
+        w8a8_marlin(x, qw, ws, N, K)
+    torch.accelerator.synchronize()
+    logger.info_once("T29_W8A8=2: Marlin-layout W8A8 for M > %d (warmed %s)", MAX_MARLIN_M, key,
+                     scope="global")
diff --git a/vllm/model_executor/layers/quantization/utils/t31_cfg.py b/vllm/model_executor/layers/quantization/utils/t31_cfg.py
new file mode 100644
index 0000000000..a7b26e90cc
--- /dev/null
+++ b/vllm/model_executor/layers/quantization/utils/t31_cfg.py
@@ -0,0 +1,59 @@
+# T31 config table for _C::t31_gemm_e4m3 (leader-31.w1). cfg packing: un | ks<<4 | kseg<<8 | deep<<12 | mt_override<<13 (0 = auto).
+# Entries: TABLE[(N, K)][M_bucket] = {cold, mid, r48, warm}: best config measured (GPU0, standalone, M=bucket) for weights fully in HBM (cold),
+# ~16-32 MB of the weight L2-resident (mid), ~48 MB resident (r48) and fully L2-warm. Sources: agents/leader-31.w1/v2c.json, w13b.json.
+# gate_up (17408x5120): M=64/96 rows reuse the M=48 picks (sweep there was pruned); qkvz/attn_qkv/down/gdn_out/attn_o: measured.
+TABLE = {
+    (5120, 3072): {
+        16: {'cold': 290, 'warm': 804, 'mid': 290, 'r48': 804},
+        48: {'cold': 322, 'warm': 804, 'mid': 322, 'r48': 804},
+        64: {'cold': 292, 'warm': 292, 'mid': 292, 'r48': 292},
+        96: {'cold': 292, 'warm': 292, 'mid': 292, 'r48': 292},
+    },
+    (5120, 8704): {
+        16: {'cold': 290, 'warm': 804, 'mid': 290, 'r48': 804},
+        48: {'cold': 322, 'warm': 804, 'mid': 322, 'r48': 804},
+        64: {'cold': 292, 'warm': 804, 'mid': 292, 'r48': 804},
+        96: {'cold': 292, 'warm': 804, 'mid': 292, 'r48': 804},
+    },
+    (7168, 5120): {
+        16: {'cold': 290, 'warm': 548, 'mid': 290, 'r48': 548},
+        48: {'cold': 290, 'warm': 548, 'mid': 290, 'r48': 548},
+        64: {'cold': 292, 'warm': 292, 'mid': 292, 'r48': 292},
+        96: {'cold': 292, 'warm': 292, 'mid': 292, 'r48': 292},
+    },
+    (8192, 5120): {
+        16: {'cold': 385, 'warm': 548, 'mid': 385, 'r48': 548},
+        48: {'cold': 290, 'mid': 4386, 'r48': 4386, 'warm': 548},
+        64: {'cold': 292, 'warm': 292, 'mid': 292, 'r48': 292},
+        96: {'cold': 292, 'warm': 292, 'mid': 292, 'r48': 292},
+    },
+    (17408, 5120): {
+        16: {'cold': 322, 'warm': 322, 'mid': 322, 'r48': 322},
+        48: {'cold': 322, 'mid': 322, 'r48': 4388, 'warm': 578},
+        64: {'cold': 322, 'mid': 322, 'r48': 4388, 'warm': 578},
+        96: {'cold': 322, 'mid': 322, 'r48': 4388, 'warm': 578},
+    },
+}
+
+
+def pack(un, ks, kseg, deep=0, mt=0):
+    return un | ks << 4 | kseg << 8 | deep << 12 | mt << 13
+
+
+def pick(N, K, M, regime="cold"):
+    """cfg int for t31_gemm_e4m3. regime: 'cold' | 'mid' | 'r48' | 'warm'. Smallest measured M bucket >= M, else the largest."""
+    d = TABLE.get((N, K))
+    if d is None:
+        return pack(2, 2, 1)
+    for m in sorted(d):
+        if M <= m:
+            return d[m][regime]
+    return d[max(d)][regime]
+
+
+def ws_numel(N, K, M, cfg):
+    """fp32 workspace elements the cfg needs (only kseg>1 uses it)."""
+    un, kseg = cfg & 15, (cfg >> 8) & 15
+    mt = (cfg >> 13) & 3 or ((M + 15) // 16 if M <= 48 else (2 if M <= 64 else 3))
+    z = -(-M // (mt * 16))
+    return z * (N // (32 * un)) * kseg * un * mt * 16 * 32 if kseg > 1 else 0
diff --git a/vllm/model_executor/layers/t27_screen.py b/vllm/model_executor/layers/t27_screen.py
new file mode 100644
index 0000000000..82c71b5cc3
--- /dev/null
+++ b/vllm/model_executor/layers/t27_screen.py
@@ -0,0 +1,220 @@
+"""AutoInfer T27: screened draft lm_head (draft side only; the target verifies with its full head).
+
+Per TP rank, for each draft row h (bf16, D=5120):
+  1. a = h @ P                      (P [D, R] bf16, PCA of the drafter's hidden states, train split only)
+  2. s = a @ U^T * us               (U [V_local, R] fp8 e4m3 with per-row scale us; U = dequant(W_local) @ P)
+  3. top-64 of s per row            (per-chunk bisection top-64, then a merge over the chunk candidates)
+  4. exact logits of the 64 candidates from the champion's FP8 draft head
+     (dynamic per-token activation quant, per-row weight scale, fp32 accumulate, bf16 rounding)
+  5. local (max, argmax) over the 64 -> the champion's existing all-gather.
+Switch: T27_SCREEN (default 1; 0 = champion path). T27_SCREEN_PCA = path of the PCA file.
+"""
+import os
+
+import torch
+
+from vllm.logger import init_logger
+from vllm.triton_utils import tl, triton
+
+logger = init_logger(__name__)
+
+KSEL = 64
+CH = 16  # chunks per row
+MAX_ROWS = 64
+
+
+def enabled() -> bool:
+    return os.environ.get("T27_SCREEN", "1") != "0"
+
+
+@triton.jit
+def _scores_kernel(a_ptr, u_ptr, us_ptr, s_ptr, M, V,
+                   K: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):
+    pid_n = tl.program_id(0)
+    pid_m = tl.program_id(1)
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    acc = tl.zeros([BN, BM], dtype=tl.float32)
+    for k0 in range(0, K, BK):
+        rk = k0 + tl.arange(0, BK)
+        u = tl.load(u_ptr + rn[:, None] * K + rk[None, :])  # [BN, BK] fp8
+        a = tl.load(a_ptr + rm[None, :] * K + rk[:, None], mask=rm[None, :] < M, other=0.0)  # [BK, BM]
+        acc += tl.dot(u.to(tl.bfloat16), a)
+    us = tl.load(us_ptr + rn)
+    acc = acc * us[:, None]
+    tl.store(s_ptr + rm[None, :] * V + rn[:, None], acc, mask=rm[None, :] < M)
+
+
+@triton.jit
+def _key(x):
+    bits = x.to(tl.int32, bitcast=True)
+    return tl.where(bits >= 0, bits, bits ^ 0x7FFFFFFF)
+
+
+@triton.jit
+def _chunk_topk_kernel(s_ptr, cv_ptr, ci_ptr, V, CHUNK: tl.constexpr, BLK: tl.constexpr,
+                       KS: tl.constexpr, NCH: tl.constexpr):
+    m = tl.program_id(0)
+    c = tl.program_id(1)
+    offs = tl.arange(0, BLK)
+    col = c * CHUNK + offs
+    valid = (offs < CHUNK) & (col < V)
+    x = tl.load(s_ptr + m * V + col, mask=valid, other=float("-inf"))
+    key = _key(x)
+    lo = tl.full([], -2147483648, tl.int64)
+    hi = tl.full([], 2147483647, tl.int64)
+    for _ in range(32):
+        mid = lo + (hi - lo + 1) // 2
+        cnt = tl.sum(((key.to(tl.int64) >= mid) & valid).to(tl.int32), axis=0)
+        ok = cnt >= KS
+        lo = tl.where(ok, mid, lo)
+        hi = tl.where(ok, hi, mid - 1)
+    sel = (key.to(tl.int64) >= lo) & valid
+    pos = tl.cumsum(sel.to(tl.int32), axis=0) - 1
+    keep = sel & (pos < KS)
+    base = (m * NCH + c) * KS
+    o64 = tl.arange(0, KS)
+    tl.store(cv_ptr + base + o64, tl.full([KS], float("-inf"), tl.float32))
+    tl.store(ci_ptr + base + o64, tl.zeros([KS], tl.int32))
+    tl.debug_barrier()
+    tl.store(cv_ptr + base + pos, x, mask=keep)
+    tl.store(ci_ptr + base + pos, col, mask=keep)
+
+
+@triton.jit
+def _merge_exact_kernel(cv_ptr, ci_ptr, sidx_ptr, xq_ptr, xs_ptr, w_ptr, ws_ptr,
+                        ov_ptr, oi_ptr, pair_ptr, vstart, K: tl.constexpr, NCAND: tl.constexpr,
+                        KS: tl.constexpr, BK: tl.constexpr, PACK: tl.constexpr):
+    m = tl.program_id(0)
+    o = tl.arange(0, NCAND)
+    x = tl.load(cv_ptr + m * NCAND + o)
+    ci = tl.load(ci_ptr + m * NCAND + o)
+    key = _key(x)
+    lo = tl.full([], -2147483648, tl.int64)
+    hi = tl.full([], 2147483647, tl.int64)
+    for _ in range(32):
+        mid = lo + (hi - lo + 1) // 2
+        cnt = tl.sum((key.to(tl.int64) >= mid).to(tl.int32), axis=0)
+        ok = cnt >= KS
+        lo = tl.where(ok, mid, lo)
+        hi = tl.where(ok, hi, mid - 1)
+    sel = key.to(tl.int64) >= lo
+    pos = tl.cumsum(sel.to(tl.int32), axis=0) - 1
+    keep = sel & (pos < KS)
+    o64 = tl.arange(0, KS)
+    tl.store(sidx_ptr + m * KS + o64, tl.zeros([KS], tl.int32))
+    tl.debug_barrier()
+    tl.store(sidx_ptr + m * KS + pos, ci, mask=keep)
+    tl.debug_barrier()
+    idx = tl.load(sidx_ptr + m * KS + o64)  # [KS] candidate columns
+    acc = tl.zeros([KS], dtype=tl.float32)
+    for k0 in range(0, K, BK):
+        rk = k0 + tl.arange(0, BK)
+        w = tl.load(w_ptr + idx[:, None].to(tl.int64) * K + rk[None, :])  # [KS, BK] fp8
+        xv = tl.load(xq_ptr + m * K + rk)  # [BK] fp8
+        acc += tl.sum(w.to(tl.float32) * xv.to(tl.float32)[None, :], axis=1)
+    xs = tl.load(xs_ptr + m)
+    ws = tl.load(ws_ptr + idx)
+    logit = (acc * xs * ws).to(tl.bfloat16).to(tl.float32)
+    best = tl.max(logit, axis=0)
+    cand = tl.where(logit == best, idx, 2147483647)
+    bidx = tl.min(cand, axis=0)
+    tl.store(ov_ptr + m, best)
+    tl.store(oi_ptr + m, bidx)
+    if PACK:  # T57_PACK: the (value, global index) pair the all-gather sends, written here instead of 4 tiny kernels
+        tl.store(pair_ptr + m * 2, best)
+        tl.store(pair_ptr + m * 2 + 1, (bidx + vstart).to(tl.float32))
+
+
+PACK_ON = os.environ.get("T57_PACK", "1") != "0"
+
+
+@triton.jit
+def _argmax_ranks_kernel(g_ptr, out_ptr, TP: tl.constexpr):
+    # g [M, 2*TP] fp32 (value, global index per rank); first max wins ties, like torch.argmax
+    m = tl.program_id(0)
+    best = tl.load(g_ptr + m * 2 * TP)
+    bi = tl.load(g_ptr + m * 2 * TP + 1)
+    for r in tl.static_range(1, TP):
+        v = tl.load(g_ptr + m * 2 * TP + 2 * r)
+        i = tl.load(g_ptr + m * 2 * TP + 2 * r + 1)
+        take = v > best
+        best = tl.where(take, v, best)
+        bi = tl.where(take, i, bi)
+    tl.store(out_ptr + m, bi.to(tl.int64))
+
+
+def argmax_ranks(gathered: torch.Tensor, tp: int) -> torch.Tensor:
+    M = gathered.shape[0]
+    out = torch.empty(M, dtype=torch.int64, device=gathered.device)
+    _argmax_ranks_kernel[(M,)](gathered, out, tp)
+    return out
+
+
+class Screen:
+    """Per-draft-head screening state. Built once after the draft head is quantized."""
+
+    def __init__(self, head, pca_path: str):
+        dev = head.weight.device
+        qm = head.quant_method
+        self.fp8_linear = qm.fp8_linear
+        W = head.weight.t()  # [V_local, K] view of the [N, K] row-major fp8 storage
+        assert W.dtype == torch.float8_e4m3fn and W.stride() == (W.shape[1], 1), (W.shape, W.stride())
+        self.W = W
+        self.ws = head.weight_scale.reshape(-1).float().contiguous()
+        self.V, self.D = W.shape
+        P = torch.load(pca_path, map_location="cpu")["Vh"].to(dev).to(torch.bfloat16).contiguous()
+        assert P.shape[0] == self.D, P.shape
+        self.R = P.shape[1]
+        self.P = P
+        self.U = torch.empty(self.V, self.R, dtype=torch.float8_e4m3fn, device=dev)
+        self.us = torch.empty(self.V, dtype=torch.float32, device=dev)
+        with torch.no_grad():
+            for c0 in range(0, self.V, 2048):
+                c1 = min(self.V, c0 + 2048)
+                wd = (W[c0:c1].float() * self.ws[c0:c1, None]).to(torch.bfloat16)
+                u = (wd @ P).float()
+                sc = (u.abs().amax(dim=1) / 448.0).clamp_min(1e-12)
+                self.us[c0:c1] = sc
+                self.U[c0:c1] = (u / sc[:, None]).to(torch.float8_e4m3fn)
+        self.S = torch.empty(MAX_ROWS, self.V, dtype=torch.float32, device=dev)
+        self.cv = torch.empty(MAX_ROWS, CH * KSEL, dtype=torch.float32, device=dev)
+        self.ci = torch.empty(MAX_ROWS, CH * KSEL, dtype=torch.int32, device=dev)
+        self.sidx = torch.empty(MAX_ROWS, KSEL, dtype=torch.int32, device=dev)
+        self.ov = torch.empty(MAX_ROWS, dtype=torch.float32, device=dev)
+        self.oi = torch.empty(MAX_ROWS, dtype=torch.int32, device=dev)
+        self.pair = torch.empty(MAX_ROWS, 2, dtype=torch.float32, device=dev)
+        self.chunk = triton.cdiv(self.V, CH)
+        self.blk = triton.next_power_of_2(self.chunk)
+        self.bn = int(os.environ.get("T27_SCREEN_BN", "64"))
+        logger.info("T27 screen attached: V=%d D=%d R=%d (U %.1f MiB)", self.V, self.D, self.R,
+                    self.U.numel() / 2**20)
+
+    def top(self, h: torch.Tensor, vstart: int = 0, pack: bool = False):
+        """h [M, D] bf16 -> (local max value fp32 [M], local argmax int32 [M]); pack: also fills self.pair [M, 2]
+        = (value, float(global index))."""
+        M = h.shape[0]
+        assert M <= MAX_ROWS and h.dtype == torch.bfloat16
+        a = h @ self.P  # [M, R] bf16
+        _scores_kernel[(self.V // self.bn, triton.cdiv(M, 16))](
+            a, self.U, self.us, self.S, M, self.V, K=self.R, BM=16, BN=self.bn, BK=128,
+            num_warps=4, num_stages=4)
