+// Applies the pending rows (if any) of every request to its column-0 state and
+// switches the request back to the old format (flag = 0). eff_accepted[req] is
+// the accepted count the old-format kernels must use afterwards.
+template <typename StateT>
+__global__ __launch_bounds__(kThreads) void gdn_replay_flush_kernel(
+    const int* __restrict__ state_indices,
+    const int* __restrict__ num_accepted_tokens, StateT* __restrict__ state,
+    int* __restrict__ replay_flag, int* __restrict__ eff_accepted, int HV,
+    int state_indices_width, int64_t state_slot_stride) {
+  const int request = blockIdx.x;
+  const int value_head = blockIdx.y;
+  const int tid = threadIdx.x;
+  const int lane = tid & 31;
+  const int warp = tid >> 5;
+  const int col0 = state_indices[request * state_indices_width];
+  const int accepted = num_accepted_tokens[request];
+  if (col0 <= 0) {
+    if (value_head == 0 && tid == 0) eff_accepted[request] = accepted;
+    return;
+  }
+  const int pending = *reinterpret_cast<volatile const int*>(&replay_flag[col0 * 2]);
+  if (value_head == 0 && tid == 0) {
+    eff_accepted[request] = pending > 0 ? 1 : accepted;
+  }
+  if (pending <= 0) return;
+  const int col1 = state_indices[request * state_indices_width + 1];
+  const int replay_count = min(max(accepted, 0), pending);
+  const unsigned char* rows =
+      replay_rows_base(state, col1, value_head, state_slot_stride);
+  StateT* s0 = state + static_cast<int64_t>(col0) * state_slot_stride +
+               value_head * kDimV * kDimK;
+  const int k_base = lane * 4;
+  for (int chunk = 0; chunk < kNumChunks; ++chunk) {
+    float h[kRowsPerWarp][4];
+#pragma unroll
+    for (int row = 0; row < kRowsPerWarp; ++row) {
+      const int value = chunk * kChunkV + warp + row * kWarps;
+      const float4 sv = load_state4(s0 + value * kDimK + k_base);
+      h[row][0] = sv.x; h[row][1] = sv.y; h[row][2] = sv.z; h[row][3] = sv.w;
+    }
+    for (int i = 0; i < replay_count; ++i) {
+      const unsigned char* r = rows + i * kRowBytes;
+      const float4 k4 = *reinterpret_cast<const float4*>(r + k_base * 4);
+      const float2 db = *reinterpret_cast<const float2*>(r + 768);
+      float v_rows[kRowsPerWarp];
+#pragma unroll
+      for (int row = 0; row < kRowsPerWarp; ++row) {
+        const int value = chunk * kChunkV + warp + row * kWarps;
+        v_rows[row] = __bfloat162float(
+            reinterpret_cast<const __nv_bfloat16*>(r + 512)[value]);
+      }
+      replay_row_update(h, k4, db.x, db.y, v_rows);
+    }
+#pragma unroll
+    for (int row = 0; row < kRowsPerWarp; ++row) {
+      const int value = chunk * kChunkV + warp + row * kWarps;
+      store_state4(s0 + value * kDimK + k_base,
+                   make_float4(h[row][0], h[row][1], h[row][2], h[row][3]));
+    }
+  }
+  __syncthreads();
+  if (tid == 0) {
+    __threadfence();
+    const int old = atomicAdd(&replay_flag[col0 * 2 + 1], 1);
+    if (old == HV - 1) {
+      replay_flag[col0 * 2 + 1] = 0;
+      replay_flag[col0 * 2] = 0;
+      __threadfence();
+    }
+  }
+}
