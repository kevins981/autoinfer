+# SPDX-License-Identifier: Apache-2.0
+"""Greedy fast path for the target sampler / verifier under tensor parallelism.
+
+When every request in the batch is greedy (temperature 0) and needs no logits
+processing, the sampled/verified token at each logits row is just the argmax over
+the full vocabulary. Each TP rank takes the argmax over its own vocab shard, the
+(value, global id) pairs are all-gathered (8 B per row instead of a full
+logits all-to-all) and the first maximum wins (ties -> lower global id, as
+torch.argmax / the rejection kernel). Greedy verification then accepts the
+leading draft tokens that equal the target argmax and takes the target argmax at
+the first mismatch (or at the bonus row), exactly like the rejection kernel.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+from vllm.v1.worker.gpu.sample.greedy_argmax import greedy_argmax
+
+
+def combine_shard_argmax(values: torch.Tensor, ids: torch.Tensor) -> torch.Tensor:
+    """values/ids: [rows, tp] per-shard (max, global id), shards in increasing
+    vocab order. Returns the global id of the first maximum."""
+    r = values.argmax(dim=-1, keepdim=True)  # first max -> lowest shard on ties
+    return ids.gather(-1, r).squeeze(-1).to(torch.int64)
+
+
+def local_argmax_pairs(
+    local_logits: torch.Tensor, rank: int, vocab_size: int
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """(max value fp32, global id int64) over this rank's shard, first max on ties,
+    NaN treated as -inf, columns beyond ``vocab_size`` ignored."""
+    shard_w = local_logits.shape[-1]
+    start = rank * shard_w
+    n_eff = max(0, min(shard_w, vocab_size - start))
+    view = local_logits[:, :n_eff]
+    idx = greedy_argmax(view)
+    vals = view.gather(1, idx[:, None]).squeeze(1).float()
+    vals = torch.where(vals != vals, torch.full_like(vals, float("-inf")), vals)
+    return vals, idx + start
+
+
+@triton.jit
+def _greedy_verify_kernel(
+    tgt_ptr,  # [num_logits] int64 target argmax
+    draft_ptr,  # [num_logits] int64 draft token at each logits row (row i holds input)
+    cu_ptr,  # [num_reqs + 1]
+    sampled_ptr,  # [num_reqs, width]
+    sampled_stride,
+    num_sampled_ptr,  # [num_reqs] int32
+):
+    r = tl.program_id(0)
+    start = tl.load(cu_ptr + r).to(tl.int64)
+    end = tl.load(cu_ptr + r + 1).to(tl.int64)
+    n_draft = end - start - 1
+    a = tl.zeros((), tl.int64)
+    verifying = True
+    for i in range(n_draft):
+        if verifying:
+            t = tl.load(tgt_ptr + start + i)
+            d = tl.load(draft_ptr + start + i + 1)
+            acc = (t == d) & (d >= 0)
+            tl.store(sampled_ptr + r * sampled_stride + i, t)
+            verifying = acc
+            a += acc
+    # a == n_draft: bonus token; else the rejection row was already stored.
+    if a == n_draft:
+        tl.store(sampled_ptr + r * sampled_stride + a, tl.load(tgt_ptr + start + a))
+    tl.store(num_sampled_ptr + r, (a + 1).to(tl.int32))
+
+
+def greedy_verify(
+    tgt: torch.Tensor,
+    draft_sampled: torch.Tensor,
+    cu_num_logits: torch.Tensor,
+    num_reqs: int,
+    width: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    sampled = torch.full((num_reqs, width), -1, dtype=torch.int64, device=tgt.device)
+    num_sampled = torch.empty(num_reqs, dtype=torch.int32, device=tgt.device)
+    _greedy_verify_kernel[(num_reqs,)](
+        tgt,
+        draft_sampled,
+        cu_num_logits,
+        sampled,
+        sampled.stride(0),
+        num_sampled,
+        num_warps=1,
+    )
+    return sampled, num_sampled
