diff --git a/vllm/model_executor/layers/overlap_ar.py b/vllm/model_executor/layers/overlap_ar.py
new file mode 100644
index 0000000000..de01c7b34d
--- /dev/null
+++ b/vllm/model_executor/layers/overlap_ar.py
@@ -0,0 +1,74 @@
+# Chunked row-parallel GEMM + all-reduce pipeline for large eager steps (prefill chunks).
+# GEMM chunk i runs on the main stream; the NCCL all-reduce of chunk i runs on a side
+# stream while GEMM chunk i+1 runs. Marlin is told (VLLM_MARLIN_SM_RESERVE) to leave a
+# few SMs free so NCCL's CTAs can run concurrently. Never active during CUDA graph capture.
+import os
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+_calls = 0
+
+_CHUNKS = int(os.environ.get("VLLM_OVERLAP_AR_CHUNKS", "4"))
+_MIN_TOKENS = int(os.environ.get("VLLM_OVERLAP_AR_MIN_TOKENS", "512"))
+_MIN_CHUNK = 256  # keep chunks > host-AR size limit (2 MiB) and big enough for Marlin
+_RESERVE = os.environ.get("VLLM_OVERLAP_AR_SM_RESERVE", "2")
+
+_side: dict = {}
+_done_ptr = None  # data_ptr of the last output that was already all-reduced
+
+
+def mark_done(t: torch.Tensor | None) -> None:
+    global _done_ptr
+    _done_ptr = None if t is None else t.data_ptr()
+
+
+def consume(x: torch.Tensor) -> bool:
+    """True if x is the output of a pipeline call that is already all-reduced."""
+    global _done_ptr
+    p, _done_ptr = _done_ptr, None
+    return p is not None and p == x.data_ptr()
+
+
+def num_chunks(num_tokens: int) -> int:
+    if _CHUNKS < 2 or num_tokens < _MIN_TOKENS:
+        return 0
+    n = min(_CHUNKS, num_tokens // _MIN_CHUNK)
+    return n if n >= 2 else 0
+
+
+def run(quant_apply, x: torch.Tensor, n: int, pynccl) -> torch.Tensor:
+    """quant_apply(chunk)->partial output (T_i, N). Returns the all-reduced (T, N)."""
+    global _calls
+    if _calls == 0:
+        logger.info("chunked GEMM+AR overlap engaged (T=%d, n=%d)", x.shape[0], n)
+    _calls += 1
+    if _calls % 1000 == 0:
+        logger.info("chunked GEMM+AR overlap: %d calls so far", _calls)
+    dev = x.device
+    side = _side.get(dev)
+    if side is None:
+        side = _side[dev] = torch.cuda.Stream(device=dev)
+    cur = torch.cuda.current_stream(dev)
+    T = x.shape[0]
+    bounds = [T * i // n for i in range(n + 1)]
+    outs = []
+    old = os.environ.get("VLLM_MARLIN_SM_RESERVE")
+    os.environ["VLLM_MARLIN_SM_RESERVE"] = _RESERVE
+    try:
+        for i in range(n):
+            o = quant_apply(x[bounds[i] : bounds[i + 1]])
+            outs.append(o)
+            ev = torch.cuda.Event()
+            ev.record(cur)
+            side.wait_event(ev)
+            pynccl.all_reduce(o, o, stream=side)  # in place, on the side stream
+    finally:
+        if old is None:
+            del os.environ["VLLM_MARLIN_SM_RESERVE"]
+        else:
+            os.environ["VLLM_MARLIN_SM_RESERVE"] = old
+    cur.wait_stream(side)
+    return torch.cat(outs)
