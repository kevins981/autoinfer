+# T9: reduced-vocab draft head (ruling 2). The drafter's greedy argmax runs over a
+# generic token subset: the first K-n_added ids of the tokenizer (BPE merge-rank
+# order, chosen without benchmark data) plus every added/special token id. Rows are
+# re-sharded evenly over TP ranks, quantized like the fp8 draft copy (per-row
+# weight scales). Draft side only: verification stays full-vocab and exact.
+class ReducedDraftHead(torch.nn.Module):
+    def __init__(self, head, id_map: torch.Tensor, tp_size: int):
+        super().__init__()
+        self.head = head
+        self.register_buffer("id_map", id_map, persistent=False)
+        self.tp_size = tp_size
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        from vllm.distributed import tensor_model_parallel_all_gather
+
+        logits = self.head.quant_method.apply(self.head, hidden_states, bias=None)
+        vals, idx = logits.max(dim=-1)
+        gid = self.id_map[idx]
+        if self.tp_size == 1:
+            return gid.to(torch.int64)
+        pair = torch.stack([vals.float(), gid.float()], dim=-1)
+        gathered = tensor_model_parallel_all_gather(pair, dim=-1)
+        gathered = gathered.view(hidden_states.shape[0], self.tp_size, 2)
+        best = gathered[:, :, 0].argmax(dim=-1, keepdim=True)
+        return gathered[:, :, 1].gather(dim=-1, index=best).squeeze(-1).to(torch.int64)
+
