+@triton.jit
+def _argmax_finish_value(
+    PV, PI, OUT_V, OUT_I, SPLITS: tl.constexpr, BLOCK: tl.constexpr
+):
+    row = tl.program_id(0)
+    col = tl.arange(0, BLOCK)
+    value = tl.load(PV + row * SPLITS + col, col < SPLITS, float("-inf"))
+    part = tl.argmax(value, axis=0)
+    tl.store(OUT_V + row, tl.max(value, axis=0))
+    tl.store(OUT_I + row, tl.load(PI + row * SPLITS + part))
+
+
+def greedy_argmax_with_value(
+    logits: torch.Tensor, num_valid: int
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """(max, argmax) over the first ``num_valid`` columns of each row.
+
+    Same pick as ``greedy_argmax`` restricted to ``logits[:, :num_valid]``: first
+    index on ties, NaN treated as -inf, all -inf rows give index 0. Returns
+    float32 values and int32 indices (relative to column 0).
+    """
+    rows, vocab = logits.shape
+    assert logits.stride(1) == 1 and 0 <= num_valid <= vocab
+    vals = torch.empty(rows, dtype=torch.float32, device=logits.device)
+    idx = torch.empty(rows, dtype=torch.int32, device=logits.device)
+    if rows == 0:
+        return vals, idx
+    block = 4096
+    splits = max(1, triton.cdiv(num_valid, block))
+    pv = torch.empty((rows, splits), dtype=torch.float32, device=logits.device)
+    pi = torch.empty((rows, splits), dtype=torch.int32, device=logits.device)
+    _argmax_partial[(rows, splits)](
+        logits, pv, pi, num_valid, logits.stride(0), splits, block, num_warps=4
+    )
+    _argmax_finish_value[(rows,)](
+        pv, pi, vals, idx, splits, triton.next_power_of_2(splits), num_warps=1
+    )
+    return vals, idx
