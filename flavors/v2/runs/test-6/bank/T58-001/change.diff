+  STD_TORCH_CHECK(!apply_norm || (output_gate.dim() == 3 &&
+                      output_gate.size(0) == num_tokens &&
+                      output_gate.size(1) == num_value_heads &&
+                      output_gate.size(2) == kDimV),
