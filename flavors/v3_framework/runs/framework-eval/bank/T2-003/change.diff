diff --git a/vllm/model_executor/kernels/linear/__init__.py b/vllm/model_executor/kernels/linear/__init__.py
index 122c13aa55..f6ad4b8c10 100644
--- a/vllm/model_executor/kernels/linear/__init__.py
+++ b/vllm/model_executor/kernels/linear/__init__.py
@@ -744,6 +744,18 @@ def choose_scaled_mm_linear_kernel(
     )
 
 
+def _prefer_triton_fp8_block() -> bool:
+    """VLLM_FP8_BLOCK_PREFER_TRITON: 1/0 forces; default on for sm89 (no
+    native block-scaled FP8 kernel there except Triton)."""
+    import os
+
+    v = os.environ.get("VLLM_FP8_BLOCK_PREFER_TRITON")
+    if v is not None:
+        return v == "1"
+    cap = current_platform.get_device_capability()
+    return cap is not None and cap.to_int() == 89
+
+
 def init_fp8_linear_kernel(
     activation_quant_key: QuantKey,
     weight_quant_key: QuantKey,
@@ -769,6 +781,11 @@ def init_fp8_linear_kernel(
                 "fp8_block_w8a8",
             )
 
+        if force_kernel is None and _prefer_triton_fp8_block():
+            # W8A8 block-FP8 via Triton (dynamic per-token-group-128 activation
+            # quant, 128x128 block-scaled weights) instead of weight-only Marlin.
+            force_kernel = TritonFp8BlockScaledMMKernel
+
         kernel_type = choose_scaled_mm_linear_kernel(
             config=scaled_mm_linear_kernel_config,
             possible_kernels=_POSSIBLE_FP8_BLOCK_KERNELS,  # type: ignore[misc]
