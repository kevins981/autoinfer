diff --git a/vllm/distributed/device_communicators/host_all_reduce.py b/vllm/distributed/device_communicators/host_all_reduce.py
new file mode 100644
index 0000000000..0734d9ac46
--- /dev/null
+++ b/vllm/distributed/device_communicators/host_all_reduce.py
@@ -0,0 +1,142 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Two-rank all-reduce through pinned host memory, for PCIe machines without GPU P2P.
+
+Each rank writes its tensor into a slot of a shared /dev/shm buffer (registered as mapped pinned
+memory in both processes), publishes a per-block sequence flag, waits for the peer's flag, reads
+the peer's slot and sums.  Used only for small tensors (default <= 128*5120*2 bytes, env
+VLLM_HOST_AR_MAX_BYTES; 0 disables); everything else stays on NCCL.  The sequence counters live
+on the device and are advanced by the kernel, so calls are CUDA-graph capturable/replayable.
+Both ranks must issue the same sequence of host-AR calls (they do: dispatch depends only on
+shape/dtype, which are identical across TP ranks).
+"""
+
+import atexit
+import ctypes
+import mmap
+import os
+import uuid
+
+import torch
+import torch.distributed as dist
+from torch.distributed import ProcessGroup
+
+import vllm._custom_ops  # noqa: F401  (loads the _C_custom_ar ops)
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_FLAGS_BYTES = 1 << 20
+_DEFAULT_MAX_BYTES = 128 * 5120 * 2
+_GRID = 4  # fixed block count (see all_reduce); enforced in csrc/host_all_reduce.cu
+
+
+class HostAllReduce:
+    def __init__(self, group: ProcessGroup, device: int | str | torch.device) -> None:
+        self.disabled = True
+        self.max_bytes = int(os.environ.get("VLLM_HOST_AR_MAX_BYTES", _DEFAULT_MAX_BYTES))
+        if self.max_bytes <= 0:
+            return
+        if not isinstance(group, ProcessGroup):
+            return
+        self.group = group
+        self.device = torch.device(device)
+        self.world_size = dist.get_world_size(group)
+        self.rank = dist.get_rank(group)
+        if self.world_size != 2:
+            return
+        from vllm.distributed.device_communicators.custom_all_reduce import _can_p2p
+
+        if _can_p2p(self.rank, self.world_size):
+            return  # P2P works: NCCL / custom all-reduce are the better choice
+        self.max_bytes = (self.max_bytes // 16) * 16
+        self.slot_bytes = self.max_bytes
+        self.total = _FLAGS_BYTES + 4 * self.slot_bytes
+        self.total = (self.total + 4095) // 4096 * 4096
+        ranks = dist.get_process_group_ranks(group)
+        # Rank 0 creates the shm file (zero-filled) and broadcasts its name.
+        name = [None]
+        if self.rank == 0:
+            name[0] = f"/dev/shm/vllm_host_ar_{os.getpid()}_{uuid.uuid4().hex}"
+            with open(name[0], "wb") as f:
+                f.truncate(self.total)
+        dist.broadcast_object_list(name, src=ranks[0], group=group)
+        self.path = name[0]
+        f = open(self.path, "r+b")
+        self._mm = mmap.mmap(f.fileno(), self.total)
+        f.close()
+        self._buf = ctypes.c_char.from_buffer(self._mm)
+        addr = ctypes.addressof(self._buf)
+        with torch.cuda.device(self.device):
+            self.dev_base = torch.ops._C_custom_ar.host_ar_register(addr, self.total)
+            self._addr = addr
+            self.ctr = torch.zeros(256, dtype=torch.int32, device=self.device)
+        # Both ranks have the file mapped: unlink it now so nothing is left behind on crashes.
+        dist.barrier(group=group)
+        if self.rank == 0:
+            try:
+                os.unlink(self.path)
+            except OSError:
+                pass
+        atexit.register(self.destroy)
+        self.disabled = False
+        ok = self._self_test()
+        if not ok:
+            self.disabled = True
+            logger.error("Host all-reduce self-test FAILED; disabled.")
+        else:
+            logger.info(
+                "Host-pinned all-reduce enabled (tp rank %d, <= %d bytes, self-test: bitwise OK).",
+                self.rank,
+                self.max_bytes,
+            )
+
+    def _self_test(self) -> bool:
+        ok = True
+        for rows in (1, 48):
+            xs = []
+            for r in range(2):
+                g = torch.Generator(device="cpu").manual_seed(1234 + r)
+                xs.append(
+                    (torch.randn(rows, 5120, generator=g) * 3).to(torch.bfloat16)
+                )
+            ref = (xs[0] + xs[1]).to(self.device)
+            x = xs[self.rank].to(self.device)
+            for _ in range(3):  # repeated calls exercise the sequence/parity logic
+                out = self.all_reduce(x)
+                torch.cuda.synchronize(self.device)
+                ok = ok and bool(torch.equal(out, ref))
+        flag = torch.tensor([int(ok)], dtype=torch.int32)
+        dist.all_reduce(flag, op=dist.ReduceOp.MIN, group=self.group)
+        return bool(flag.item())
+
+    def should_use(self, inp: torch.Tensor) -> bool:
+        if self.disabled or not inp.is_cuda:
+            return False
+        if inp.dtype not in (torch.bfloat16, torch.float16):
+            return False
+        nbytes = inp.numel() * inp.element_size()
+        return nbytes % 16 == 0 and 0 < nbytes <= self.max_bytes and inp.is_contiguous()
+
+    def all_reduce(self, inp: torch.Tensor) -> torch.Tensor:
+        out = torch.empty_like(inp)
+        nbytes = inp.numel() * inp.element_size()
+        # The grid MUST be constant across calls: slot parity comes from per-block sequence
+        # counters, and a call's block ranges must line up with the previous call's.
+        grid, threads = _GRID, 1024
+        torch.ops._C_custom_ar.host_ar_all_reduce(
+            inp, out, self.dev_base, _FLAGS_BYTES, self.slot_bytes,
+            self.ctr, self.rank, grid, threads,
+        )
+        return out
+
+    def destroy(self) -> None:
+        if getattr(self, "disabled", True) and not hasattr(self, "_mm"):
+            return
+        self.disabled = True
+        try:
+            torch.ops._C_custom_ar.host_ar_unregister(self._addr)
+            del self._buf
+            self._mm.close()
+        except Exception:
+            pass
+        del self._mm
