+// same tiles with the smem-staged coalesced epilogue: id = 100 + base id
+#define MCFG_EPI_LIST(X)        \
+  X(103, 1, 4, 64, 32, 2, 128)  \
+  X(107, 2, 2, 32, 32, 4, 64)   \
+  X(109, 2, 2, 32, 32, 3, 128)  \
+  X(112, 1, 4, 32, 32, 5, 64)   \
