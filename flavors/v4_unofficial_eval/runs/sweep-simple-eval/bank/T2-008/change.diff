+def _expose_nvrtc_builtins() -> None:
+    """Make humming's NVRTC compile subprocess find libnvrtc-builtins.
+
+    humming JIT-compiles through a separate `nvrtc_compile` binary that dlopens the pip
+    package's libnvrtc.so (nvidia/cu13/lib). libnvrtc then dlopens libnvrtc-builtins.so.13.0
+    by bare name, which fails unless that directory is on LD_LIBRARY_PATH of the child
+    process. Children inherit os.environ at spawn time, so extending it here (before the
+    first compile) is enough; no manual LD_LIBRARY_PATH is needed. No-op when the library is
+    not in a pip `nvidia` package.
+    """
+    spec = importlib.util.find_spec("nvidia")
+    for base in (spec.submodule_search_locations or []) if spec else []:
+        for lib_dir in glob.glob(os.path.join(base, "cu*", "lib")):
+            if not glob.glob(os.path.join(lib_dir, "libnvrtc-builtins.so*")):
+                continue
+            cur = os.environ.get("LD_LIBRARY_PATH", "")
+            if lib_dir not in cur.split(os.pathsep):
+                os.environ["LD_LIBRARY_PATH"] = (
+                    lib_dir + (os.pathsep + cur if cur else "")
+                )
+            return
+
+
+_expose_nvrtc_builtins()
+
