#!/usr/bin/env python3
"""agent: launch AutoInfer run agents and see who is who.

Messaging between agents is Claude Code's native SendMessage; this tool only starts, lists and
stops agents (plus `send`, a convenience for the human and the manager to put a message into an
agent's inbox). Spec: wip/infra/agent_runtime.md.

Every agent is a folder $AUTOINFER_RUN/agents/<name>/ and a headless `claude -p` process:
  meta.json     name, role, team, parent, cwd, pgid, session_id, started, stopped
  prompt.md     the prompt appended to Claude Code's system prompt (common + role)
  inbox.jsonl   its stdin (stream-json user messages); `tail -f` keeps the process alive
  events.jsonl  its stdout (stream-json events)
  err.log       its stderr

Usage:
  agent start <name> --role R [--team T] [--cwd DIR] [--prompt-file F]... [--model M]
              [--effort E] [--task TEXT | --task-file F] [--settings FILE]
  agent register <name> --role R [--team T]   # an already running session (e.g. the manager)
  agent list [--all] [--json]
  agent send <name> (TEXT | -f FILE)          # append to its inbox ("[from <sender>]" header)
  agent stop <name>
"""
import argparse, json, os, signal, subprocess, sys, time, uuid
from datetime import datetime, timezone
from pathlib import Path

TOOLS_DIR = Path(__file__).resolve().parent


def die(msg):
    print(f"agent: {msg}", file=sys.stderr)
    sys.exit(1)


def run_dir():
    r = os.environ.get("AUTOINFER_RUN")
    if not r:
        die("AUTOINFER_RUN is not set (the run folder)")
    p = Path(r).resolve()
    if not p.is_dir():
        die(f"run folder {p} does not exist")
    return p


def agents_dir():
    d = run_dir() / "agents"
    d.mkdir(exist_ok=True)
    return d


def now():
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def me():
    return os.environ.get("AUTOINFER_AGENT", "human")


def read_meta(d):
    try:
        return json.loads((d / "meta.json").read_text())
    except (OSError, ValueError):
        return None


def write_meta(d, meta):
    tmp = d / "meta.json.tmp"
    tmp.write_text(json.dumps(meta, indent=2) + "\n")
    tmp.replace(d / "meta.json")


def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    # a zombie counts as dead
    try:
        with open(f"/proc/{pid}/stat") as f:
            return f.read().split(")")[-1].split()[0] != "Z"
    except OSError:
        return False


def alive(meta):
    if meta.get("stopped"):
        return False
    return pid_alive(meta.get("pid"))


def message_line(text, sender):
    content = f"[from {sender}]\n{text}"
    return json.dumps({"type": "user", "message": {"role": "user", "content": content}}) + "\n"


def append_inbox(d, text, sender):
    with open(d / "inbox.jsonl", "a") as f:
        f.write(message_line(text, sender))
    meta = read_meta(d) or {}
    first = text.strip().splitlines()[0] if text.strip() else ""
    meta["last_task"] = f"{sender}: {first}"[:200]
    meta["last_task_at"] = now()
    write_meta(d, meta)


def activity(d):
    """(busy, seconds since last event, cost in USD) from the event log."""
    ev = d / "events.jsonl"
    if not ev.exists() or ev.stat().st_size == 0:
        inbox = d / "inbox.jsonl"
        busy = inbox.exists() and inbox.stat().st_size > 0
        return busy, None, None
    age = time.time() - ev.stat().st_mtime
    # Read the tail: the last event decides busy/idle; the last result carries the cost.
    with open(ev, "rb") as f:
        f.seek(0, 2)
        size = f.tell()
        f.seek(max(0, size - 400_000))
        lines = f.read().decode("utf-8", "replace").splitlines()
    last_type, cost = None, None
    for line in lines:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        t = e.get("type")
        if t in ("assistant", "user", "result") or (t == "system" and e.get("subtype") == "init"):
            last_type = t
        if t == "result" and e.get("total_cost_usd") is not None:
            cost = e["total_cost_usd"]
    busy = last_type not in (None, "result")
    return busy, age, cost


def fmt_age(s):
    if s is None:
        return "-"
    s = int(s)
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    return f"{s // 3600}h{(s % 3600) // 60:02d}m"


# ------------------------------------------------------------------------------------------
def cmd_start(a):
    d = agents_dir() / a.name
    if d.exists() and (read_meta(d) or {}).get("pid") and alive(read_meta(d)):
        die(f"{a.name} is already running")
    if d.exists() and any(d.iterdir()):
        die(f"{d} already exists (agent names are unique in a run; pick another name)")
    d.mkdir(parents=True, exist_ok=True)

    parts = []
    prompt_files = a.prompt_file
    if not prompt_files:
        # Default: the flavor's common instructions + the role's prompt
        # (the run folder is flavors/<flavor>/runs/<run>/).
        agents = run_dir().parent.parent / "agents"
        prompt_files = [agents / "common.md", agents / f"{a.role}.md"]
        missing = [str(f) for f in prompt_files if not f.exists()]
        if missing:
            die(f"no --prompt-file given and default prompts not found: {', '.join(missing)}")
    for pf in prompt_files:
        parts.append(Path(pf).read_text().rstrip() + "\n")
    parts.append(
        f"\n## Who you are in this run\n"
        f"- Your name: `{a.name}` (others send you messages at this name). Role: {a.role}."
        + (f" Team: {a.team}." if a.team else "")
        + f"\n- You were started by `{me()}` (your parent).\n"
        f"- Run folder: `{run_dir()}`.\n"
    )
    prompt = "\n".join(parts)
    (d / "prompt.md").write_text(prompt)
    (d / "inbox.jsonl").touch()
    (d / "events.jsonl").touch()

    cwd = Path(a.cwd).resolve() if a.cwd else run_dir()
    if not cwd.is_dir():
        die(f"cwd {cwd} does not exist")
    settings = a.settings or os.environ.get("AUTOINFER_AGENT_SETTINGS")
    if not settings:
        run_settings = run_dir() / "agent_settings.json"
        settings = str(run_settings if run_settings.exists() else TOOLS_DIR / "agent_settings.json")
    if not Path(settings).exists():
        die(f"settings file {settings} not found (permissions for headless agents)")
    session_id = str(uuid.uuid4())

    claude = [
        "claude", "-p",
        "--input-format", "stream-json", "--output-format", "stream-json", "--verbose",
        "--name", a.name,
        "--session-id", session_id,
        "--permission-mode", a.permission_mode,
        "--settings", settings,
        "--disallowedTools", "ListAgents",
        "--strict-mcp-config",
        "--append-system-prompt", prompt,
    ]
    if a.model:
        claude += ["--model", a.model]
    if a.effort:
        claude += ["--effort", a.effort]

    env = dict(os.environ)
    env.update({
        "AUTOINFER_RUN": str(run_dir()),
        "AUTOINFER_AGENT": a.name,
        "AUTOINFER_ROLE": a.role,
        "PATH": f"{TOOLS_DIR}:{env.get('PATH', '')}",
    })
    if a.team:
        env["AUTOINFER_TEAM"] = a.team
    else:
        env.pop("AUTOINFER_TEAM", None)

    # tail -f keeps stdin open, so the agent stays alive between tasks until it is stopped.
    shell = 'exec tail -n +1 -f "$1/inbox.jsonl" | "${@:2}" > "$1/events.jsonl" 2> "$1/err.log"'
    proc = subprocess.Popen(
        ["bash", "-c", shell, "agent-launch", str(d)] + claude,
        cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True,
    )
    meta = {
        "name": a.name, "role": a.role, "team": a.team, "parent": me(), "cwd": str(cwd),
        "pid": proc.pid, "pgid": proc.pid, "session_id": session_id, "model": a.model,
        "started": now(), "stopped": None, "last_task": None, "last_task_at": None,
    }
    write_meta(d, meta)
    task = Path(a.task_file).read_text() if a.task_file else a.task
    if task:
        append_inbox(d, task, me())
    print(f"started {a.name} (role {a.role}{', team ' + a.team if a.team else ''}); "
          f"events: {d / 'events.jsonl'}")


def find_claude_ancestor():
    pid = os.getppid()
    for _ in range(30):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmd = f.read().split(b"\0")
            with open(f"/proc/{pid}/stat") as f:
                ppid = int(f.read().split(")")[-1].split()[1])
        except OSError:
            return None
        if cmd and os.path.basename(cmd[0].decode()) == "claude":
            return pid
        if ppid <= 1:
            return None
        pid = ppid
    return None


def cmd_register(a):
    d = agents_dir() / a.name
    if d.exists() and read_meta(d) and alive(read_meta(d)):
        die(f"{a.name} is already registered and alive")
    d.mkdir(parents=True, exist_ok=True)
    pid = find_claude_ancestor()
    meta = {
        "name": a.name, "role": a.role, "team": a.team, "parent": "human", "cwd": os.getcwd(),
        "pid": pid, "pgid": None, "session_id": None, "model": None, "started": now(),
        "stopped": None, "registered": True, "last_task": None, "last_task_at": None,
    }
    write_meta(d, meta)
    print(f"registered {a.name} (pid {pid})")


def collect(include_stopped):
    rows = []
    for d in sorted(agents_dir().iterdir()):
        meta = read_meta(d)
        if not meta:
            continue
        is_alive = alive(meta)
        if not is_alive and not include_stopped:
            continue
        if meta.get("registered"):
            busy, age, cost = None, None, None
        else:
            busy, age, cost = activity(d)
        rows.append({
            "name": meta["name"], "role": meta.get("role"), "team": meta.get("team"),
            "parent": meta.get("parent"), "state": ("alive" if is_alive else "stopped"),
            "busy": busy, "last_event_age_s": None if age is None else int(age),
            "cost_usd": cost, "task": meta.get("last_task"), "started": meta.get("started"),
        })
    return rows


def cmd_list(a):
    rows = collect(a.all)
    if a.json:
        print(json.dumps(rows, indent=2))
        return
    if not rows:
        print("no agents" + ("" if a.all else " alive (use --all to include stopped ones)"))
        return
    hdr = ["NAME", "ROLE", "TEAM", "PARENT", "STATE", "ACTIVITY", "LAST EVENT", "COST", "TASK"]
    table = []
    for r in rows:
        act = "-" if r["busy"] is None else ("busy" if r["busy"] else "idle")
        if r["state"] == "stopped":
            act = "-"
        cost = "-" if r["cost_usd"] is None else f"${r['cost_usd']:.3f}"
        table.append([r["name"], r["role"] or "-", r["team"] or "-", r["parent"] or "-",
                      r["state"], act, fmt_age(r["last_event_age_s"]), cost,
                      (r["task"] or "-")[:70]])
    w = [max(len(str(x[i])) for x in table + [hdr]) for i in range(len(hdr) - 1)]
    for row in [hdr] + table:
        print("  ".join(str(c).ljust(w[i]) for i, c in enumerate(row[:-1])) + "  " + str(row[-1]))


def cmd_send(a):
    d = agents_dir() / a.name
    meta = read_meta(d)
    if not meta:
        die(f"no agent named {a.name} in this run (see `agent list --all`)")
    if meta.get("registered"):
        die(f"{a.name} is an interactive session without an inbox; use SendMessage")
    if not alive(meta):
        die(f"{a.name} is stopped; messages can't be delivered")
    text = Path(a.file).read_text() if a.file else " ".join(a.text)
    if not text.strip():
        die("empty message")
    append_inbox(d, text, me())
    print(f"sent to {a.name}")


def cmd_stop(a):
    d = agents_dir() / a.name
    meta = read_meta(d)
    if not meta:
        die(f"no agent named {a.name} in this run")
    if meta.get("registered"):
        meta["stopped"] = now()
        write_meta(d, meta)
        print(f"marked {a.name} as stopped (it is an interactive session; end it yourself)")
        return
    pgid = meta.get("pgid")
    if pgid and alive(meta):
        for sig, wait in ((signal.SIGTERM, 10), (signal.SIGKILL, 5)):
            try:
                os.killpg(pgid, sig)
            except ProcessLookupError:
                break
            t0 = time.time()
            while time.time() - t0 < wait and pid_alive(meta["pid"]):
                time.sleep(0.2)
            if not pid_alive(meta["pid"]):
                break
    meta["stopped"] = now()
    write_meta(d, meta)
    print(f"stopped {a.name}")


def main():
    p = argparse.ArgumentParser(prog="agent", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("start", help="launch a new headless agent")
    s.add_argument("name")
    s.add_argument("--role", required=True)
    s.add_argument("--team")
    s.add_argument("--cwd")
    s.add_argument("--prompt-file", action="append",
                   help="appended to Claude Code's system prompt, in order (repeatable); default: "
                        "the flavor's agents/common.md + agents/<role>.md")
    s.add_argument("--model")
    s.add_argument("--effort")
    s.add_argument("--permission-mode", default=os.environ.get("AUTOINFER_PERMISSION_MODE", "auto"),
                   help="must be the same for every agent of a run (default: auto)")
    s.add_argument("--settings", help="default: $AUTOINFER_RUN/agent_settings.json, else tools/agent_settings.json")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--task", help="first message")
    g.add_argument("--task-file", help="first message, from a file")
    s.set_defaults(fn=cmd_start)

    s = sub.add_parser("register", help="add an already running session (e.g. the manager)")
    s.add_argument("name")
    s.add_argument("--role", required=True)
    s.add_argument("--team")
    s.set_defaults(fn=cmd_register)

    s = sub.add_parser("list", help="the run's agents")
    s.add_argument("--all", action="store_true", help="include stopped agents")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("send", help="append a message to an agent's inbox")
    s.add_argument("name")
    s.add_argument("-f", "--file")
    s.add_argument("text", nargs="*")
    s.set_defaults(fn=cmd_send)

    s = sub.add_parser("stop", help="kill an agent's process")
    s.add_argument("name")
    s.set_defaults(fn=cmd_stop)

    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
