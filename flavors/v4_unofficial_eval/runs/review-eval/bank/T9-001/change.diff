+    w_ptr,
+    q_ptr,
+    s_ptr,
+    y_ptr,
+    eps,
+    H: tl.constexpr,
+    GS: tl.constexpr,
+    HAS_RESIDUAL: tl.constexpr,
+    WRITE_Y: tl.constexpr,
