+# SPDX-License-Identifier: Apache-2.0
+"""Greedy verification from per-row target argmax tokens (no full-vocab logits needed)."""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _greedy_verify_kernel(
+    sampled_ptr,  # [num_reqs, width]
+    sampled_stride,
+    num_sampled_ptr,  # [num_reqs] int32
+    target_ptr,  # [num_logits] int64 target argmax per logits row
+    draft_sampled_ptr,  # [num_logits] (row r+1 holds the draft checked by row r)
+    cu_num_logits_ptr,  # [num_reqs + 1]
+):
+    # Mirrors _rejection_kernel (greedy) + _insert_resampled_kernel: accept drafts while
+    # draft == target argmax (placeholders < 0 are rejected); the first rejected / bonus
+    # slot holds the target argmax of that row.
+    req_idx = tl.program_id(0)
+    start = tl.load(cu_num_logits_ptr + req_idx).to(tl.int64)
+    end = tl.load(cu_num_logits_ptr + req_idx + 1).to(tl.int64)
+    num_draft = end - start - 1
+    accepted_length = tl.zeros((), tl.int64)
+    verifying = True
+    for i in range(num_draft):
+        if verifying:
+            t = tl.load(target_ptr + start + i)
+            d = tl.load(draft_sampled_ptr + start + i + 1).to(tl.int64)
+            accepted = (t == d) & (d >= 0)
+            verifying = accepted
+            accepted_length += accepted
+            tl.store(sampled_ptr + req_idx * sampled_stride + i, tl.where(accepted, d, t))
+    t = tl.load(target_ptr + start + accepted_length)
+    tl.store(sampled_ptr + req_idx * sampled_stride + accepted_length, t)
+    tl.store(num_sampled_ptr + req_idx, (accepted_length + 1).to(tl.int32))
+
+
+def greedy_verify(
+    target_tokens: torch.Tensor,
+    draft_sampled: torch.Tensor,
+    cu_num_logits: torch.Tensor,
+    num_reqs: int,
+    width: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    sampled = torch.empty(num_reqs, width, dtype=torch.int64, device=target_tokens.device)
+    num_sampled = torch.empty(num_reqs, dtype=torch.int32, device=target_tokens.device)
+    _greedy_verify_kernel[(num_reqs,)](
+        sampled,
+        sampled.stride(0),
+        num_sampled,
+        target_tokens,
+        draft_sampled,
+        cu_num_logits,
+        num_warps=1,
+    )
+    return sampled, num_sampled
