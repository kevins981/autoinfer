+// Replays DeltaLog rows onto slot idx[0] and writes the full state into slot
+// idx[accepted-1], for every (request, value head) whose destination slot
+// still carries the log marker. No-op otherwise.
+void gdn_deltalog_materialize(torch::stable::Tensor const& state_indices,
+                              torch::stable::Tensor const& num_accepted_tokens,
+                              torch::stable::Tensor& state) {
+  using torch::headeronly::ScalarType;
+  STD_TORCH_CHECK(
+      state_indices.is_cuda() && state_indices.scalar_type() == ScalarType::Int &&
+          state_indices.dim() == 2 && state_indices.is_contiguous(),
+      "state_indices must be a contiguous CUDA int32 [N, W] tensor");
+  STD_TORCH_CHECK(num_accepted_tokens.is_cuda() &&
+                      num_accepted_tokens.scalar_type() == ScalarType::Int &&
+                      num_accepted_tokens.is_contiguous() &&
+                      num_accepted_tokens.numel() >= state_indices.size(0),
+                  "num_accepted_tokens must be a contiguous CUDA int32 tensor");
+  const auto state_scalar_type = state.scalar_type();
+  STD_TORCH_CHECK(
+      state.is_cuda() && state.dim() == 4 && state.size(2) == kDimV &&
+          state.size(3) == kDimK &&
+          (state_scalar_type == ScalarType::Float ||
+           state_scalar_type == ScalarType::BFloat16),
+      "state must be a CUDA float32/bfloat16 [slots, HV, 128, 128] tensor");
+  const int num_requests = static_cast<int>(state_indices.size(0));
+  if (num_requests == 0) {
+    return;
+  }
+  const int num_value_heads = static_cast<int>(state.size(1));
+  torch::stable::accelerator::DeviceGuard const device_guard(
+      state.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream(state.get_device_index());
+  const dim3 grid(num_requests, num_value_heads);
+  if (state_scalar_type == ScalarType::Float) {
+    gdn_deltalog_materialize_kernel<float><<<grid, kThreads, 0, stream>>>(
+        static_cast<const int*>(state_indices.data_ptr()),
+        static_cast<const int*>(num_accepted_tokens.data_ptr()),
+        static_cast<float*>(state.data_ptr()),
+        static_cast<int>(state_indices.size(1)), state.stride(0));
+  } else {
+    gdn_deltalog_materialize_kernel<__nv_bfloat16><<<grid, kThreads, 0, stream>>>(
+        static_cast<const int*>(state_indices.data_ptr()),
+        static_cast<const int*>(num_accepted_tokens.data_ptr()),
+        static_cast<__nv_bfloat16*>(state.data_ptr()),
+        static_cast<int>(state_indices.size(1)), state.stride(0));
+  }
+  const cudaError_t error = cudaGetLastError();
+  STD_TORCH_CHECK(error == cudaSuccess, "GDN DeltaLog materialize failed: ",
+                  cudaGetErrorString(error));
+}
