+  };
+  auto load_s = [&](float(&sA_)[MT][2], float& sB_, int kb) {
+#pragma unroll
+    for (int mt = 0; mt < MT; ++mt)
+#pragma unroll
+      for (int h = 0; h < 2; ++h) sA_[mt][h] = arow[mt][h] >= 0 ? __ldg(As + (size_t)arow[mt][h] * BL + kb) : 0.f;
+    sB_ = __ldg(bsrow + kb);
+  };
+
+  if (b0 < b1) {
+    load_w(wA, b0);
+    if constexpr (DEEP) { if (b0 + 1 < b1) load_w(wB, b0 + 1); }
+    load_s(sa, sb, b0);
+#pragma unroll
+    for (int s = 0; s < NS - 1; ++s) {
+      if (b0 + s < b1) load_A(s, b0 + s);
+      cp_commit();
+    }
+  }
+  const int a_r = lane & 15, a_c = lane >> 4;
+  auto step = [&](int i, uint4(&wc)[8], uint4(&wn)[8], uint4(&wnn)[DEEP ? 8 : 1]) {
+    cp_wait<NS - 2>();
+    group_sync(1 + kg, GT);
+    {
+      const int nx = i + NS - 1;
+      if (nx < b1) load_A((nx - b0) % NS, nx);
+      cp_commit();
+    }
+    const bool has_next = (i + 1) < b1;
+    if constexpr (DEEP) {
+      if (i + 2 < b1) load_w(*reinterpret_cast<uint4(*)[8]>(&wnn[0]), i + 2);
+      if (has_next) load_s(sa_n, sb_n, i + 1);
+    } else if (has_next) { load_w(wn, i + 1); load_s(sa_n, sb_n, i + 1); }
