+def self_bind_to_device_node(device_index: int, label: str) -> int | None:
+    """In-process NUMA binding without numactl (for hosts where `numactl` is
+    missing, so --numa-bind / auto-bind can't run).
+
+    Pins every thread of this process to the CPUs of the GPU's NUMA node and
+    sets a *preferred* memory policy for it, so pinned host buffers that this
+    process first-touches (cudaHostRegister / cudaHostAlloc) land on the node
+    the GPU's PCIe root hangs off. Performance-only: changes no computation.
+    Skipped when disabled (VLLM_NUMA_SELF_BIND=0), on single-node hosts, when
+    --numa-bind is in use, or when the affinity is already constrained.
+    Returns the node bound to, or None.
+    """
+    if os.environ.get("VLLM_NUMA_SELF_BIND", "1") == "0":
+        return None
+    if not os.path.isdir("/sys/devices/system/node/node1"):
+        return None
+    try:
+        from vllm.platforms import current_platform
+        from vllm.utils.cpu_resource_utils import parse_id_list
+
+        cpu_count = os.cpu_count()
+        if cpu_count is None or set(os.sched_getaffinity(0)) != set(range(cpu_count)):
+            return None
+        if not hasattr(current_platform, "get_device_numa_node"):
+            return None
+        node = current_platform.get_device_numa_node(device_index)
+        if node is None or node < 0:
+            return None
+        cpus = set(
+            parse_id_list(
+                Path(f"/sys/devices/system/node/node{node}/cpulist").read_text().strip()
+            )
+        )
+        if not cpus:
+            return None
+        for tid in os.listdir("/proc/self/task"):
+            try:
+                os.sched_setaffinity(int(tid), cpus)
+            except OSError:
+                pass
+        mem = "affinity only (libnuma unavailable; first touch follows the CPUs)"
+        try:
+            libnuma = get_libnuma()
+            if libnuma is not None and libnuma.numa_available() >= 0:
+                libnuma.numa_set_preferred(ctypes.c_int(node))
+                mem = "preferred memory"
+        except Exception:
+            pass
+        logger.info(
+            "%s: bound to NUMA node %d (CPUs %s, %s) without numactl",
+            label, node, Path(f"/sys/devices/system/node/node{node}/cpulist").read_text().strip(), mem,
+        )
+        return node
+    except Exception as e:  # never fail startup over a performance hint
+        logger.warning("%s: NUMA self-binding skipped: %s", label, e)
+        return None
