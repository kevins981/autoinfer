index 65abf238b8..0dd896bdb2 100644
--- a/vllm/models/qwen3_5/nvidia/ops/fused_norm_quant.py
+++ b/vllm/models/qwen3_5/nvidia/ops/fused_norm_quant.py
@@ -214,3 +214,103 @@ def gemma_add_rms_norm_quant(
