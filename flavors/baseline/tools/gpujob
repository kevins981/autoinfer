#!/usr/bin/env python3
"""gpujob: run one ad-hoc GPU script (profiling, a quick bench, a microbenchmark) safely.

Usage: gpujob --timeout MIN [--label L] -- <command...>
  e.g. gpujob --timeout 15 --label nsys -- bash $AUTOINFER_RUN/scratch/prof.sh
  Run as a BACKGROUND command. Output: $AUTOINFER_RUN/gpu/jobs/<n>.log (tail printed at the end).

Refuses if someone else is on the GPUs (exit 75) or the run's time limit is reached (76); kills
everything the command started when it ends or times out (124). Its time counts toward the run's
wall clock like everything else; it doesn't count as an experiment.
Never start servers or GPU work outside gpujob/experiment, and never run two at once.
"""
import argparse, sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _gpu


def main():
    p = argparse.ArgumentParser(prog="gpujob", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--timeout", type=float, required=True)
    p.add_argument("--label", default="job")
    p.add_argument("command", nargs=argparse.REMAINDER)
    a = p.parse_args()
    cmd = a.command[1:] if a.command[:1] == ["--"] else a.command
    if not cmd:
        p.error("no command")
    run = _gpu.run_dir("gpujob")
    _gpu.check_start("gpujob", run)
    jobs = run / "gpu" / "jobs"
    jobs.mkdir(parents=True, exist_ok=True)
    log = jobs / f"{len(list(jobs.glob('*.log'))) + 1:03d}-{a.label}.log"
    rc = _gpu.run_job("gpujob", run, cmd, log, a.timeout, a.label)
    print("".join(log.read_text(errors="replace").splitlines(True)[-30:]))
    print(f"full output: {log}")
    sys.exit(rc)


if __name__ == "__main__":
    main()
