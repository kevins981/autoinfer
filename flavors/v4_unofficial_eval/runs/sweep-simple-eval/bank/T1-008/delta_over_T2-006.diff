+                    np.array_equal(self.paged_kv_indices[:tot].cpu().numpy(), ref)
+                )
+                ub = seq_lens_cpu_check
+                ub_ok = ub is None or bool(
+                    (ub[:num_reqs].cpu().numpy() >= sl_cpu).all()
+                )
+            st = _draft_ub_check_stats
