+        return None
+    if num_rows >= target_lm_head.org_vocab_size:
+        return None
+    tp = get_tp_group()
+    ws, rank = tp.world_size, tp.rank_in_group
+    if num_rows % (ws * 64):
+        return None
+    src = target_lm_head.weight.data
+    dtype, dim = src.dtype, src.shape[1]
