+# Decode-shape (M <= 64) overrides of humming's default heuristic config for dense
+# FP8 W8A8 layers on SM89. Keyed by (shape_n, shape_k); each entry is
+# (m_lo, m_hi, delta): for M in (m_lo, m_hi] the default config of that M gets
+# `delta` applied. Found by a one-parameter-at-a-time sweep (agents/leader-1.w1/hm):
+# only entries that won at that M bucket. M > 64 is never touched.
+# delta keys: "stream_k" (bool), "bm" (block/warp M), "bn" (block N), "bk" (block K).
+_DECODE_TUNE = {
+    (17408, 5120): [(0, 64, {"stream_k": False})],
+    (8192, 5120): [(0, 48, {"stream_k": False}), (48, 64, {"bn": 64})],
+    (5120, 3072): [(0, 32, {"stream_k": False}), (32, 64, {"bm": 32})],
+    (5120, 8704): [(32, 64, {"bk": 128})],
+}
+
+
+def _apply_delta(cfg: dict, delta: dict) -> dict:
+    cfg = json.loads(json.dumps(cfg))
+    bm, bn, bk = cfg["block_shape"]
+    wm, wn, wk = cfg["warp_shape"]
+    if "stream_k" in delta:
+        cfg["use_stream_k"] = delta["stream_k"]
+    if "bm" in delta:
+        bm = delta["bm"]
+        wm = min(wm, bm)
+    if "bn" in delta:
+        bn = delta["bn"]
+        wn = min(wn, bn)
+    if "bk" in delta:
+        bk = delta["bk"]
+        wk = min(wk, bk)
+    cfg["block_shape"] = [bm, bn, bk]
+    cfg["warp_shape"] = [wm, wn, wk]
+    return cfg
+
+
+def get_humming_decode_tuning_config(layer_config, compute_config: str) -> str | None:
+    """Default humming heuristic config list with the decode-shape overrides spliced
+    in, as a JSON string for `tuning_config`; None when no override applies."""
+    import os
+
+    if os.environ.get("VLLM_HUMMING_DECODE_TUNE", "1") == "0":
+        return None
+    key = (layer_config.shape_n, layer_config.shape_k)
+    rules = _DECODE_TUNE.get(key)
+    if not rules:
+        return None
+    from vllm.utils.humming import get_heuristics_config
+
+    compute = json.loads(compute_config)
+    if compute.get("use_f16_accum") or compute.get("use_batch_invariant"):
+        return None
+    default = get_heuristics_config(
+        layer_config, **compute, device=torch.cuda.current_device()
+    )
+    cuts = sorted({b for lo, hi, _ in rules for b in (lo, hi)})
+    out = []
+    for lo, hi, cfg in default:
+        pts = [lo] + [c for c in cuts if lo < c < hi] + [hi]
+        for a, b in zip(pts, pts[1:]):
+            c = cfg
+            for rlo, rhi, delta in rules:
+                if a >= rlo and b <= rhi:
+                    c = _apply_delta(cfg, delta)
+                    break
+            out.append([a, b, c])
+    return json.dumps(out)
