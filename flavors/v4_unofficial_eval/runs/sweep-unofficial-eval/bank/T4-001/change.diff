diff --git a/vllm/model_executor/kernels/linear/scaled_mm/w8a16_triton.py b/vllm/model_executor/kernels/linear/scaled_mm/w8a16_triton.py
new file mode 100644
index 0000000000..579391c682
--- /dev/null
+++ b/vllm/model_executor/kernels/linear/scaled_mm/w8a16_triton.py
@@ -0,0 +1,202 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Triton W8A16 block-fp8 GEMM on the checkpoint layout (fp8 weight [N, K] with 128x128
+block scales, bf16 activations, fp32 accumulate). Replaces the Marlin repack for selected
+projections (env VLLM_W8A16_TRITON_PROJ, comma separated: out_proj, gate_up, down).
+Same math as Marlin weight-only fp8 up to fp32 summation order; no runtime autotune:
+configs come from the fixed table below, keyed on (N, K, M bucket)."""
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from vllm.utils.torch_utils import direct_register_custom_op
+
+# (N, K) -> list of (max_M, (BM, BN, BK, stages, warps)); last entry max_M=None = any M
+_BIG = (64, 128, 64, 4, 4)
+CONFIGS: dict[tuple[int, int], list] = {
+    # out_proj / o_proj (per rank, TP=2)
+    (5120, 3072): [(48, (16, 128, 128, 4, 8)), (64, (32, 128, 128, 4, 8)),
+                   (80, (32, 64, 128, 4, 4)), (96, (32, 128, 128, 4, 4)),
+                   (128, (32, 64, 128, 4, 4)), (192, _BIG),
+                   (256, (32, 64, 128, 4, 4)), (None, _BIG)],
+    # MLP gate_up (merged gate+up)
+    (17408, 5120): [(32, (16, 32, 128, 5, 4)), (48, (16, 128, 128, 3, 4)),
+                    (64, (32, 64, 128, 4, 8)), (192, (32, 64, 128, 4, 4)),
+                    (None, _BIG)],
+    # MLP down
+    (5120, 8704): [(48, (16, 128, 128, 4, 8)), (64, (32, 128, 128, 3, 8)),
+                   (80, (32, 64, 128, 4, 4)), (96, (32, 128, 128, 4, 4)),
+                   (128, (32, 64, 128, 4, 4)), (192, _BIG),
+                   (256, (32, 64, 128, 4, 4)), (None, _BIG)],
+    # GDN in_proj_qkvz (48 layers; merged q,k,v,z); small-M sweep job 163
+    (8192, 5120): [(16, (16, 32, 128, 5, 4)), (32, (16, 64, 128, 4, 8)),
+                   (48, (16, 128, 128, 3, 4)), (80, (32, 128, 128, 4, 8)),
+                   (192, (32, 64, 128, 4, 4)), (None, _BIG)],
+    # attention qkv_proj (16 layers + MTP layer; q includes the output gate); job 163
+    (7168, 5120): [(16, (16, 32, 128, 5, 4)), (32, (16, 64, 128, 4, 8)),
+                   (80, (32, 128, 128, 4, 8)), (192, (32, 64, 128, 4, 4)), (None, _BIG)],
+}
+# W8A8 large-M route (prefill): per-(N, K) min M (from the microbench: W8A8 beats Marlin and
+# W8A16 from there up). VLLM_W8A8_PREFILL=0 disables it (pure W8A16). Activations become
+# fp8 per-token-group-128 (allowed by TASK.definition), weights/scales are the checkpoint's.
+W8A8_MIN_M: dict[tuple[int, int], int] = {
+    (5120, 3072): 80,     # out_proj
+    (17408, 5120): 80,    # gate_up
+    (5120, 8704): 80,     # down
+    (8192, 5120): 80,     # in_proj_qkvz
+    (7168, 5120): 80,     # qkv_proj
+}
+_W8A8_ON = os.environ.get("VLLM_W8A8_PREFILL", "1") != "0"
+_PROJ_SUFFIX = {
+    "out_proj": ("out_proj", "o_proj"),
+    "gate_up": ("gate_up_proj",),
+    "down": ("down_proj",),
+    "qkvz": ("in_proj_qkvz",),
+    "qkv": ("qkv_proj",),
+}
+
+
+def enabled_projections() -> set[str]:
+    v = os.environ.get("VLLM_W8A16_TRITON_PROJ", "out_proj,gate_up,down,qkvz,qkv")
+    return {t.strip() for t in v.split(",") if t.strip()}
+
+
+def layer_selected(prefix: str, n: int, k: int) -> bool:
+    if (n, k) not in CONFIGS:
+        return False
+    last = prefix.rsplit(".", 1)[-1]
+    for tok in enabled_projections():
+        if last in _PROJ_SUFFIX.get(tok, ()):
+            return True
+    return False
+
+
+def pick_config(n: int, k: int, m: int):
+    for max_m, cfg in CONFIGS[(n, k)]:
+        if max_m is None or m <= max_m:
+            return cfg
+    raise AssertionError
+
+
+@triton.jit(do_not_specialize=["M"])
+def _w8a16_kernel(
+    x_ptr, w_ptr, sc_ptr, o_ptr, M, N, K, KB,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+):
+    mb = tl.program_id(0)
+    pn = tl.program_id(1)
+    rn = pn * BN + tl.arange(0, BN)
+    rm = mb * BM + tl.arange(0, BM)
+    rk = tl.arange(0, BK)
+    acc = tl.zeros((BM, BN), dtype=tl.float32)
+    ng = (pn * BN) // 128
+    for k in range(0, K, BK):
+        a = tl.load(x_ptr + rm[:, None] * K + (k + rk)[None, :],
+                    mask=rm[:, None] < M, other=0.0)
+        w = tl.load(w_ptr + rn[:, None] * K + (k + rk)[None, :],
+                    mask=rn[:, None] < N, other=0.0)
+        s = tl.load(sc_ptr + ng * KB + k // 128)
+        acc += tl.dot(a, tl.trans(w.to(tl.bfloat16))) * s
+    tl.store(o_ptr + rm[:, None] * N + rn[None, :], acc.to(tl.bfloat16),
+             mask=(rm[:, None] < M) & (rn[None, :] < N))
+
+
+def _launch(x: torch.Tensor, w: torch.Tensor, sc: torch.Tensor, cfg) -> torch.Tensor:
+    bm, bn, bk, ns, nw = cfg
+    m, k = x.shape
+    n = w.shape[0]
+    out = torch.empty((m, n), dtype=torch.bfloat16, device=x.device)
+    grid = (triton.cdiv(m, bm), triton.cdiv(n, bn))
+    _w8a16_kernel[grid](x, w, sc, out, m, n, k, sc.shape[1],
