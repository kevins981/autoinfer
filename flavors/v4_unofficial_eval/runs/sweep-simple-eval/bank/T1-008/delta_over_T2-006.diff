+        sl = seq_lens[:num_reqs]
+        nb = (sl + (page_size - 1)) // page_size
+        indptr = self.paged_kv_indptr.gpu[: num_reqs + 1]
+        indptr[:1].zero_()
+        torch.cumsum(nb, dim=0, dtype=torch.int32, out=indptr[1 : num_reqs + 1])
+        lp = sl % page_size
+        lp = torch.where((lp == 0) & (sl != 0), page_size, lp)
+        self.paged_kv_last_page_len.gpu[:num_reqs].copy_(lp)
