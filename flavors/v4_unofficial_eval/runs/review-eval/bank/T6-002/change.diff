new file mode 100644
index 0000000000..5f833794b8
--- /dev/null
+++ b/vllm/distributed/device_communicators/t6_split_ar.py
@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: Apache-2.0
+"""T6: row-split GEMM -> all-reduce overlap for large (mixed/prefill) steps.
+
+A row-parallel linear's output rows are independent, so the GEMM runs in two
+row chunks; chunk 1's all-reduce (NCCL, on a persistent comm side stream) runs
+while chunk 2's GEMM runs on the main stream. The main stream then waits for the
+comm stream and the result is returned already reduced; `is_reduced(x)` tells
+the following norm to skip its own all-reduce. Same math as unsplit (row chunks
+of a GEMM + an elementwise sum), up to GEMM tile-config accumulation order.
+"""
+import torch
+
+_state: dict = {}
+_last_reduced: torch.Tensor | None = None
+
+
+def is_reduced(x: torch.Tensor) -> bool:
+    return _last_reduced is not None and x is _last_reduced
+
+
+def _get(device):
+    st = _state.get(device)
+    if st is None:
+        st = {
+            "stream": torch.cuda.Stream(device=device),
+            "e1": torch.cuda.Event(),
+            "e2": torch.cuda.Event(),
+            "e3": torch.cuda.Event(),
+        }
+        _state[device] = st
+    return st
+
+
+def split_gemm_ar(quant_method, layer, x, bias):
+    global _last_reduced
+    from vllm.distributed import get_tp_group
+
+    comm = get_tp_group().device_communicator.pynccl_comm
+    if comm is None or comm.disabled:
+        return None
+    import dataclasses
+
+    is_qa = not isinstance(x, torch.Tensor)
+    M = (x.data if is_qa else x).shape[0]
+
+    def rows(a, b):
+        if not is_qa:
+            return x[a:b]
+        return dataclasses.replace(
+            x, data=x.data[a:b], scale=x.scale[a:b],
+            orig_shape=torch.Size((b - a,) + tuple(x.orig_shape[1:])),
+        )
+    h = M // 2
+    dev = (x.data if is_qa else x).device
+    st = _get(dev)
+    if not st.get("logged"):
+        st["logged"] = True
+        print(f"[t6_split_ar] first split call: M={M} qa={is_qa}", flush=True)
+    side, e1, e2, e3 = st["stream"], st["e1"], st["e2"], st["e3"]
+    main = torch.cuda.current_stream()
+    o1 = quant_method.apply(layer, rows(0, h), bias)
+    out = torch.empty((M, o1.shape[-1]), dtype=o1.dtype, device=o1.device)
+    e1.record(main)
+    with torch.cuda.stream(side):
+        e1.wait(side)
+        comm.all_reduce(o1, out[:h], stream=side)
+    o2 = quant_method.apply(layer, rows(h, M), bias)
+    e2.record(main)
+    with torch.cuda.stream(side):
+        e2.wait(side)
+        comm.all_reduce(o2, out[h:], stream=side)
+        e3.record(side)
+    e3.wait(main)
+    _last_reduced = out
+    return out
