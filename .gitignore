# Per-run heavy artifacts (run records like the search tree, KBs, journal stay tracked)
flavors/*/runs/*/workspaces/
# agent event streams (large transcripts)
flavors/*/runs/*/agents/
flavors/*/runs/*/**/logs/
*.log
*.nsys-rep
*.ncu-rep
*.sqlite
*.qdrep

# Caches, builds, envs, model weights
.cache/
__pycache__/
*.pyc
build/
env/
*.so
*.safetensors
*.bin

# Local / per-user Claude Code settings
.claude/settings.local.json
**/.claude/settings.local.json

# Secrets
.env
*.key
*.pem
# judge reports and overlays: temporary, kept locally only
evals/

# Run records: keep the text that shows what each experiment did (records, diffs, KBs, journal,
# proposals, reports, official results.json); skip raw per-request outputs, binaries and the task copy
flavors/*/runs/*/task/
flavors/*/runs/*/bank/*/official/*/trial*/
flavors/*/runs/*/bank/*/official/*/gsm8k.json
flavors/*/runs/*/bank/*/accuracy/
*.pt
*.npy
# run plumbing (session ids, settings, locks, resume messages, flavor commits: see the run README)
flavors/*/runs/*/manager_session*.json
flavors/*/runs/*/*_settings.json
flavors/*/runs/*/task_source.json
flavors/*/runs/*/team_slots.json
flavors/*/runs/*/kickoff_resume*.md
flavors/*/runs/*/kickoff_msg_*.md
flavors/*/runs/**/*.lock
flavors/*/runs/**/.lock
flavors/*/runs/*/gpu/lock
flavors/*/runs/*/gpu/seq
flavors/*/runs/*/flavor_commit*.txt
