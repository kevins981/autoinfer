#!/usr/bin/env python3
"""new_run: create a run folder and start its manager as a background Claude session.

Usage: new_run <run name> --task <task> [--no-start]
       new_run <run name> --start
  e.g. flavors/v1/tools/new_run ffn-latency-1 --task qwen38-27b-fp8-2x4090

Creates runs/<run>/ in this flavor (a copy of the task, config.md, search_policy.md, folders), prepares
the task (`ws setup-task`), then starts the manager in the flavor folder with AUTOINFER_RUN set
and the run's permission settings. Talk to it with `claude attach <id>` (printed at the end).
The first time, run `claude` once in the flavor folder and accept the trust prompt.

--start starts the manager on a run created with --no-start (e.g. after editing its config.md).
Pausing and resuming a run are messages to the manager (CLAUDE.md, "Pausing and resuming a run").
"""
import argparse, json, re, os, shutil, subprocess, sys, uuid
from datetime import datetime, timezone
from pathlib import Path

TOOLS = Path(__file__).resolve().parent
FLAVOR = TOOLS.parent
ROOT = TOOLS.parents[2]                 # autoinfer/


def die(msg):
    print(f"new_run: {msg}", file=sys.stderr)
    sys.exit(1)


QWEN38_OPT = ROOT.parent / "qwen38_opt"


def copy_task(run, task):
    """The run's own copy of the task, for agents to read (they stay in their run folder). Trusted
    tools (ws, the official eval) read the original in tasks/, found by task_source.json."""
    shutil.copytree(task, run / "task", symlinks=True)
    g = lambda *c: subprocess.run(["git", "-C", str(ROOT), *c], capture_output=True, text=True).stdout.strip()
    (run / "task_source.json").write_text(json.dumps(
        {"task": task.name, "autoinfer_commit": g("rev-parse", "HEAD"),
         "uncommitted": g("status", "--porcelain", "--", str(task.relative_to(ROOT))) or None}, indent=2) + "\n")


def confine(s, run):
    """Keep the run's agents (the manager or researcher included) away from what would leak
    answers: answer keys, evaluations, design notes, other runs, and qwen38_opt's findings and
    optimized code. Two layers: deny rules (hard for the Read/Edit tools and for shell commands
    that name these paths) and an auto-mode classifier rule (catches python, git show, ...).
    "$defaults" keeps the classifier's built-in rules (a soft_deny list replaces them otherwise)."""
    own = run.resolve()
    dirs = [ROOT / d for d in ("answer_keys", "evals", "design", ".claude", ".git")]
    # flavor folders: everything but what agents use (design/, notes such as observations.md, ...)
    keep = {"agents", "tools", "runs", "config_default.md", "program.md", ".claude"}
    flav = sorted(e for f in (ROOT / "flavors").iterdir() if f.is_dir() for e in f.iterdir() if e.name not in keep)
    dirs += [e for e in flav if e.is_dir()]
    dirs += sorted(r for f in (ROOT / "flavors").iterdir() if (f / "runs").is_dir()
                   for r in (f / "runs").iterdir() if r.is_dir() and r.resolve() != own)
    dirs += [QWEN38_OPT / d for d in ("results", "logs", "ext", "vllm", "build")]
    files = [ROOT / "EVAL.md", ROOT / "CLAUDE.md"] + [e for e in flav if not e.is_dir()] + [QWEN38_OPT / f for f in ("FINDINGS.md", "TODO.md", "CLAUDE.md")]
    pats = [f"/{d}/**" for d in dirs] + [f"/{f}" for f in files]
    ro = [f"/{ROOT / 'tasks'}/**", f"/{run / 'task'}/**"]   # the task is read-only to agents
    deny = s["permissions"]["deny"]
    deny += [f"{tool}({p})" for p in pats for tool in ("Read", "Edit")]   # Edit covers every file-writing tool
    deny += [f"Edit({p})" for p in ro]
    off = ", ".join(str(p) for p in dirs + files if p.parent.name != "runs" and QWEN38_OPT not in p.parents)
    s["includeGitInstructions"] = False   # else the system prompt holds the autoinfer repo's recent commits
    s["autoMode"] = {"soft_deny": ["$defaults", (
        f"Leaving the run: this agent belongs to one AutoInfer optimization run, folder {run}. "
        f"Never read, list, search, copy or print the following, by any method (Read, cat, grep, find, "
        f"python, symlinks, git log/show/grep/diff on the {ROOT} repository or reading its .git): {off}; any other AutoInfer "
        f"run's folder (other runs under {ROOT}/flavors/*/runs/, or anywhere else); and {QWEN38_OPT}'s "
        f"notes, results, logs and code (FINDINGS.md, TODO.md, results/, logs/, ext/, vllm/, build/). They hold "
        f"the evaluators' answers and grades, design notes, or other runs' results; using them invalidates "
        f"the experiment. Allowed outside the run: running the run's tools; reading the flavor's agents/ "
        f"and tools/; the engine code and caches under {ROOT}/.cache; {QWEN38_OPT}/env (the conda env) "
        f"and {QWEN38_OPT}/.cache (model weights); git inside the agent's own workspaces; installed "
        f"system software and documentation.")]}
    return s


def write_settings(run, flavor):
    # Permission settings: the same mode and deny rules for every agent of the run. Every agent,
    # the manager included, gets its instructions via --append-system-prompt and excludes the
    # CLAUDE.md files (the flavor CLAUDE.md only points a hand-started manager to its prompts).
    base = confine(json.loads((TOOLS / "agent_settings.json").read_text()), run)
    (run / "agent_settings.json").write_text(json.dumps(base, indent=2) + "\n")
    mgr = json.loads(json.dumps(base))
    mgr["claudeMdExcludes"] = [str(ROOT / "CLAUDE.md"), str(flavor / "CLAUDE.md")]
    # The manager's env must live in its settings: `claude --bg` hands the session to a spare
    # process pre-started by the background daemon, which has the daemon's environment (e.g. an
    # older run's AUTOINFER_RUN), not the one we pass to `claude --bg`.
    mgr["env"] = {"AUTOINFER_RUN": str(run), "AUTOINFER_AGENT": "manager",
                  "AUTOINFER_ROLE": "manager", "AUTOINFER_TEAM": "",
                  "PATH": f"{TOOLS}:{os.environ.get('PATH', '')}"}
    (run / "manager_settings.json").write_text(json.dumps(mgr, indent=2) + "\n")


def seed_base(run, task):
    """bank/BASE from the task's shipped official result (task/baseline/official/), so runs don't
    re-measure the baseline. Without one, the manager runs `official_eval BASE` itself."""
    src = task / "baseline" / "official"
    base = run / "bank" / "BASE"
    base.mkdir(parents=True)
    (base / "change.diff").write_text("")
    line = "(none shipped with the task: run `official_eval BASE`)"
    if (src / "results.json").exists():
        shutil.copytree(src, base / "official" / "1")
        r = json.loads((src / "results.json").read_text())
        line = (f"official #1 (shipped with the task, task/baseline/official/): "
                f"{r['output_throughput']:.1f} tok/s at c=16, GSM8K {100 * r['gsm8k_accuracy']:.1f}%, "
                f"MTP acceptance {r.get('mtp_acceptance_length')}, TTFT p50/p99 "
                f"{r['median_ttft_ms']:.0f}/{r['p99_ttft_ms']:.0f} ms, TPOT p50/p99 "
                f"{r['median_tpot_ms']:.1f}/{r['p99_tpot_ms']:.1f} ms (official/1/results.json)")
        (run / "champion.md").write_text(f"# Champion\nBASE (the task baseline): {line}\n")
    (base / "record.md").write_text(
        "team:         -\n"
        "builds_on:    -\n"
        "performance:  official results below\n"
        "summary:\n"
        "  hypothesis: none: the task baseline\n"
        "  change:     none (empty change.diff); serve args = task/harness/serve_args.sh\n"
        "  results:    see official/\n"
        "  conclusion: the reference for every comparison and for the latency gates\n"
        "validity:     the task baseline by definition\n\n" + line + "\n")


def record_flavor_commit(run, flavor):
    """The autoinfer commit the run started from (+ uncommitted changes in the flavor), so every
    result traces back to the exact flavor code even after the flavor is edited."""
    g = lambda *c: subprocess.run(["git", "-C", str(ROOT), *c], capture_output=True, text=True).stdout.strip()
    dirty = g("status", "--porcelain", "--", str(flavor.relative_to(ROOT)) + "/agents",
              str(flavor.relative_to(ROOT)) + "/tools", str(flavor.relative_to(ROOT)) + "/design")
    (run / "flavor_commit.txt").write_text(f"{g('rev-parse', 'HEAD')}\n" +
                                           (f"uncommitted flavor changes:\n{dirty}\n" if dirty else ""))


def main():
    p = argparse.ArgumentParser(prog="new_run", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("run")
    p.add_argument("--task", help="task name in tasks/ (required for a new run)")
    p.add_argument("--no-start", action="store_true", help="only create the folder")
    p.add_argument("--start", action="store_true", help="start the manager on a run created with --no-start")
    a = p.parse_args()

    flavor = FLAVOR
    run = flavor / "runs" / a.run
    if a.start:
        if not run.is_dir():
            die(f"no run {run}")
        if (run / "manager_session.json").exists():
            die(f"{run.name} already has a manager; talk to it (CLAUDE.md, 'Pausing and resuming a run')")
        t = run / "task"
        task_name = t.resolve().name if t.is_symlink() else json.loads((run / "task_source.json").read_text())["task"]
    else:
        if not a.task:
            die("--task is required for a new run")
        task_name = a.task
        task = ROOT / "tasks" / a.task
        if not task.is_dir():
            die(f"no task {task}")
        if run.exists():
            die(f"{run} already exists")
        run.mkdir(parents=True)
        copy_task(run, task)
        for d in ("agents", "bank", "brainstorm", "reports", "local_kb", "gpu", "workspaces"):
            (run / d).mkdir()
        shutil.copy(flavor / "config_default.md", run / "config.md")
        shutil.copy(flavor / "design" / "search_policy.md", run / "search_policy.md")
        for f in ("graph.md", "ideas.md", "journal.md", "shared_kb.md", "champion.md", "focus.md"):
            (run / f).write_text("")
        seed_base(run, task)
        env = dict(os.environ, AUTOINFER_RUN=str(run))
        r = subprocess.run([str(TOOLS / "ws"), "setup-task"], env=env, capture_output=True,
                           text=True)
        print(r.stdout.strip())
        if r.returncode != 0:
            die(f"ws setup-task failed:\n{r.stderr}")
        print(f"created run folder {run}")
        if a.no_start:
            print(f"edit {run / 'config.md'} if needed, then: {TOOLS / 'new_run'} {a.run} --start")
            return
    write_settings(run, flavor)
    record_flavor_commit(run, flavor)
    first = (f"You are the manager of a new run. Run folder: {run} (AUTOINFER_RUN is set). "
             f"Task: {task_name}. Start with `agent register manager --role manager`, then begin "
             f"initialize(): greet the human and start defining the task with them.")

    env = dict(os.environ, AUTOINFER_RUN=str(run), AUTOINFER_AGENT="manager",
               AUTOINFER_ROLE="manager", PATH=f"{TOOLS}:{os.environ.get('PATH', '')}")
    env.pop("AUTOINFER_TEAM", None)
    import importlib.machinery
    agent_mod = importlib.machinery.SourceFileLoader("agent_tool", str(TOOLS / "agent")).load_module()
    mgr_model, mgr_effort = agent_mod.role_model("manager", run)
    print(f"manager: {mgr_model} / {mgr_effort} (config.md)")
    prompt = "\n\n".join((flavor / "agents" / f).read_text() for f in ("common.md", "manager.md"))
    prompt += (f"\n\n# Who you are in this run\nYou are `manager` (role manager) of run `{a.run}`; "
               f"run folder {run}; task {task_name}.\n")
    sid = str(uuid.uuid4())                  # recorded: resources.py, and recovery of a dead session
    (run / "manager_session.json").write_text(json.dumps(
        {"session_id": sid, "started": datetime.now(timezone.utc).isoformat(timespec="seconds")}) + "\n")
    r = subprocess.run(["claude", "--bg", "--name", "manager", "--session-id", sid, "--permission-mode", "auto",
                        "--model", mgr_model, "--effort", mgr_effort,
                        "--autocompact", os.environ.get("AUTOINFER_AUTOCOMPACT", "400000"),
                        "--settings", str(run / "manager_settings.json"),
                        "--append-system-prompt", prompt, first],
                       cwd=flavor, env=env, capture_output=True, text=True)
    print(r.stdout.strip() or r.stderr.strip())
    # `claude --bg` assigns its own session id (it ignores --session-id): record the one it prints,
    # a prefix of the transcript's file name (resources.py matches by prefix)
    m = re.search(r"backgrounded\s*\S\s*([0-9a-f]{8})", r.stdout)
    if m:
        (run / "manager_session.json").write_text(json.dumps(
            {"session_id": m.group(1), "started": datetime.now(timezone.utc).isoformat(timespec="seconds")}) + "\n")
    if r.returncode != 0:
        die("could not start the manager (see above). Folder is ready; fix and start it by hand.")


if __name__ == "__main__":
    main()
