+  const int vh_per_kh = num_value_heads / num_key_heads;
+  STD_TORCH_CHECK(num_value_heads % num_key_heads == 0 &&
+                      ((vh_per_kh >= 1 && vh_per_kh <= 4) || vh_per_kh == 8),
+                  "requires HV/H in {1, 2, 3, 4, 8}");
