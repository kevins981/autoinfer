+      }
+      replay_row_update(h, k4, replay_decay[i], replay_beta[i], v_rows);
+    }
+#pragma unroll
+    for (int row = 0; row < kRowsPerWarp; ++row) {
+      const int value = chunk * kChunkV + warp + row * kWarps;
+      store_state4(sd + value * kDimK + k_base,
+                   make_float4(h[row][0], h[row][1], h[row][2], h[row][3]));
+    }
+  }
