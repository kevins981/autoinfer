+// Flush: materialize the state(s) stock would have left in the per-token slots,
+// from (committed state S[0] + log), for requests whose state is about to be read
+// by code outside the fused kernel. Grid: (batch, HV, layers).
+// mode 0 (pre-copy, V2): col=src_col[req] (<0 skip), skip when col==dst(state_idx);
+//        a = src_off[req]+1; clear flags of block bt[req, dst].
+// mode 1 (post-copy, V2): decision of postprocess_mamba_fused_kernel;
+//        materializes S[0..a-1]; clears flags of the destination block.
+// mode 2 (layer, direct): bt is the [n, W] state-index tensor, col 0, a=acc[req].
+// mode 3 (layer, clear-only): bt is a [n] tensor of keys.
+template <bool Red8>
+__global__ __launch_bounds__(kThreads, 2) void gdn_replay_flush_kernel(
+    const int64_t* __restrict__ state_ptrs,
+    const int64_t* __restrict__ flag_ptrs, int64_t state_slot_stride, int HV,
+    const int* __restrict__ bt, int64_t bt_stride,
+    const int* __restrict__ idx_mapping, const int* __restrict__ p0,
+    const int* __restrict__ p1, const int* __restrict__ p2, int num_reqs,
+    int mode, int block_size, unsigned long long* __restrict__ counters) {
+  const bool two_slot = (mode >> 8) & 1;  // Route B: only S[replay-1] -> S[0]
+  mode &= 0xFF;
+  const int batch = blockIdx.x;
+  const int value_head = blockIdx.y;
+  const int layer = blockIdx.z;
+  if (batch >= num_reqs) return;
+  const int tid = threadIdx.x;
+  const int lane = tid & 31;
+  const int warp = tid >> 5;
+  const int req = idx_mapping ? idx_mapping[batch] : batch;
+  if (req < 0) return;
+  const int* bt_row = bt + static_cast<int64_t>(req) * bt_stride;
+  float* state = reinterpret_cast<float*>(state_ptrs[layer]);
+  uint8_t* flags = reinterpret_cast<uint8_t*>(flag_ptrs[layer]);
+
+  int col = -1;     // block-table column of the committed slot S[0]
+  int a = 0;        // accepted count (replay length)
+  int clear_col = -1;
+  if (mode == 0) {
+    const int src_col = p0[req];
+    const int dst_col = p1[req];
+    if (src_col == dst_col) return;
+    col = src_col;  // < 0: fresh request, only clear the destination flags
+    a = p2[req] + 1;
+    clear_col = dst_col;
+  } else if (mode == 1) {
+    // p0 = num_accepted (live), p1 = mamba_state_idx, p2 = new_num_computed
+    const int acc = p0[req];
+    const int src_col = p1[req];
+    const int new_nc = p2[req];
+    const int running = new_nc - acc + 1;
+    const int aligned = (new_nc / block_size) * block_size;
+    if (!(aligned >= running)) return;
+    col = src_col;
+    a = acc;
+    clear_col = aligned / block_size - 1;
+  } else if (mode == 2) {
+    if (batch >= num_reqs) return;
+    col = 0;
+    a = p0[req];
+  } else {  // mode 3
+    if (tid == 0) {
+      const int key = bt[req];
+      if (key > 0) {
+        uint8_t* fl = flags + static_cast<int64_t>(key) * HV + value_head;
+        if (counters != nullptr && *fl != 0) atomicAdd(&counters[3], 1ULL);
+        *fl = 0;
+      }
+    }
+    return;
+  }
+
+  __shared__ __align__(16) float shared_lk[kLogCap][kDimK];
+  __shared__ __nv_bfloat16 shared_lv[kLogCap][kDimV];
+  __shared__ float shared_ldecay[kLogCap];
+  __shared__ float shared_lbeta[kLogCap];
+
+  const int key_slot = col >= 0 ? bt_row[col] : 0;
+  const int log_slot = col >= 0 ? bt_row[col + 1] : 0;
+  int replay = 0;   // accepted tokens of the last step (stored to S[0..replay-1])
+  int pending = 0;  // earlier accepted tokens not yet in S[0] (replayed first)
+  if (key_slot > 0 && log_slot > 0 && a > 0) {
+    const int flag = flags[static_cast<int64_t>(key_slot) * HV + value_head];
+    const int logged = flag & kFlagLastMask;
+    replay = a < logged ? a : logged;
+    pending = logged > 0 ? flag >> kFlagLastBits : 0;
+  }
+  const int total = pending + replay;
+  const int64_t head_off = static_cast<int64_t>(value_head) * kDimV * kDimK;
+  if (replay > 0) {
+    float* committed =
+        state + static_cast<int64_t>(key_slot) * state_slot_stride + head_off;
+    float* log_ptr =
+        state + static_cast<int64_t>(log_slot) * state_slot_stride + head_off;
+    // Stage the log (it may live in a slot we are about to overwrite).
+    for (int idx = tid; idx < total * kDimK; idx += kThreads) {
+      (&shared_lk[0][0])[idx] = log_ptr[idx];
+    }
+    const __nv_bfloat16* log_v =
+        reinterpret_cast<const __nv_bfloat16*>(log_ptr + kLogVOff);
+    for (int idx = tid; idx < total * kDimV; idx += kThreads) {
+      (&shared_lv[0][0])[idx] = log_v[idx];
+    }
+    if (tid < total) {
+      shared_ldecay[tid] = log_ptr[kLogDecayOff + tid];
+      shared_lbeta[tid] = log_ptr[kLogBetaOff + tid];
+    }
+    __syncthreads();
+    // Slots S[0..replay-1] receive the state after tokens 0..replay-1, i.e.
+    // exactly what the per-token-store kernel leaves there (S[0] is overwritten
+    // last in program order for each thread-owned element, after C was read).
+    float* slot_state[kMaxLogTokens];
+#pragma unroll
+    for (int r = 0; r < kMaxLogTokens; ++r) {
+      // Two-slot: the only slot with a reader is S[0], and it must hold the state
+      // after the LAST accepted token (what the stock layout leaves in S[a-1]).
+      const int sl = two_slot ? (r == replay - 1 ? key_slot : 0)
+                              : (r < replay ? bt_row[col + r] : 0);
+      slot_state[r] = sl > 0 ? state + static_cast<int64_t>(sl) * state_slot_stride + head_off
+                             : nullptr;
+    }
+    if constexpr (Red8) {
+      const int j8 = lane & (kRed8Lanes - 1);
+      const int my_row = warp + (lane / kRed8Lanes) * kWarps;
+      for (int chunk = 0; chunk < kNumChunks; ++chunk) {
+        const int value = chunk * kChunkV + my_row;
+        float h[kRed8Vals];
+        red8_load(h, committed + value * kDimK, j8);
+        for (int r = 0; r < pending; ++r) {
+          red8_advance(h, &shared_lk[r][0], shared_ldecay[r], shared_lbeta[r],
+                       __bfloat162float(shared_lv[r][value]), j8);
+        }
+        for (int r = 0; r < replay; ++r) {
+          const int e = pending + r;
+          red8_advance(h, &shared_lk[e][0], shared_ldecay[e], shared_lbeta[e],
+                       __bfloat162float(shared_lv[e][value]), j8);
+          if (slot_state[r] != nullptr) red8_store(slot_state[r] + value * kDimK, h, j8);
+        }
+      }
+    } else {
+    const int k_base = lane * 4;
+      int rows[kRowsPerWarp];
+  #pragma unroll
+      for (int row = 0; row < kRowsPerWarp; ++row) rows[row] = warp + row * kWarps;
+      for (int chunk = 0; chunk < kNumChunks; ++chunk) {
+        float h[kRowsPerWarp][4];
+  #pragma unroll
+        for (int row = 0; row < kRowsPerWarp; ++row) {
+          const float4 sv = *reinterpret_cast<const float4*>(
+              committed + (chunk * kChunkV + rows[row]) * kDimK + k_base);
+          h[row][0] = sv.x; h[row][1] = sv.y; h[row][2] = sv.z; h[row][3] = sv.w;
+        }
+        for (int r = 0; r < pending; ++r) {
+          replay_advance(h, &shared_lk[r][k_base], shared_ldecay[r],
+                         shared_lbeta[r], shared_lv[r], chunk, rows);
+        }
+        for (int r = 0; r < replay; ++r) {
+          const int e = pending + r;
+          replay_advance(h, &shared_lk[e][k_base], shared_ldecay[e],
+                         shared_lbeta[e], shared_lv[e], chunk, rows);
+          if (slot_state[r] != nullptr) {
+  #pragma unroll
+            for (int row = 0; row < kRowsPerWarp; ++row) {
+              store_state4(slot_state[r] + (chunk * kChunkV + rows[row]) * kDimK + k_base,
+                           make_float4(h[row][0], h[row][1], h[row][2], h[row][3]));
+            }
+          }
+        }
+      }
+    }
+    __syncthreads();
+    if (tid == 0) {
+      flags[static_cast<int64_t>(key_slot) * HV + value_head] = 0;
+      if (counters != nullptr) atomicAdd(&counters[mode], 1ULL);
+    }
+  }
+  if (tid == 0 && clear_col >= 0) {
+    const int ck = bt_row[clear_col];
+    if (ck > 0) flags[static_cast<int64_t>(ck) * HV + value_head] = 0;
+  }
+}
