+      unsigned thr = 0;
+      if (t == 0 && r < M) {
+        const unsigned mine = f2ord(v);
+        const unsigned now = __ldcg(lb + r);
+        if (mine > now) atomicMax(lb + r, mine);
+        thr = max(mine, now);
+      }
+      thr = __shfl_sync(0xffffffffu, thr, lane & ~3);
+      const float T = bf_rd(ord2f(thr));
+      if (r < M) {
+#pragma unroll
+        for (int nt = 0; nt < NT; nt++)
+#pragma unroll
+          for (int e1 = 0; e1 < 2; e1++) {
+            const float u = U[mt][nt][2 * hf + e1];
+            if (bf_ru(u) >= T) {
+              const int pos = atomicAdd(ecnt + r, 1);
+              if (pos < ecap) ebuf[(long)r * ecap + pos] = make_int2((int)((n8_base + nt) * 8 + 2 * t + e1), __float_as_int(u));
+            }
+          }
+      }
+    }
+}
+
+
+// ---------------- finalize: filter emitted entries against the final (cross-rank) LB ----------------
+// lb_all [M][tp] ordered keys of every rank's LB; keeps (m, v) with bf16_ru(U) >= bf16_rd(max_r lb_all[m][r]).
+__global__ void finalize_kernel(int M, const unsigned* lb_all, int tp, const int* ecnt, const int2* ebuf, int ecap,
+                                int* pair_cnt, int2* pairs, int* src, int paircap, int* map, int* kept, int* fallback, int capr) {
+  const int m = blockIdx.x;
+  if (m >= M) return;
+  const int n = ecnt[m];
+  if (n > ecap) { if (threadIdx.x == 0) { fallback[m] = 1; kept[m] = 0; } return; }
+  unsigned lbk = 0;
+  for (int r = 0; r < tp; r++) lbk = max(lbk, lb_all[m * tp + r]);
+  const float T = bf_rd(ord2f(lbk));
+  __shared__ int nk;
+  if (threadIdx.x == 0) nk = 0;
+  __syncthreads();
+  for (int i = threadIdx.x; i < n; i += blockDim.x) {
+    const int2 e = ebuf[(long)m * ecap + i];
+    if (bf_ru(__int_as_float(e.y)) >= T) {
+      const int k = atomicAdd(&nk, 1);
+      if (k >= capr) continue;
+      const int p = atomicAdd(pair_cnt, 1);
+      if (p >= paircap) { fallback[m] = 1; continue; }
+      pairs[p] = make_int2(m, e.x);
+      const int own = atomicCAS(map + e.x, -1, p);
+      src[p] = own < 0 ? p : own;
+    }
+  }
+  __syncthreads();
+  if (threadIdx.x == 0) { kept[m] = nk; if (nk > capr) fallback[m] = 1; }
+}
+
+// ---------------- gather: copy owner rows (p < stagecap) from the host-mapped shard into HBM staging; unmap ----------------
+__global__ void gather_kernel(const int* pair_cnt, int paircap, const int2* pairs, const int* src, const uint4* W, long K,
+                              uint4* stage, int stagecap) {
+  const int np = min(min(*pair_cnt, paircap), stagecap);
+  const int vpr = K / 8;
+  const long total = (long)np * vpr;
+  for (long i = (long)blockIdx.x * blockDim.x + threadIdx.x; i < total; i += (long)gridDim.x * blockDim.x) {
+    const int p = i / vpr, c = i % vpr;
+    if (src[p] != p) continue;
+    stage[(long)p * vpr + c] = W[(long)pairs[p].y * vpr + c];
+  }
+}
+__global__ void unmap_kernel(const int* pair_cnt, int paircap, const int2* pairs, int* map) {
+  const int np = min(*pair_cnt, paircap);
+  for (int p = blockIdx.x * blockDim.x + threadIdx.x; p < np; p += gridDim.x * blockDim.x) map[pairs[p].y] = -1;
+}
+
+static __device__ __forceinline__ unsigned long long make_key(float v, unsigned idx) {
+  const __nv_bfloat16 bv = __float2bfloat16_rn(v);
+  float fv = __bfloat162float(bv);
+  if (fv != fv) fv = -INFINITY;  // as greedy_argmax: NaN -> -inf
+  return ((unsigned long long)f2ord(fv) << 32) | (unsigned long long)(0xFFFFFFFFu - idx);
+}
+
+// ---------------- rescore: exact bf16 logits with lmh_codec's MMA chain, diagonal trick ----------------
+// warp per octet of pairs; A row g = h_{m_g}, B col g = w_{v_g}; D[g][g] gets the same per-element MMA chain as
+// lmh_codec's tile. Row source: staging row src[p] if src[p] < stagecap, else the host-mapped shard row v.
+__global__ void rescore_kernel(const __nv_bfloat16* __restrict__ X, long K, const int* pair_cnt, int paircap,
+                               const int2* __restrict__ pairs, const int* __restrict__ src,
+                               const __nv_bfloat16* __restrict__ stage, int stagecap, const __nv_bfloat16* __restrict__ Wh,
+                               unsigned long long* keys) {
+  const int np = min(*pair_cnt, paircap);
+  const int lane = threadIdx.x & 31;
+  const int g = lane >> 2, t = lane & 3;
+  const int nwarps = gridDim.x * (blockDim.x / 32);
+  for (int o = blockIdx.x * (blockDim.x / 32) + threadIdx.x / 32; o * 8 < np; o += nwarps) {
+    const int p = o * 8 + g;
+    const bool valid = p < np;
+    const int2 pr = valid ? pairs[p] : make_int2(0, 0);
+    const int sp = valid ? src[p] : 0;
+    const uint32_t* hrow = reinterpret_cast<const uint32_t*>(X + (long)pr.x * K);
+    const uint32_t* wrow = reinterpret_cast<const uint32_t*>(
+        sp < stagecap ? stage + (long)sp * K : Wh + (long)pr.y * K);
+    float acc[4] = {0.f, 0.f, 0.f, 0.f};
+    const long KC = K / 128;  // KC % PF == 0 (checked on the host)
+    constexpr int PF = 4;
+    uint32_t rb[PF][16], ra[PF][16];
+#pragma unroll
+    for (int sl = 0; sl < PF; sl++) {
+#pragma unroll
+      for (int j = 0; j < 8; j++) {
+        const long o0 = (sl * 128 + 16 * j + 2 * t) / 2, o1 = (sl * 128 + 16 * j + 2 * t + 8) / 2;
+        rb[sl][2 * j] = wrow[o0]; rb[sl][2 * j + 1] = wrow[o1]; ra[sl][2 * j] = hrow[o0]; ra[sl][2 * j + 1] = hrow[o1];
+      }
+    }
+    for (long kc0 = 0; kc0 < KC; kc0 += PF) {
+#pragma unroll
+      for (int sl = 0; sl < PF; sl++) {
+#pragma unroll
+        for (int j = 0; j < 8; j++) {  // same chain as lmh_codec: kc ascending, k16 steps ascending, from 0
+          uint32_t a[4] = {ra[sl][2 * j], 0u, ra[sl][2 * j + 1], 0u};
+          mma16816(acc, a, rb[sl][2 * j], rb[sl][2 * j + 1]);
+        }
+        const long kn = kc0 + sl + PF;
+        if (kn < KC) {
+#pragma unroll
+          for (int j = 0; j < 8; j++) {
+            const long o0 = (kn * 128 + 16 * j + 2 * t) / 2, o1 = (kn * 128 + 16 * j + 2 * t + 8) / 2;
+            rb[sl][2 * j] = wrow[o0]; rb[sl][2 * j + 1] = wrow[o1]; ra[sl][2 * j] = hrow[o0]; ra[sl][2 * j + 1] = hrow[o1];
+          }
+        }
+      }
+    }
+    const int n = g;  // diagonal element (n, n) lives in lane (g = n, t = n >> 1), c[n & 1]
+    if ((t == (n >> 1)) && valid) atomicMax(keys + pr.x, make_key((n & 1) ? acc[1] : acc[0], (unsigned)pr.y));
+  }
+}
+
+// ---------------- exact full-shard logits (fallback rows / full-logits path), B read from W (host-mapped ok) ----------------
+// rows: list of row indices (or identity when null), count *nrows_ptr (device) or nrows; processes up to 64 rows per pass
+// with lmh_codec's exact per-element chain (m16 tiles, kc ascending, k16 ascending). out: bf16 logits [row][ldo] or
+// keys: atomicMax per row.
+__global__ void __launch_bounds__(128) rawgemm_kernel(const __nv_bfloat16* __restrict__ X, long K, const int* rows,
+                                                      const int* nrows_ptr, int nrows, int pass,
+                                                      const __nv_bfloat16* __restrict__ W, long N,
+                                                      __nv_bfloat16* out, long ldo, unsigned long long* keys) {
+  const int n_all = nrows_ptr ? *nrows_ptr : nrows;
+  const int r0 = pass * 64;
+  if (r0 >= n_all) return;
+  const int nr = min(64, n_all - r0);
+  const int lane = threadIdx.x & 31, g = lane >> 2, t = lane & 3;
+  int rid[4][2];
+#pragma unroll
+  for (int mt = 0; mt < 4; mt++)
+#pragma unroll
+    for (int hf = 0; hf < 2; hf++) {
+      const int i = mt * 16 + g + 8 * hf;
+      rid[mt][hf] = i < nr ? (rows ? rows[r0 + i] : r0 + i) : -1;
+    }
+  const long KC = K / 128, n8s = N / 8;
+  const int nwarps = gridDim.x * (blockDim.x / 32);
+  for (long n8 = blockIdx.x * (blockDim.x / 32) + threadIdx.x / 32; n8 < n8s; n8 += nwarps) {
+    const uint32_t* wrow = reinterpret_cast<const uint32_t*>(W + (n8 * 8 + g) * K);
+    float acc[4][4];
+#pragma unroll
+    for (int mt = 0; mt < 4; mt++) acc[mt][0] = acc[mt][1] = acc[mt][2] = acc[mt][3] = 0.f;
+    uint32_t bw[16], bn[16];
+#pragma unroll
+    for (int j = 0; j < 8; j++) { bw[2 * j] = wrow[(16 * j + 2 * t) / 2]; bw[2 * j + 1] = wrow[(16 * j + 2 * t + 8) / 2]; }
+    for (long kc = 0; kc < KC; kc++) {
+      if (kc + 1 < KC) {
+#pragma unroll
+        for (int j = 0; j < 8; j++) {
+          bn[2 * j] = wrow[((kc + 1) * 128 + 16 * j + 2 * t) / 2];
+          bn[2 * j + 1] = wrow[((kc + 1) * 128 + 16 * j + 2 * t + 8) / 2];
+        }
+      }
+#pragma unroll
+      for (int j = 0; j < 8; j++) {
+#pragma unroll
+        for (int mt = 0; mt < 4; mt++) {
+          if (mt * 16 >= nr) break;
+          uint32_t a[4];
+          const long o0 = (kc * 128 + 16 * j + 2 * t) / 2, o1 = (kc * 128 + 16 * j + 2 * t + 8) / 2;
+          const uint32_t* h0 = reinterpret_cast<const uint32_t*>(X + (long)max(rid[mt][0], 0) * K);
+          const uint32_t* h1 = reinterpret_cast<const uint32_t*>(X + (long)max(rid[mt][1], 0) * K);
+          a[0] = rid[mt][0] >= 0 ? h0[o0] : 0u; a[1] = rid[mt][1] >= 0 ? h1[o0] : 0u;
+          a[2] = rid[mt][0] >= 0 ? h0[o1] : 0u; a[3] = rid[mt][1] >= 0 ? h1[o1] : 0u;
+          mma16816(acc[mt], a, bw[2 * j], bw[2 * j + 1]);
+        }
+      }
+#pragma unroll
+      for (int i = 0; i < 16; i++) bw[i] = bn[i];
+    }
+#pragma unroll
+    for (int mt = 0; mt < 4; mt++) {
+      if (mt * 16 >= nr) break;
+#pragma unroll
+      for (int hf = 0; hf < 2; hf++) {
+        const int r = rid[mt][hf];
+        const long col = n8 * 8 + 2 * t;
+        if (out) {
+          if (r >= 0)
+            *reinterpret_cast<__nv_bfloat162*>(out + (long)r * ldo + col) =
+                __float22bfloat162_rn(make_float2(acc[mt][2 * hf], acc[mt][2 * hf + 1]));
+        } else {
+          unsigned long long k = max(make_key(acc[mt][2 * hf], (unsigned)col), make_key(acc[mt][2 * hf + 1], (unsigned)col + 1));
+          k = max(k, __shfl_xor_sync(0xffffffffu, k, 1));
+          k = max(k, __shfl_xor_sync(0xffffffffu, k, 2));
+          if (t == 0 && r >= 0) atomicMax(keys + r, k);
+        }
+      }
+    }
+  }
+}
+
+// fallback list + stats: one block. stats[0] fallback rows, [1] sum kept, [2] max kept, [3] rows, [4] calls
+__global__ void fblist_kernel(int M, const int* fb, const int* kept, int* rows, int* nrows, long long* stats) {
+  __shared__ int n;
+  if (threadIdx.x == 0) n = 0;
+  __syncthreads();
+  for (int m = threadIdx.x; m < M; m += blockDim.x) {
+    if (fb[m]) rows[atomicAdd(&n, 1)] = m;
+    atomicAdd((unsigned long long*)(stats + 1), (unsigned long long)kept[m]);
+    atomicMax((unsigned long long*)(stats + 2), (unsigned long long)kept[m]);
+  }
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    *nrows = n;
+    stats[0] += n; stats[3] += M; stats[4] += 1;
+  }
+}
+
+// keys -> (local max value fp32, local argmax int32); key 0 (no candidate on this rank) -> (-inf, 0)
+__global__ void keys_decode_kernel(int M, const unsigned long long* keys, float* vals, int* idx) {
+  const int m = blockIdx.x * blockDim.x + threadIdx.x;
+  if (m >= M) return;
+  const unsigned long long k = keys[m];
+  if (k == 0) { vals[m] = -INFINITY; idx[m] = 0; return; }
+  vals[m] = ord2f((unsigned)(k >> 32));
+  idx[m] = (int)(0xFFFFFFFFu - (unsigned)(k & 0xFFFFFFFFu));
+}
+
+// ---------------- host ----------------
+static cudaStream_t cur() { return at::cuda::getCurrentCUDAStream(); }
+
+int64_t plane_verify(torch::Tensor Q, torch::Tensor plane) {
+  const long N = Q.size(0), K = Q.size(1), ng = (N / 8) * (K / 128);
+  auto bad = torch::zeros({1}, Q.options().dtype(torch::kInt64));
+  plane_verify_kernel<<<(ng + 7) / 8, 256, 0, cur()>>>((const int8_t*)Q.data_ptr(), N, K, (const uint8_t*)plane.data_ptr(),
+                                                       (unsigned long long*)bad.data_ptr());
+  return bad.cpu().item<int64_t>();
+}
+void hprep(torch::Tensor X, int64_t M, torch::Tensor hq, torch::Tensor hs, torch::Tensor hn, torch::Tensor hqe) {
+  hprep_kernel<<<M, 256, 0, cur()>>>((const __nv_bfloat16*)X.data_ptr(), X.size(1), (int8_t*)hq.data_ptr(), hs.data_ptr<float>(),
+                                     hn.data_ptr<float>(), hqe.data_ptr<float>());
+}
+template <int MT, int NT, int WARPS, int STAGES>
+static void launch_screen(const torch::Tensor& hq, int M, long K, const torch::Tensor& plane, const torch::Tensor& vA,
+                          const torch::Tensor& vB, const torch::Tensor& hs, const torch::Tensor& hn, const torch::Tensor& hqe,
+                          long N, torch::Tensor& lb, torch::Tensor& ecnt, torch::Tensor& ebuf, int ecap) {
+  const long n8 = N / 8, per_cta = (long)WARPS * NT;
+  const int grid = (n8 + per_cta - 1) / per_cta;
+  const int smem = STAGES * MT * 16 * 16 * 16;
+  auto k = screen_kernel<MT, NT, WARPS, STAGES, true>;
+  static bool init = false;  // set before graph capture (the load-time self-test calls every MT)
+  if (!init) { cudaFuncSetAttribute(k, cudaFuncAttributeMaxDynamicSharedMemorySize, smem); init = true; }
+  k<<<grid, WARPS * 32, smem, cur()>>>((const int8_t*)hq.data_ptr(), M, K, (const uint8_t*)plane.data_ptr(),
+                                       vA.data_ptr<float>(), vB.data_ptr<float>(), hs.data_ptr<float>(), hn.data_ptr<float>(),
+                                       hqe.data_ptr<float>(), N, (unsigned*)lb.data_ptr(), ecnt.data_ptr<int>(),
+                                       (int2*)ebuf.data_ptr(), ecap);
+}
+void screen(torch::Tensor hq, int64_t M, torch::Tensor plane, torch::Tensor vA, torch::Tensor vB, torch::Tensor hs,
+            torch::Tensor hn, torch::Tensor hqe, int64_t N, torch::Tensor lb, torch::Tensor ecnt, torch::Tensor ebuf, int64_t ecap) {
+  TORCH_CHECK(M >= 1 && M <= 64);
+  const long K = hq.size(1) / 2;  // hq [64][KC*256]
+  if (M > 48) launch_screen<4, 2, 4, 3>(hq, M, K, plane, vA, vB, hs, hn, hqe, N, lb, ecnt, ebuf, ecap);
+  else if (M > 32) launch_screen<3, 2, 4, 3>(hq, M, K, plane, vA, vB, hs, hn, hqe, N, lb, ecnt, ebuf, ecap);
+  else if (M > 16) launch_screen<2, 2, 4, 3>(hq, M, K, plane, vA, vB, hs, hn, hqe, N, lb, ecnt, ebuf, ecap);
+  else launch_screen<1, 2, 4, 3>(hq, M, K, plane, vA, vB, hs, hn, hqe, N, lb, ecnt, ebuf, ecap);
+}
+void finalize(int64_t M, torch::Tensor lb_all, int64_t tp, torch::Tensor ecnt, torch::Tensor ebuf, int64_t ecap,
+              torch::Tensor pair_cnt, torch::Tensor pairs, torch::Tensor src, torch::Tensor map, torch::Tensor kept,
+              torch::Tensor fallback, int64_t capr) {
+  finalize_kernel<<<M, 256, 0, cur()>>>(M, (const unsigned*)lb_all.data_ptr(), tp, ecnt.data_ptr<int>(),
+                                        (const int2*)ebuf.data_ptr(), ecap, pair_cnt.data_ptr<int>(), (int2*)pairs.data_ptr(),
+                                        src.data_ptr<int>(), pairs.size(0), map.data_ptr<int>(), kept.data_ptr<int>(),
+                                        fallback.data_ptr<int>(), capr);
+}
+void gather_rescore(torch::Tensor X, torch::Tensor pair_cnt, torch::Tensor pairs, torch::Tensor src, torch::Tensor map,
+                    int64_t Wh, torch::Tensor stage, torch::Tensor keys) {
+  const long K = X.size(1);
+  TORCH_CHECK((K / 128) % 4 == 0);
+  const int paircap = pairs.size(0), stagecap = stage.size(0);
+  gather_kernel<<<512, 256, 0, cur()>>>(pair_cnt.data_ptr<int>(), paircap, (const int2*)pairs.data_ptr(), src.data_ptr<int>(),
+                                        (const uint4*)Wh, K, (uint4*)stage.data_ptr(), stagecap);
+  unmap_kernel<<<16, 256, 0, cur()>>>(pair_cnt.data_ptr<int>(), paircap, (const int2*)pairs.data_ptr(), map.data_ptr<int>());
+  rescore_kernel<<<256, 128, 0, cur()>>>((const __nv_bfloat16*)X.data_ptr(), K, pair_cnt.data_ptr<int>(), paircap,
+                                         (const int2*)pairs.data_ptr(), src.data_ptr<int>(),
+                                         (const __nv_bfloat16*)stage.data_ptr(), stagecap, (const __nv_bfloat16*)Wh,
+                                         (unsigned long long*)keys.data_ptr());
+}
+// fallback rows (flagged in fb) get the exact max over the whole shard from W (host-mapped); then keys -> (vals, idx)
+void fallback_decode(torch::Tensor X, int64_t M, torch::Tensor fb, torch::Tensor kept, torch::Tensor rows, torch::Tensor nrows,
+                     torch::Tensor stats, int64_t W, int64_t N, torch::Tensor keys, torch::Tensor vals, torch::Tensor idx) {
+  fblist_kernel<<<1, 64, 0, cur()>>>(M, fb.data_ptr<int>(), kept.data_ptr<int>(), rows.data_ptr<int>(), nrows.data_ptr<int>(),
+                                     (long long*)stats.data_ptr());
+  // at most 64 rows: one pass; the kernel exits at once when no row is flagged
+  rawgemm_kernel<<<1024, 128, 0, cur()>>>((const __nv_bfloat16*)X.data_ptr(), X.size(1), rows.data_ptr<int>(),
+                                          nrows.data_ptr<int>(), 0, 0, (const __nv_bfloat16*)W, N, nullptr, 0,
+                                          (unsigned long long*)keys.data_ptr());
+  keys_decode_kernel<<<1, 64, 0, cur()>>>(M, (const unsigned long long*)keys.data_ptr(), vals.data_ptr<float>(),
+                                          idx.data_ptr<int>());
+}
+// exact full logits out[M][N] (bf16) of X against W (device or host-mapped), lmh_codec's per-element chain
+void full_logits(torch::Tensor X, int64_t W, int64_t N, torch::Tensor out) {
+  const int M = X.size(0);
+  TORCH_CHECK(X.is_contiguous() && out.is_contiguous() && out.size(1) == N);
+  for (int pass = 0; pass * 64 < M; pass++)
+    rawgemm_kernel<<<1024, 128, 0, cur()>>>((const __nv_bfloat16*)X.data_ptr(), X.size(1), nullptr, nullptr, M, pass,
+                                            (const __nv_bfloat16*)W, N, (__nv_bfloat16*)out.data_ptr(), N, nullptr);
+}
+int64_t host_dev_ptr(int64_t hptr) {
+  void* d = nullptr;
+  TORCH_CHECK(cudaHostGetDevicePointer(&d, (void*)hptr, 0) == cudaSuccess, "cudaHostGetDevicePointer");
+  return (int64_t)d;
+}
+void host_register(int64_t hptr, int64_t bytes) {
+  TORCH_CHECK(cudaHostRegister((void*)hptr, bytes, cudaHostRegisterMapped | cudaHostRegisterPortable) == cudaSuccess,
+              "cudaHostRegister");
+}
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.def("host_register", &host_register);
+  m.def("plane_verify", &plane_verify); m.def("hprep", &hprep); m.def("screen", &screen); m.def("finalize", &finalize);
+  m.def("gather_rescore", &gather_rescore); m.def("fallback_decode", &fallback_decode); m.def("full_logits", &full_logits);
+  m.def("host_dev_ptr", &host_dev_ptr);
+}
