     )
     return sampled, num_sampled
+
+
+@triton.jit
+def _greedy_ids_rejection_kernel(
+    # [num_reqs, num_speculative_steps + 1]
+    sampled_ptr,
+    sampled_stride,
+    # [num_reqs]
+    num_sampled_ptr,
+    # [num_logits] target argmax of every logits row
+    target_ids_ptr,
+    # [num_logits]
+    draft_sampled_ptr,
+    # [num_reqs + 1]
+    cu_num_logits_ptr,
+):
+    req_idx = tl.program_id(0)
+    start_idx = tl.load(cu_num_logits_ptr + req_idx).to(tl.int64)
+    end_idx = tl.load(cu_num_logits_ptr + req_idx + 1).to(tl.int64)
+    num_draft_tokens = end_idx - start_idx - 1
+    accepted_length = tl.zeros((), tl.int64)
+    verifying = True
+    for i in range(num_draft_tokens):
+        if verifying:
+            draft = tl.load(draft_sampled_ptr + start_idx + i + 1).to(tl.int64)
+            target = tl.load(target_ids_ptr + start_idx + i).to(tl.int64)
+            # -1 placeholder drafts are rejected.
+            accepted = (target == tl.maximum(0, draft)) & (draft >= 0)
+            # Accepted: sampled == draft == target; rejected: the target.
+            tl.store(sampled_ptr + req_idx * sampled_stride + i, target)
+            verifying = accepted
+            accepted_length += accepted
+    # Rejected position (correction) or bonus: the target argmax there.
+    final = tl.load(target_ids_ptr + start_idx + accepted_length).to(tl.int64)
+    tl.store(sampled_ptr + req_idx * sampled_stride + accepted_length, final)
+    tl.store(num_sampled_ptr + req_idx, (accepted_length + 1).to(tl.int32))
+
+
+def greedy_ids_rejection_sample(
+    target_ids: torch.Tensor,  # [num_logits]
+    draft_sampled: torch.Tensor,  # [num_logits]
+    cu_num_logits: torch.Tensor,  # [num_reqs + 1]
+    num_speculative_steps: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Greedy verification from precomputed target argmax ids.
+
+    Equivalent to ``rejection_sample`` when every request is greedy.
+    """
+    num_reqs = cu_num_logits.shape[0] - 1
+    sampled = draft_sampled.new_empty(
+        num_reqs, num_speculative_steps + 1, dtype=torch.int64
+    )
+    num_sampled = sampled.new_empty(num_reqs, dtype=torch.int32)
+    _greedy_ids_rejection_kernel[(num_reqs,)](
+        sampled,
+        sampled.stride(0),
+        num_sampled,
+        target_ids,
+        draft_sampled,
+        cu_num_logits,
+        num_warps=1,
+    )
+    return sampled, num_sampled
