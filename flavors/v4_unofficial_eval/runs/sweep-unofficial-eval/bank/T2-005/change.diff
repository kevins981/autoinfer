@@ -0,0 +1,83 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Prefetch the next GEMM's weights into L2 while a TP all-reduce runs.
+
+During a decode step's all-reduce (PCIe, ~60 us) HBM is mostly idle. A small
+streaming-load kernel on a side stream pulls the first part of the next linear
+layer's weight into L2, so the GEMM after the all-reduce reads it from L2.
+Pure scheduling: no value is changed. Enabled with VLLM_L2_PREFETCH_MB > 0
+(default 32 MB) and VLLM_L2_PREFETCH_CTAS (default 16); TP > 1 only.
+"""
+import os
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+_MB = float(os.environ.get("VLLM_L2_PREFETCH_MB", "32"))
+_CTAS = int(os.environ.get("VLLM_L2_PREFETCH_CTAS", "16"))
+_BLOCK = 4096
+
+_side_streams: dict[int, torch.cuda.Stream] = {}
+_sinks: dict[int, torch.Tensor] = {}
+_logged = False
+
+
+@triton.jit
+def _l2_prefetch_kernel(p, out, n_per, BLOCK: tl.constexpr):
+    pid = tl.program_id(0)
+    base = pid.to(tl.int64) * n_per
+    acc = tl.zeros([BLOCK], dtype=tl.int32)
+    for i in range(0, n_per, BLOCK):
+        acc += tl.load(p + base + i + tl.arange(0, BLOCK))
+    tl.store(out + pid * BLOCK + tl.arange(0, BLOCK), acc)
+
+
+def enabled() -> bool:
+    return _MB > 0 and _CTAS > 0
+
+
+def _weight_view(linear) -> torch.Tensor | None:
+    w = getattr(linear, "weight", None)
+    if w is None or not w.is_cuda or not w.is_contiguous():
+        return None
+    if w.dtype == torch.int32:
+        return w.view(-1)
+    if w.element_size() * w.numel() % 4:
+        return None
+    return w.view(torch.int32).view(-1)
+
+
+def start(linear):
+    """Fork a side stream and launch the prefetch; returns a join token."""
+    if linear is None or not enabled():
+        return None
+    w = _weight_view(linear)
+    if w is None:
+        return None
+    dev = w.device.index
+    cur = torch.cuda.current_stream()
+    side = _side_streams.get(dev)
+    if side is None:
+        side = _side_streams[dev] = torch.cuda.Stream(device=w.device)
+        _sinks[dev] = torch.empty(_CTAS * _BLOCK, dtype=torch.int32, device=w.device)
+    n = min(int(_MB * 1024 * 1024 / 4), w.numel())
+    per = ((n // _CTAS) // _BLOCK) * _BLOCK
+    if per <= 0:
+        return None
+    global _logged
+    if not _logged:
+        _logged = True
+        from vllm.logger import init_logger
+
+        init_logger(__name__).info(
+            "L2 prefetch during TP all-reduce: %.0f MB, %d CTAs", _MB, _CTAS
+        )
+    side.wait_stream(cur)
+    with torch.cuda.stream(side):
+        _l2_prefetch_kernel[(_CTAS,)](w, _sinks[dev], per, BLOCK=_BLOCK, num_warps=8)
+    return side
+
+
+def join(token) -> None:
+    if token is not None:
+        torch.cuda.current_stream().wait_stream(token)
