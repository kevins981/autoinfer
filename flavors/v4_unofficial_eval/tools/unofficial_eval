#!/usr/bin/env python3
"""unofficial_eval: measure the speed of some code at low GPU cost (unofficial numbers).

Usage:
  unofficial_eval <record id> [--gsm8k] [--long] [--stop-below TOK_S] [--timeout MIN]
      a bank record (its change.diff + serve_args.txt, in a fresh workspace)
  unofficial_eval --ws <workspace> --label L [--args FILE] [--env K=V]... [same options]
      a workspace as it is now (build it first if you changed compiled code), with optional
      extra serve args (a file, like serve_args.txt) and environment variables
  e.g. unofficial_eval T1-004 --stop-below 640
       unofficial_eval --ws t1-w1 --env MY_CHANGE=1 --label t1-my-change-on

2 fresh inference-server starts of the code, each the task's eval harness (harness/eval.sh, as
the official eval) with 200 prompts instead of 400. --gsm8k / --long add the GSM8K-250 and
128K-request checks. --stop-below: skip the second start if the first is below this tok/s (one
start can be an outlier). It only measures: compare with other codes' numbers yourself (a
record's are in bank/<id>/unofficial/; a workspace label's in unofficial/ws/<label>/).

Output: tok/s of each start, p99 TTFT/TPOT (and BASE's official ones), MTP acceptance and the
checks run, in unofficial.json (record: bank/<id>/unofficial/<n>/, plus a line in record.md;
workspace: unofficial/ws/<label>/<n>/) and one line in unofficial/log.md.
Exit codes: 0 = measured; 1 = failed (recorded); 2 = bad arguments; 75/76 as for `gpu run`
(nothing run, nothing recorded).
"""
import argparse, json, os, shlex, statistics as st, subprocess, sys
from datetime import datetime, timezone
from pathlib import Path

TOOLS = Path(__file__).resolve().parent
ROOT = TOOLS.parents[2]
PROMPTS = 200
MIN_PER_START = 3.0    # GPU-minutes per start, for the default timeout


def die(msg, code=1):
    print(f"unofficial_eval: {msg}", file=sys.stderr)
    sys.exit(code)


def now():
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def task_folder(run):
    t = run / "task"
    return t.resolve() if t.is_symlink() else ROOT / "tasks" / json.loads((run / "task_source.json").read_text())["task"]


def needs_build(diff_text):
    paths = [l.split(" b/", 1)[1] for l in diff_text.splitlines() if l.startswith("diff --git a/")]
    compiled = (".cu", ".cuh", ".cpp", ".cc", ".c", ".h", ".hpp", ".txt", ".cmake")
    return [p for p in paths if p.startswith(("csrc/", "cmake/")) or p == "CMakeLists.txt"
            or (p.endswith(compiled) and not p.startswith("vllm/"))]


def main():
    p = argparse.ArgumentParser(prog="unofficial_eval", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("record", nargs="?", help="bank record id")
    p.add_argument("--ws", help="measure this workspace as it is now (instead of a record)")
    p.add_argument("--label", help="with --ws: the name the results are saved under")
    p.add_argument("--args", help="with --ws: file of extra serve args (like serve_args.txt)")
    p.add_argument("--env", action="append", default=[], help="with --ws: K=V for the inference server")
    p.add_argument("--gsm8k", action="store_true", help="also run GSM8K-250")
    p.add_argument("--long", action="store_true", help="also run the 128K request")
    p.add_argument("--stop-below", type=float, default=0, help="skip the 2nd start if the 1st is below this tok/s")
    p.add_argument("--timeout", type=float, help="GPU job timeout, minutes (default: from the planned starts)")
    a = p.parse_args()
    if bool(a.record) == bool(a.ws):
        die("give a record id or --ws <workspace> (one of them)", 2)
    if a.record and (a.args or a.env or a.label):
        die("--args/--env/--label go with --ws (a record's code is its change.diff + serve_args.txt)", 2)
    if a.ws and not a.label:
        die("--ws needs --label (the name its results are saved under)", 2)
    bad = [e for e in a.env if "=" not in e]
    if bad:
        die(f"--env needs K=V: {bad}", 2)

    run = Path(os.environ.get("AUTOINFER_RUN") or die("AUTOINFER_RUN is not set")).resolve()
    harness = task_folder(run) / "harness"
    if a.record:
        rec = run / "bank" / a.record
        if not (rec / "change.diff").exists():
            die(f"{rec}/change.diff not found", 2)
        name, out_parent, args_file = a.record, rec / "unofficial", rec / "serve_args.txt"
    else:
        ws = run / "workspaces" / a.ws
        if not ws.exists():
            die(f"no workspace {ws}", 2)
        name, out_parent = a.label, run / "unofficial" / "ws" / a.label
        args_file = Path(a.args).resolve() if a.args else None
    out_parent.mkdir(parents=True, exist_ok=True)
    n = 1 + max([int(x.name) for x in out_parent.iterdir() if x.name.isdigit()], default=0)
    out = out_parent / str(n)
    res = {"name": name, "workspace": a.ws, "env": a.env, "n": n, "prompts": PROMPTS, "stop_below": a.stop_below,
           "requested_by": os.environ.get("AUTOINFER_AGENT", "human"), "team": os.environ.get("AUTOINFER_TEAM"),
           "started": now()}

    def record(line, code):
        res["ended"] = now()
        out.mkdir(parents=True, exist_ok=True)
        (out / "unofficial.json").write_text(json.dumps(res, indent=1) + "\n")
        if a.record:
            with open(rec / "record.md", "a") as f:
                f.write(f"\n{line}\n")
        (run / "unofficial").mkdir(exist_ok=True)
        with open(run / "unofficial" / "log.md", "a") as f:
            f.write(f"- {name}: {line} [{res['requested_by']}]\n")
        print(line)
        sys.exit(code)

    # prepare (CPU, not charged): a record gets a fresh workspace from its diff (+ build)
    if a.record:
        wsname = f"uo-{a.record}-{n}"
        log = []
        r = subprocess.run([str(TOOLS / "ws"), "create", wsname, "--from", a.record], capture_output=True, text=True)
        log.append(r.stdout + r.stderr)
        stage = "apply_diff" if r.returncode else None
        if not stage and needs_build((rec / "change.diff").read_text(errors="replace")):
            print(f"{a.record}: diff touches compiled code: building", flush=True)
            r = subprocess.run([str(TOOLS / "ws"), "build", wsname], capture_output=True, text=True)
            log.append(r.stdout + r.stderr)
            stage = "build" if r.returncode else None
        if stage:
            out.mkdir(parents=True, exist_ok=True)
            (out / "prepare.log").write_text("\n".join(log))
            res["failed_stage"] = stage
            record(f"unofficial #{n} ({now()[:16]}): FAILED at {stage} ({out.relative_to(run)}/)", 1)
        ws = run / "workspaces" / wsname

    checks = ",".join(["gsm8k"] * a.gsm8k + ["long"] * a.long) or "none"
    step = (f"env {' '.join(shlex.quote(e) for e in a.env)} TRIALS=2 PROMPTS={PROMPTS} GATES={checks} "
            f"STOP_BELOW={a.stop_below or 0} {shlex.quote(str(harness / 'eval.sh'))} {shlex.quote(str(ws))} "
            f"{shlex.quote(str(out / 'b'))}" + (f" {shlex.quote(str(args_file))}" if args_file and args_file.exists() else ""))
    timeout = a.timeout or round(MIN_PER_START * 2 + 2.0 * a.gsm8k + 1.5 * a.long + 4, 1)
    print(f"unofficial #{n} of {name}: 2 starts, {PROMPTS} prompts; queued on the GPUs", flush=True)
    out.mkdir(parents=True, exist_ok=True)
    r = subprocess.run([str(TOOLS / "gpu"), "run", "--timeout", str(timeout), "--label", f"unofficial:{name}",
                        "--", "bash", "-c", step], capture_output=True, text=True)
    if r.returncode in (75, 76):   # not admitted: nothing ran, leave nothing behind
        for f in sorted(out.rglob("*"), reverse=True):
            f.unlink() if f.is_file() else f.rmdir()
        out.rmdir()
        sys.stderr.write(r.stderr)
        die("the GPU job was not run; nothing recorded", r.returncode)
    (out / "gpu_job.log").write_text(r.stdout + r.stderr)

    d = out / "b"
    subprocess.run([sys.executable, str(harness / "summarize.py"), str(d)], capture_output=True)
    f = d / "results.json"
    bm = [t for t in json.loads(f.read_text()).get("trials", []) if t.get("output_throughput")] if f.exists() else []
    B = [m["output_throughput"] for m in bm]
    fs = d / "failed_stage"
    if fs.exists() or r.returncode != 0 or not B:
        stage = fs.read_text().strip() if fs.exists() else \
            ("timeout" if r.returncode == 124 else f"exit {r.returncode}" if r.returncode else "no results")
        res.update(tok_s=B, failed_stage=stage)
        record(f"unofficial #{n} ({now()[:16]}): FAILED at {stage} ({out.relative_to(run)}/)", 1)

    stopped = (d / "stopped_early").exists()
    acc = [m["mtp_acceptance_length"] for m in bm if m.get("mtp_acceptance_length")]
    lat = {k: round(st.mean(m[k] for m in bm), 1) for k in ("p99_ttft_ms", "p99_tpot_ms")}
    base = run / "bank" / "BASE" / "official" / "1" / "results.json"
    bj = json.loads(base.read_text()) if base.exists() else {}
    gsm = lr = None
    if a.gsm8k and not stopped:
        g = d / "gsm8k.json"
        gsm = json.loads(g.read_text())["accuracy"] if g.exists() else None
    if a.long and not stopped:
        g = d / "long_request.json"
        lr = bool(json.loads(g.read_text()).get("pass")) if g.exists() else False
    res.update(tok_s=B, mean=round(st.mean(B), 2), stopped_early=stopped, gsm8k=gsm, long_request=lr, p99=lat,
               base_official_p99={k: bj.get(k) for k in lat}, mtp_acceptance=acc)
    extra = []
    if stopped:
        extra.append(f"stopped after 1 start (below {a.stop_below:g})" + ("; GSM8K/128K not run" if a.gsm8k or a.long else ""))
    if a.gsm8k and not stopped:
        extra.append(f"GSM8K {100 * gsm:.1f}%" if gsm is not None else "GSM8K failed to run")
    if lr is not None:
        extra.append(f"128K {'pass' if lr else 'FAIL'}")
    extra.append(f"p99 TTFT {lat['p99_ttft_ms']:.0f} ms / TPOT {lat['p99_tpot_ms']:.1f} ms"
                 + (f" (BASE official {bj['p99_ttft_ms']:.0f} / {bj['p99_tpot_ms']:.1f})" if bj else ""))
    if acc:
        extra.append(f"MTP acceptance {st.mean(acc):.3f}")
    record(f"unofficial #{n} ({now()[:16]}): {' / '.join(f'{x:.1f}' for x in B)} tok/s ({PROMPTS} prompts"
           f"{', env ' + ' '.join(a.env) if a.env else ''}); {', '.join(extra)} ({out.relative_to(run)}/unofficial.json)", 0)


if __name__ == "__main__":
    main()
