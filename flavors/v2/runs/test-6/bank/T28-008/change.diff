+}  // namespace
+
+void bs_gemm(torch::Tensor A, torch::Tensor B, torch::Tensor As, torch::Tensor Bs, torch::Tensor C, int64_t cfg,
+             int64_t split, torch::Tensor ws, torch::Tensor cnt) {
+  TORCH_CHECK(A.is_cuda() && A.element_size() == 1 && B.element_size() == 1, "fp8 inputs");
+  TORCH_CHECK(A.stride(1) == 1 && B.stride(1) == 1 && C.stride(1) == 1, "K-contiguous A/B, row-major C");
+  TORCH_CHECK(As.stride(1) == 1 && Bs.stride(1) == 1, "scales contiguous along K-blocks");
+  TORCH_CHECK(A.size(1) % 128 == 0 && A.size(1) == B.size(1), "K");
+  TORCH_CHECK(B.size(0) == C.size(1), "N");
+  TORCH_CHECK(C.scalar_type() == at::kBFloat16, "bf16 out");
+  const at::cuda::OptionalCUDAGuard guard(A.device());
+  cudaStream_t st = at::cuda::getCurrentCUDAStream();
+  float* wsp = split > 1 ? ws.data_ptr<float>() : nullptr;
+  int* cp = split > 1 ? cnt.data_ptr<int>() : nullptr;
+  if (split > 1) {
+    TORCH_CHECK(ws.numel() >= split * A.size(0) * B.size(0), "workspace too small");
+  }
+  switch (cfg) {
+#define X(id, a, b, c, d, e, f) \
+  case id: launch<a, b, c, d, e, f, false>(A, B, As, Bs, C, (int)split, wsp, cp, st); break;
+    CFG_LIST(X)
+#undef X
+    default: TORCH_CHECK(false, "bad cfg");
+  }
+}
