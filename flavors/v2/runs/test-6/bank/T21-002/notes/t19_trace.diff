diff --git a/vllm/v1/engine/t19_trace.py b/vllm/v1/engine/t19_trace.py
new file mode 100644
index 0000000000..67b8367493
--- /dev/null
+++ b/vllm/v1/engine/t19_trace.py
@@ -0,0 +1,103 @@
+"""T19 step/request tracing (measurement only). Off unless T19_TRACE=<path> is set.
+Writes <path>.<proc>.jsonl (proc = core | fe), one JSON object per line."""
+import json
+import os
+import threading
+import time
+
+_PATH = os.environ.get("T19_TRACE", "")
+ON = bool(_PATH)
+
+_f = None
+_lock = threading.Lock()
+_proc = None
+
+
+def _open(proc):
+    global _f, _proc
+    if _f is None:
+        _proc = proc
+        _f = open(f"{_PATH}.{proc}.jsonl", "a", buffering=1 << 16)
+        _f.write(json.dumps({"e": "hdr", "proc": proc, "pid": os.getpid(),
+                             "wall": time.time_ns(), "perf": time.perf_counter_ns()}) + "\n")
+
+        def _flusher():
+            while True:
+                time.sleep(1.0)
+                with _lock:
+                    _f.flush()
+
+        threading.Thread(target=_flusher, daemon=True).start()
+
+
+def emit(proc, **kw):
+    if _f is None:
+        _open(proc)
+    line = json.dumps(kw, separators=(",", ":")) + "\n"
+    with _lock:
+        _f.write(line)
+
+
+# ---- engine-core side helpers ----
+class CoreState:
+    def __init__(self):
+        self.step = 0
+        self.inflight = {}      # id(scheduler_output) -> (step idx, t_sched info)
+        self.seen_first = set()
+
+
+def now():
+    return time.perf_counter_ns(), time.time_ns()
+
+
+def core_step_record(st, so, sched, qdepth, t0, t1, t2):
+    """t0=before schedule, t1=schedule done, t2=execute submitted (each (perf, wall))."""
+    idx = st.step
+    st.step += 1
+    st.inflight[id(so)] = idx
+    nst = so.num_scheduled_tokens
+    pre = []
+    for nr in so.scheduled_new_reqs:
+        pre.append([nr.req_id, nst.get(nr.req_id, 0), "N"])
+    cr = so.scheduled_cached_reqs
+    ndec = 0
+    try:
+        reqs = sched.requests
+        for i, rid in enumerate(cr.req_ids):
+            r = reqs.get(rid)
+            if r is not None and cr.num_computed_tokens[i] < r.num_prompt_tokens:
+                pre.append([rid, nst.get(rid, 0), "C"])
+            else:
+                ndec += 1
+    except Exception:
+        ndec = len(cr.req_ids)
+    emit("core", e="step", i=idx, p0=t0[0], w0=t0[1], p1=t1[0], w1=t1[1], p2=t2[0], w2=t2[1],
+         nreq=len(nst), ndec=ndec, npre=len(pre), pre=pre, ntok=so.total_num_scheduled_tokens,
+         q=qdepth)
+
+
+def core_out_record(st, so, outs, t_wait, t_recv, t_proc):
+    idx = st.inflight.pop(id(so), -1)
+    first, fin = [], []
+    if outs:
+        for eco in outs.values():
+            for o in eco.outputs:
+                rid = o.request_id
+                if rid not in st.seen_first and o.new_token_ids:
+                    st.seen_first.add(rid)
+                    first.append(rid)
+                if o.finish_reason is not None:
+                    st.seen_first.discard(rid)
+                    fin.append(rid)
+    emit("core", e="out", i=idx, pw=t_wait[0], ww=t_wait[1], pr=t_recv[0], wr=t_recv[1],
+         pp=t_proc[0], wp=t_proc[1], first=first, fin=fin)
+
+
+def core_add(request):
+    p, w = now()
+    emit("core", e="add", p=p, w=w, rid=request.request_id, np=request.num_prompt_tokens)
+
+
+# ---- frontend side ----
+def fe(ev, rid, **kw):
+    emit("fe", e=ev, rid=rid, w=time.time_ns(), **kw)
