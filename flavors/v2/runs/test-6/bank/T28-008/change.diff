index 0000000000..711cec09cb
--- /dev/null
+++ b/vllm/model_executor/layers/quantization/utils/t29_marlin_w8a8.py.orig
@@ -0,0 +1,224 @@
+# SPDX-License-Identifier: Apache-2.0
+"""T29_W8A8=2: W8A8 on the champion's Marlin-repacked FP8 weights, for M > 96 only.
+
+Weights stay exactly as the champion's Marlin layout (prepare_fp8_layer_for_marlin); each FP8
+block linear keeps an fp32 copy of weight_scale_inv [N/128, K/128] (taken before Marlin consumes
+it). Per call (inside one opaque custom op, so the dispatch is fixed per captured size and
+torch.compile never guards on M):
+  M <= T29_W8A8_MAX_MARLIN_M (96): the champion's Marlin call, same op and arguments (bitwise);
+  M >  96: quant_perm (dynamic per-token-group-128 e4m3, columns permuted by PI) +
+           bs_gemm_marlin (e4m3 MMA within each 128-K block, fp32 scale-and-accumulate across
+           blocks), leader-29.w2's kernel (agents/leader-29.w2/gemm/PI_SPEC.md). No split-K.
+"""
+
+import hashlib
+import os
+
+import torch
+
+from vllm.logger import init_logger
+from vllm.model_executor.layers.quantization.utils import t28_e4m3 as _t28
+from vllm.triton_utils import tl, triton
+from vllm.utils.torch_utils import direct_register_custom_op
+
+logger = init_logger(__name__)
+
+T29_MODE = os.environ.get("T29_W8A8", "2")
+ENABLED = T29_MODE == "2"
+MAX_MARLIN_M = int(os.environ.get("T29_W8A8_MAX_MARLIN_M", "96"))
+_D = os.path.join(os.path.dirname(os.path.abspath(__file__)), "t29_bs_gemm")
+
+# best split-1 (mcfg_id, 1) per "NxK" and measured M (GPU0 cold; agents/leader-29.w2/gemm/sweep2.json),
+# in t29_bs_gemm/configs.json. Split-K dropped: only down@M<=128 preferred split 3 (-10 us), and
+# concurrent token-split chunks would share its workspace. Entry for the smallest measured M >=
+# actual M; above the largest, the largest.
+def _load_table():
+    import json
+
+    p = os.path.join(_D, "configs.json")
+    t = json.load(open(p))
+    return {k: {int(m): v[0] for m, v in d.items()} for k, d in t.items()}
+
+
+_TABLE = _load_table()
+
+
+def pick(N: int, K: int, M: int) -> int:
+    d = _TABLE.get(f"{N}x{K}")
+    if not d:
+        return 7
+    for m in sorted(d):
+        if M <= m:
+            return d[m]
+    return d[max(d)]
+
+
+_ext = None
+
+
+def ext():
+    global _ext
+    if _ext is None:
+        from torch.utils.cpp_extension import load
+
+        code = open(os.path.join(_D, "bs_gemm.cu"), "rb").read()
+        h = hashlib.sha1(code).hexdigest()[:10]
+        root = os.environ.get("TORCH_EXTENSIONS_DIR") or os.path.join(_D, "build")
+        bd = os.path.join(root, f"t29_bs_gemm_{h}")
+        os.makedirs(bd, exist_ok=True)
+        # build from a copy at a path fixed by the content hash, so any copy of this workspace
+        # (e.g. the official eval's) reuses the prebuilt library instead of rebuilding.
+        src = os.path.join(bd, "bs_gemm.cu")
+        if not os.path.exists(src) or open(src, "rb").read() != code:
+            tmp = f"{src}.{os.getpid()}"
+            with open(tmp, "wb") as f:
+                f.write(code)
+            os.replace(tmp, src)
+        os.environ.setdefault("TORCH_CUDA_ARCH_LIST", "8.9")
+        _ext = load(f"t29_bs_gemm_{h}", [src], build_directory=bd, verbose=False,
+                    extra_cuda_cflags=["-O3", "-lineinfo", "--expt-relaxed-constexpr", "-std=c++20"])
+    return _ext
+
+
+@triton.jit
+def _quant_perm_kernel(X, Q, S, K, stride_x, stride_q, stride_s, G: tl.constexpr):
+    # (leader-29.w2's kernel) one program = one row x G groups of 128.
+    # Q[:, blk*32+s] = quant(X[:, blk*32+PI[s]]), PI[s] = 16a+8b+2t+c for s = 16a+4t+2c+b
+    row = tl.program_id(0)
+    g0 = tl.program_id(1) * G
+    s = tl.arange(0, 128)
+    r = s % 32
+    pi = (s - r) + 16 * (r // 16) + 8 * (r % 2) + 2 * ((r % 16) // 4) + (r % 4) // 2
+    gi = tl.arange(0, G)
+    cols_in = (g0 + gi)[:, None] * 128 + pi[None, :]
+    cols_out = (g0 + gi)[:, None] * 128 + s[None, :]
+    x = tl.load(X + row * stride_x + cols_in).to(tl.float32)
+    amax = tl.maximum(tl.max(tl.abs(x), axis=1), 1e-10)
+    sc = tl.math.div_rn(amax, tl.full(amax.shape, 448.0, tl.float32))
+    inv = tl.math.div_rn(tl.full(sc.shape, 1.0, tl.float32), sc)
+    q = tl.clamp(x * inv[:, None], -448.0, 448.0)
+    # round to the e4m3 grid in fp32 (RNE) first: Triton's fp32->e4m3 goes via f16 on sm_89
+    e = ((q.to(tl.int32, bitcast=True) >> 23) & 0xFF) - 127
+    e = tl.maximum(e, -6)
+    quantum = ((e - 3 + 127) << 23).to(tl.float32, bitcast=True)
+    inv_quantum = ((127 - (e - 3)) << 23).to(tl.float32, bitcast=True)
+    q = tl.extra.cuda.libdevice.rint(q * inv_quantum) * quantum
+    q = q.to(Q.dtype.element_ty)
+    tl.store(Q + row * stride_q + cols_out, q)
+    tl.store(S + row * stride_s + g0 + gi, sc)
+
+
+def quant_perm(x: torch.Tensor, G: int = 4):
+    M, K = x.shape
+    assert x.stride(1) == 1 and K % 128 == 0
+    if K % (128 * G):
+        G = 1
+    q = torch.empty(M, K, device=x.device, dtype=torch.float8_e4m3fn)
+    s = torch.empty(M, K // 128, device=x.device, dtype=torch.float32)
+    _quant_perm_kernel[(M, K // 128 // G)](x, q, s, K, x.stride(0), q.stride(0), s.stride(0),
+                                            G=G, num_warps=4)
+    return q, s
+
+
+_dummy = {}
+
+
+def _dummies(dev):
+    d = _dummy.get(dev)
+    if d is None:
+        d = (torch.empty(1, device=dev, dtype=torch.float32),
+             torch.zeros(64, device=dev, dtype=torch.int32))
+        _dummy[dev] = d
+    return d
+
+
+def w8a8_marlin(x: torch.Tensor, qweight: torch.Tensor, w_scales_f32: torch.Tensor,
+                N: int, K: int) -> torch.Tensor:
+    xq, xs = quant_perm(x)
+    out = torch.empty(x.shape[0], N, device=x.device, dtype=torch.bfloat16)
+    ws, cnt = _dummies(x.device)
+    ext().bs_gemm_marlin(xq, qweight, xs, w_scales_f32, out, pick(N, K, x.shape[0]), 1, ws, cnt)
+    return out
+
+
+def _t29_marlin_fp8_linear(
+    a: torch.Tensor,
+    b_q_weight: torch.Tensor,
+    b_scales: torch.Tensor,
+    w_scales_f32: torch.Tensor,
+    size_n: int,
+    size_k: int,
+    use_atomic_add: bool,
+    use_fp32_reduce: bool,
+    use_e4m3: bool = False,
+) -> torch.Tensor:
+    M = a.shape[0]
+    if M > MAX_MARLIN_M:
+        return w8a8_marlin(a, b_q_weight, w_scales_f32, size_n, size_k)
+    if use_e4m3 and M <= _t28.MAX_M and a.dtype == torch.bfloat16:
+        # T28 Marlin-e4m3 (decode shapes): FP8 activations x the Marlin-repacked FP8 weights, e4m3 MMA, fp32 block scales
+        xq, xs = quant_perm(a)
+        return _t28.gemm(xq, xs, b_q_weight, w_scales_f32, size_n, size_k)
+    # the champion's call, unchanged (apply_fp8_marlin_linear)
+    from vllm.scalar_type import scalar_types
+
+    return torch.ops.vllm.marlin_gemm(
+        a=a, b_q_weight=b_q_weight, b_bias=None, b_scales=b_scales, global_scale=None,
+        b_zeros=None, workspace=None, b_q_type_id=scalar_types.float8_e4m3fn.id, size_m=M,
+        size_n=size_n, size_k=size_k, use_atomic_add=use_atomic_add,
+        use_fp32_reduce=use_fp32_reduce)
+
+
+def _t29_marlin_fp8_linear_fake(a, b_q_weight, b_scales, w_scales_f32, size_n, size_k,
+                                use_atomic_add, use_fp32_reduce, use_e4m3=False):
+    return torch.empty((a.shape[0], size_n), device=a.device, dtype=a.dtype)
+
+
+direct_register_custom_op("t29_marlin_fp8_linear", _t29_marlin_fp8_linear,
+                          fake_impl=_t29_marlin_fp8_linear_fake)
+
+_warmed: set = set()
+
+
+def prepare_layer(layer: torch.nn.Module, weight_scale: torch.Tensor) -> None:
+    """Before the Marlin repack: keep an fp32 copy of the [N/128, K/128] block scales."""
+    N, K = layer.output_size_per_partition, layer.input_size_per_partition
+    if N % 128 or K % 128 or tuple(weight_scale.shape) != (N // 128, K // 128):
+        layer.t29_ws_f32 = None
+        logger.warning("T29_W8A8=2: layer %dx%d not eligible (scales %s); stays Marlin",
+                       N, K, tuple(weight_scale.shape))
+        return
+    layer.t29_ws_f32 = weight_scale.detach().float().contiguous().clone()
+
+
+def warmup_layer(layer: torch.nn.Module) -> None:
+    """After the repack: build/load the extension, check the layout, compile quant_perm per K and
+    run the GEMM once per table config, so no JIT happens while serving."""
+    ws = getattr(layer, "t29_ws_f32", None)
+    if ws is None:
+        return
+    N, K = layer.output_size_per_partition, layer.input_size_per_partition
+    qw = layer.weight
+    if qw.numel() * qw.element_size() != N * K:
+        layer.t29_ws_f32 = None
+        logger.warning("T29_W8A8=2: Marlin qweight %dx%d padded; stays Marlin", N, K)
+        return
+    key = (N, K)
+    if key in _warmed:
+        return
+    _warmed.add(key)
+    ms = sorted({MAX_MARLIN_M + 1, *(m for m in _TABLE.get(f"{N}x{K}", {})), 2048})
+    for m in ms:
+        x = torch.zeros(m, K, device=qw.device, dtype=torch.bfloat16)
+        w8a8_marlin(x, qw, ws, N, K)
+    if getattr(layer, "t28_e4m3", False):
+        # T28 Marlin-e4m3 for M <= _t28.MAX_M: touch every M-class once (attribute setup, buffers) before graph capture
+        for m in (1, 16, 32, 48, 64, 80, 96):
+            if m <= _t28.MAX_M:
+                x = torch.zeros(m, K, device=qw.device, dtype=torch.bfloat16)
+                xq, xs = quant_perm(x)
+                _t28.gemm(xq, xs, qw, ws, N, K)
+        logger.info_once("T28_E4M3=1: Marlin-e4m3 (e4m3 MMA on the Marlin layout) for M <= %d", _t28.MAX_M, scope="global")
+    torch.accelerator.synchronize()
+    logger.info_once("T29_W8A8=2: Marlin-layout W8A8 for M > %d (warmed %s)", MAX_MARLIN_M, key,
+                     scope="global")
diff --git a/vllm/model_executor/layers/t27_screen.py b/vllm/model_executor/layers/t27_screen.py
new file mode 100644
index 0000000000..cbde502d72
--- /dev/null
+++ b/vllm/model_executor/layers/t27_screen.py
@@ -0,0 +1,188 @@
+"""AutoInfer T27: screened draft lm_head (draft side only; the target verifies with its full head).
+
+Per TP rank, for each draft row h (bf16, D=5120):
+  1. a = h @ P                      (P [D, R] bf16, PCA of the drafter's hidden states, train split only)
+  2. s = a @ U^T * us               (U [V_local, R] fp8 e4m3 with per-row scale us; U = dequant(W_local) @ P)
+  3. top-64 of s per row            (per-chunk bisection top-64, then a merge over the chunk candidates)
+  4. exact logits of the 64 candidates from the champion's FP8 draft head
+     (dynamic per-token activation quant, per-row weight scale, fp32 accumulate, bf16 rounding)
+  5. local (max, argmax) over the 64 -> the champion's existing all-gather.
+Switch: T27_SCREEN (default 1; 0 = champion path). T27_SCREEN_PCA = path of the PCA file.
+"""
+import os
+
+import torch
+
+from vllm.logger import init_logger
+from vllm.triton_utils import tl, triton
+
+logger = init_logger(__name__)
+
+KSEL = 64
+CH = 16  # chunks per row
+MAX_ROWS = 64
+
+
+def enabled() -> bool:
+    return os.environ.get("T27_SCREEN", "1") != "0"
+
+
+@triton.jit
+def _scores_kernel(a_ptr, u_ptr, us_ptr, s_ptr, M, V,
+                   K: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):
+    pid_n = tl.program_id(0)
+    pid_m = tl.program_id(1)
+    rm = pid_m * BM + tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    acc = tl.zeros([BN, BM], dtype=tl.float32)
+    for k0 in range(0, K, BK):
+        rk = k0 + tl.arange(0, BK)
+        u = tl.load(u_ptr + rn[:, None] * K + rk[None, :])  # [BN, BK] fp8
+        a = tl.load(a_ptr + rm[None, :] * K + rk[:, None], mask=rm[None, :] < M, other=0.0)  # [BK, BM]
+        acc += tl.dot(u.to(tl.bfloat16), a)
+    us = tl.load(us_ptr + rn)
+    acc = acc * us[:, None]
+    tl.store(s_ptr + rm[None, :] * V + rn[:, None], acc, mask=rm[None, :] < M)
+
+
+@triton.jit
+def _key(x):
+    bits = x.to(tl.int32, bitcast=True)
+    return tl.where(bits >= 0, bits, bits ^ 0x7FFFFFFF)
+
+
+@triton.jit
+def _chunk_topk_kernel(s_ptr, cv_ptr, ci_ptr, V, CHUNK: tl.constexpr, BLK: tl.constexpr,
+                       KS: tl.constexpr, NCH: tl.constexpr):
+    m = tl.program_id(0)
+    c = tl.program_id(1)
+    offs = tl.arange(0, BLK)
+    col = c * CHUNK + offs
+    valid = (offs < CHUNK) & (col < V)
+    x = tl.load(s_ptr + m * V + col, mask=valid, other=float("-inf"))
+    key = _key(x)
+    lo = tl.full([], -2147483648, tl.int64)
+    hi = tl.full([], 2147483647, tl.int64)
+    for _ in range(32):
+        mid = lo + (hi - lo + 1) // 2
+        cnt = tl.sum(((key.to(tl.int64) >= mid) & valid).to(tl.int32), axis=0)
+        ok = cnt >= KS
+        lo = tl.where(ok, mid, lo)
+        hi = tl.where(ok, hi, mid - 1)
+    sel = (key.to(tl.int64) >= lo) & valid
+    pos = tl.cumsum(sel.to(tl.int32), axis=0) - 1
+    keep = sel & (pos < KS)
+    base = (m * NCH + c) * KS
+    o64 = tl.arange(0, KS)
+    tl.store(cv_ptr + base + o64, tl.full([KS], float("-inf"), tl.float32))
+    tl.store(ci_ptr + base + o64, tl.zeros([KS], tl.int32))
+    tl.debug_barrier()
+    tl.store(cv_ptr + base + pos, x, mask=keep)
+    tl.store(ci_ptr + base + pos, col, mask=keep)
+
+
+@triton.jit
+def _merge_exact_kernel(cv_ptr, ci_ptr, sidx_ptr, xq_ptr, xs_ptr, w_ptr, ws_ptr,
+                        ov_ptr, oi_ptr, K: tl.constexpr, NCAND: tl.constexpr,
+                        KS: tl.constexpr, BK: tl.constexpr):
+    m = tl.program_id(0)
+    o = tl.arange(0, NCAND)
+    x = tl.load(cv_ptr + m * NCAND + o)
+    ci = tl.load(ci_ptr + m * NCAND + o)
+    key = _key(x)
+    lo = tl.full([], -2147483648, tl.int64)
+    hi = tl.full([], 2147483647, tl.int64)
+    for _ in range(32):
+        mid = lo + (hi - lo + 1) // 2
+        cnt = tl.sum((key.to(tl.int64) >= mid).to(tl.int32), axis=0)
+        ok = cnt >= KS
+        lo = tl.where(ok, mid, lo)
+        hi = tl.where(ok, hi, mid - 1)
+    sel = key.to(tl.int64) >= lo
+    pos = tl.cumsum(sel.to(tl.int32), axis=0) - 1
+    keep = sel & (pos < KS)
+    o64 = tl.arange(0, KS)
+    tl.store(sidx_ptr + m * KS + o64, tl.zeros([KS], tl.int32))
+    tl.debug_barrier()
+    tl.store(sidx_ptr + m * KS + pos, ci, mask=keep)
+    tl.debug_barrier()
+    idx = tl.load(sidx_ptr + m * KS + o64)  # [KS] candidate columns
+    acc = tl.zeros([KS], dtype=tl.float32)
+    for k0 in range(0, K, BK):
+        rk = k0 + tl.arange(0, BK)
+        w = tl.load(w_ptr + idx[:, None].to(tl.int64) * K + rk[None, :])  # [KS, BK] fp8
+        xv = tl.load(xq_ptr + m * K + rk)  # [BK] fp8
+        acc += tl.sum(w.to(tl.float32) * xv.to(tl.float32)[None, :], axis=1)
+    xs = tl.load(xs_ptr + m)
+    ws = tl.load(ws_ptr + idx)
+    logit = (acc * xs * ws).to(tl.bfloat16).to(tl.float32)
+    best = tl.max(logit, axis=0)
+    cand = tl.where(logit == best, idx, 2147483647)
+    bidx = tl.min(cand, axis=0)
+    tl.store(ov_ptr + m, best)
+    tl.store(oi_ptr + m, bidx)
+
+
+class Screen:
+    """Per-draft-head screening state. Built once after the draft head is quantized."""
+
+    def __init__(self, head, pca_path: str):
+        dev = head.weight.device
+        qm = head.quant_method
+        self.fp8_linear = qm.fp8_linear
+        W = head.weight.t()  # [V_local, K] view of the [N, K] row-major fp8 storage
+        assert W.dtype == torch.float8_e4m3fn and W.stride() == (W.shape[1], 1), (W.shape, W.stride())
+        self.W = W
+        self.ws = head.weight_scale.reshape(-1).float().contiguous()
+        self.V, self.D = W.shape
+        P = torch.load(pca_path, map_location="cpu")["Vh"].to(dev).to(torch.bfloat16).contiguous()
+        assert P.shape[0] == self.D, P.shape
+        self.R = P.shape[1]
+        self.P = P
+        self.U = torch.empty(self.V, self.R, dtype=torch.float8_e4m3fn, device=dev)
+        self.us = torch.empty(self.V, dtype=torch.float32, device=dev)
+        with torch.no_grad():
+            for c0 in range(0, self.V, 2048):
+                c1 = min(self.V, c0 + 2048)
+                wd = (W[c0:c1].float() * self.ws[c0:c1, None]).to(torch.bfloat16)
+                u = (wd @ P).float()
+                sc = (u.abs().amax(dim=1) / 448.0).clamp_min(1e-12)
+                self.us[c0:c1] = sc
+                self.U[c0:c1] = (u / sc[:, None]).to(torch.float8_e4m3fn)
