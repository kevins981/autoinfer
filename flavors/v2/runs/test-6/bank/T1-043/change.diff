+def all_reduce_prefetch(
+    tensor: torch.Tensor,
+    prefetch: torch.Tensor,
+    prefetch2: torch.Tensor | None,
+    group_name: str,
+) -> torch.Tensor:
+    assert group_name in _groups, f"Group {group_name} is not found."
+    group = _groups[group_name]()
+    if group is None:
+        raise ValueError(f"Group {group_name} is destroyed.")
+    return group._all_reduce_prefetch_out_place(tensor, prefetch, prefetch2)
+
+
+def all_reduce_prefetch_fake(
+    tensor: torch.Tensor,
+    prefetch: torch.Tensor,
+    prefetch2: torch.Tensor | None,
