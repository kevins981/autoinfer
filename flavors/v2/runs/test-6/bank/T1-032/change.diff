+def _qwen3_5_split_chain(
+    self: "Qwen3_5DecoderLayer",
+    x: torch.Tensor | QuantizedActivation,
+    residual: torch.Tensor,
+    out_proj: nn.Module,
+    split: tuple[int, int],
+    dma,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """out_proj -> AR -> add+norm -> MLP -> AR on two token chunks. Chunk 0 on
+    the current stream with the copy-engine AR, chunk 1 on an aux stream with
+    the regular (host-staged) AR; joined before returning. Returns the
+    all-reduced MLP output (sets output_reduced) and the updated residual."""
+    global _split_aux_stream
+    c0, c1 = split
+    num_tokens = c0 + c1
+    if not isinstance(x, torch.Tensor):
+        x, _ = out_proj(x)  # pre-quantized input: no row slicing; partial out
+        project = False
+    else:
+        project = True
+    gate_up = self.mlp.gate_up_proj
+    out = torch.empty(
+        (num_tokens, residual.shape[1]), dtype=residual.dtype, device=residual.device
+    )
+    if _split_aux_stream is None:
+        _split_aux_stream = torch.cuda.Stream(device=residual.device)
+    aux = _split_aux_stream
+    cur = torch.cuda.current_stream()
+
+    def chunk(a: int, b: int, use_dma: bool) -> None:
+        p = out_proj(x[a:b])[0] if project else x[a:b].contiguous()
+        if use_dma:
+            p = dma.all_reduce(p)
+        mlp_in, h, _ = self.post_attention_layernorm.forward_fused(
+            p, residual[a:b], gate_up, reduced=use_dma
+        )
+        d = self.mlp(h if mlp_in is None else mlp_in)
+        if use_dma:
+            dma.all_reduce(d, out[a:b])
+        else:
+            out[a:b].copy_(tensor_model_parallel_all_reduce(d))
+
+    check = _SPLIT_CHECK and not torch.cuda.is_current_stream_capturing()
+    if check:
+        res_in = residual.clone()
+        if project:
+            p0 = out_proj(x[:c0])[0]
+            ar_dma = dma.all_reduce(p0)
+            ar_host = tensor_model_parallel_all_reduce(p0)
+            ar_neq = (ar_dma.view(torch.int16) != ar_host.view(torch.int16)).sum().item()
