+
+        Returns the same ids as ``greedy_argmax`` over the gathered, vocab-cut
+        logits (first index on ties; padded / out-of-vocab columns excluded).
+        Each rank reduces its shard to (max, argmax); only these pairs are
+        gathered. Returns None if this head cannot be handled exactly.
+        """
+        from vllm.v1.worker.gpu.sample.greedy_argmax import (
+            greedy_argmax_with_value,
+        )
+
+        if (
+            self.scale != 1.0
+            or self.soft_cap is not None
+            or self.org_vocab_size >= 2**24
+            or self.logits_as_input
+            or not self.use_all_gather
+        ):
+            return None
+        logits = self._apply_head(lm_head, hidden_states, embedding_bias)
+        if logits.dtype not in (torch.bfloat16, torch.float32) or logits.ndim != 2:
+            return None
+        tp_size = lm_head.tp_size
+        si = lm_head.shard_indices
+        width = logits.shape[-1]
+        # The full path concatenates the shards and cuts at org_vocab_size, so
+        # shard r owns ids [r * width, (r + 1) * width). Anything else: fall back.
+        if si.num_org_vocab_padding != 0 or si.org_vocab_start_index != (
+            lm_head.tp_rank * width
+        ):
+            return None
+        num_valid = max(0, min(width, self.org_vocab_size - si.org_vocab_start_index))
+        vals, idx = greedy_argmax_with_value(logits, num_valid)
+        gidx = idx + si.org_vocab_start_index
+        if tp_size == 1:
+            return gidx.to(torch.int64)
+        pair = torch.stack([vals, gidx.float()], dim=-1)  # [rows, 2]
+        gathered = tensor_model_parallel_all_gather(pair, dim=-1)
+        gathered = gathered.view(hidden_states.shape[0], tp_size, 2)
+        # Strict '>' so the lowest rank (lowest ids) wins ties.
+        best_v = gathered[:, 0, 0]
+        best_i = gathered[:, 0, 1]
+        for r in range(1, tp_size):
+            take = gathered[:, r, 0] > best_v
+            best_v = torch.where(take, gathered[:, r, 0], best_v)
+            best_i = torch.where(take, gathered[:, r, 1], best_i)
+        return best_i.to(torch.int64)
+
     def get_top_k_tokens(
         self,
         lm_head: VocabParallelEmbedding,
