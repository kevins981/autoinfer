+    """Gemma RMSNorm of ``x (+ residual)`` quantized to dynamic per-token-group
+    e4m3 for the next linear (the checkpoint's W8A8 activation scheme).
+
+    Returns ``(q, scales, y)``: fp8 data (M, H), fp32 scales (M, H // group_size)
+    row-major, and the bf16 normed activation (or None). ``residual`` is updated
+    in place to x + residual, like gemma_fused_add_rmsnorm.
+    """
+    assert x.dim() == 2 and x.is_contiguous()
+    assert x.dtype in (torch.bfloat16, torch.float16)
+    assert residual is None or (residual.shape == x.shape and residual.is_contiguous())
+    M, H = x.shape
+    assert weight.shape == (H,) and weight.is_contiguous()
+    assert H % group_size == 0
+    q = torch.empty((M, H), dtype=FP8_DTYPE, device=x.device)
+    scales = torch.empty((M, H // group_size), dtype=torch.float32, device=x.device)
+    y = torch.empty_like(x) if write_y else None
+    if M == 0:
+        return q, scales, y
+    _gemma_add_rms_norm_dyn128_kernel[(M,)](
+        x,
+        residual if residual is not None else x,
+        weight,
+        q,
+        scales,
+        y if y is not None else x,
+        eps,
+        H=H,
+        GS=group_size,
+        HAS_RESIDUAL=residual is not None,
+        WRITE_Y=write_y,
+        num_warps=8,
+    )
+    return q, scales, y
