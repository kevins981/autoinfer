+// ---- Replay-mode support (single state write per step) -------------------
+// Rows of the previous step (L2-normalised k fp32, v bf16, decay, beta) are
+// cached as raw bytes inside the dead state page of window column 1.
+constexpr int kReplayMaxRows = 3;
+constexpr int kRowBytes = 784;  // 128*4 + 128*2 + 8 (+16B alignment pad)
+// Lazy commit (K=2): pending rows of up to two steps. Page A at the head's base
+// offset, page B at kPageB bytes; the 8 pad bytes after row 0's decay/beta hold,
+// in page B, the number of page-A rows accepted (int32 at kHeaderOff).
+constexpr int kReplayMaxTotal = 2 * kReplayMaxRows;
+constexpr int kPageB = 4096;
+constexpr int kHeaderOff = 776;
