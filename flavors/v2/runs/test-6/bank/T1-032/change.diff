+        if trace:
+            self._start_trace(trace)
+        logger.info("Host-staged all-reduce (no-P2P, 2 ranks) enabled")
+
+    def _start_trace(self, prefix: str):
+        """Test-only: stamp every call into a device ring; dump it to
+        <prefix>.rank<r>.npy once <prefix>.dump exists."""
+        import threading
+        import time
+
+        import numpy as np
+
+        self.mod.trace_enable(1 << 19)
+        rank = self.rank
+
+        def watch():
+            while not os.path.exists(prefix + ".dump"):
+                time.sleep(0.5)
+            np.save(f"{prefix}.rank{rank}.npy", self.mod.trace_dump().numpy())
+            logger.info("host AR trace dumped (rank %d)", rank)
+
+        threading.Thread(target=watch, daemon=True).start()
+        logger.warning("Host-staged AR TRACE enabled (test-only): %s", prefix)
+
+    def should_use(self, inp: torch.Tensor) -> bool:
+        if self.disabled or inp.dtype != torch.bfloat16 or not inp.is_cuda:
+            return False
+        nbytes = inp.numel() * inp.element_size()
+        return (
+            _MIN_BYTES <= nbytes <= _SLOT_BYTES
+            and nbytes % 16 == 0
+            and inp.is_contiguous()
+        )
+
+    def all_reduce(
+        self,
+        inp: torch.Tensor,
+        prefetch: torch.Tensor | None = None,
+        prefetch2: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        out = torch.empty_like(inp)
+        nbytes = inp.numel() * 2
+        grid, k = _config(nbytes)
+        mode = 20 if (_COMP and nbytes >= _COMP_MIN) else 4
+        if mode == 20 and not self._comp_logged:
+            self._comp_logged = True
+            logger.info("Host-staged AR: lossless payload compression on (first message %d B)", nbytes)
+        if (
+            prefetch is not None
+            and _L2PF
+            and _L2PF_BLOCKS > 0
+            and nbytes <= _L2PF_MSG_MAX
+            and prefetch.is_cuda
+            and prefetch.device == inp.device
+        ):
+            self.mod.allreduce_pf(
+                inp, out, grid, k, 512, mode, prefetch, _L2PF_MAX_BYTES, _L2PF_BLOCKS,
+                _L2PF_STEP,
+                prefetch2 if prefetch2 is not None and prefetch2.is_cuda else None,
+            )
+        else:
+            self.mod.allreduce(inp, out, grid, k, 512, mode)
+        return out
+
+    def should_use_all_gather(self, inp: torch.Tensor, dim: int) -> bool:
+        if self.disabled or not inp.is_cuda or not inp.is_contiguous():
+            return False
+        nbytes = inp.numel() * inp.element_size()
+        inner = 1
+        for s in inp.shape[dim:]:
+            inner *= s
+        return (
+            _MIN_BYTES <= nbytes <= _SLOT_BYTES
+            and nbytes % 16 == 0
+            and (inner * inp.element_size()) % 16 == 0
+        )
+
+    def all_gather(self, inp: torch.Tensor, dim: int) -> torch.Tensor:
+        """Exact copy-based all-gather of two shards along `dim` (dim >= 0)."""
+        shape = list(inp.shape)
+        inner = 1
+        for s in shape[dim:]:
+            inner *= s
+        shape[dim] *= 2
+        out = torch.empty(shape, dtype=inp.dtype, device=inp.device)
+        grid, k = _config(inp.numel() * inp.element_size())
+        self.mod.allgather(inp, out, grid, k, 512, inner * inp.element_size())
+        return out
