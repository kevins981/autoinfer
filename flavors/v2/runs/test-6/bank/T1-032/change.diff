diff --git a/vllm/distributed/device_communicators/dma_staged_ar.cu b/vllm/distributed/device_communicators/dma_staged_ar.cu
new file mode 100644
index 0000000000..4e97aee4da
--- /dev/null
+++ b/vllm/distributed/device_communicators/dma_staged_ar.cu
@@ -0,0 +1,90 @@
+// Copy-engine (DMA) 2-rank all-reduce through a shared pinned host buffer.
+// Per lane: D2H own partial -> host slot; doorbell (stream write); wait peer doorbell (stream wait);
+// H2D peer partial -> device tmp; add kernel out = bf16(float(x) + float(peer)) (same math as hostar).
+// Graph-capturable: only memcpy + stream mem-op + kernel nodes, all with constant values:
+//  F[r][l]: rank r's "data ready" flag (r writes 1, peer resets to 0 after observing)
+//  A[r][l]: rank r's "consumed peer's slot" ack (r writes 1, peer resets to 0 before reusing its slot)
+#include <torch/extension.h>
+#include <cuda.h>
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <sys/mman.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <string>
+#define NL 1
+#define FS 16   // ints per flag (64B)
+struct Ctx { char* hbase; char* dbase; size_t slot; int rank; bool init=false; void* tmp[NL]; size_t tmp_bytes; };
+static Ctx C;
+static size_t tot(size_t slot) { return 2 * (size_t)NL * slot + 4 * NL * FS * 4; }
+static char* slotp(int r, int l) { return C.hbase + ((size_t)(r * NL + l)) * C.slot; }
+static CUdeviceptr flagF(int r, int l) { return (CUdeviceptr)(C.dbase + 2 * NL * C.slot + ((size_t)(0 * 2 * NL + r * NL + l)) * FS * 4); }
+static CUdeviceptr flagA(int r, int l) { return (CUdeviceptr)(C.dbase + 2 * NL * C.slot + ((size_t)(1 * 2 * NL + r * NL + l)) * FS * 4); }
+#define CK(x) TORCH_CHECK((x) == CUDA_SUCCESS, #x)
+#define CKR(x) TORCH_CHECK((x) == cudaSuccess, #x)
+
+void dma_init(std::string path, int64_t slot, int64_t rank, bool create) {
+  size_t t = tot(slot);
+  int fd = open(path.c_str(), O_RDWR | (create ? O_CREAT : 0), 0600);
+  TORCH_CHECK(fd >= 0, "open");
+  if (create) TORCH_CHECK(ftruncate(fd, t) == 0, "ftruncate");
+  void* m = mmap(nullptr, t, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  TORCH_CHECK(m != MAP_FAILED, "mmap"); close(fd);
+  CKR(cudaHostRegister(m, t, cudaHostRegisterMapped | cudaHostRegisterPortable));
+  void* d; CKR(cudaHostGetDevicePointer(&d, m, 0));
+  C.hbase = (char*)m; C.dbase = (char*)d; C.slot = slot; C.rank = rank;
+  if (create) {  // A = 1 (slots free), F = 0
+    for (int r = 0; r < 2; r++) for (int l = 0; l < NL; l++) {
+      *(volatile int*)(C.hbase + 2 * NL * slot + ((size_t)(1 * 2 * NL + r * NL + l)) * FS * 4) = 1;
+      *(volatile int*)(C.hbase + 2 * NL * slot + ((size_t)(0 * 2 * NL + r * NL + l)) * FS * 4) = 0;
+    }
+  }
+  C.tmp_bytes = slot;
+  for (int l = 0; l < NL; l++) CKR(cudaMalloc(&C.tmp[l], slot));
+  C.init = true;
+}
+
+__global__ void add_kernel(const uint4* __restrict__ x, const uint4* __restrict__ y, uint4* __restrict__ o, long n) {
+  for (long i = blockIdx.x * (long)blockDim.x + threadIdx.x; i < n; i += (long)gridDim.x * blockDim.x) {
+    uint4 a = x[i], b = y[i], r;
+    uint32_t* pa = (uint32_t*)&a; uint32_t* pb = (uint32_t*)&b; uint32_t* pr = (uint32_t*)&r;
+#pragma unroll
+    for (int k = 0; k < 4; k++) {
+      __nv_bfloat162 u = *reinterpret_cast<__nv_bfloat162*>(&pa[k]), v = *reinterpret_cast<__nv_bfloat162*>(&pb[k]);
+      float2 fu = __bfloat1622float2(u), fv = __bfloat1622float2(v);
+      __nv_bfloat162 s = __floats2bfloat162_rn(fu.x + fv.x, fu.y + fv.y);
+      pr[k] = *reinterpret_cast<uint32_t*>(&s);
+    }
+    o[i] = r;
+  }
+}
+
+void dma_allreduce(torch::Tensor x, torch::Tensor out, int64_t lane) {
+  TORCH_CHECK(C.init && lane >= 0 && lane < NL && x.is_contiguous() && out.is_contiguous());
+  size_t bytes = x.numel() * 2;
+  TORCH_CHECK(bytes % 16 == 0 && bytes <= C.slot);
+  cudaStream_t s = at::cuda::getCurrentCUDAStream();
+  CUstream cs = (CUstream)s;
+  int me = C.rank, pr = 1 - C.rank;
+  // 1. peer has consumed my previous payload on this lane -> slot free; reset its ack
+  CK(cuStreamWaitValue32(cs, flagA(pr, lane), 1, CU_STREAM_WAIT_VALUE_EQ));
+  CK(cuStreamWriteValue32(cs, flagA(pr, lane), 0, CU_STREAM_WRITE_VALUE_DEFAULT));
+  // 2. D2H own partial
+  CKR(cudaMemcpyAsync(slotp(me, lane), x.data_ptr(), bytes, cudaMemcpyDeviceToHost, s));
+  // 3. doorbell
+  CK(cuStreamWriteValue32(cs, flagF(me, lane), 1, CU_STREAM_WRITE_VALUE_DEFAULT));
+  // 4. wait peer doorbell; reset it
+  CK(cuStreamWaitValue32(cs, flagF(pr, lane), 1, CU_STREAM_WAIT_VALUE_EQ));
+  CK(cuStreamWriteValue32(cs, flagF(pr, lane), 0, CU_STREAM_WRITE_VALUE_DEFAULT));
+  // 5. H2D peer partial
+  CKR(cudaMemcpyAsync(C.tmp[lane], slotp(pr, lane), bytes, cudaMemcpyHostToDevice, s));
+  // 6. ack: I consumed peer's slot
+  CK(cuStreamWriteValue32(cs, flagA(me, lane), 1, CU_STREAM_WRITE_VALUE_DEFAULT));
+  {
+    long n = bytes / 16;
+    int blocks = (int)std::min<long>((n + 255) / 256, 256);
+    add_kernel<<<blocks, 256, 0, s>>>((const uint4*)x.data_ptr(), (const uint4*)C.tmp[lane], (uint4*)out.data_ptr(), n);
+  }
+}
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("init", &dma_init); m.def("allreduce", &dma_allreduce); }
diff --git a/vllm/distributed/device_communicators/dma_staged_ar.py b/vllm/distributed/device_communicators/dma_staged_ar.py
new file mode 100644
index 0000000000..a65c16a0d6
--- /dev/null
+++ b/vllm/distributed/device_communicators/dma_staged_ar.py
@@ -0,0 +1,93 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Copy-engine (DMA) 2-rank all-reduce through shared pinned host memory.
+
+Same math as the host-staged AR (fp32 add of the two bf16 partials, rounded
+to bf16), but the transport is cudaMemcpyAsync (D2H own partial, H2D peer
+partial) with stream mem-op doorbells, so it uses no SMs and can run under a
+GEMM that occupies every SM. Graph-capturable (memcpy, mem-op and kernel
+nodes with constant values). It has its own host slots and flags; it never
+shares state with the host-staged AR. Calls on one lane must stay on one
+stream (they are ordered by it).
+"""
+
+import hashlib
+import os
+import uuid
+
+import torch
+import torch.distributed as dist
+from torch.distributed import ProcessGroup
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_SLOT_BYTES = 24 << 20
+_mod = None
+
+
+def _load_ext():
+    global _mod
+    if _mod is not None:
+        return _mod
+    from torch.utils.cpp_extension import load
+
+    if "TORCH_EXTENSIONS_DIR" not in os.environ:
+        os.environ["TORCH_EXTENSIONS_DIR"] = os.path.join(
+            envs.VLLM_CACHE_ROOT, "torch_extensions"
+        )
+    src = os.path.join(os.path.dirname(__file__), "dma_staged_ar.cu")
+    with open(src, "rb") as f:
+        tag = hashlib.sha1(f.read()).hexdigest()[:10]
+    name = f"vllm_dma_staged_ar_{tag}"
+    build_dir = os.path.join(os.environ["TORCH_EXTENSIONS_DIR"], name)
+    os.makedirs(build_dir, exist_ok=True)
+    major, minor = torch.cuda.get_device_capability()
+    os.environ.setdefault("TORCH_CUDA_ARCH_LIST", f"{major}.{minor}")
+    _mod = load(name, [src], build_directory=build_dir,
+                extra_ldflags=["-lcuda"], verbose=False)
+    return _mod
+
+
+class DmaStagedAllReduce:
+    _instance_made = False
+
+    def __init__(self, group: ProcessGroup, device: torch.device):
+        self.disabled = True
+        if DmaStagedAllReduce._instance_made:
+            return
+        self.world_size = dist.get_world_size(group=group)
+        self.rank = dist.get_rank(group=group)
+        if self.world_size != 2:
+            return
+        DmaStagedAllReduce._instance_made = True
+        torch.cuda.set_device(device)
+        mod = _load_ext()
+        name = [f"/dev/shm/vllm_dmaar_{os.getpid()}_{uuid.uuid4().hex}"]
+        dist.broadcast_object_list(name, src=dist.get_process_group_ranks(group)[0],
+                                   group=group)
+        path = name[0]
+        if self.rank == 0:
+            mod.init(path, _SLOT_BYTES, 0, True)
+        dist.barrier(group=group)
+        if self.rank == 1:
+            mod.init(path, _SLOT_BYTES, 1, False)
+        dist.barrier(group=group)
+        if self.rank == 0:
+            os.unlink(path)
+        self.mod = mod
+        self.disabled = False
+        logger.info("Copy-engine (DMA) all-reduce enabled (split prefill chains)")
+
+    def should_use(self, inp: torch.Tensor) -> bool:
+        if self.disabled or inp.dtype != torch.bfloat16 or not inp.is_cuda:
+            return False
+        nbytes = inp.numel() * 2
+        return 0 < nbytes <= _SLOT_BYTES and nbytes % 16 == 0 and inp.is_contiguous()
+
+    def all_reduce(self, inp: torch.Tensor, out: torch.Tensor | None = None) -> torch.Tensor:
+        if out is None:
+            out = torch.empty_like(inp)
+        self.mod.allreduce(inp, out, 0)
+        return out
diff --git a/vllm/distributed/device_communicators/host_staged_ar.cu b/vllm/distributed/device_communicators/host_staged_ar.cu
new file mode 100644
index 0000000000..17ab835a42
--- /dev/null
+++ b/vllm/distributed/device_communicators/host_staged_ar.cu
@@ -0,0 +1,403 @@
+#include <torch/extension.h>
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <sys/mman.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <string>
+
+#define MAXB 128
+#define MAXK 8
+#define FSTRIDE 16   // ints between flags (64B)
+
+static __device__ __forceinline__ uint4 ld_cv(const uint4* p) {
+  uint4 r;
+  asm volatile("ld.global.cv.v4.u32 {%0,%1,%2,%3}, [%4];" : "=r"(r.x),"=r"(r.y),"=r"(r.z),"=r"(r.w) : "l"(p) : "memory");
+  return r;
+}
+static __device__ __forceinline__ void st_cs(uint4* p, uint4 v) {
+  asm volatile("st.global.cs.v4.u32 [%0], {%1,%2,%3,%4};" :: "l"(p),"r"(v.x),"r"(v.y),"r"(v.z),"r"(v.w) : "memory");
+}
+static __device__ __forceinline__ int ld_vol(const int* p) {
+  int r; asm volatile("ld.volatile.global.s32 %0, [%1];" : "=r"(r) : "l"(p) : "memory"); return r;
+}
+static __device__ __forceinline__ uint32_t add_bf16x2(uint32_t a, uint32_t b) {
+  __nv_bfloat162 x = *reinterpret_cast<__nv_bfloat162*>(&a), y = *reinterpret_cast<__nv_bfloat162*>(&b);
+  float2 fx = __bfloat1622float2(x), fy = __bfloat1622float2(y);
+  __nv_bfloat162 r = __floats2bfloat162_rn(fx.x + fy.x, fx.y + fy.y);
+  return *reinterpret_cast<uint32_t*>(&r);
+}
+static __device__ __forceinline__ uint4 add4(uint4 a, uint4 b) {
+  return make_uint4(add_bf16x2(a.x,b.x), add_bf16x2(a.y,b.y), add_bf16x2(a.z,b.z), add_bf16x2(a.w,b.w));
+}
+
+
+// ---- Bitwise-lossless fixed-rate re-encoding of the bf16 payload (mode & 16) ----
+// Per 32 values (64 B raw, a "block"): a header byte = max exponent field; per value sign+7 mantissa
+// bits (1 B) and a 4-bit exponent offset (max - e; code 15 = exponent field 0, so zeros/denormals stay
+// exact). A block with any offset > 14 (non-zero exponent), or max exponent 255 (Inf/NaN), is sent
+// raw: header 0xFF, raw bytes 0-47 in the three planes, bytes 48-63 in an exception slot.
+// Blocks are grouped by 32 (one warp, one block per lane); each group has a 64 B header region:
+// 32 header bytes + CEX exception slots (16 B), filled in lane order of the group's raw blocks
+// (warp ballot), read speculatively with the headers so a raw block costs no dependent PCIe read.
+// A group with more than CEX raw blocks (0.008% on real payloads) puts the rest in a sparse
+// overflow array O[block] that only those blocks touch. Layout (16 B units) for nb blocks, ng
+// groups: A[nb] (sm bytes 0-15), B[nb] (sm 16-31), C[nb] (offset nibbles), GH[4 ng], O[nb].
+// Wire bytes: 1600 per 2048 raw (0.781) + 16 B per raw block beyond CEX in its group.
+#define CEX 2
+static __device__ __forceinline__ uint8_t ld_cv_u8(const uint8_t* p) {
+  unsigned short r; asm volatile("ld.global.cv.u8 %0, [%1];" : "=h"(r) : "l"(p) : "memory"); return (uint8_t)r;
+}
+static __device__ __forceinline__ void st_cs_u8(uint8_t* p, uint8_t v) {
+  asm volatile("st.global.cs.u8 [%0], %1;" :: "l"(p), "h"((unsigned short)v) : "memory");
+}
+static __device__ __forceinline__ void enc_block(uint4 r0, uint4 r1, uint4 r2, uint4 r3,
+                                                 uint4& a, uint4& b, uint4& c, uint8_t& h) {
+  const uint32_t w[16] = {r0.x, r0.y, r0.z, r0.w, r1.x, r1.y, r1.z, r1.w,
+                          r2.x, r2.y, r2.z, r2.w, r3.x, r3.y, r3.z, r3.w};
+  uint32_t sm[8], e[8], code[8];
+  uint32_t m = 0;
+#pragma unroll
+  for (int q = 0; q < 8; q++) {
+    uint32_t P0 = __byte_perm(w[2 * q], w[2 * q + 1], 0x6420);  // low bytes of values 4q..4q+3
+    uint32_t P1 = __byte_perm(w[2 * q], w[2 * q + 1], 0x7531);  // high bytes
+    sm[q] = (P1 & 0x80808080u) | (P0 & 0x7F7F7F7Fu);
+    e[q] = ((P1 << 1) & 0xFEFEFEFEu) | ((P0 >> 7) & 0x01010101u);
+    m = __vmaxu4(m, e[q]);
+  }
+  m = __vmaxu4(m, m >> 16); m = __vmaxu4(m, m >> 8);
+  const uint32_t mx = m & 0xFF, mb = mx * 0x01010101u;
+  uint32_t bad = (mx == 255u);
+#pragma unroll
+  for (int q = 0; q < 8; q++) {
+    uint32_t off = mb - e[q];                       // bytewise mb >= e: no borrows
+    uint32_t z = __vcmpeq4(e[q], 0u);               // 0xFF per zero-exponent byte
+    bad |= __vcmpgtu4(off, 0x0E0E0E0Eu) & ~z;
+    code[q] = (off & ~z) | (0x0F0F0F0Fu & z);
+  }
+  a = make_uint4(sm[0], sm[1], sm[2], sm[3]); b = make_uint4(sm[4], sm[5], sm[6], sm[7]);
+  c = make_uint4(code[0] | (code[1] << 4), code[2] | (code[3] << 4), code[4] | (code[5] << 4), code[6] | (code[7] << 4));
+  h = (uint8_t)mx;
+  if (bad) { a = r0; b = r1; c = r2; h = 0xFF; }
+}
+static __device__ __forceinline__ void dec_quad(uint32_t smw, uint32_t code, uint32_t mb, uint32_t& w0, uint32_t& w1) {
+  uint32_t z = __vcmpeq4(code, 0x0F0F0F0Fu);
+  uint32_t e = (mb - (code & ~z)) & ~z;             // offset <= max for valid encodings: no borrows
+  uint32_t P0 = (smw & 0x7F7F7F7Fu) | ((e << 7) & 0x80808080u);
+  uint32_t P1 = (smw & 0x80808080u) | ((e >> 1) & 0x7F7F7F7Fu);
+  w0 = __byte_perm(P0, P1, 0x5140); w1 = __byte_perm(P0, P1, 0x7362);
+}
+// decode a non-raw block into 4 uint4 (32 bf16 values, original order)
+static __device__ __forceinline__ void dec_block(uint4 a, uint4 b, uint4 c, uint32_t h,
+                                                 uint4& o0, uint4& o1, uint4& o2, uint4& o3) {
+  const uint32_t mb = h * 0x01010101u;
+  const uint32_t cw[4] = {c.x, c.y, c.z, c.w};
+  const uint32_t sw[8] = {a.x, a.y, a.z, a.w, b.x, b.y, b.z, b.w};
+  uint32_t w[16];
+#pragma unroll
+  for (int q = 0; q < 8; q++) {
+    uint32_t code = (cw[q >> 1] >> (4 * (q & 1))) & 0x0F0F0F0Fu;
+    dec_quad(sw[q], code, mb, w[2 * q], w[2 * q + 1]);
+  }
+  o0 = make_uint4(w[0], w[1], w[2], w[3]); o1 = make_uint4(w[4], w[5], w[6], w[7]);
+  o2 = make_uint4(w[8], w[9], w[10], w[11]); o3 = make_uint4(w[12], w[13], w[14], w[15]);
+}
+// compressed-slot layout helpers (all in 16 B units from the slot base)
+static __host__ __device__ __forceinline__ long comp_gh_off(long nb) { return 3 * nb; }
+static __host__ __device__ __forceinline__ long comp_o_off(long nb) { return 3 * nb + 4 * ((nb + 31) / 32); }
+static __host__ __device__ __forceinline__ long comp_total_vec(long nb) { return comp_o_off(nb) + nb; }
+struct Params {
+  const uint4* x; uint4* out;
+  uint4* slot[2][2];      // [rank][parity] device ptr to host-mapped data slots
+  int* flags[2];          // [rank] flag base (host-mapped)
+  int* state;             // device: [0]=epoch, [1]=done counter
+  int rank; long n_vec; int K; int mode; int gather; long inner_vec;
+  unsigned long long* trace;  // test-only (VLLM_HOSTAR_TRACE): [cap][8] stamps, null = off
+  long trace_cap;
+  int G;                      // AR blocks per role (grid = 2G AR blocks + optional prefetch blocks)
+  const uint4* pf; long pf_vec;  // optional: L2 prefetch range (next GEMM's weights), 16B units
+  int pf_step;                // prefetch stride in 16B units (2 = one per 32B L2 sector)
+  const uint4* pf2; long pf2_vec;  // optional second prefetch range
+};
+static __device__ __forceinline__ unsigned long long gtimer() {
+  unsigned long long t; asm volatile("mov.u64 %0, %globaltimer;" : "=l"(t)); return t;
+}
+
+__global__ void hostar_kernel(Params p) {
+  __shared__ int s_epoch;
+  const int G = p.G, tid = threadIdx.x, nt = blockDim.x;
+  if (blockIdx.x >= 2 * G) {
+    // L2 prefetch blocks: warm the next GEMM's weights while the AR is PCIe-bound. No data
+    // dependence; only cache hints. They still take part in the done counter below.
+    long stride = (long)(gridDim.x - 2 * G) * nt;
+    for (long i = ((long)(blockIdx.x - 2 * G) * nt + tid) * p.pf_step; i < p.pf_vec; i += stride * p.pf_step)
+      asm volatile("prefetch.global.L2::evict_last [%0];" :: "l"(p.pf + i));
+    for (long i = ((long)(blockIdx.x - 2 * G) * nt + tid) * p.pf_step; i < p.pf2_vec; i += stride * p.pf_step)
+      asm volatile("prefetch.global.L2::evict_last [%0];" :: "l"(p.pf2 + i));
+    __syncthreads();
+    if (tid == 0) {
+      __threadfence();
+      int d = atomicAdd(&p.state[1], 1);
+      if (d == (int)gridDim.x - 1) {
+        int e = *(volatile int*)&p.state[0];
+        if (p.trace && e < p.trace_cap) p.trace[(size_t)e * 8 + 6] = gtimer();
+        p.state[1] = 0; __threadfence(); *(volatile int*)&p.state[0] = e + 1;
+      }
+    }
+    return;
+  }
+  const bool writer = blockIdx.x < G;
+  const int g = writer ? blockIdx.x : blockIdx.x - G;
+  if (tid == 0) s_epoch = *(volatile int*)&p.state[0];
+  __syncthreads();
+  const int epoch = s_epoch, par = epoch & 1;
+  // trace entry: [0]=n_vec|gather<<40|grid<<48, [1]=w0 start, [2]=w0 flags published, [3]=r0 start,
+  // [4]=r0 peer flag observed (chunk 0), [5]=r0 end, [6]=last block end, [7]=max reader observe
+  unsigned long long* tr = (p.trace && epoch < p.trace_cap) ? p.trace + (size_t)epoch * 8 : nullptr;
+  if (tr && tid == 0) {
+    unsigned long long t = gtimer();
+    if (blockIdx.x == 0) { tr[0] = (unsigned long long)p.n_vec | ((unsigned long long)p.gather << 40) | ((unsigned long long)gridDim.x << 48); tr[1] = t; }
+    else if (blockIdx.x == G) tr[3] = t;
+  }
+  uint4* mine = p.slot[p.rank][par];
+  const uint4* peer = p.slot[1 - p.rank][par];
+  int* myf = p.flags[p.rank] + (size_t)g * MAXK * FSTRIDE;
+  const int* pf = p.flags[1 - p.rank] + (size_t)g * MAXK * FSTRIDE;
+  const int K = p.K;
+  long total_chunks = (long)G * K;
+  const long n_units = (p.mode & 16) ? (p.n_vec >> 2) : p.n_vec;  // 32-value blocks when compressed
+  long cs = (n_units + total_chunks - 1) / total_chunks;
+  if (p.mode & 16) cs = (cs + 31) & ~31L;  // group-aligned chunks
+  for (int c = 0; c < K; c++) {
+    long lo = ((long)c * G + g) * cs, hi = lo + cs;
+    if (lo > n_units) lo = n_units; if (hi > n_units) hi = n_units;
+    if (writer && p.gather) {
+      // all-gather: publish my shard and place it in my slot of the output
+      for (long i = lo + tid; i < hi; i += nt) {
+        uint4 v = p.x[i];
+        st_cs(mine + i, v);
+        p.out[(i / p.inner_vec * 2 + p.rank) * p.inner_vec + i % p.inner_vec] = v;
+      }
+      __threadfence_system();
+      __syncthreads();
+      if (tid == 0) asm volatile("st.volatile.global.s32 [%0], %1;" :: "l"(myf + c * FSTRIDE), "r"(epoch) : "memory");
+    } else if (writer && (p.mode & 16)) {
+      // compressed write: warp w handles groups of 32 blocks (lane = block), two groups per iteration
+      const long nb = p.n_vec >> 2;
+      uint4* A = mine; uint4* B = mine + nb; uint4* Cc = mine + 2 * nb;
+      uint4* GH = mine + comp_gh_off(nb); uint4* O = mine + comp_o_off(nb);
+      const int lane = tid & 31; const long wstep = (long)(nt >> 5) * 32;
+      const unsigned lt = (1u << lane) - 1;
+      for (long gb = lo + (long)(tid >> 5) * 32; gb < hi; gb += 2 * wstep) {
+        uint4 xr[2][4], a[2], b[2], cc[2]; uint8_t h[2]; bool v[2];
+#pragma unroll
+        for (int u = 0; u < 2; u++) {
+          const long bk = gb + u * wstep + lane; v[u] = bk < hi;
+#pragma unroll
+          for (int k = 0; k < 4; k++) xr[u][k] = v[u] ? p.x[4 * bk + k] : make_uint4(0, 0, 0, 0);
+        }
+#pragma unroll
+        for (int u = 0; u < 2; u++) {
+          const long g0 = gb + u * wstep, bk = g0 + lane;
+          if (g0 >= hi) break;  // warp-uniform
+          enc_block(xr[u][0], xr[u][1], xr[u][2], xr[u][3], a[u], b[u], cc[u], h[u]);
+          const bool raw = v[u] && h[u] == 0xFF;
+          const unsigned bal = __ballot_sync(0xffffffffu, raw);
+          uint4* gh = GH + (g0 >> 5) * 4;
+          if (v[u]) {
+            st_cs(A + bk, a[u]); st_cs(B + bk, b[u]); st_cs(Cc + bk, cc[u]);
+            st_cs_u8((uint8_t*)gh + lane, h[u]);
+          }
+          if (raw) {
+            const int r = __popc(bal & lt);
+            st_cs(r < CEX ? gh + 2 + r : O + bk, xr[u][3]);
+          }
+        }
+      }
+      if (!(p.mode & 4)) __threadfence_system();
+      __syncthreads();
+      if (tid == 0 && (p.mode & 4)) __threadfence_system();
+      if (tid == 0) asm volatile("st.volatile.global.s32 [%0], %1;" :: "l"(myf + c * FSTRIDE), "r"(epoch) : "memory");
+      if (tr && tid == 0 && blockIdx.x == 0 && c == K - 1) tr[2] = gtimer();
+    } else if (writer) {
+      long i = lo + tid;
+      for (; i + 3 * nt < hi; i += 4 * nt) {
+        uint4 v0 = p.x[i], v1 = p.x[i+nt], v2 = p.x[i+2*nt], v3 = p.x[i+3*nt];
+        st_cs(mine+i, v0); st_cs(mine+i+nt, v1); st_cs(mine+i+2*nt, v2); st_cs(mine+i+3*nt, v3);
+      }
+      for (; i < hi; i += nt) st_cs(mine + i, p.x[i]);
+      if (!(p.mode & 4)) __threadfence_system();
+      __syncthreads();
+      if (tid == 0 && (p.mode & 4)) __threadfence_system();
+      if (tid == 0) asm volatile("st.volatile.global.s32 [%0], %1;" :: "l"(myf + c * FSTRIDE), "r"(epoch) : "memory");
+      if (tr && tid == 0 && blockIdx.x == 0 && c == K - 1) tr[2] = gtimer();
+    } else {
+      if (tid == 0) {
+        if (p.mode & 8) { while (ld_vol(pf + c * FSTRIDE) != epoch) { } }  // test-only: old racy check
+        else { while ((int)(ld_vol(pf + c * FSTRIDE) - epoch) < 0) { } }   // monotonic: peer may be ahead
+        __threadfence_system();
+        if (tr && c == 0) { unsigned long long t = gtimer(); if (blockIdx.x == G) tr[4] = t; atomicMax(tr + 7, t); }
+      }
+      __syncthreads();
+      if (p.gather) {
+        const int pr = 1 - p.rank;
+        long j = lo + tid;
+        for (; j + 3 * nt < hi; j += 4 * nt) {
+          uint4 v0 = ld_cv(peer + j), v1 = ld_cv(peer + j + nt), v2 = ld_cv(peer + j + 2*nt), v3 = ld_cv(peer + j + 3*nt);
+          #define PUT(jj, vv) p.out[((jj) / p.inner_vec * 2 + pr) * p.inner_vec + (jj) % p.inner_vec] = vv
+          PUT(j, v0); PUT(j + nt, v1); PUT(j + 2*nt, v2); PUT(j + 3*nt, v3);
+        }
+        for (; j < hi; j += nt) { uint4 v = ld_cv(peer + j); PUT(j, v); }
+        continue;
+      }
+      // test-only (mode & 32): store the decoded peer value itself (codec round-trip check)
+#define ADDV(xv, v) ((p.mode & 32) ? (v) : add4((xv), (v)))
+      if (p.mode & 16) {
+        const long nb = p.n_vec >> 2;
+        const uint4* A = peer; const uint4* B = peer + nb; const uint4* Cc = peer + 2 * nb;
+        const uint4* GH = peer + comp_gh_off(nb); const uint4* O = peer + comp_o_off(nb);
+        const int lane = tid & 31; const long wstep = (long)(nt >> 5) * 32;
+        const unsigned lt = (1u << lane) - 1;
+        for (long gb = lo + (long)(tid >> 5) * 32; gb < hi; gb += 2 * wstep) {
+          uint4 a[2], b[2], cc[2], ex[2]; uint32_t h[2]; bool v[2], gv[2];
+#pragma unroll
+          for (int u = 0; u < 2; u++) {   // issue all PCIe reads of both groups first
+            const long g0 = gb + u * wstep, bk = g0 + lane;
+            gv[u] = g0 < hi; v[u] = bk < hi;
+            const uint4* gh = GH + (g0 >> 5) * 4;
+            if (v[u]) { a[u] = ld_cv(A + bk); b[u] = ld_cv(B + bk); cc[u] = ld_cv(Cc + bk); h[u] = ld_cv_u8((const uint8_t*)gh + lane); }
+            else h[u] = 0;
+            ex[u] = (gv[u] && lane < CEX) ? ld_cv(gh + 2 + lane) : make_uint4(0, 0, 0, 0);
+          }
+#pragma unroll
+          for (int u = 0; u < 2; u++) {
+            if (!gv[u]) break;  // warp-uniform
+            const long bk = gb + u * wstep + lane;
+            const bool raw = v[u] && h[u] == 0xFF;
+            const unsigned bal = __ballot_sync(0xffffffffu, raw);
+            const int r = __popc(bal & lt);
+            const int src = (raw && r < CEX) ? r : 0;
+            uint4 o;
+            o.x = __shfl_sync(0xffffffffu, ex[u].x, src); o.y = __shfl_sync(0xffffffffu, ex[u].y, src);
+            o.z = __shfl_sync(0xffffffffu, ex[u].z, src); o.w = __shfl_sync(0xffffffffu, ex[u].w, src);
+            if (!v[u]) continue;
+            uint4 v0, v1, v2, v3;
+            if (raw) { v0 = a[u]; v1 = b[u]; v2 = cc[u]; v3 = (r < CEX) ? o : ld_cv(O + bk); }
+            else dec_block(a[u], b[u], cc[u], h[u], v0, v1, v2, v3);
+            p.out[4*bk] = ADDV(p.x[4*bk], v0); p.out[4*bk+1] = ADDV(p.x[4*bk+1], v1);
+            p.out[4*bk+2] = ADDV(p.x[4*bk+2], v2); p.out[4*bk+3] = ADDV(p.x[4*bk+3], v3);
+          }
+        }
+        continue;
+#undef ADDV
+      }
+      long i = lo + tid;
+      for (; i + 3 * nt < hi; i += 4 * nt) {
+        uint4 v0 = ld_cv(peer + i), v1 = ld_cv(peer + i + nt), v2 = ld_cv(peer + i + 2*nt), v3 = ld_cv(peer + i + 3*nt);
+        p.out[i] = add4(p.x[i], v0); p.out[i+nt] = add4(p.x[i+nt], v1);
+        p.out[i+2*nt] = add4(p.x[i+2*nt], v2); p.out[i+3*nt] = add4(p.x[i+3*nt], v3);
+      }
+      for (; i < hi; i += nt) p.out[i] = add4(p.x[i], ld_cv(peer + i));
+    }
+  }
+  __syncthreads();
+  if (tr && tid == 0 && blockIdx.x == G) tr[5] = gtimer();
+  if (tid == 0) {
+    __threadfence();
+    int d = atomicAdd(&p.state[1], 1);
+    if (tr && d == (int)gridDim.x - 1) tr[6] = gtimer();
+    if (d == (int)gridDim.x - 1) { p.state[1] = 0; __threadfence(); *(volatile int*)&p.state[0] = epoch + 1; }
+  }
+}
+
+struct Ctx {
+  void* base[1]; size_t slot_bytes; Params p; int* state; bool init=false; int dev=0;
+};
+static Ctx C;
+
+// Layout of shm file: [rank 0..1][parity 0..1] data slots, then flags [rank][MAXB*MAXK*FSTRIDE ints]
+size_t total_bytes(size_t slot_bytes) { return 4 * slot_bytes + 2 * (size_t)MAXB * MAXK * FSTRIDE * 4; }
+
+void hostar_init(std::string path, int64_t slot_bytes, int64_t rank, bool create) {
+  size_t tot = total_bytes(slot_bytes);
+  int fd = open(path.c_str(), O_RDWR | (create ? (O_CREAT) : 0), 0600);
+  TORCH_CHECK(fd >= 0, "open failed");
+  if (create) TORCH_CHECK(ftruncate(fd, tot) == 0, "ftruncate");
+  void* m = mmap(nullptr, tot, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  TORCH_CHECK(m != MAP_FAILED, "mmap");
+  close(fd);
+  TORCH_CHECK(cudaHostRegister(m, tot, cudaHostRegisterMapped) == cudaSuccess, "hostregister");
+  void* d; TORCH_CHECK(cudaHostGetDevicePointer(&d, m, 0) == cudaSuccess, "getdevptr");
+  char* b = (char*)d;
+  for (int r = 0; r < 2; r++) for (int q = 0; q < 2; q++) C.p.slot[r][q] = (uint4*)(b + ((size_t)(r * 2 + q)) * slot_bytes);
+  for (int r = 0; r < 2; r++) C.p.flags[r] = (int*)(b + 4 * slot_bytes + (size_t)r * MAXB * MAXK * FSTRIDE * 4);
+  void* st; cudaMalloc(&st, 64); cudaMemset(st, 0, 64);
+  int one = 1; cudaMemcpy(st, &one, 4, cudaMemcpyHostToDevice);
+  C.p.state = (int*)st; C.p.rank = rank; C.slot_bytes = slot_bytes; C.init = true;
+  C.p.trace = nullptr; C.p.trace_cap = 0; cudaGetDevice(&C.dev);
+}
+// test-only tracing (default off)
+void hostar_trace_enable(int64_t cap) {
+  void* t; TORCH_CHECK(cudaMalloc(&t, cap * 64) == cudaSuccess); cudaMemset(t, 0, cap * 64); cudaDeviceSynchronize();
+  C.p.trace = (unsigned long long*)t; C.p.trace_cap = cap;
+}
+torch::Tensor hostar_trace_dump() {
+  TORCH_CHECK(C.p.trace);
+  cudaSetDevice(C.dev);
+  auto out = torch::empty({C.p.trace_cap, 8}, torch::kInt64);
+  cudaStream_t s; cudaStreamCreateWithFlags(&s, cudaStreamNonBlocking);
+  cudaMemcpyAsync(out.data_ptr(), C.p.trace, C.p.trace_cap * 64, cudaMemcpyDeviceToHost, s);
+  cudaStreamSynchronize(s); cudaStreamDestroy(s);
+  return out;
+}
+void hostar_zero(std::string path) {}  // flags are zero from ftruncate
+
+// Compression (mode & 16) needs whole 32-value blocks and a layout that fits the slot; else raw.
+static int comp_mode(int64_t mode, long n_vec) {
+  if (!(mode & 16)) return (int)mode;
+  if (n_vec % 4 != 0 || (size_t)comp_total_vec(n_vec / 4) * 16 > C.slot_bytes) return (int)(mode & ~16);
+  return (int)mode;
+}
+void hostar_allreduce(torch::Tensor x, torch::Tensor out, int64_t grid, int64_t K, int64_t threads, int64_t mode) {
+  TORCH_CHECK(C.init);
+  size_t bytes = x.numel() * 2;
+  TORCH_CHECK(bytes % 16 == 0 && bytes <= C.slot_bytes && K <= MAXK && grid <= 2*MAXB && grid%2==0);
+  Params p = C.p; p.x = (const uint4*)x.data_ptr(); p.out = (uint4*)out.data_ptr();
+  p.n_vec = bytes / 16; p.K = K; p.mode = comp_mode(mode, p.n_vec); p.gather = 0; p.inner_vec = 1;
+  p.G = grid / 2; p.pf = nullptr; p.pf_vec = 0; p.pf2 = nullptr; p.pf2_vec = 0;
+  hostar_kernel<<<grid, threads, 0, at::cuda::getCurrentCUDAStream()>>>(p);
+}
+// all-reduce + `pf_blocks` extra blocks prefetching the first `pf_bytes` of `pf` into L2.
+void hostar_allreduce_pf(torch::Tensor x, torch::Tensor out, int64_t grid, int64_t K, int64_t threads, int64_t mode,
+                         torch::Tensor pf, int64_t pf_bytes, int64_t pf_blocks, int64_t pf_step,
+                         std::optional<torch::Tensor> pf2) {
+  TORCH_CHECK(C.init);
+  size_t bytes = x.numel() * 2;
+  TORCH_CHECK(bytes % 16 == 0 && bytes <= C.slot_bytes && K <= MAXK && grid <= 2*MAXB && grid%2==0);
+  TORCH_CHECK(pf.is_cuda() && pf_blocks >= 0 && pf_blocks <= 64 && pf_step >= 1 && pf_step <= 64);
+  int64_t pfb = std::min<int64_t>(pf_bytes, pf.numel() * pf.element_size());
+  Params p = C.p; p.x = (const uint4*)x.data_ptr(); p.out = (uint4*)out.data_ptr();
+  p.n_vec = bytes / 16; p.K = K; p.mode = comp_mode(mode, p.n_vec); p.gather = 0; p.inner_vec = 1;
+  p.G = grid / 2; p.pf = (const uint4*)pf.data_ptr(); p.pf_vec = pfb > 0 ? pfb / 16 : 0; p.pf_step = pf_step;
+  p.pf2 = nullptr; p.pf2_vec = 0;
+  if (pf2.has_value() && pf2->defined()) {
+    TORCH_CHECK(pf2->is_cuda());
+    int64_t b2 = std::min<int64_t>(pf_bytes, pf2->numel() * pf2->element_size());
+    p.pf2 = (const uint4*)pf2->data_ptr(); p.pf2_vec = b2 > 0 ? b2 / 16 : 0;
+  }
+  int g = grid + (p.pf_vec > 0 ? pf_blocks : 0);
+  hostar_kernel<<<g, threads, 0, at::cuda::getCurrentCUDAStream()>>>(p);
+}
+void hostar_allgather(torch::Tensor x, torch::Tensor out, int64_t grid, int64_t K, int64_t threads, int64_t inner_bytes) {
+  TORCH_CHECK(C.init);
+  size_t bytes = x.numel() * x.element_size();
+  TORCH_CHECK(bytes % 16 == 0 && inner_bytes % 16 == 0 && bytes <= C.slot_bytes && K <= MAXK && grid <= 2*MAXB && grid%2==0);
+  Params p = C.p; p.x = (const uint4*)x.data_ptr(); p.out = (uint4*)out.data_ptr();
+  p.n_vec = bytes / 16; p.K = K; p.mode = 4; p.gather = 1; p.inner_vec = inner_bytes / 16;
+  p.G = grid / 2; p.pf = nullptr; p.pf_vec = 0; p.pf2 = nullptr; p.pf2_vec = 0;
+  hostar_kernel<<<grid, threads, 0, at::cuda::getCurrentCUDAStream()>>>(p);
+}
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.def("init", &hostar_init); m.def("trace_enable", &hostar_trace_enable); m.def("trace_dump", &hostar_trace_dump); m.def("allreduce", &hostar_allreduce); m.def("allreduce_pf", &hostar_allreduce_pf); m.def("allgather", &hostar_allgather);
+}
