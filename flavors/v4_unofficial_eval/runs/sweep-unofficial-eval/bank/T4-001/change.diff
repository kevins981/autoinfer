+                0,
+            )
+            checks = []
+            for j, r in enumerate(rows):
+                H = si[r][0]
+                base = self._sh_map.get(H)
+                if base is None or H in self._sh_bad:
+                    self._sh_stats["unverified"] += 1
+                    continue
+                checks.append(
+                    (r, H, (tmp[1 + 3 * j] == self._sh_pool[base + ac[r] - 1]).all())
+                )
+            if checks:
+                oks = torch.stack([c[2] for c in checks]).tolist()
+                for (r, H, _), ok in zip(checks, oks):
+                    if ok:
+                        self._sh_stats["commit_ok"] += 1
+                    else:
+                        self._shadow_report(
+                            "commit",
+                            r,
+                            f"H={H} acc={ac[r]} flags={fl[r]} hist={self._sh_hist.get(H)}",
+                        )
+        if flush_only:
+            for r in range(n):
+                self._sh_map.pop(si[r][0], None)
+            return None
+        # 2. (re)sync the shadow pool for rows not coming from a replay step
+        if len(self._sh_map) + n > self._sh_cap:
+            keep = {si[r][0] for r in range(n) if fl[r] & 2}
+            self._sh_map = {h: b for h, b in self._sh_map.items() if h in keep}
+        used = set(self._sh_map.values())
+        free = [b for b in range(0, self._sh_cap * 3, 3) if b not in used]
+        bases = []
+        for r in range(n):
+            H = si[r][0]
+            base = self._sh_map.get(H)
+            if base is None:
+                base = free.pop()
+                self._sh_map[H] = base
+                fresh = True
+            else:
+                fresh = False
+            if not (fl[r] & 2):
+                self._sh_bad.discard(H)
+                for t in range(3):
+                    self._sh_pool[base + t].copy_(ssm_state[si[r][t]])
+            elif fresh:
+                self._sh_bad.add(H)  # shadow state unknown: unverifiable
+            h = self._sh_hist.setdefault(H, [])
+            h.append((self._sh_calls, fl[r], ac[r]))
+            del h[:-6]
+            bases.append(base)
+        sh_idx = torch.tensor(
+            [[b, b + 1, b + 2] for b in bases],
+            dtype=torch.int32,
+            device=ssm_state.device,
+        )
+        return (sh_idx, si, fl, ac)
+
+    def _shadow_post(
+        self,
+        shadow,
+        mixed_qkv,
+        a,
+        b,
+        output_gate,
+        core_attn_out,
+        cu_seqlens,
+        num_accepted_tokens,
+    ) -> None:
+        sh_idx, si, fl, ac = shadow
+        n = sh_idx.shape[0]
+        out2 = torch.empty_like(core_attn_out)
+        ops.fused_gdn_decode_post_conv_mtp(
+            mixed_qkv=mixed_qkv,
+            a=a,
+            b=b,
+            A_log=self.A_log,
+            dt_bias=self.dt_bias,
+            state_indices=sh_idx,
+            cu_seqlens=cu_seqlens,
+            num_accepted_tokens=num_accepted_tokens,
+            state=self._sh_pool,
+            output_gate=output_gate,
+            norm_weight=self.norm.weight,
+            out=out2,
+            scale=self.head_k_dim**-0.5,
+            norm_eps=self.layer_norm_epsilon,
+            output_gate_activation=self.norm.activation,
+        )
+        ssm_state = self.kv_cache[1]
+        cu = cu_seqlens.tolist()
+        bl = sh_idx[:, 0].tolist()
+        checks = []
+        for r in range(n):
+            lo, hi = cu[r], cu[r + 1]
+            H = si[r][0]
+            if H in self._sh_bad:
+                continue
+            checks.append(
+                ("out", r, -1, (core_attn_out[lo:hi] == out2[lo:hi]).all(), H)
+            )
+            if not (fl[r] & 1):
+                for t in range(hi - lo):
+                    checks.append(
+                        (
+                            "state",
+                            r,
+                            t,
+                            (ssm_state[si[r][t]] == self._sh_pool[bl[r] + t]).all(),
+                            H,
+                        )
+                    )
+        if checks:
+            oks = torch.stack([c[3] for c in checks]).tolist()
+            for (kind, r, t, _, H), ok in zip(checks, oks):
+                if ok:
+                    self._sh_stats[kind + "_ok"] += 1
+                else:
+                    self._shadow_report(
+                        kind,
+                        r,
+                        f"H={H} slot={t} flags={fl[r]} acc={ac[r]} hist={self._sh_hist.get(H)}",
+                    )
+        if ".layers.0." in self.prefix and self._sh_calls % 50 == 0:
+            logger.info("GDN replay SHADOW stats call=%d %s", self._sh_calls, self._sh_stats)
+
     def _can_use_fused_gdn_mtp_decode(
         self, attn_metadata: GDNAttentionMetadata
     ) -> bool:
