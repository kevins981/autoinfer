diff --git a/vllm/model_executor/layers/mamba/gdn/recurrent_prefill.py b/vllm/model_executor/layers/mamba/gdn/recurrent_prefill.py
new file mode 100644
index 0000000000..6fd4e2a75b
--- /dev/null
+++ b/vllm/model_executor/layers/mamba/gdn/recurrent_prefill.py
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: Apache-2.0
+"""One-kernel recurrent GDN prefill for short prompt chunks (<= one FLA chunk, see the hook).
+
+Same math as fused_post_conv_prep + chunk_gated_delta_rule (token-by-token form,
+as fused_sigmoid_gating_delta_rule_update does for decode), but: reads q|k|v straight
+from the conv output rows, reads the initial state from ssm_state[state_idx] (zeros if
+the sequence has no initial state), and writes the final state once per sequence.
+"""
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _recurrent_prefill_kernel(
+    mixed_ptr, a_ptr, b_ptr, A_log_ptr, dt_bias_ptr, o_ptr,
+    ssm_ptr, state_idx_ptr, has_init_ptr, cu_ptr,
+    scale,
+    stride_x_tok, stride_a_tok, stride_b_tok, stride_o_tok,
+    stride_ssm_slot, stride_idx,
+    H: tl.constexpr, HV: tl.constexpr, K: tl.constexpr, V: tl.constexpr,
+    BK: tl.constexpr, BV: tl.constexpr,
+):
+    i_v, i_nhv = tl.program_id(0), tl.program_id(1)
+    i_n, i_hv = i_nhv // HV, i_nhv % HV
+    i_h = i_hv // (HV // H)
+    bos = tl.load(cu_ptr + i_n).to(tl.int64)
+    eos = tl.load(cu_ptr + i_n + 1).to(tl.int64)
+    T = eos - bos
+    if T == 0:
+        return
+    o_k = tl.arange(0, BK)
+    o_v = i_v * BV + tl.arange(0, BV)
+    mask_k = o_k < K
+    mask_v = o_v < V
+    mask_h = mask_v[:, None] & mask_k[None, :]
+    state_idx = tl.load(state_idx_ptr + i_n * stride_idx).to(tl.int64)
+    p_h = ssm_ptr + state_idx * stride_ssm_slot + i_hv * V * K + o_v[:, None] * K + o_k[None, :]
+    has_init = tl.load(has_init_ptr + i_n)
+    b_h = tl.zeros([BV, BK], dtype=tl.float32)
+    # idx <= 0 (null/invalid slot): no state to resume, nothing is stored (the chunk path
+    # would gather/scatter slot 0, which is reserved scratch).
+    if (has_init != 0) & (state_idx > 0):
+        b_h += tl.load(p_h, mask=mask_h, other=0).to(tl.float32)
+
+    p_q = mixed_ptr + bos * stride_x_tok + i_h * K + o_k
+    p_k = p_q + H * K
+    p_v = mixed_ptr + bos * stride_x_tok + 2 * H * K + i_hv * V + o_v
+    p_a = a_ptr + bos * stride_a_tok + i_hv
+    p_b = b_ptr + bos * stride_b_tok + i_hv
+    p_o = o_ptr + bos * stride_o_tok + i_hv * V + o_v
+    neg_A = -tl.exp(tl.load(A_log_ptr + i_hv).to(tl.float32))
+    dtb = tl.load(dt_bias_ptr + i_hv).to(tl.float32)
+    for i_t in range(0, T):
+        b_q = tl.load(p_q, mask=mask_k, other=0).to(tl.float32)
+        b_k = tl.load(p_k, mask=mask_k, other=0).to(tl.float32)
+        b_v = tl.load(p_v, mask=mask_v, other=0).to(tl.float32)
+        x = tl.load(p_a).to(tl.float32) + dtb
+        sp = tl.where(x <= 20.0, tl.log(1 + tl.exp(x)), x)
+        b_g = neg_A * sp
+        b_beta = tl.sigmoid(tl.load(p_b).to(tl.float32))
+        b_q = b_q * tl.rsqrt(tl.sum(b_q * b_q) + 1e-6) * scale
+        b_k = b_k * tl.rsqrt(tl.sum(b_k * b_k) + 1e-6)
+        b_h *= tl.exp(b_g)
+        b_v -= tl.sum(b_h * b_k[None, :], 1)
+        b_v *= b_beta
+        b_h += b_v[:, None] * b_k[None, :]
+        b_o = tl.sum(b_h * b_q[None, :], 1)
+        tl.store(p_o, b_o.to(p_o.dtype.element_ty), mask=mask_v)
+        p_q += stride_x_tok
+        p_k += stride_x_tok
+        p_v += stride_x_tok
+        p_a += stride_a_tok
+        p_b += stride_b_tok
+        p_o += stride_o_tok
+    if state_idx > 0:
+        tl.store(p_h, b_h.to(p_h.dtype.element_ty), mask=mask_h)
+
+
+def recurrent_gdn_prefill(
+    conv_output, a, b, A_log, dt_bias, ssm_state, state_indices, has_initial_state,
+    cu_seqlens, out, num_k_heads, head_k_dim, head_v_dim, BV=16, num_warps=4,
+):
+    """conv_output [L, 2HK+HV*V] (row stride arbitrary), a/b [L, HV], out [L, HV, V] (or
+    [L, HV*V] view). state_indices/cu_seqlens int tensors, has_initial_state bool [N]."""
+    N = cu_seqlens.shape[0] - 1
+    HV = A_log.shape[0]
+    K, V, H = head_k_dim, head_v_dim, num_k_heads
+    BK = triton.next_power_of_2(K)
+    grid = (triton.cdiv(V, BV), N * HV)
+    _recurrent_prefill_kernel[grid](
+        conv_output, a, b, A_log, dt_bias, out, ssm_state, state_indices,
+        has_initial_state, cu_seqlens, K ** -0.5,
+        conv_output.stride(0), a.stride(0), b.stride(0), out.stride(0),
+        ssm_state.stride(0), state_indices.stride(0),
+        H=H, HV=HV, K=K, V=V, BK=BK, BV=BV, num_warps=num_warps, num_stages=2,
+    )
+    return out
