+  __shared__ __nv_bfloat16 replay_v[kReplayMaxTotal][kDimV];
+  __shared__ float replay_decay[kReplayMaxTotal];
+  __shared__ float replay_beta[kReplayMaxTotal];
+  const unsigned char* rows = replay_rows_base(
+      state, state_indices[request * state_indices_width + 1], value_head,
+      state_slot_stride);
+  int c0, c1;
+  const int replay_count = replay_row_counts(flags, accepted, rows, c0, c1);
+  load_pending_rows(rows, flags, c0, c1, tid, replay_k, replay_v, replay_decay,
