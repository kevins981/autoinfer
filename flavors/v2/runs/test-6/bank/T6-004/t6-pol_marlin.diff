+// ---- T6 per-shape / per-M policy (see agents/leader-6.w1/POLICY.md) ----
+// AI_POLICY unset/1: measured default policy; 0: stock behaviour;
+// "manual": use the raw env knobs (AI_SLAB, AI_SLAB_S49, AI_SLAB_INNER,
+// AI_FORCE="k,n,threads,stages,bps") for A/B.
+struct T6Knobs {
+  bool slab = false;
+  int s49 = 1;
+  bool inner = false;
+  bool force = false;
+  int fk = 0, fn = 0, ft = 0, fs = 0, fb = 0;
+};
+
+static T6Knobs t6_knobs(int M, int N, int K) {
+  T6Knobs k;
+  const char* pol = getenv("AI_POLICY");
+  if (pol && strcmp(pol, "manual") == 0) {
+    const char* e = getenv("AI_SLAB");
+    k.slab = !(e && e[0] == '0');
+    e = getenv("AI_SLAB_S49");
+    k.s49 = e ? atoi(e) : 1;
+    e = getenv("AI_SLAB_INNER");
+    k.inner = e && e[0] == '1';
+    if (const char* f = getenv("AI_FORCE"))
+      k.force = sscanf(f, "%d,%d,%d,%d,%d", &k.fk, &k.fn, &k.ft, &k.fs,
+                       &k.fb) == 5;
+    return k;
+  }
+  if (pol && pol[0] == '0') return k;
+  // shape class by weight size: 0 = gate_up-like (>= 60M), 1 = down-like
+  // (K >= 8000), 2 = qkv-like (>= 30M), 3 = small (o_proj, gdn out)
+  long long nk = (long long)N * K;
+  int cls = nk >= 60000000LL ? 0 : (K >= 8000 ? 1 : (nk >= 30000000LL ? 2 : 3));
+  if (M <= 48) return k;  // decode sizes: stock, bitwise identical
+  if (M <= 64) {
+    // 2x32 parallel slabs for the small/medium shapes; gate_up/down stay stock
+    if (cls >= 2) { k.slab = true; k.s49 = 2; }
+  } else if (M <= 128) {
+    k.slab = true;
+    if (cls == 0) k.inner = true;
+  } else if (M <= 150) {
+    if (cls == 0) { k.slab = true; k.inner = true; }
+  } else {
+    if (cls == 0 || cls == 3) k.slab = true;
+  }
+  return k;
+}
