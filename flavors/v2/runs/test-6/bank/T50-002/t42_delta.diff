+# SPDX-License-Identifier: Apache-2.0
+"""Certified greedy decisions for the target lm_head (AutoInfer T42; study: bank/T42-002).
+
+At load, each rank's bf16 lm_head shard is replaced in HBM by a 7-bit integer plane (0.57 vs 0.99 GB for the
+lossless code). The exact bf16 shard moves to pinned host memory. A greedy decision is:
+  screen (int8 MMA over the plane, rigorous per-(row, id) bound) -> exchange of the per-row lower bound across
+  TP ranks -> candidates = ids whose upper bound can still reach it -> exact bf16 logits of the candidates with
+  lmh_codec's own MMA chain (rows gathered from host) -> (max, first argmax) per rank, combined as before.
+The reference argmax is provably a candidate (proof: bank/T42-002/code/PROOF.md), so the decision equals argmax
+over the baseline's bf16 logits, first index on ties. Rows whose certificate cannot be used (buffer caps) are
+recomputed exactly over the whole shard from host (counted, logged). Paths that need full logits (non-greedy
+sampling, logprobs) compute them exactly from the host copy: correct but slow (~0.1 s per call).
+
+VLLM_LMH_CERT=0 disables it (lmh_codec then encodes the head as before).
+"""
+
+import hashlib
+import os
+import re
+
+import torch
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_ENABLED = os.environ.get("VLLM_LMH_CERT", "1") != "0"
+_MMAX = 64
+_ECAP = 65536      # emitted (id, U) entries per row (screen, running LB)
+_PAIRCAP = 8192    # kept (row, id) pairs per call
+_STAGECAP = 2048   # unique candidate rows staged in HBM per call (more: read from host directly)
+_CAPR = 1024       # kept candidates per row (more: exact full-shard fallback for that row)
+_LOG_EVERY = int(os.environ.get("VLLM_LMH_CERT_LOG_EVERY", "2048"))
+_DTC = 2.0 ** -11  # assumed bound on the champion kernel's fp32 accumulation error, relative to sum |h w|
+_mod = None
+
+
+def _load_ext():
+    global _mod
+    if _mod is not None:
+        return _mod
+    from torch.utils.cpp_extension import load
+
+    if "TORCH_EXTENSIONS_DIR" not in os.environ:
+        os.environ["TORCH_EXTENSIONS_DIR"] = os.path.join(envs.VLLM_CACHE_ROOT, "torch_extensions")
+    src = os.path.join(os.path.dirname(__file__), "lmh_cert.cu")
+    with open(src, "rb") as f:
+        tag = hashlib.sha1(f.read()).hexdigest()[:10]
+    name = f"vllm_lmh_cert_{tag}"
+    build_dir = os.path.join(os.environ["TORCH_EXTENSIONS_DIR"], name)
+    os.makedirs(build_dir, exist_ok=True)
+    major, minor = torch.cuda.get_device_capability()
+    os.environ.setdefault("TORCH_CUDA_ARCH_LIST", f"{major}.{minor}")
+    _mod = load(name, [src], build_directory=build_dir, verbose=False, extra_cuda_cflags=["-O3"])
+    return _mod
+
+
+def _ru32(x64: torch.Tensor) -> torch.Tensor:
+    """float64 (>= 0) -> float32 rounded up."""
+    f = x64.float()
+    return torch.where(f.double() < x64, torch.nextafter(f, torch.full_like(f, float("inf"))), f)
+
+
+@torch.no_grad()
+def build_plane(w: torch.Tensor, mod):
+    """Plane records [N/8 * KC * 912 B], A_v, B_v (bound coefficients), verified bitwise against q."""
+    n, k = w.shape
+    kc_n = k // 128
+    planes = torch.empty((n // 8, kc_n, 228), dtype=torch.int32, device=w.device)
+    A = torch.empty(n, dtype=torch.float32, device=w.device)
+    B = torch.empty_like(A)
+    bad = 0
+    ch = 4096
+    for r0 in range(0, n, ch):
+        r1 = min(n, r0 + ch)
+        wf = w[r0:r1].float().view(-1, kc_n, 128)
+        mx = wf.abs().amax(2)
+        s32 = torch.where(mx > 0, mx / 63, torch.ones_like(mx))
+        sb = s32.bfloat16()
+        sb = torch.where(sb.float() < s32, (sb.view(torch.int16) + 1).view(torch.bfloat16), sb)  # round up
+        s = sb.float()
+        q = torch.round(wf / s[..., None]).clamp(-64, 63)
+        wd = wf.double()
+        what = s.double()[..., None] * q.double()
+        rn = (wd - what).pow(2).sum((1, 2)).sqrt() * (1 + 1e-9)
+        wh = what.pow(2).sum((1, 2)).sqrt() * (1 + 1e-9)
+        wn = wd.pow(2).sum((1, 2)).sqrt() * (1 + 1e-9)
+        del wd, what
+        A[r0:r1] = _ru32((rn + _DTC * wn + 2.0 ** -18 * wh) * (1 + 1e-9))
+        B[r0:r1] = _ru32(wh * (1 + 2.0 ** -18) * (1 + 1e-9))
+        qi = q.to(torch.int8)
+        del q, wf
+        # [n8, row, kc, j, half, t, byte] -> [n8, kc, row, t, j, half, byte]: lane = row*4 + t, reg = 2j + half
+        qq = qi.view(-1, 8, kc_n, 4, 2, 4, 4).permute(0, 2, 1, 5, 3, 4, 6).reshape(-1, kc_n, 32, 8, 4)
+        by = qq.to(torch.int64) & 0x7F
+        x = by[..., 0] | (by[..., 1] << 8) | (by[..., 2] << 16) | (by[..., 3] << 24)
+        del by, qq
+        nw = torch.stack([(x[..., 2 * i] & 0x0F0F0F0F) | ((x[..., 2 * i + 1] & 0x0F0F0F0F) << 4) for i in range(4)], -1)
+        p1 = torch.stack([sum(((x[..., 4 * i + j] >> 4) & 0x03030303) << (2 * j) for j in range(4)) for i in range(2)], -1)
+        p2 = sum(((x[..., i] >> 6) & 0x01010101) << i for i in range(8))
+        s16 = sb.view(-1, 8, kc_n).permute(0, 2, 1).contiguous().view(torch.int16).to(torch.int64) & 0xFFFF
+        sc = s16[..., 0::2] | (s16[..., 1::2] << 16)
+        rec = torch.cat([nw.reshape(-1, kc_n, 128), p1.reshape(-1, kc_n, 64), p2.reshape(-1, kc_n, 32), sc], -1)
+        rec = torch.where(rec >= 2 ** 31, rec - 2 ** 32, rec).to(torch.int32)
+        planes[r0 // 8:r1 // 8] = rec
+        del x, nw, p1, p2, rec
+        bad += mod.plane_verify(qi.view(-1, k).contiguous(), planes[r0 // 8:r1 // 8].view(torch.uint8).reshape(-1))
+        del qi
+    return planes.view(torch.uint8).reshape(-1), A, B, bad
+
+
+def _numa_nodes_of(ptr: int) -> str:
+    """Page placement of the mapping containing ptr, from /proc/self/numa_maps (N<node>=<pages>)."""
+    try:
+        best = None
+        with open("/proc/self/numa_maps") as f:
+            for line in f:
+                addr = int(line.split()[0], 16)
+                if addr <= ptr and (best is None or addr > best[0]):
+                    best = (addr, line)
+        if best is None:
+            return "unknown"
+        nodes = re.findall(r"\bN(\d+)=(\d+)", best[1])
+        return ", ".join(f"node{n}: {int(p)} pages" for n, p in nodes) or best[1].strip()[:120]
+    except Exception as e:  # informational only
+        return f"unavailable ({e})"
+
+
+class LmhCertMethod:
+    """quant_method of a target lm_head whose exact weights live in pinned host memory."""
+
+    def __init__(self, orig_method, plane, A, B, w_host, n, k, tp_rank, tp_size, device):
+        self.orig_method = orig_method
+        self.mod = _load_ext()
+        self.plane, self.A, self.B = plane, A, B
+        self.w_host = w_host
+        self.whp = self.mod.host_dev_ptr(w_host.data_ptr())  # registered mapped by maybe_certify
+        self.n, self.k = n, k
+        self.tp_rank, self.tp_size = tp_rank, tp_size
+        i32 = dict(dtype=torch.int32, device=device)
+        self.hq = torch.zeros((_MMAX, (k // 128) * 256), dtype=torch.int8, device=device)
+        self.hs = torch.zeros(_MMAX, dtype=torch.float32, device=device)
+        self.hn = torch.zeros_like(self.hs)
+        self.hqe = torch.zeros_like(self.hs)
+        self.c1 = torch.zeros(2 * _MMAX, **i32)          # lb | ecnt
+        self.lb, self.ecnt = self.c1[:_MMAX], self.c1[_MMAX:]
+        self.c2 = torch.zeros(1 + 2 * _MMAX, **i32)      # pair count | kept | fallback flags
+        self.pcnt, self.kept, self.fb = self.c2[:1], self.c2[1:1 + _MMAX], self.c2[1 + _MMAX:]
+        self.ebuf = torch.zeros((_MMAX, _ECAP, 2), **i32)
+        self.pairs = torch.zeros((_PAIRCAP, 2), **i32)
+        self.src = torch.zeros(_PAIRCAP, **i32)
+        self.map = torch.full((n,), -1, **i32)
+        self.stage = torch.empty((_STAGECAP, k), dtype=torch.bfloat16, device=device)
+        self.keys = torch.zeros(_MMAX, dtype=torch.int64, device=device)
+        self.vals = torch.zeros(_MMAX, dtype=torch.float32, device=device)
+        self.idx = torch.zeros(_MMAX, **i32)
+        self.rows = torch.zeros(_MMAX, **i32)
+        self.nrows = torch.zeros(1, **i32)
+        self.stats = torch.zeros(8, dtype=torch.int64, device=device)
+        self.stats_host = torch.zeros(8, dtype=torch.int64, pin_memory=True)
+        self.calls = 0
+        self.full_calls = 0
+        self.last_fb = 0
+
+    def __getattr__(self, name):
+        return getattr(self.__dict__["orig_method"], name)
+
+    def buffer_bytes(self) -> int:
+        ts = [self.hq, self.c1, self.c2, self.ebuf, self.pairs, self.src, self.map, self.stage, self.keys, self.vals,
+              self.idx, self.rows, self.nrows, self.stats, self.A, self.B, self.hs, self.hn, self.hqe]
+        return sum(t.numel() * t.element_size() for t in ts)
+
+    # ---- exact full logits (slow path: everything that needs logits rather than the argmax) ----
+    def apply(self, layer, x: torch.Tensor, bias: torch.Tensor | None = None) -> torch.Tensor:
+        assert bias is None, "lm_head cert: bias not supported"
+        lead = x.shape[:-1]
+        x2 = x.reshape(-1, self.k)
+        if not x2.is_contiguous():
+            x2 = x2.contiguous()
+        out = torch.empty((x2.shape[0], self.n), dtype=x2.dtype, device=x2.device)
+        if x2.shape[0]:
+            self.mod.full_logits(x2, self.whp, self.n, out)
+        self.full_calls += 1
+        if self.full_calls in (1, 10, 100) or self.full_calls % 1000 == 0:
+            logger.warning("lm_head cert: exact full logits streamed from host (%d calls so far; slow path)",
+                           self.full_calls)
+        return out.reshape(*lead, self.n)
+
+    def embedding(self, layer, input_):
+        raise RuntimeError("lm_head cert: the target lm_head weight lives in host memory")
+
+    # ---- certified greedy: per-rank (max value fp32, first argmax int32) usable by the cross-rank combine ----
+    def greedy_local(self, x: torch.Tensor):
+        from vllm.distributed import tensor_model_parallel_all_gather
+
+        x = x.contiguous()
+        outs_v, outs_i = [], []
+        for c0 in range(0, x.shape[0], _MMAX):
+            xc = x[c0:c0 + _MMAX]
+            m = xc.shape[0]
+            self.c1.zero_()
+            self.c2.zero_()
+            self.keys.zero_()
+            self.mod.hprep(xc, m, self.hq, self.hs, self.hn, self.hqe)
+            self.mod.screen(self.hq, m, self.plane, self.A, self.B, self.hs, self.hn, self.hqe, self.n, self.lb,
+                            self.ecnt, self.ebuf, _ECAP)
+            if self.tp_size > 1:
+                lb_all = tensor_model_parallel_all_gather(self.lb[:m].view(torch.float32).unsqueeze(1), dim=-1)
+                lb_all = lb_all.contiguous().view(torch.int32)
+            else:
+                lb_all = self.lb[:m].unsqueeze(1).contiguous()
+            self.mod.finalize(m, lb_all, self.tp_size, self.ecnt, self.ebuf, _ECAP, self.pcnt, self.pairs, self.src,
+                              self.map, self.kept, self.fb, _CAPR)
+            self.mod.gather_rescore(xc, self.pcnt, self.pairs, self.src, self.map, self.whp, self.stage, self.keys)
+            self.mod.fallback_decode(xc, m, self.fb, self.kept, self.rows, self.nrows, self.stats, self.whp, self.n,
+                                     self.keys, self.vals, self.idx)
+            if x.shape[0] <= _MMAX:
+                outs_v.append(self.vals[:m])
+                outs_i.append(self.idx[:m])
+            else:
+                outs_v.append(self.vals[:m].clone())
+                outs_i.append(self.idx[:m].clone())
+        self._log_stats()
+        if len(outs_v) == 1:
+            return outs_v[0], outs_i[0]
+        return torch.cat(outs_v), torch.cat(outs_i)
+
+    def _log_stats(self):
+        self.calls += 1
+        if self.calls % _LOG_EVERY != 1:
+            return
+        # values copied by the previous checkpoint (no sync now); then queue a fresh async copy
+        s = self.stats_host.tolist()
+        if s[3]:
+            logger.info("lm_head cert stats (rank %d): calls %d, rows %d, candidates/row mean %.2f max %d, "
+                        "fallback rows %d, full-logit calls %d", self.tp_rank, s[4], s[3], s[1] / s[3], s[2], s[0],
+                        self.full_calls)
+        if s[0] > self.last_fb:
+            logger.warning("lm_head cert: %d rows fell back to the exact full-shard path (host)", s[0] - self.last_fb)
+            self.last_fb = s[0]
+        self.stats_host.copy_(self.stats, non_blocking=True)
+
+
+def _target_lm_head(model):
+    lm = model.get_language_model() if hasattr(model, "get_language_model") else model
+    return getattr(lm, "lm_head", None) or getattr(model, "lm_head", None)
+
+
+def _combine(vals, idx, start, tp_size):
+    """Cross-rank combine exactly as LogitsProcessor.get_greedy_tokens (lowest rank wins ties)."""
+    from vllm.distributed import tensor_model_parallel_all_gather
+
+    gidx = idx + start
+    if tp_size == 1:
+        return vals, gidx.to(torch.int64)
+    pair = torch.stack([vals, gidx.float()], dim=-1)
+    g = tensor_model_parallel_all_gather(pair, dim=-1).view(vals.shape[0], tp_size, 2)
+    bv, bi = g[:, 0, 0], g[:, 0, 1]
+    for r in range(1, tp_size):
+        take = g[:, r, 0] > bv
+        bv = torch.where(take, g[:, r, 0], bv)
+        bi = torch.where(take, g[:, r, 1], bi)
+    return bv, bi.to(torch.int64)
+
+
+@torch.no_grad()
+def maybe_certify_target_lm_head(model) -> bool:
+    """Replace the target lm_head shard by the certified plane + host copy. False: nothing changed."""
+    if not _ENABLED:
+        logger.info("lm_head cert: disabled (VLLM_LMH_CERT=0)")
+        return False
+    from vllm.distributed import tensor_model_parallel_all_gather
+    from vllm.model_executor.layers.vocab_parallel_embedding import (
+        ParallelLMHead,
+        UnquantizedEmbeddingMethod,
+    )
+    from vllm.v1.worker.gpu.sample.greedy_argmax import greedy_argmax_with_value
+
+    head = _target_lm_head(model)
+    w = getattr(head, "weight", None)
+    ok = (
+        isinstance(head, ParallelLMHead)
+        and type(head.quant_method) is UnquantizedEmbeddingMethod
+        and getattr(head, "bias", None) is None
+        and isinstance(w, torch.Tensor)
+        and w.is_cuda
+        and w.dtype == torch.bfloat16
+        and w.dim() == 2
+        and w.is_contiguous()
+        and w.shape[0] % 8 == 0
+        and w.shape[1] % 512 == 0
+    )
+    if ok:
+        si = head.shard_indices
+        n, k = w.shape
+        ok = si.num_org_vocab_padding == 0 and si.org_vocab_start_index == head.tp_rank * n and \
+            si.org_vocab_end_index - si.org_vocab_start_index == n
+    tp_size = head.tp_size if ok else 1
