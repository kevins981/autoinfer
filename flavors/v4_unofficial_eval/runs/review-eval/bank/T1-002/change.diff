+def build_reduced_draft_head(
+    target_lm_head: nn.Module, num_ids: int
+) -> torch.Tensor | None:
+    """Rows [0, num_ids) of the target lm_head as one replicated bf16/fp16
+    [num_ids, hidden] tensor on every TP rank (all-reduce of zero-padded
+    shards, so rows are copied bit-exactly). None if the head is not a plain
+    16-bit vocab-parallel head."""
+    weight = getattr(target_lm_head, "weight", None)
+    indices = getattr(target_lm_head, "shard_indices", None)
+    if (
+        not isinstance(weight, torch.Tensor)
+        or indices is None
+        or weight.dtype not in (torch.bfloat16, torch.float16)
+        or getattr(target_lm_head, "bias", None) is not None
+    ):
+        return None
+    num_ids = min(num_ids, target_lm_head.org_vocab_size)
+    buf = torch.zeros(num_ids, weight.shape[1], dtype=weight.dtype, device=weight.device)
+    start = indices.org_vocab_start_index
+    end = min(indices.org_vocab_end_index, num_ids)
+    if start < end:
+        buf[start:end] = weight[: end - start]
+    if target_lm_head.tp_size > 1:
+        buf = get_tp_group().all_reduce(buf)
+    return buf
+
