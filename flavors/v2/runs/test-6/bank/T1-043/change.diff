+  // log_cap: bits 0-7 log capacity (0 = commit every step), bits 8-9 RED8 variant.
+  const int prologue_dbg = (log_cap >> 12) & 1;
+  const int red8 = (log_cap >> 8) & 7;
+  STD_TORCH_CHECK(red8 <= 5, "RED8 variant must be 0-5");
+  log_cap &= 0xFF;
+  STD_TORCH_CHECK(log_cap >= 0 && log_cap <= kLogCap,
+                  "log_cap must be in [0, 8] (0 = commit every step)");
+  STD_TORCH_CHECK(
+      mixed_qkv.is_cuda() && mixed_qkv.scalar_type() == ScalarType::BFloat16,
+      "mixed_qkv must be a CUDA bfloat16 tensor");
+  STD_TORCH_CHECK(a.is_cuda() && a.scalar_type() == ScalarType::BFloat16 &&
+                      b.is_cuda() && b.scalar_type() == ScalarType::BFloat16,
+                  "a, b must be CUDA bfloat16 tensors");
+  STD_TORCH_CHECK(a_log.is_cuda() && a_log.scalar_type() == ScalarType::Float,
+                  "A_log must be a CUDA float32 tensor");
+  const auto dt_bias_scalar_type = dt_bias.scalar_type();
+  STD_TORCH_CHECK(
+      dt_bias.is_cuda() && (dt_bias_scalar_type == ScalarType::Float ||
+                            dt_bias_scalar_type == ScalarType::BFloat16 ||
+                            dt_bias_scalar_type == ScalarType::Half),
+      "dt_bias must be a CUDA float32, bfloat16, or float16 tensor");
+  STD_TORCH_CHECK(state_indices.is_cuda() &&
+                      state_indices.scalar_type() == ScalarType::Int &&
+                      cu_seqlens.is_cuda() &&
+                      cu_seqlens.scalar_type() == ScalarType::Int &&
+                      num_accepted_tokens.is_cuda() &&
+                      num_accepted_tokens.scalar_type() == ScalarType::Int,
+                  "index tensors must be CUDA int32");
+  STD_TORCH_CHECK(state.is_cuda() && state.scalar_type() == ScalarType::Float,
+                  "replay path requires a CUDA float32 state");
+  STD_TORCH_CHECK(flags.is_cuda() && flags.scalar_type() == ScalarType::Byte &&
+                      flags.dim() == 2 && flags.size(0) >= state.size(0) &&
+                      flags.size(1) == state.size(1) && flags.is_contiguous(),
+                  "flags must be a contiguous uint8 [num_blocks, HV] tensor");
+  // An empty norm_weight selects the pre-norm output variant (no gated norm;
+  // output_gate is then ignored and may be empty).
+  const bool apply_norm = norm_weight.numel() > 0;
+  STD_TORCH_CHECK(!apply_norm || (output_gate.is_cuda() &&
+                      output_gate.scalar_type() == ScalarType::BFloat16),
+                  "output_gate must be a CUDA bfloat16 tensor");
+  STD_TORCH_CHECK(norm_weight.is_cuda() &&
+                      (norm_weight.scalar_type() == ScalarType::Float ||
+                       norm_weight.scalar_type() == ScalarType::BFloat16),
+                  "norm_weight must be a CUDA float32 or bfloat16 tensor");
+  STD_TORCH_CHECK(out.is_cuda() && out.scalar_type() == ScalarType::BFloat16,
+                  "out must be a CUDA bfloat16 tensor");
+  STD_TORCH_CHECK(
+      output_gate_activation == "silu" || output_gate_activation == "sigmoid",
+      "output_gate_activation must be 'silu' or 'sigmoid'");
+  STD_TORCH_CHECK(mixed_qkv.dim() == 2, "mixed_qkv must be 2-D");
+  const int num_tokens = static_cast<int>(mixed_qkv.size(0));
+  STD_TORCH_CHECK(num_tokens > 0, "requires at least one token");
+  STD_TORCH_CHECK(
+      state.dim() == 4 && state.size(2) == kDimV && state.size(3) == kDimK,
+      "state must have shape [slots, HV, 128, 128]");
+  const int num_value_heads = static_cast<int>(state.size(1));
+  const int64_t key_width =
+      mixed_qkv.size(1) - static_cast<int64_t>(num_value_heads) * kDimV;
+  STD_TORCH_CHECK(key_width > 0 && key_width % (2 * kDimK) == 0,
+                  "mixed_qkv width is inconsistent with state");
+  const int num_key_heads = static_cast<int>(key_width / (2 * kDimK));
+  const int vh_per_kh = num_value_heads / num_key_heads;
+  STD_TORCH_CHECK(num_value_heads % num_key_heads == 0 &&
+                      ((vh_per_kh >= 1 && vh_per_kh <= 4) || vh_per_kh == 8),
+                  "requires HV/H in {1, 2, 3, 4, 8}");
+  STD_TORCH_CHECK(state_indices.dim() == 2 && state_indices.size(0) > 0 &&
+                      state_indices.size(1) >= 2 &&
+                      state_indices.size(1) <= kMaxLogTokens,
+                  "state_indices must have shape [N, S] with 2 <= S <= 4");
+  const int num_requests = static_cast<int>(state_indices.size(0));
+  STD_TORCH_CHECK(cu_seqlens.numel() == num_requests + 1 &&
+                      num_accepted_tokens.numel() == num_requests,
+                  "cu_seqlens / num_accepted_tokens size mismatch");
+  STD_TORCH_CHECK(a.dim() == 2 && a.size(0) == num_tokens &&
+                      a.size(1) == num_value_heads && b.dim() == 2 &&
+                      b.size(0) == num_tokens && b.size(1) == num_value_heads,
+                  "a/b must have shape [L, HV]");
+  STD_TORCH_CHECK(a_log.is_contiguous() && a_log.numel() == num_value_heads &&
+                      dt_bias.is_contiguous() &&
+                      dt_bias.numel() == num_value_heads,
+                  "A_log / dt_bias must be contiguous with HV elements");
+  STD_TORCH_CHECK(state_indices.is_contiguous() && cu_seqlens.is_contiguous() &&
+                      num_accepted_tokens.is_contiguous(),
+                  "index tensors must be contiguous");
+  STD_TORCH_CHECK(!apply_norm || (output_gate.dim() == 3 &&
+                      output_gate.size(0) == num_tokens &&
+                      output_gate.size(1) == num_value_heads &&
+                      output_gate.size(2) == kDimV),
+                  "output_gate must have shape [L, HV, 128]");
+  STD_TORCH_CHECK(!apply_norm ||
+                      (norm_weight.is_contiguous() && norm_weight.numel() == kDimV),
+                  "norm_weight must be contiguous with 128 elements");
+  STD_TORCH_CHECK(out.dim() == 3 && out.size(0) == num_tokens &&
+                      out.size(1) == num_value_heads && out.size(2) == kDimV &&
+                      out.is_contiguous(),
+                  "out must be contiguous [L, HV, 128]");
+  STD_TORCH_CHECK(mixed_qkv.stride(1) == 1 && a.stride(1) == 1 &&
+                      b.stride(1) == 1,
+                  "channels must be contiguous");
+  STD_TORCH_CHECK(state.stride(0) >= num_value_heads * kDimV * kDimK &&
+                      state.stride(1) == kDimV * kDimK &&
+                      state.stride(2) == kDimK && state.stride(3) == 1,
+                  "state must have contiguous [HV, 128, 128] slot contents");
+  STD_TORCH_CHECK(reinterpret_cast<uintptr_t>(state.data_ptr()) % 16 == 0 &&
+                      state.stride(0) % 4 == 0,
+                  "state slots must preserve 16-byte alignment");
+  STD_TORCH_CHECK(!apply_norm || (output_gate.stride(2) == 1 &&
+                                   output_gate.stride(1) == kDimV),
+                  "output_gate head rows must be contiguous");
+  STD_TORCH_CHECK(norm_eps >= 0.0, "norm_eps must be non-negative");
+
+  const GdnDecodeStrides strides{mixed_qkv.stride(0), a.stride(0), b.stride(0),
+                                 apply_norm ? output_gate.stride(0) : 0,
+                                 state.stride(0)};
+  const int dt_bias_type =
+      dt_bias_scalar_type == ScalarType::Float
+          ? kDtBiasFloat32
+          : (dt_bias_scalar_type == ScalarType::BFloat16 ? kDtBiasBFloat16
+                                                         : kDtBiasFloat16);
+  torch::stable::accelerator::DeviceGuard const device_guard(
+      mixed_qkv.get_device_index());
+  const cudaStream_t stream =
+      get_current_cuda_stream(mixed_qkv.get_device_index());
+  const dim3 grid(num_requests, num_value_heads);
+  const bool sigmoid = output_gate_activation == "sigmoid";
+  const auto launch = [&]<int VH, bool Sig>() {
+    auto kernel = red8 == 5   ? gdn_decode_replay_kernel<VH, Sig, 5>
+                  : red8 == 4 ? gdn_decode_replay_kernel<VH, Sig, 4>
+                  : red8 == 3 ? gdn_decode_replay_kernel<VH, Sig, 3>
+                  : red8 == 2 ? gdn_decode_replay_kernel<VH, Sig, 2>
+                  : red8 == 1 ? gdn_decode_replay_kernel<VH, Sig, 1>
+                              : gdn_decode_replay_kernel<VH, Sig, 0>;
+    kernel<<<grid, kThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(mixed_qkv.data_ptr()),
+        static_cast<const __nv_bfloat16*>(a.data_ptr()),
+        static_cast<const __nv_bfloat16*>(b.data_ptr()),
+        static_cast<const float*>(a_log.data_ptr()), dt_bias.data_ptr(),
+        static_cast<const int*>(state_indices.data_ptr()),
+        static_cast<const int*>(cu_seqlens.data_ptr()),
+        static_cast<const int*>(num_accepted_tokens.data_ptr()),
+        static_cast<float*>(state.data_ptr()),
+        static_cast<uint8_t*>(flags.data_ptr()),
+        static_cast<const __nv_bfloat16*>(output_gate.data_ptr()),
+        norm_weight.data_ptr(), static_cast<__nv_bfloat16*>(out.data_ptr()),
+        num_key_heads, num_value_heads,
+        static_cast<int>(state_indices.size(1)), dt_bias_type,
+        norm_weight.scalar_type() == ScalarType::BFloat16,
+        static_cast<float>(scale), static_cast<float>(norm_eps), strides,
+        apply_norm, static_cast<int>(log_cap) | (prologue_dbg << 12));
+  };
+  const auto dispatch_act = [&]<int VH>() {
+    if (sigmoid) {
+      launch.template operator()<VH, true>();
+    } else {
+      launch.template operator()<VH, false>();
+    }
+  };
+  switch (vh_per_kh) {
+    case 1: dispatch_act.template operator()<1>(); break;
+    case 2: dispatch_act.template operator()<2>(); break;
+    case 3: dispatch_act.template operator()<3>(); break;
+    case 4: dispatch_act.template operator()<4>(); break;
+    default: dispatch_act.template operator()<8>(); break;
+  }
+  const cudaError_t error = cudaGetLastError();
+  STD_TORCH_CHECK(error == cudaSuccess,
+                  "GDN replay decode kernel launch failed: ",
+                  cudaGetErrorString(error));
+}
+
+void gdn_replay_flush(torch::stable::Tensor const& state_ptrs,
+                      torch::stable::Tensor const& flag_ptrs,
+                      int64_t state_slot_stride, int64_t hv,
+                      torch::stable::Tensor const& bt,
+                      torch::stable::Tensor const& idx_mapping,
+                      torch::stable::Tensor const& p0,
+                      torch::stable::Tensor const& p1,
+                      torch::stable::Tensor const& p2, int64_t num_reqs,
+                      int64_t mode, int64_t block_size,
+                      int64_t use_idx_mapping,
+                      torch::stable::Tensor const& counters) {
+  using torch::headeronly::ScalarType;
+  if (num_reqs <= 0) return;
+  STD_TORCH_CHECK(state_ptrs.is_cuda() &&
+                      state_ptrs.scalar_type() == ScalarType::Long &&
+                      flag_ptrs.is_cuda() &&
+                      flag_ptrs.scalar_type() == ScalarType::Long &&
+                      state_ptrs.numel() == flag_ptrs.numel(),
+                  "pointer tables must be CUDA int64 of equal length");
+  STD_TORCH_CHECK(bt.is_cuda() && bt.scalar_type() == ScalarType::Int &&
+                      p0.is_cuda() && p0.scalar_type() == ScalarType::Int &&
+                      p1.is_cuda() && p1.scalar_type() == ScalarType::Int &&
+                      p2.is_cuda() && p2.scalar_type() == ScalarType::Int &&
+                      idx_mapping.is_cuda() &&
+                      idx_mapping.scalar_type() == ScalarType::Int,
+                  "index tensors must be CUDA int32");
+  // mode: bits 0-3 flush mode, bit 4 RED8 layout (must match the replay kernel).
+  const bool red8 = (mode >> 4) & 1;
+  mode &= 0xF;
+  STD_TORCH_CHECK(mode >= 0 && mode <= 3, "bad mode");
+  const int64_t bt_stride = bt.dim() == 2 ? bt.stride(0) : 1;
+  torch::stable::accelerator::DeviceGuard const device_guard(
+      bt.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream(bt.get_device_index());
+  const dim3 grid(static_cast<unsigned>(num_reqs), static_cast<unsigned>(hv),
+                  static_cast<unsigned>(state_ptrs.numel()));
+  auto flush_kernel = red8 ? gdn_replay_flush_kernel<true> : gdn_replay_flush_kernel<false>;
+  flush_kernel<<<grid, kThreads, 0, stream>>>(
+      static_cast<const int64_t*>(state_ptrs.data_ptr()),
+      static_cast<const int64_t*>(flag_ptrs.data_ptr()), state_slot_stride,
+      static_cast<int>(hv), static_cast<const int*>(bt.data_ptr()), bt_stride,
+      use_idx_mapping ? static_cast<const int*>(idx_mapping.data_ptr())
+                      : nullptr,
+      static_cast<const int*>(p0.data_ptr()),
+      static_cast<const int*>(p1.data_ptr()),
+      static_cast<const int*>(p2.data_ptr()), static_cast<int>(num_reqs),
+      static_cast<int>(mode), static_cast<int>(block_size),
+      counters.numel() >= 4
+          ? static_cast<unsigned long long*>(counters.data_ptr())
+          : nullptr);
+  const cudaError_t error = cudaGetLastError();
+  STD_TORCH_CHECK(error == cudaSuccess, "GDN replay flush launch failed: ",
+                  cudaGetErrorString(error));
+}
