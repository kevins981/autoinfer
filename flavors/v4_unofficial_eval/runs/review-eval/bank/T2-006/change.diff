+
+
+@triton.jit
+def _gemma_add_rms_norm_dyn128_kernel(
+    x_ptr,
+    res_ptr,
+    w_ptr,
+    q_ptr,
+    s_ptr,
+    y_ptr,
+    eps,
+    H: tl.constexpr,
+    GS: tl.constexpr,
+    HAS_RESIDUAL: tl.constexpr,
+    WRITE_Y: tl.constexpr,
+):
+    """Gemma add-RMSNorm fused with dynamic per-token-group e4m3 quant.
+
+    Same arithmetic as the unfused chain: the norm output is rounded to the
+    activation dtype, then per group of GS columns
+    ``scale = max(absmax, 1e-10) / 448``, ``q = clamp(y * (1 / scale))``
+    (per_token_group_quant_fp8 / QuantFP8 with use_ue8m0=False).
+    """
+    G: tl.constexpr = triton.next_power_of_2(H // GS)
+    row = tl.program_id(0).to(tl.int64)
+    g = tl.arange(0, G)
+    j = tl.arange(0, GS)
+    cols = g[:, None] * GS + j[None, :]
+    mask = cols < H
+
+    x = tl.load(x_ptr + row * H + cols, mask=mask, other=0.0)
+    if HAS_RESIDUAL:
+        r = tl.load(res_ptr + row * H + cols, mask=mask, other=0.0)
+    w = tl.load(w_ptr + cols, mask=mask, other=0.0)
+
+    h = x.to(tl.float32)
+    if HAS_RESIDUAL:
+        h += r.to(tl.float32)
+        # Residual stream: the fp32 sum, like flashinfer's fused_add_rmsnorm.
+        tl.store(res_ptr + row * H + cols, h, mask=mask)
+    var = tl.sum(h * h) / H
+    rstd = tl.rsqrt(var + eps)
+    y = (h * rstd * (1.0 + w.to(tl.float32))).to(x_ptr.dtype.element_ty)
+    if WRITE_Y:
+        tl.store(y_ptr + row * H + cols, y, mask=mask)
+    y = y.to(tl.float32)
+
+    amax = tl.maximum(tl.max(tl.abs(y), axis=1), 1e-10)
+    # Plain fp32 `/` (div.full, fast-math division) reproduces the CUDA
+    # per_token_group_quant kernel, which is compiled with --use_fast_math:
+    # scales and codes were bit-identical to the unfused chain in the unit test
+    # (div_rn did not match: 57% of scales differed by one ulp).
+    scale = amax / 448.0
+    inv = 1.0 / scale
+    q = tl.clamp(y * inv[:, None], -FP8_MAX, FP8_MAX)
+    tl.store(q_ptr + row * H + cols, q, mask=mask)
+    tl.store(s_ptr + row * (H // GS) + g, scale, mask=g < H // GS)
+
+
+def gemma_add_rms_norm_dyn128(
+    x: torch.Tensor,
+    residual: torch.Tensor | None,
+    weight: torch.Tensor,
+    eps: float,
+    write_y: bool = False,
+    group_size: int = 128,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor | None]:
+    """Gemma RMSNorm of ``x (+ residual)`` quantized to dynamic per-token-group
+    e4m3 for the next linear (the checkpoint's W8A8 activation scheme).
+
+    Returns ``(q, scales, y)``: fp8 data (M, H), fp32 scales (M, H // group_size)
+    row-major, and the bf16 normed activation (or None). ``residual`` is updated
+    in place to x + residual, like gemma_fused_add_rmsnorm.
+    """
+    assert x.dim() == 2 and x.is_contiguous()
+    assert x.dtype in (torch.bfloat16, torch.float16)
+    assert residual is None or (residual.shape == x.shape and residual.is_contiguous())
+    M, H = x.shape
+    assert weight.shape == (H,) and weight.is_contiguous()
+    assert H % group_size == 0
+    q = torch.empty((M, H), dtype=FP8_DTYPE, device=x.device)
+    scales = torch.empty((M, H // group_size), dtype=torch.float32, device=x.device)
+    y = torch.empty_like(x) if write_y else None
+    if M == 0:
+        return q, scales, y
+    _gemma_add_rms_norm_dyn128_kernel[(M,)](
+        x,
+        residual if residual is not None else x,
+        weight,
+        q,
+        scales,
+        y if y is not None else x,
+        eps,
+        H=H,
+        GS=group_size,
+        HAS_RESIDUAL=residual is not None,
+        WRITE_Y=write_y,
+        num_warps=8,
+    )
+    return q, scales, y
