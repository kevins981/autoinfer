+  for (int i = 0; i < 8; i++) {
+    uint32_t lo = (nw[i >> 1] >> (4 * (i & 1))) & 0x0F0F0F0Fu;
+    uint32_t mid = ((pw[i >> 2] >> (2 * (i & 3))) & 0x03030303u) << 4;
+    uint32_t hi = (r.p2 >> i) & 0x01010101u;
