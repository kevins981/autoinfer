                   "-DCMAKE_CUDA_COMPILER_LAUNCHER=ccache"],
    "python_arg": "-DVLLM_PYTHON_EXECUTABLE={python}",
    "default_targets": ["_C_stable_libtorch"],
    "target_outputs": {
      "_C_stable_libtorch": "vllm/_C_stable_libtorch.abi3.so",
      "_moe_C_stable_libtorch": "vllm/_moe_C_stable_libtorch.abi3.so",
      "cumem_allocator": "vllm/cumem_allocator.abi3.so"
    }
  }
