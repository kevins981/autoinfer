+        c_ids = ids[c0:c0 + chunk]
+        buf = torch.zeros(c_ids.numel(), w.shape[1], dtype=w.dtype, device=dev)
+        mine = (c_ids >= lo) & (c_ids < hi)
+        rows = (c_ids[mine] - lo)
+        buf[mine] = w[rows]
