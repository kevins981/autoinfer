diff --git a/vllm/v1/worker/t29_hostprobe.py b/vllm/v1/worker/t29_hostprobe.py
new file mode 100644
index 0000000000..bb43da053d
--- /dev/null
+++ b/vllm/v1/worker/t29_hostprobe.py
@@ -0,0 +1,176 @@
+# SPDX-License-Identifier: Apache-2.0
+"""T29_HOSTPROBE=<path prefix>: untraced host-vs-GPU timing per engine step (measurement only).
+
+Off (env unset) = ENABLED is False and every hook returns at its first line.
+On: only the TP rank-0 worker (GPU0, the pacing GPU) records; output <prefix>.rank0.jsonl.
+
+Per step (gpu_model_runner): host perf_counter_ns + a CUDA timing event (current stream) at
+  t0 execute_model entry, t1 after _model_forward returned, t2 at the end of sample_tokens (drafting included).
+Per GDN core call in eager steps (qwen_gdn_attention_core*): host ns at entry/exit (summed), and an event at
+  entry on every LAYER_EVERY-th call.
+GPU event times are put on the host clock through an anchor event: synchronize, record eA, synchronize, take host
+time tA -> gpu(e) = tA + elapsed(eA, e). Re-anchored every REANCHOR steps (one sync), and opportunistically
+(no sync) when at step entry the last recorded event already completed (GPU idle on that stream: error ~launch
+latency). Events are read lazily (query() only, never synchronize) a few steps later.
+Nothing is recorded while a CUDA graph is being captured.
+"""
+import json
+import os
+import time
+
+import torch
+
+_PATH = os.environ.get("T29_HOSTPROBE", "")
+ENABLED = bool(_PATH)
+LAYER_EVERY = int(os.environ.get("T29_HOSTPROBE_LAYER_EVERY", "8"))
+REANCHOR = int(os.environ.get("T29_HOSTPROBE_REANCHOR", "1000"))
+
+_state = None
+
+
+class _Probe:
+    def __init__(self):
+        self.f = open(f"{_PATH}.rank0.jsonl", "w", buffering=1 << 20)
+        self.pool = []
+        self.pending = []
+        self.cur = None
+        self.anchor = None  # (event, host_ns)
+        self.anchor_age = 0
+        self.last_ev = None
+        self.nstep = 0
+
+    def ev(self):
+        e = self.pool.pop() if self.pool else torch.cuda.Event(enable_timing=True)
+        e.record()
+        return e
+
+    def sync_anchor(self):
+        torch.cuda.synchronize()
+        e = torch.cuda.Event(enable_timing=True)
+        e.record()
+        torch.cuda.synchronize()
+        self.anchor = (e, time.perf_counter_ns(), "sync")
+        self.anchor_age = 0
+
+    def drain(self, final=False):
+        keep = []
+        for rec in self.pending:
+            evs = rec.pop("_evs")
+            if not final and not all(e.query() for _, e in evs):
+                rec["_evs"] = evs
+                keep.append(rec)
+                continue
+            if final:
+                for _, e in evs:
+                    e.synchronize()
+            ea, ta, kind = rec.pop("_anchor")
+            for name, e in evs:
+                g = ta + ea.elapsed_time(e) * 1e6  # ns on the host clock
+                rec.setdefault("g", {})[name] = round((g - rec["t0"]) / 1e3, 1)  # us since host t0
+                self.pool.append(e)
+            rec["anchor"] = kind
+            self.f.write(json.dumps(rec) + "\n")
+            self.nwritten = getattr(self, "nwritten", 0) + 1
+            if self.nwritten % 64 == 0:
+                self.f.flush()  # workers are force-killed at shutdown; atexit may not run
+        self.pending = keep
+
+
+def _get():
+    global _state
+    if _state is None:
+        _state = _Probe()
+    return _state
+
+
+def _active():
+    if not ENABLED or torch.cuda.is_current_stream_capturing():
+        return False
+    try:
+        from vllm.distributed import get_tensor_model_parallel_rank
+        return get_tensor_model_parallel_rank() == 0
+    except Exception:
+        return False
+
+
+def step_begin(scheduler_output, cudagraph_mode=None):
+    if not ENABLED or not _active():
+        return
+    p = _get()
+    t0 = time.perf_counter_ns()
+    p.drain()
+    idle = False
+    if p.anchor is None or p.anchor_age >= REANCHOR:
+        p.sync_anchor()
+        t0 = time.perf_counter_ns()
+    elif p.last_ev is not None and p.last_ev.query():
+        # GPU idle on this stream: an event recorded now completes within launch latency.
+        e = torch.cuda.Event(enable_timing=True)
+        e.record()
+        p.anchor = (e, time.perf_counter_ns(), "idle")
+        idle = True
+    p.anchor_age += 1
+    pt = 0
+    npre = 0
+    spec = scheduler_output.scheduled_spec_decode_tokens
+    for rid, n in scheduler_output.num_scheduled_tokens.items():
+        if n > 1 + len(spec.get(rid, ())):
+            pt += n
+            npre += 1
+    p.cur = dict(step=p.nstep, t0=t0, tok=scheduler_output.total_num_scheduled_tokens, pt=pt, npre=npre,
+                 nreq=len(scheduler_output.num_scheduled_tokens), idle_at_start=idle, _evs=[("e0", p.ev())], h={}, gdn_n=0, gdn_host_us=0.0, lay=[])
+    p.nstep += 1
+
+
+def mark(name, extra=None):
+    if not ENABLED or _state is None or _state.cur is None or torch.cuda.is_current_stream_capturing():
+        return
+    c = _state.cur
+    c["h"][name] = round((time.perf_counter_ns() - c["t0"]) / 1e3, 1)
+    c["_evs"].append((name, _state.ev()))
+    if extra:
+        c.update(extra)
+
+
+def step_end():
+    if not ENABLED or _state is None or _state.cur is None or torch.cuda.is_current_stream_capturing():
+        return
+    mark("e2")
+    p = _state
+    c = p.cur
+    p.last_ev = c["_evs"][-1][1]
+    c["_anchor"] = p.anchor
+    p.pending.append(c)
+    p.cur = None
+
+
+def gdn_enter():
+    """Returns a token for gdn_exit (host ns) or None."""
+    if not ENABLED or _state is None or _state.cur is None or torch.cuda.is_current_stream_capturing():
+        return None
+    c = _state.cur
+    i = c["gdn_n"]
+    c["gdn_n"] = i + 1
+    t = time.perf_counter_ns()
+    if i % LAYER_EVERY == 0:
+        name = f"L{i}"
+        c["h"][name] = round((t - c["t0"]) / 1e3, 1)
+        c["_evs"].append((name, _state.ev()))
+    return t
+
+
+def gdn_exit(t):
+    if t is None or _state is None or _state.cur is None:
+        return
+    _state.cur["gdn_host_us"] += (time.perf_counter_ns() - t) / 1e3
+
+
+def close():
+    if _state is not None:
+        _state.drain(final=True)
+        _state.f.flush()
+
+
+if ENABLED:
+    import atexit
+    atexit.register(close)
