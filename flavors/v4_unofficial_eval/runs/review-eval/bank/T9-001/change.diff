+void fused_gdn_decode_post_conv_mtp_dl(
+    torch::stable::Tensor const& mixed_qkv, torch::stable::Tensor const& a,
+    torch::stable::Tensor const& b, torch::stable::Tensor const& a_log,
+    torch::stable::Tensor const& dt_bias,
+    torch::stable::Tensor const& state_indices,
+    torch::stable::Tensor const& cu_seqlens,
+    torch::stable::Tensor const& num_accepted_tokens,
+    torch::stable::Tensor& state, torch::stable::Tensor const& output_gate,
+    torch::stable::Tensor const& norm_weight, torch::stable::Tensor& out,
+    torch::stable::Tensor& fmt, torch::stable::Tensor const& seq_lens,
+    int64_t block_size_i64, double scale, double norm_eps, const std::string& output_gate_activation) {
+  using torch::headeronly::ScalarType;
+  STD_TORCH_CHECK(state.scalar_type() == ScalarType::Float,
+                  "DL op requires float32 state");
+  STD_TORCH_CHECK(fmt.is_cuda() && fmt.scalar_type() == ScalarType::Int &&
+                      fmt.is_contiguous() && fmt.size(0) == state.size(0) &&
+                      fmt.size(1) == state.size(1),
+                  "fmt must be int32 [slots, HV]");
+  STD_TORCH_CHECK(seq_lens.is_cuda() && seq_lens.scalar_type() == ScalarType::Int &&
+                      seq_lens.numel() >= state_indices.size(0),
+                  "seq_lens must be int32 [>=N]");
+  const int block_size = static_cast<int>(block_size_i64);
+  STD_TORCH_CHECK(state_indices.dim() == 2 && state_indices.size(0) > 0 &&
+                      state_indices.size(1) > 0 &&
+                      state_indices.size(1) <= kMaxMtpTokens,
+                  "state_indices must have shape [N, S] with 1 <= S <= 8");
+  STD_TORCH_CHECK(state.dim() == 4 && state.size(2) == kDimV &&
+                      state.size(3) == kDimK && state.stride(1) == kDimV * kDimK &&
+                      state.stride(2) == kDimK && state.stride(3) == 1 &&
+                      state.stride(0) % 4 == 0 &&
+                      reinterpret_cast<uintptr_t>(state.data_ptr()) % 16 == 0,
+                  "state layout");
+  STD_TORCH_CHECK(mixed_qkv.is_cuda() && mixed_qkv.scalar_type() == ScalarType::BFloat16 &&
+                      mixed_qkv.dim() == 2 && mixed_qkv.stride(1) == 1 &&
+                      a.stride(1) == 1 && b.stride(1) == 1 &&
+                      output_gate.stride(2) == 1 && output_gate.stride(1) == kDimV &&
+                      out.is_contiguous() && norm_weight.is_contiguous() &&
+                      (output_gate_activation == "silu" || output_gate_activation == "sigmoid"),
+                  "bad inputs");
+  const int num_value_heads = static_cast<int>(state.size(1));
+  const int64_t key_width =
+      mixed_qkv.size(1) - static_cast<int64_t>(num_value_heads) * kDimV;
+  STD_TORCH_CHECK(key_width > 0 && key_width % (2 * kDimK) == 0, "mixed_qkv width");
+  const int num_key_heads = static_cast<int>(key_width / (2 * kDimK));
+  STD_TORCH_CHECK(num_value_heads % num_key_heads == 0, "HV/H");
+  const int ratio = num_value_heads / num_key_heads;
+  const GdnDecodeStrides strides{mixed_qkv.stride(0), a.stride(0), b.stride(0),
+                                 output_gate.stride(0), state.stride(0)};
+  const auto* a_ptr = static_cast<const __nv_bfloat16*>(a.data_ptr());
+  const auto* b_ptr = static_cast<const __nv_bfloat16*>(b.data_ptr());
+  const auto* og = static_cast<const __nv_bfloat16*>(output_gate.data_ptr());
+  const bool sig = output_gate_activation == "sigmoid";
+#define GDN_DL_CASE(R)                                                        \
+  case R:                                                                     \
+    if (sig)                                                                  \
+      launch_gdn_decode_post_conv_mtp_dl<R, true>(                            \
+          mixed_qkv, a_log, dt_bias, state_indices, cu_seqlens,               \
+          num_accepted_tokens, state, norm_weight, out, fmt, seq_lens,        \
+          block_size, a_ptr,                                                  \
+          b_ptr, og, num_key_heads, num_value_heads, scale, norm_eps,         \
+          strides);                                                           \
+    else                                                                      \
+      launch_gdn_decode_post_conv_mtp_dl<R, false>(                           \
+          mixed_qkv, a_log, dt_bias, state_indices, cu_seqlens,               \
+          num_accepted_tokens, state, norm_weight, out, fmt, seq_lens,        \
+          block_size, a_ptr,                                                  \
+          b_ptr, og, num_key_heads, num_value_heads, scale, norm_eps,         \
+          strides);                                                           \
+    break;
+  switch (ratio) {
+    GDN_DL_CASE(1)
+    GDN_DL_CASE(2)
+    GDN_DL_CASE(3)
+    GDN_DL_CASE(4)
+    GDN_DL_CASE(8)
+    default:
+      STD_TORCH_CHECK(false, "HV/H must be in {1,2,3,4,8}");
+  }
+#undef GDN_DL_CASE
+}
+
+void gdn_dl_materialize(torch::stable::Tensor const& state_indices,
+                        torch::stable::Tensor const& num_accepted_tokens,
+                        torch::stable::Tensor& state,
+                        torch::stable::Tensor& fmt) {
+  using torch::headeronly::ScalarType;
+  STD_TORCH_CHECK(state.scalar_type() == ScalarType::Float && state.dim() == 4 &&
+                      state.stride(1) == kDimV * kDimK && state.stride(2) == kDimK &&
+                      state.stride(3) == 1 && state.stride(0) % 4 == 0 &&
+                      reinterpret_cast<uintptr_t>(state.data_ptr()) % 16 == 0,
+                  "state layout");
+  STD_TORCH_CHECK(state_indices.dim() == 2 && state_indices.scalar_type() == ScalarType::Int &&
+                      state_indices.is_contiguous() &&
+                      num_accepted_tokens.scalar_type() == ScalarType::Int &&
+                      num_accepted_tokens.numel() >= state_indices.size(0) &&
+                      fmt.scalar_type() == ScalarType::Int && fmt.is_contiguous() &&
+                      fmt.size(0) == state.size(0) && fmt.size(1) == state.size(1),
+                  "materialize inputs");
+  const int n = static_cast<int>(state_indices.size(0));
+  if (n == 0) return;
+  torch::stable::accelerator::DeviceGuard const device_guard(
+      state.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream(state.get_device_index());
+  const dim3 grid(n, static_cast<int>(state.size(1)));
+  gdn_dl_materialize_kernel<<<grid, kThreads, 0, stream>>>(
+      static_cast<const int*>(state_indices.data_ptr()),
+      static_cast<const int*>(num_accepted_tokens.data_ptr()),
+      static_cast<float*>(state.data_ptr()), static_cast<int*>(fmt.data_ptr()),
+      static_cast<int>(state.size(1)), static_cast<int>(state_indices.size(1)),
+      state.stride(0));
+  const cudaError_t error = cudaGetLastError();
+  STD_TORCH_CHECK(error == cudaSuccess, "GDN DL materialize launch failed: ",
+                  cudaGetErrorString(error));
+}
