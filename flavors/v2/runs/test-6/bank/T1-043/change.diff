+# SPDX-License-Identifier: Apache-2.0
+"""Lossless compressed storage of the bf16 target lm_head (decoded inside its GEMM).
+
+At load, each rank's lm_head shard is re-encoded with the host-staged AR's
+block-exponent codec (per 32 values: max exponent + sign/7-bit mantissa + 4-bit
+exponent offset, raw fallback per block; ~0.78 of the bytes). Every block is
+decoded back and compared bitwise with the original before anything changes;
+on any mismatch the raw shard and the cuBLAS path stay. Otherwise the raw shard
+is freed (no full-size copy remains) and the head's GEMM becomes a kernel that
+decodes the exact bf16 weights in registers and runs bf16 MMA with fp32
+accumulation over all of K (one bf16 rounding), so only the fp32 summation
+order differs from cuBLAS.
+
+VLLM_LMH_CODEC=0 disables it. VLLM_LMH_CODEC_PF=0 stops the final-norm AR from
+L2-prefetching the (encoded) lm_head prefix.
+"""
+
+import hashlib
+import os
+
+import torch
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_ENABLED = os.environ.get("VLLM_LMH_CODEC", "1") != "0"
+_PREFETCH = os.environ.get("VLLM_LMH_CODEC_PF", "1") != "0"
+_GROUP_BYTES = 1600  # 32 blocks x 32 values (one n8 tile x 128 cols) per group
+_SIDE_GROUPS = 4096  # overflow-group capacity (512 B each)
+_MAX_M = 64
+_mod = None
+
+
+def _load_ext():
+    global _mod
+    if _mod is not None:
+        return _mod
+    from torch.utils.cpp_extension import load
+
+    if "TORCH_EXTENSIONS_DIR" not in os.environ:
+        os.environ["TORCH_EXTENSIONS_DIR"] = os.path.join(
+            envs.VLLM_CACHE_ROOT, "torch_extensions"
+        )
+    src = os.path.join(os.path.dirname(__file__), "lmh_codec.cu")
+    with open(src, "rb") as f:
+        tag = hashlib.sha1(f.read()).hexdigest()[:10]
+    name = f"vllm_lmh_codec_{tag}"
+    build_dir = os.path.join(os.environ["TORCH_EXTENSIONS_DIR"], name)
+    os.makedirs(build_dir, exist_ok=True)
+    major, minor = torch.cuda.get_device_capability()
+    os.environ.setdefault("TORCH_CUDA_ARCH_LIST", f"{major}.{minor}")
+    _mod = load(name, [src], build_directory=build_dir, verbose=False,
+                extra_cuda_cflags=["-O3"])
+    return _mod
+
+
+class LmhCodecMethod:
+    """quant_method of a target lm_head whose weight is stored encoded."""
+
+    def __init__(self, orig_method, enc: torch.Tensor, side: torch.Tensor, n: int, k: int):
+        self.orig_method = orig_method
+        self.enc = enc
+        self.side = side
+        self.n = n
+        self.k = k
+        self.mod = _load_ext()
+
+    def __getattr__(self, name):
+        return getattr(self.__dict__["orig_method"], name)
+
+    def apply(self, layer, x: torch.Tensor, bias: torch.Tensor | None = None) -> torch.Tensor:
+        assert bias is None, "lm_head codec: bias not supported"
+        lead = x.shape[:-1]
+        x2 = x.reshape(-1, self.k)
+        if not x2.is_contiguous():
+            x2 = x2.contiguous()
+        m = x2.shape[0]
+        out = torch.empty((m, self.n), dtype=x2.dtype, device=x2.device)
+        for i in range(0, m, _MAX_M):
+            self.mod.gemm(x2[i:i + _MAX_M], self.enc, self.side, self.n, out[i:i + _MAX_M])
+        return out.reshape(*lead, self.n)
+
+    def embedding(self, layer, input_):
+        raise RuntimeError("lm_head codec: the target lm_head weight is stored encoded")
+
+
+def lm_head_prefetch_tensor(head) -> torch.Tensor | None:
+    """What the final-norm AR should L2-prefetch for this head (the encoded buffer if encoded)."""
+    enc = getattr(head, "_lmh_codec_enc", None)
+    if enc is not None:
+        return enc if _PREFETCH else None
+    w = getattr(head, "weight", None)
+    return w if isinstance(w, torch.Tensor) and w.is_cuda else None
+
+
+def _target_lm_head(model):
+    lm = model.get_language_model() if hasattr(model, "get_language_model") else model
+    return getattr(lm, "lm_head", None) or getattr(model, "lm_head", None)
+
+
+@torch.no_grad()
+def maybe_encode_target_lm_head(model) -> bool:
+    """Encode the target lm_head in place (call after the drafter copied what it needs)."""
+    if not _ENABLED:
+        logger.info("lm_head codec: disabled (VLLM_LMH_CODEC=0)")
+        return False
+    from vllm.model_executor.layers.vocab_parallel_embedding import (
+        ParallelLMHead,
+        UnquantizedEmbeddingMethod,
+    )
+
+    head = _target_lm_head(model)
+    w = getattr(head, "weight", None)
+    if (
+        not isinstance(head, ParallelLMHead)
+        or type(head.quant_method) is not UnquantizedEmbeddingMethod
+        or getattr(head, "bias", None) is not None
+        or not isinstance(w, torch.Tensor)
+        or not w.is_cuda
+        or w.dtype != torch.bfloat16
+        or w.dim() != 2
+        or not w.is_contiguous()
+        or w.shape[0] % 8
+        or w.shape[1] % 128
+    ):
+        logger.warning("lm_head codec: target lm_head not eligible, keeping cuBLAS")
+        return False
+    n, k = w.shape
+    mod = _load_ext()
+    enc = torch.empty((n // 8) * (k // 128) * _GROUP_BYTES, dtype=torch.uint8, device=w.device)
+    side = torch.zeros(_SIDE_GROUPS * 512, dtype=torch.uint8, device=w.device)
+    raw_blocks, ovf, cap_miss, _ = mod.encode(w, enc, side)
+    bad = mod.verify(w, enc, side) if cap_miss == 0 else -1
+    if bad != 0:
+        logger.error(
+            "lm_head codec: LOSSLESS VERIFICATION FAILED (mismatching words %d, side-table misses %d); "
+            "keeping the raw lm_head and cuBLAS", bad, cap_miss)
+        return False
+    # sanity (not bitwise: fp32 summation order differs from cuBLAS) on random input, incl. a chunked M
+    method = LmhCodecMethod(head.quant_method, enc, side, n, k)
+    gen = torch.Generator(device=w.device).manual_seed(0)
+    worst, agree, rows = 0.0, 0, 0
+    for m in (1, 17, 48, 64, 70):
+        x = torch.randn(m, k, device=w.device, dtype=torch.float32, generator=gen).to(torch.bfloat16)
+        ref = torch.nn.functional.linear(x, w).float()
+        got = method.apply(head, x).float()
+        rel = ((got - ref).abs().max() / ref.abs().max().clamp_min(1e-6)).item()
+        worst = max(worst, rel)
+        agree += int((got.argmax(-1) == ref.argmax(-1)).sum().item())
+        rows += m
+    torch.cuda.synchronize()
+    if not worst < 1e-2:
+        logger.error("lm_head codec: sanity check FAILED (max rel diff %.3e); keeping cuBLAS", worst)
+        return False
+    head.quant_method = method
+    head._lmh_codec_enc = enc
+    head._lmh_codec_side = side
+    raw_bytes = w.numel() * w.element_size()
+    # free the raw shard: no full-size copy of the weight remains
+    head.weight.data = torch.empty((0, k), dtype=w.dtype, device=w.device)
+    del w
+    torch.cuda.empty_cache()
+    logger.info(
+        "lm_head codec: target lm_head %dx%d encoded losslessly (verified bitwise over all blocks): "
+        "%.3f GB -> %.3f GB (%.4f), raw blocks %d, overflow groups %d; sanity vs cuBLAS max rel diff %.2e, "
+        "argmax agree %d/%d; L2 prefetch of encoded prefix %s",
+        n, k, raw_bytes / 1e9, (enc.numel() + ovf * 512) / 1e9, (enc.numel() + ovf * 512) / raw_bytes,
+        raw_blocks, ovf, worst, agree, rows, "on" if _PREFETCH else "off")
+    return True
