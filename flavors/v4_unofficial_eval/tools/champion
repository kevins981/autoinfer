#!/usr/bin/env python3
"""champion: the run's two-tier champion (manager writes; anyone may `show`).

  CONFIRMED (C): the last record whose official eval matched expectations. Official number.
  HEAD (U):      the unofficial champion: the last record promoted on a unofficial PASS. Teams build
                 on HEAD and run unofficial_eval against it. HEAD = C when nothing is unconfirmed.
  chain:         the records promoted since C, in order, each with its unofficial gain over the one
                 before it.

Commands:
  champion show                   C, HEAD, the chain, and whether a confirmation is due
  champion promote <id>           (manager) make <id> HEAD: needs its latest unofficial eval to be a PASS
                                  against the current HEAD
  champion confirm <id>           (manager) after `official_eval <id>` (<id> in the chain): compare
                                  its official number with the expected one (C's official number
                                  x the chain's unofficial gains up to <id>). MATCH: <id> becomes C.
                                  MISMATCH: says what to evaluate next (bisection of the chain)
  champion revert <id> --note T   (manager) remove <id> and everything promoted after it from the
                                  chain (they build on it); HEAD = the record before <id>

Confirmation is due when the chain's summed unofficial gains reach DUE_GAIN % or it holds DUE_STEPS
records (fixed values, not a judgment call). The files: champion.json (state) and champion.md
(the readable view, regenerated on every change).
"""
import argparse, json, math, os, sys
from datetime import datetime, timezone
from pathlib import Path

DUE_GAIN = 5.0         # % summed unofficial gains since C
DUE_STEPS = 4          # unconfirmed records
MISMATCH_MIN = 1.5     # %: mismatch if official < expected - max(MISMATCH_MIN, 2 sigma)
SIGMA_STEP = 0.75      # %: sigma of one unofficial gain (2 B starts vs 2 cached starts + between-job drift)
SIGMA_OFF = 0.8        # %: sigma of an official-vs-official comparison (2 trials each, different jobs)


def die(msg, code=1):
    print(f"champion: {msg}", file=sys.stderr)
    sys.exit(code)


def now():
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def run_dir():
    return Path(os.environ.get("AUTOINFER_RUN") or die("AUTOINFER_RUN is not set")).resolve()


def need_manager():
    if os.environ.get("AUTOINFER_ROLE", "") not in ("manager", ""):
        die("only the manager changes the champion")


def latest_official(run, rid):
    off = run / "bank" / rid / "official"
    if not off.exists():
        return None, None
    ok = [x for x in off.iterdir() if x.name.isdigit() and (x / "results.json").exists()]
    if not ok:
        return None, None
    x = max(ok, key=lambda x: int(x.name))
    return int(x.name), json.loads((x / "results.json").read_text())


def load(run):
    f = run / "champion.json"
    if f.exists():
        return json.loads(f.read_text())
    n, r = latest_official(run, "BASE")
    if not r:
        die("no champion.json and no official result for BASE")
    return {"confirmed": {"id": "BASE", "official": r["output_throughput"], "official_n": n, "time": "start"},
            "chain": [], "reverted": [], "history": [f"start: BASE confirmed at {r['output_throughput']:.1f} tok/s (official #{n})"]}


def head(c):
    return c["chain"][-1]["id"] if c["chain"] else c["confirmed"]["id"]


def due(c):
    g = sum(x["gain_pct"] for x in c["chain"])
    k = len(c["chain"])
    return (g >= DUE_GAIN or k >= DUE_STEPS), g, k


def expected(c, upto):
    e = c["confirmed"]["official"]
    k = 0
    for x in c["chain"]:
        e *= 1 + x["gain_pct"] / 100
        k += 1
        if x["id"] == upto:
            break
    return e, k


def save(run, c):
    (run / "champion.json").write_text(json.dumps(c, indent=1) + "\n")
    C = c["confirmed"]
    lines = ["# Champion", "",
             f"**HEAD (unofficial champion; build on it, run unofficial_eval against it): {head(c)}**", "",
             f"CONFIRMED: {C['id']}: official {C['official']:.1f} tok/s (bank/{C['id']}/official/{C['official_n']}/)", ""]
    if c["chain"]:
        lines.append("Promoted since CONFIRMED (unofficial gain over the record before it):")
        e = C["official"]
        for x in c["chain"]:
            e *= 1 + x["gain_pct"] / 100
            lines.append(f"- {x['id']} (team {x.get('team') or '?'}): {x['gain_pct']:+.2f}% "
                         f"(unofficial #{x['screen_n']}: {x['line']}); expected ~{e:.1f} tok/s")
        d, g, k = due(c)
        lines += ["", f"Unconfirmed: {k} records, summed unofficial gains {g:+.2f}%"
                  + ("  -> CONFIRMATION DUE" if d else f" (confirmation due at {DUE_GAIN:g}% or {DUE_STEPS} records)")]
    else:
        lines.append("Nothing unconfirmed: HEAD = CONFIRMED.")
    if c["reverted"]:
        lines += ["", "Reverted (removed from the chain; not champions):"]
        lines += [f"- {x['id']}: {x['why']} ({x['time'][:16]})" for x in c["reverted"]]
    lines += ["", "## History"] + [f"- {h}" for h in reversed(c["history"])]
    (run / "champion.md").write_text("\n".join(lines) + "\n")


def cmd_show(run, a):
    c = load(run)
    save(run, c) if not (run / "champion.json").exists() else None
    print((run / "champion.md").read_text())


def cmd_promote(run, a):
    need_manager()
    c = load(run)
    h = head(c)
    sd = run / "bank" / a.record / "unofficial"
    ns = sorted((int(x.name) for x in sd.iterdir() if x.name.isdigit() and (x / "unofficial.json").exists()), reverse=True) \
        if sd.exists() else []
    if not ns:
        die(f"{a.record} has no unofficial result")
    s = json.loads((sd / str(ns[0]) / "unofficial.json").read_text())
    if s.get("head") != h:
        die(f"{a.record}'s latest unofficial eval (#{ns[0]}) compared with {s.get('head')}, but HEAD is {h}: "
            f"the team must rebase onto {h} and run unofficial_eval again")
    if s.get("verdict") != "PASS":
        die(f"{a.record}'s latest unofficial eval (#{ns[0]}) verdict is {s.get('verdict')!r}, not PASS")
    line = next((l for l in reversed((run / "bank" / a.record / "record.md").read_text().splitlines())
                 if l.startswith(f"unofficial #{ns[0]} ")), "")
    short = line.split(": ", 1)[1].split(" (unofficial/")[0] if ": " in line else ""
    c["chain"].append({"id": a.record, "team": s.get("team"), "screen_n": ns[0], "gain_pct": s["gain_pct"],
                       "line": short[:200], "time": now()})
    c["history"].append(f"{now()[:16]}: {a.record} promoted to HEAD ({s['gain_pct']:+.2f}% over {h}, unofficial #{ns[0]})")
    save(run, c)
    d, g, k = due(c)
    print(f"HEAD = {a.record} ({s['gain_pct']:+.2f}% over {h}). Unconfirmed: {k} records, {g:+.2f}%."
          + (f" CONFIRMATION DUE: official_eval {a.record}, then champion confirm {a.record}." if d else ""))


def cmd_confirm(run, a):
    need_manager()
    c = load(run)
    ids = [x["id"] for x in c["chain"]]
    if a.record not in ids:
        die(f"{a.record} is not in the unconfirmed chain ({', '.join(ids) or 'empty'})")
    n, r = latest_official(run, a.record)
    if not r:
        die(f"{a.record} has no official result: run `official_eval {a.record}` first")
    e, k = expected(c, a.record)
    o = r.get("output_throughput") or 0
    sigma = math.sqrt(k * SIGMA_STEP ** 2 + SIGMA_OFF ** 2)
    tol = max(MISMATCH_MIN, 2 * sigma)
    gates_ok = bool(r.get("ok")) and all(r.get(g) == "pass" for g in ("gate_gsm8k", "gate_latency", "gate_long_request"))
    diff = 100 * (o / e - 1)
    beats = o > c["confirmed"]["official"]
    i = ids.index(a.record)
    if gates_ok and beats and diff >= -tol:
        old = c["confirmed"]
        c["confirmed"] = {"id": a.record, "official": o, "official_n": n, "time": now()}
        c["chain"] = c["chain"][i + 1:]
        c["history"].append(f"{now()[:16]}: {a.record} CONFIRMED: official {o:.1f} tok/s (expected {e:.1f}, {diff:+.1f}%, "
                            f"tolerance {tol:.1f}%; +{100 * (o / old['official'] - 1):.1f}% over {old['id']})")
        save(run, c)
        print(f"MATCH: {a.record} is CONFIRMED at {o:.1f} tok/s (expected {e:.1f}, {diff:+.1f}%, tolerance -{tol:.1f}%).")
        later = [x["id"] for x in c["chain"] if latest_official(run, x["id"])[1]]
        if later:
            print(f"Still unconfirmed with an official result: {', '.join(later)}: `champion confirm {later[-1]}` "
                  f"again (it reuses that result; no new eval).")
        return
    why = []
    if not gates_ok:
        why.append(f"gates: ok={r.get('ok')} GSM8K {r.get('gate_gsm8k')} latency {r.get('gate_latency')} "
                   f"128K {r.get('gate_long_request')}")
    if not beats:
        why.append(f"official {o:.1f} does not beat CONFIRMED {c['confirmed']['id']} {c['confirmed']['official']:.1f}")
    if diff < -tol:
        why.append(f"official {o:.1f} is {diff:+.1f}% vs expected {e:.1f} (tolerance -{tol:.1f}%)")
    c["history"].append(f"{now()[:16]}: {a.record} MISMATCH at confirmation: {'; '.join(why)}")
    save(run, c)
    print(f"MISMATCH for {a.record}: {'; '.join(why)}.")
    if i == 0:
        print(f"{a.record} is the first record after CONFIRMED, so it is the cause: "
              f"`champion revert {a.record} --note \"...\"` (this also reverts every record promoted after it).")
    else:
        mid = ids[(i - 1) // 2]
        print(f"Bisect: `official_eval {mid}`, then `champion confirm {mid}`. A MATCH there moves CONFIRMED to "
              f"{mid} and narrows the search to the records after it; a MISMATCH narrows it to {mid} and before.")


def cmd_revert(run, a):
    need_manager()
    c = load(run)
    ids = [x["id"] for x in c["chain"]]
    if a.record not in ids:
        die(f"{a.record} is not in the unconfirmed chain ({', '.join(ids) or 'empty'})")
    i = ids.index(a.record)
    gone = c["chain"][i:]
    c["chain"] = c["chain"][:i]
    for x in gone:
        c["reverted"].append({"id": x["id"], "team": x.get("team"), "why": a.note if x["id"] == a.record
                              else f"built on reverted {a.record}", "time": now()})
    c["history"].append(f"{now()[:16]}: reverted {', '.join(x['id'] for x in gone)} ({a.note}); HEAD = {head(c)}")
    save(run, c)
    print(f"Reverted {', '.join(x['id'] for x in gone)}. HEAD = {head(c)}.")


def main():
    p = argparse.ArgumentParser(prog="champion", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = p.add_subparsers(dest="cmd", required=True)
    sp.add_parser("show")
    for name in ("promote", "confirm"):
        sp.add_parser(name).add_argument("record")
    rv = sp.add_parser("revert")
    rv.add_argument("record")
    rv.add_argument("--note", required=True)
    a = p.parse_args()
    run = run_dir()
    {"show": cmd_show, "promote": cmd_promote, "confirm": cmd_confirm, "revert": cmd_revert}[a.cmd](run, a)


if __name__ == "__main__":
    main()
