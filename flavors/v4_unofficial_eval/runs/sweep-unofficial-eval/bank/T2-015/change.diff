+    const int i = idx / kDimK;
+    const int d = idx % kDimK;
+    const unsigned char* r = rows + i * kRowBytes;
+    replay_k[i][d] = *reinterpret_cast<const float*>(r + d * 4);
+    replay_v[i][d] = reinterpret_cast<const __nv_bfloat16*>(r + 512)[d];
+  }
+  if (tid < replay_count) {
+    const float2 db =
+        *reinterpret_cast<const float2*>(rows + tid * kRowBytes + 768);
