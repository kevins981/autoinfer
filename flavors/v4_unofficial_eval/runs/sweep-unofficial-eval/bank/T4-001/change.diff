+// Number of rows to replay: page A rows (c0, only with bit 8) then page B / the
+// single pending page (c1 = min(accepted, 3)).
+__device__ __forceinline__ int replay_row_counts(int flags, int accepted,
+                                                 const unsigned char* rows_base,
