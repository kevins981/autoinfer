+# SPDX-License-Identifier: Apache-2.0
+"""Host-staged 2-rank all-reduce for GPUs without peer-to-peer access.
+
+Both ranks write their partial into a pinned host buffer shared through a
+/dev/shm file (mapped into both processes and registered with
+cudaHostRegister), exchange per-chunk flags in the same shared memory and add
+the peer's partial locally (fp32 add, round to bf16: the same math as NCCL).
+The kernel is CUDA-graph capturable: the flag value (an epoch) lives in device
+memory and is advanced by the kernel itself.
+"""
+
+import os
+import uuid
+
+import torch
+import torch.distributed as dist
+from torch.distributed import ProcessGroup
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_SLOT_BYTES = 24 << 20  # max message size handled; larger falls back to NCCL
+_MIN_BYTES = 1024
+# L2 prefetch of the next GEMM's weights by extra blocks of the decode-size AR kernel (exact: cache
+# hints only). VLLM_HOSTAR_L2PF=0 disables it.
+_L2PF = os.environ.get("VLLM_HOSTAR_L2PF", "1") != "0"
+_L2PF_BLOCKS = int(os.environ.get("VLLM_HOSTAR_L2PF_BLOCKS", "8"))
+_L2PF_MAX_BYTES = int(float(os.environ.get("VLLM_HOSTAR_L2PF_MAX_MB", "88")) * (1 << 20))
+_L2PF_STEP = max(1, int(os.environ.get("VLLM_HOSTAR_L2PF_STRIDE", "32")) // 16)  # bytes/prefetch
+_L2PF_MSG_MAX = int(os.environ.get("VLLM_HOSTAR_L2PF_MSG_MAX", str(1 << 20)))  # decode-size ARs only
+# Bitwise-lossless re-encoding of the AR payload on the PCIe hop (per 32 bf16 values: max-exponent
+# byte + sign/7-bit mantissa + 4-bit exponent offset, raw fallback per block; ~0.77 of the bytes).
+# The peer's decoded partial is bit-identical, so the reduction is unchanged. VLLM_HOSTAR_COMP=0
+# disables it; messages below VLLM_HOSTAR_COMP_MIN_BYTES stay raw.
+_COMP = os.environ.get("VLLM_HOSTAR_COMP", "1") != "0"
+_COMP_MIN = int(os.environ.get("VLLM_HOSTAR_COMP_MIN_BYTES", "0"))
+# Fused all-reduce + residual add + Gemma RMSNorm (norm epilogue blocks in the AR kernel) for
+# messages up to VLLM_HOSTAR_NORM_MAX_BYTES (decode sizes). VLLM_HOSTAR_NORM=0 disables it.
+_NORM = os.environ.get("VLLM_HOSTAR_NORM", "1") != "0"
+_NORM_MAX = int(os.environ.get("VLLM_HOSTAR_NORM_MAX_BYTES", str(1 << 20)))
+_NORM_R = 2  # rows per norm block
+_mod = None
+
+
+def _load_ext():
+    global _mod
+    if _mod is not None:
+        return _mod
+    from torch.utils.cpp_extension import load
+
+    if "TORCH_EXTENSIONS_DIR" not in os.environ:
+        os.environ["TORCH_EXTENSIONS_DIR"] = os.path.join(
+            envs.VLLM_CACHE_ROOT, "torch_extensions"
+        )
+    import hashlib
+
+    src = os.path.join(os.path.dirname(__file__), "host_staged_ar.cu")
+    with open(src, "rb") as f:
+        tag = hashlib.sha1(f.read()).hexdigest()[:10]
+    # One build per source version: copies with different sources sharing the
+    # extensions dir don't rebuild over each other.
+    name = f"vllm_host_staged_ar_{tag}"
+    build_dir = os.path.join(os.environ["TORCH_EXTENSIONS_DIR"], name)
+    os.makedirs(build_dir, exist_ok=True)
+    major, minor = torch.cuda.get_device_capability()
+    os.environ.setdefault("TORCH_CUDA_ARCH_LIST", f"{major}.{minor}")
+    _mod = load(name, [src], build_directory=build_dir, verbose=False)
+    return _mod
+
+
+def _config(nbytes: int) -> tuple[int, int]:
+    """(grid, chunks per writer block) as a function of message size."""
+    if nbytes <= 600 * 1024:
+        return 8, 1
+    if nbytes <= 8 << 20:
+        return 16, 4
+    return 32, 8
+
+
+class HostStagedAllReduce:
+    _instance_made = False
+
+    def __init__(self, group: ProcessGroup, device: torch.device):
+        self.disabled = True
+        self._comp_logged = False
+        self._norm_logged = False
+        if HostStagedAllReduce._instance_made:
+            return
+        self.world_size = dist.get_world_size(group=group)
+        self.rank = dist.get_rank(group=group)
+        if self.world_size != 2:
+            return
+        HostStagedAllReduce._instance_made = True
+        self.device = device
+        torch.cuda.set_device(device)
+        mod = _load_ext()
+        # rank 0 creates the file; both map it; unlink once both have mapped.
+        name = [f"/dev/shm/vllm_hostar_{os.getpid()}_{uuid.uuid4().hex}"]
+        dist.broadcast_object_list(name, src=dist.get_process_group_ranks(group)[0],
+                                   group=group)
+        path = name[0]
+        if self.rank == 0:
+            mod.init(path, _SLOT_BYTES, 0, True)
+        dist.barrier(group=group)
+        if self.rank == 1:
+            mod.init(path, _SLOT_BYTES, 1, False)
+        dist.barrier(group=group)
+        if self.rank == 0:
+            os.unlink(path)
+        self.mod = mod
+        self.disabled = False
+        trace = os.environ.get("VLLM_HOSTAR_TRACE")  # test-only: path prefix
+        if trace:
+            self._start_trace(trace)
+        logger.info("Host-staged all-reduce (no-P2P, 2 ranks) enabled")
+
+    def _start_trace(self, prefix: str):
+        """Test-only: stamp every call into a device ring; dump it to
+        <prefix>.rank<r>.npy once <prefix>.dump exists."""
+        import threading
+        import time
+
+        import numpy as np
+
+        self.mod.trace_enable(1 << 19)
+        rank = self.rank
+
+        def watch():
+            while not os.path.exists(prefix + ".dump"):
+                time.sleep(0.5)
+            np.save(f"{prefix}.rank{rank}.npy", self.mod.trace_dump().numpy())
+            logger.info("host AR trace dumped (rank %d)", rank)
+
+        threading.Thread(target=watch, daemon=True).start()
+        logger.warning("Host-staged AR TRACE enabled (test-only): %s", prefix)
+
+    def should_use(self, inp: torch.Tensor) -> bool:
+        if self.disabled or inp.dtype != torch.bfloat16 or not inp.is_cuda:
+            return False
+        nbytes = inp.numel() * inp.element_size()
+        return (
+            _MIN_BYTES <= nbytes <= _SLOT_BYTES
+            and nbytes % 16 == 0
+            and inp.is_contiguous()
+        )
+
+    def all_reduce(
+        self,
+        inp: torch.Tensor,
+        prefetch: torch.Tensor | None = None,
+        prefetch2: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        out = torch.empty_like(inp)
+        nbytes = inp.numel() * 2
+        grid, k = _config(nbytes)
+        mode = 20 if (_COMP and nbytes >= _COMP_MIN) else 4
+        if mode == 20 and not self._comp_logged:
+            self._comp_logged = True
+            logger.info("Host-staged AR: lossless payload compression on (first message %d B)", nbytes)
+        if (
+            prefetch is not None
+            and _L2PF
+            and _L2PF_BLOCKS > 0
+            and nbytes <= _L2PF_MSG_MAX
+            and prefetch.is_cuda
+            and prefetch.device == inp.device
+        ):
+            self.mod.allreduce_pf(
+                inp, out, grid, k, 512, mode, prefetch, _L2PF_MAX_BYTES, _L2PF_BLOCKS,
+                _L2PF_STEP,
+                prefetch2 if prefetch2 is not None and prefetch2.is_cuda else None,
+            )
+        else:
+            self.mod.allreduce(inp, out, grid, k, 512, mode)
+        return out
+
+    def can_fuse_norm(self, inp: torch.Tensor, residual: torch.Tensor | None,
+                      weight: torch.Tensor) -> bool:
+        return (
+            _NORM
+            and residual is not None
+            and self.should_use(inp)
+            and inp.dim() == 2
+            and inp.numel() * 2 <= _NORM_MAX
+            and residual.dtype == torch.bfloat16
+            and residual.is_contiguous()
+            and residual.shape == inp.shape
+            and weight.dtype in (torch.bfloat16, torch.float32)
+            and weight.is_contiguous()
+            and weight.numel() == inp.shape[1]
+            and inp.shape[1] % 8 == 0
+            and _NORM_R * inp.shape[1] // 8 <= 4 * 512
+        )
+
+    def all_reduce_norm(
+        self,
+        inp: torch.Tensor,
+        residual: torch.Tensor,
+        weight: torch.Tensor,
+        eps: float,
+        prefetch: torch.Tensor | None = None,
+        prefetch2: torch.Tensor | None = None,
+        dbg: int = 0,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """all_reduce(inp) + residual add + Gemma RMSNorm in one kernel: returns (y, residual),
+        residual updated in place (as flashinfer gemma_fused_add_rmsnorm). dbg=1: test-only."""
+        out = torch.empty_like(inp)
+        nbytes = inp.numel() * 2
+        grid, k = _config(nbytes)
+        mode = 20 if (_COMP and nbytes >= _COMP_MIN) else 4
+        use_pf = (
+            prefetch is not None
+            and _L2PF
+            and _L2PF_BLOCKS > 0
+            and nbytes <= _L2PF_MSG_MAX
+            and prefetch.is_cuda
+            and prefetch.device == inp.device
+        )
+        if not self._norm_logged:
+            self._norm_logged = True
+            logger.info("Host-staged AR: fused residual add + RMSNorm epilogue on (first message %d B)", nbytes)
+        self.mod.allreduce_norm(
+            inp, out, residual, weight, float(eps), grid, k, 512, mode, _NORM_R,
+            prefetch if use_pf else None, _L2PF_MAX_BYTES, _L2PF_BLOCKS if use_pf else 0, _L2PF_STEP,
+            prefetch2 if (use_pf and prefetch2 is not None and prefetch2.is_cuda) else None, dbg,
+        )
+        return out, residual
+
+    def should_use_all_gather(self, inp: torch.Tensor, dim: int) -> bool:
+        if self.disabled or not inp.is_cuda or not inp.is_contiguous():
+            return False
+        nbytes = inp.numel() * inp.element_size()
+        inner = 1
+        for s in inp.shape[dim:]:
+            inner *= s
+        return (
+            _MIN_BYTES <= nbytes <= _SLOT_BYTES
+            and nbytes % 16 == 0
+            and (inner * inp.element_size()) % 16 == 0
+        )
+
+    def all_gather(self, inp: torch.Tensor, dim: int) -> torch.Tensor:
+        """Exact copy-based all-gather of two shards along `dim` (dim >= 0)."""
+        shape = list(inp.shape)
+        inner = 1
+        for s in shape[dim:]:
+            inner *= s
+        shape[dim] *= 2
+        out = torch.empty(shape, dtype=inp.dtype, device=inp.device)
+        grid, k = _config(inp.numel() * inp.element_size())
+        self.mod.allgather(inp, out, grid, k, 512, inner * inp.element_size())
+        return out
