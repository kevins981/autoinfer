+                                  tensor_model_parallel_all_gather)
+    from vllm.kernels.triton.fused_pre_fc_norms import fused_pre_fc_norms
+    from vllm.model_executor.layers.linear import UnquantizedLinearMethod
+    from vllm.model_executor.layers.lmh_cert import _load_ext, _numa_nodes_of
+
+    fc = inner.fc
+    w = fc.weight
+    tp = get_tensor_model_parallel_world_size()
+    ok = (type(fc.quant_method) is UnquantizedLinearMethod and w.dtype == torch.bfloat16 and w.dim() == 2
+          and w.is_cuda and getattr(fc, "gather_output", False) and w.shape[1] % 2 == 0
+          and getattr(fc, "bias", None) is None and getattr(inner, "embed_tokens", None) is not None)
+    if ok:
+        N, K2 = w.shape
+        H = K2 // 2
+        emb = inner.embed_tokens
+        V = emb.org_vocab_size
+        ok = N * tp == H and tuple(inner.pre_fc_norm_embedding.weight.shape) == (H,)
+    if tp > 1:
+        flag = torch.tensor([[1.0 if ok else 0.0]], device=torch.cuda.current_device())
+        ok = bool(tensor_model_parallel_all_gather(flag, dim=-1).min().item() > 0)
+    if not ok:
+        logger.warning("T57_FCTAB: drafter fc not eligible, keeping the stock path")
+        return False
+    dev = w.device
+    mod = _load_ext()
+    eps = inner.pre_fc_norm_embedding.variance_epsilon
+    tab = torch.empty((V, 2 * N if LO else N), dtype=torch.bfloat16)  # plain pages, first-touched here by the copy, then registered
+    we = inner.pre_fc_norm_embedding.weight
+    wh_w = inner.pre_fc_norm_hidden.weight
+    We = w[:, :H]
+    for c0 in range(0, V, CHUNK):
+        c1 = min(V, c0 + CHUNK)
+        ids = torch.arange(c0, c1, device=dev)
+        E = emb(ids)  # vocab-parallel lookup + AR (all ranks in lockstep)
+        en = fused_pre_fc_norms(E, E, we, wh_w, eps)[:, :H].contiguous()
+        t = torch.mm(en, We.t(), out_dtype=torch.float32)
+        hi = t.to(torch.bfloat16)
+        tab[c0:c1, :N].copy_(hi.cpu())
+        if LO:
+            tab[c0:c1, N:].copy_((t - hi.float()).to(torch.bfloat16).cpu())
+    mod.host_register(tab.data_ptr(), tab.numel() * tab.element_size())
+    addr = int(mod.host_dev_ptr(tab.data_ptr()))
+    st = FcTab(inner, tab, addr, V, N, w[:, H:], wh_w, eps, tp)
+    inner._t57_fctab = st
+    # self-check vs the stock path on random hidden rows and real vocab ids (diff of the fc output, all-gathered)
+    from vllm.model_executor.layers.linear import ColumnParallelLinear  # noqa: F401
+    g = torch.Generator(device=dev).manual_seed(1)
+    M = 64
+    ids = torch.randint(0, V, (M,), device=dev, generator=g)
+    h = (torch.randn(M, H, device=dev, generator=g) * 3.0).to(torch.bfloat16)
+    E = emb(ids)
