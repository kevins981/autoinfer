+def vocab_subset_lm_head_copy(
+    lm_head: ParallelLMHead,
+    num_rows: int,
+    quantization: Literal["fp8", "nvfp4"] | None,
+    chunk_rows: int = 8192,
+) -> ParallelLMHead:
+    """A ParallelLMHead over the first `num_rows` token ids of `lm_head`,
+    re-sharded over the TP ranks (optionally quantized). Row i is token i, so
+    its argmax is a token id of the full vocab."""
+    from vllm.distributed import tensor_model_parallel_all_reduce
+
+    dtype = lm_head.weight.dtype
+    num_rows = min(num_rows, lm_head.org_vocab_size)
+    with set_default_torch_dtype(dtype):
+        sub = ParallelLMHead(
+            num_rows,
+            lm_head.embedding_dim,
+            params_dtype=dtype,
+            padding_size=lm_head.padding_size,
+            prefix=lm_head.prefix + ".vocab_subset",
+            disable_tp=lm_head.disable_tp,
+        )
+    sub = sub.to(lm_head.weight.device)
+    src, dst = lm_head.shard_indices, sub.shard_indices
+    sub.weight.data.zero_()
+    for c0 in range(0, num_rows, chunk_rows):
+        c1 = min(num_rows, c0 + chunk_rows)
+        buf = torch.zeros(c1 - c0, lm_head.embedding_dim, dtype=dtype,
+                          device=lm_head.weight.device)
+        a, b = max(c0, src.org_vocab_start_index), min(c1, src.org_vocab_end_index)
+        if a < b:
+            off = src.org_vocab_start_index
+            buf[a - c0 : b - c0] = lm_head.weight.data[a - off : b - off]
+        if not lm_head.disable_tp and lm_head.tp_size > 1:
+            # Owners are disjoint: summing with zeros copies exactly.
+            buf = tensor_model_parallel_all_reduce(buf)
+        a, b = max(c0, dst.org_vocab_start_index), min(c1, dst.org_vocab_end_index)
+        if a < b:
+            off = dst.org_vocab_start_index
+            sub.weight.data[a - off : b - off] = buf[a - c0 : b - c0]
+    if quantization is not None:
+        sub = _quantize_copy(sub, quantization)
+    get_layerwise_info(sub).reset()
+    logger.info(
+        "Drafter lm_head over the first %d token ids (%d x %d per rank, %s).",
+        num_rows, sub.output_size_per_partition if hasattr(sub, "output_size_per_partition") else dst.num_org_elements,
+        lm_head.embedding_dim, quantization or dtype,
+    )
+    return sub
