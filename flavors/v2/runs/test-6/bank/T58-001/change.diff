+"""T30 two-wave layer-pipelined mixed steps: plan + split chooser + holder (prototype)."""
+import os
+from dataclasses import dataclass, field
+
+import numpy as np
+
+# T52_WAVE: 0: off; 1: two waves (eager, default); 2: eager forward with the old joined chain (control)
+MODE = int(os.environ.get("T52_WAVE", "1"))  # T52: on by default (0 = off)
+# T52 (test only): T52_WAVE_CTL=<file>: if the file exists its content (0/1/2) overrides MODE, re-read every step
+# (lets one server compare wave on/off token streams). Unset in serving.
+_CTL = os.environ.get("T52_WAVE_CTL", "")
+
+
+def refresh():
+    global MODE
+    if _CTL and os.path.exists(_CTL):
+        try:
+            MODE = int(open(_CTL).read().strip() or "0")
+        except ValueError:
+            pass
+MIN_TOKENS = int(os.environ.get("T30_WAVE_MIN", "768"))  # T52: below ~770 rows eager waves are host-bound
+K = int(os.environ.get("T30_WAVE_K", "2"))
+EXTRA_PLANS: dict = {}  # bench: k -> WavePlan
+FRAC = float(os.environ.get("T30_WAVE_FRAC", "0.5"))
+CHECK = int(os.environ.get("T30_WAVE_CHECK", "0"))
+BENCH_BINS = [int(x) for x in os.environ.get("T30_WAVE_BENCH_BINS", "0,1,2").split(",")]
+TRACE_DIR = os.environ.get("T30_WAVE_TRACE", "")
+BENCH = int(os.environ.get("T30_WAVE_BENCH", "0"))  # host-free timing of eligible steps (per-bin count)
+MAX_WAVE_ROWS = 2400  # DMA lane payload cap (24 MB of bf16 x 5120)
+
+
+@dataclass
+class WavePlan:
+    n: int
+    split: int  # token index where wave 1 starts (first split)
+    req_slices: list  # per-wave request slices (a cut request appears in neighbouring waves)
+    bounds: list = field(default_factory=list)  # token boundaries [0, s1, ..., n]
+    md: list = field(default_factory=list)  # per-wave {layer_name: metadata}
+    sm: list = field(default_factory=list)  # per-wave {layer_name: slot_mapping}
+
+
+_PLAN: WavePlan | None = None
+EAGER_STEP = False
+STATS = {'eager_steps': 0, 'wave_steps': 0}  # this step runs eager because of T30_WAVE (mode 1 or 2)
+
+
+def set_plan(p):
+    global _PLAN
+    _PLAN = p
+
+
+def get_plan():
+    return _PLAN
+
+
+def choose_split(num_scheduled_tokens: np.ndarray, num_decode_draft: np.ndarray, k: int | None = None):
+    """Return (splits, req_slices) or None. splits = k-1 increasing token indices (each 64-aligned
+    inside its request); wave 0 holds all spec/decode rows. req_slices[w] = requests touched by wave w
+    (a request cut by a split appears in both neighbouring waves)."""
+    k = k or K
+    R = len(num_scheduled_tokens)
+    n = int(num_scheduled_tokens.sum())
+    if MODE == 0 or n < MIN_TOKENS or R < 1 or k < 2:
+        return None
+    nd = 0
+    while nd < R and num_decode_draft[nd] >= 0:
+        nd += 1
+    if nd < R and (num_decode_draft[nd:R] >= 0).any():
+        return None  # spec rows not a prefix
+    cum = np.concatenate([[0], np.cumsum(num_scheduled_tokens)])
+    dec_end = int(cum[nd])
+    cands = set()
+    for r in range(nd, R):
+        st, ln = int(cum[r]), int(num_scheduled_tokens[r])
+        if st > 0 and st >= dec_end:
+            cands.add(st)
+        for j in range(64, ln, 64):
+            cands.add(st + j)
+    cands = sorted(c for c in cands if c >= 64 and c >= dec_end)
+    splits = []
+    prev = 0
+    for j in range(1, k):
+        target = (FRAC * n) if k == 2 else j * n / k
+        best = None
+        for c in cands:
+            if c - prev < 64 or n - c < 64 * (k - j):
+                continue
+            if c - prev > MAX_WAVE_ROWS or n - c > MAX_WAVE_ROWS * (k - j):
+                continue
+            if best is None or abs(c - target) < abs(best - target):
+                best = c
+        if best is None:
+            return None
+        splits.append(best)
+        prev = best
+    bounds = [0] + splits + [n]
+    if any(b - a > MAX_WAVE_ROWS for a, b in zip(bounds[:-1], bounds[1:])):
+        return None
+    slices = []
+    for a, b in zip(bounds[:-1], bounds[1:]):
+        r0 = int(np.searchsorted(cum, a, side="right")) - 1
+        r1 = int(np.searchsorted(cum, b - 1, side="right")) - 1
+        slices.append(slice(r0, r1 + 1))
+    return splits, slices
