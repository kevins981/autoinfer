#!/usr/bin/env python3
"""experiment: measure the current commit of the workspace with the task's frozen official harness
(the equivalent of `uv run train.py` in karpathy/autoresearch).

Usage: experiment [--timeout MIN]
  Run as a BACKGROUND command (~11-13 min with a warm cache; longer if it has to build).

What it does:
1. Checks: the code tree ($AUTOINFER_RUN/workspaces/main/vllm) has no uncommitted changes to
   tracked files (commit first); the run's limit (config.md) isn't reached; nobody else is on
   the GPUs.
2. Builds (`ws build main`) if the commit changes compiled code (csrc/, CMake) vs the last build.
3. Runs tasks/<task>/harness/eval.sh on the workspace with the tree's serve_args.txt (extra
   `vllm serve` flags on top of the task's; committed with the code, so git reset reverts it)
   (2 trials on fresh servers: ShareGPT 400 prompts at c=16; GSM8K-250; one 128K request), and
   summarizes it against BASE.
4. Prints a summary block; full output in $AUTOINFER_RUN/experiments/<n>-<commit>/ (results.json,
   logs). Exit 0 = measured (check `ok` and the gates), 1 = failed (see failed_stage),
   75 = GPUs busy with someone else (nothing run), 76 = the run's limit is reached.
"""
import argparse, json, subprocess, sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _gpu

TOOLS = Path(__file__).resolve().parent
COMPILED = (".cu", ".cuh", ".cpp", ".cc", ".c", ".h", ".hpp", ".cmake")   # + CMakeLists.txt below


def git(tree, *args):
    return subprocess.run(["git", "-C", str(tree), *args], capture_output=True, text=True)


def compiled_paths(tree, base):
    names = git(tree, "diff", "--name-only", base, "HEAD").stdout.split()
    return [p for p in names if p.startswith(("csrc/", "cmake/")) or p.endswith("CMakeLists.txt")
            or (p.endswith(COMPILED) and not p.startswith("vllm/"))]


def main():
    p = argparse.ArgumentParser(prog="experiment", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--timeout", type=float, default=45, help="minutes for the eval itself (default 45)")
    a = p.parse_args()
    run = _gpu.run_dir("experiment")
    ws = run / "workspaces" / "main"
    tree = ws / "vllm"
    meta = json.loads((ws / "ws.json").read_text())
    base = meta["baseline_commit"]
    if git(tree, "diff", "--quiet", "HEAD").returncode != 0:
        _gpu.die("experiment", "the code tree has uncommitted changes to tracked files: git commit first "
                               "(program.md: commit, then run the experiment)")
    commit = git(tree, "rev-parse", "--short=7", "HEAD").stdout.strip()
    _gpu.check_start("experiment", run, experiment=True)

    exps = run / "experiments"
    exps.mkdir(exist_ok=True)
    n = len([d for d in exps.iterdir() if d.is_dir()]) + 1
    out = exps / f"{n:03d}-{commit}"
    out.mkdir()

    # build if the commit's compiled files differ from what was last built
    comp = compiled_paths(tree, base)
    stamp = ws / "last_build.json"
    key = git(tree, "rev-parse", "HEAD:csrc").stdout.strip() + git(tree, "rev-parse", "HEAD:CMakeLists.txt").stdout.strip()
    last = json.loads(stamp.read_text()).get("key") if stamp.exists() else None
    if comp and key != last:
        print(f"commit {commit} changes compiled code ({', '.join(comp[:4])}): building", flush=True)
        r = subprocess.run([str(TOOLS / "ws"), "build", "main"], capture_output=True, text=True)
        (out / "build.log").write_text(r.stdout + r.stderr)
        if r.returncode != 0:
            (out / "failed_stage").write_text("build\n")
            print(r.stdout[-3000:] + r.stderr[-3000:])
            _gpu.die("experiment", f"build failed; log: {out / 'build.log'}")
        stamp.write_text(json.dumps({"key": key, "commit": commit}) + "\n")
    elif not comp and last:
        print("note: this commit has no compiled changes but the workspace has a custom build; "
              "rebuild with `ws build main` after reverting csrc/ changes if needed", flush=True)

    task = (run / "task").resolve()
    cmd = ["bash", str(task / "harness" / "eval.sh"), str(ws), str(out)]
    sa = tree / "serve_args.txt"
    if sa.exists() and sa.read_text().strip():
        cmd.append(str(sa))
        (out / "serve_args.txt").write_text(sa.read_text())
    print(f"experiment {n} (commit {commit}): running the official harness (~11 min)", flush=True)
    rc = _gpu.run_job("experiment", run, cmd, out / "eval.log", a.timeout, f"experiment:{n}:{commit}")
    if rc == 130:
        sys.exit(rc)
    if rc != 0 and not (out / "failed_stage").exists():
        (out / "failed_stage").write_text("timeout\n" if rc == _gpu.EXIT_TIMEOUT else f"exit {rc}\n")
    base_res = task / "baseline" / "official" / "results.json"
    subprocess.run([sys.executable, str(task / "harness" / "summarize.py"), str(out), str(base_res)],
                   capture_output=True, text=True)
    res = json.loads((out / "results.json").read_text()) if (out / "results.json").exists() else {"ok": False}
    if not res.get("ok"):
        print(f"---\nstatus:            FAILED at {res.get('failed_stage', '?')}\nlogs:              {out}")
        sys.exit(1)
    gates = all(res.get(g) == "pass" for g in ("gate_gsm8k", "gate_latency", "gate_long_request"))
    print("---")
    print(f"tok_s:             {res['output_throughput']:.1f}")
    print(f"tok_s_trials:      {' / '.join(str(x) for x in res.get('output_throughput_trials', []))}")
    print(f"vs_base_pct:       {res.get('vs_baseline_pct', 0):+.2f}")
    print(f"gates:             {'pass' if gates else 'FAIL'} (gsm8k {res.get('gate_gsm8k')} "
          f"{100 * res.get('gsm8k_accuracy', 0):.1f}%, latency {res.get('gate_latency')}, "
          f"128K {res.get('gate_long_request')})")
    print(f"ttft_p99_ms:       {res.get('p99_ttft_ms', 0):.0f}")
    print(f"tpot_p99_ms:       {res.get('p99_tpot_ms', 0):.1f}")
    print(f"mtp_acceptance:    {res.get('mtp_acceptance_length')}")
    print(f"results:           {out / 'results.json'}")
    print(f"limits:            {_gpu.limits_line(run)}")


if __name__ == "__main__":
    main()
