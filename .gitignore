# Per-run heavy artifacts (run records like the search tree, KBs, journal stay tracked)
flavors/*/runs/*/workspaces/
# agent event streams (large transcripts)
flavors/*/runs/*/agents/
flavors/*/runs/*/**/logs/
*.log
*.nsys-rep
*.ncu-rep
*.sqlite
*.qdrep

# Caches, builds, envs, model weights
.cache/
__pycache__/
*.pyc
build/
env/
*.so
*.safetensors
*.bin

# Local / per-user Claude Code settings
.claude/settings.local.json
**/.claude/settings.local.json

# Secrets
.env
*.key
*.pem
# judge reports and overlays: temporary, kept locally only
evals/
