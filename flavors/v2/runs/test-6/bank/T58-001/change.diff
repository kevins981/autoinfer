diff --git a/vllm/model_executor/layers/mamba/gdn/replay.py b/vllm/model_executor/layers/mamba/gdn/replay.py
new file mode 100644
index 0000000000..43e7f4d5c2
--- /dev/null
+++ b/vllm/model_executor/layers/mamba/gdn/replay.py
@@ -0,0 +1,257 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GDN spec-decode "checkpoint + replay" bookkeeping.
+
+The fused spec-decode kernel (``fused_gdn_decode_post_conv_mtp_replay``) keeps one
+committed recurrent state per request (block-table slot S[0]) plus a log of the
+last step's per-token recurrence inputs (slot S[1]) instead of storing the state
+after every token. The state that stock code expects at slot S[accepted - 1] is
+only materialized on demand by ``gdn_replay_flush``: before any code outside the
+fused kernel reads or copies the state (prefix-cache align copies, the non-fused
+GDN paths).  A per-(block, value head) byte holds the number of logged tokens
+(0 = no valid log).
+
+Lazy checkpoint (R12-A): the flag byte is ``pending << 3 | last``. The log may
+hold ``pending`` accepted tokens not yet applied to S[0], followed by the last
+step's ``last`` tokens; the kernel stores S[0] only when the next step's tokens
+would not fit in the log (``VLLM_GDN_LAZY_CAP`` tokens, default 8; 0 = store
+every step as before). Every flush replays the pending tokens first.
+"""
+
+import os
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+# Upper bound on the number of state blocks (the KV cache may grow after CUDA
+# graph capture, so the flag arrays are sized once, generously).
+FLAGS_CAPACITY_BLOCKS = 8192
+
+
+_STATS: dict = {}
+
+
+def stats_enabled() -> bool:
+    return os.environ.get("VLLM_GDN_REPLAY_STATS", "0") == "1"
+
+
+def get_stats_tensor(device) -> torch.Tensor:
+    """int64[4] counters of flush blocks that materialized something, per mode
+    (0 pre-copy, 1 post-copy, 2 layer-spec, 3 layer-clear of a live log). Empty
+    tensor (= disabled) unless VLLM_GDN_REPLAY_STATS=1."""
+    t = _STATS.get(device)
+    if t is None:
+        t = torch.zeros(4 if stats_enabled() else 0, dtype=torch.int64, device=device)
+        _STATS[device] = t
+    return t
+
+
+_LAZY_CAP: list = []
+
+
+def gdn_lazy_log_cap() -> int:
+    """Log capacity (pending + new tokens) of the lazy checkpoint; 0 = off."""
+    if not _LAZY_CAP:
+        cap = int(os.environ.get("VLLM_GDN_LAZY_CAP", "8"))
+        if os.environ.get("VLLM_GDN_LAZY", "1") in ("0", "false", "False"):
+            cap = 0
+        assert 0 <= cap <= 8, "VLLM_GDN_LAZY_CAP must be in [0, 8]"
+        _LAZY_CAP.append(cap)
+    return _LAZY_CAP[0]
+
+
+_RED8: list = []
+
+
+def gdn_red8() -> int:
+    """RED8 layout of the replay/flush kernels: 8 lanes per state row (3-step
+    shuffle reductions instead of 5-step x 4 rows). Same math, fp32 dot order
+    differs. VLLM_GDN_RED8=0 restores the 32-lane layout; 1 = smem staging,
+    2 = register prefetch 1 chunk ahead (3 CTAs/SM), 3 = registers 2 chunks ahead
+    4 = 1 + batched prologue loads, 5 = 4 + warp-private staging without
+    per-chunk CTA barriers (1-5 are bitwise identical; default 5). Replay and flush kernels
+    always use the same layout (lazy replay stays bitwise self-consistent)."""
+    if not _RED8:
+        v = os.environ.get("VLLM_GDN_RED8", "5")
+        v = "0" if v in ("false", "False") else v
+        assert v in ("0", "1", "2", "3", "4", "5"), "VLLM_GDN_RED8 must be 0-5"
+        _RED8.append(int(v))
+    return _RED8[0]
+
+
+def gdn_red8_flush_bit() -> int:
+    """flush-kernel mode bit 4: RED8 order iff any RED8 variant is on."""
+    return (1 if gdn_red8() else 0) << 4
+
+
+def gdn_replay_requested() -> bool:
+    return os.environ.get("VLLM_GDN_REPLAY", "1") not in ("0", "false", "False")
+
+
+def gdn_mixed_replay_requested() -> bool:
+    """Replay kernel also for the spec requests of mixed (prefill-containing)
+    steps. Default on; VLLM_GDN_MIXED_REPLAY=0 restores mode-2 flush + Triton."""
+    return os.environ.get("VLLM_GDN_MIXED_REPLAY", "1") not in ("0", "false", "False")
+
+
+_TWO_SLOT: list = []
+
+
+def gdn_two_slot_enabled(vllm_config) -> bool:
+    """Route B: GDN keeps 2 state blocks per request (committed state S[0] + the
+    replay log S[1]) for any k instead of 1 + k. Only valid when every GDN spec
+    row goes through the replay kernel (the per-token-state kernels would index
+    past the 2-wide block-table row). VLLM_GDN_TWO_SLOT=0 restores stock slots."""
+    spec = vllm_config.speculative_config
+    on = (
+        os.environ.get("VLLM_GDN_TWO_SLOT", "1") not in ("0", "false", "False")
+        and spec is not None
+        and spec.num_speculative_tokens is not None
+        and 2 <= spec.num_speculative_tokens <= 3
+        and gdn_replay_requested()
+        and gdn_mixed_replay_requested()
+        and gdn_replay_op_available()
+        and vllm_config.use_v2_model_runner
+    )
+    _TWO_SLOT[:] = [on]
+    return on
+
+
+def gdn_two_slot() -> bool:
+    """Process-wide decision, set by the first gdn_two_slot_enabled() call (KV spec
+    creation); False if no GDN layer ever asked."""
+    return bool(_TWO_SLOT and _TWO_SLOT[0])
+
+
+def gdn_replay_op_available() -> bool:
+    return hasattr(torch.ops._C, "gdn_replay_flush") and hasattr(
+        torch.ops._C, "fused_gdn_decode_post_conv_mtp_replay"
+    )
+
+
+def _is_gdn_layer(layer: object) -> bool:
+    return hasattr(layer, "_gdn_replay_capable") and layer._gdn_replay_capable
+
+
+class GdnReplayRegistry:
+    """Flag arrays + batched flush over all replay-capable GDN layers."""
+
+    def __init__(self, forward_context: dict, kv_cache_config=None) -> None:
+        # Group layers by KV cache group (each group has its own block table).
+        name_to_group: dict[str, int] = {}
+        if kv_cache_config is not None:
+            for gid, group in enumerate(kv_cache_config.kv_cache_groups):
+                for name in group.layer_names:
+                    name_to_group[name] = gid
+        self.groups: dict[int, list] = {}
+        for name, layer in forward_context.items():
+            if not _is_gdn_layer(layer) or not hasattr(layer, "kv_cache"):
+                continue
+            state = layer.kv_cache[1]
+            hv = state.shape[1]
+            if layer._gdn_replay_flags is None:
+                layer._gdn_replay_flags = torch.zeros(
+                    max(FLAGS_CAPACITY_BLOCKS, state.shape[0]),
+                    hv,
+                    dtype=torch.uint8,
+                    device=state.device,
+                )
+            self.groups.setdefault(name_to_group.get(name, 0), []).append(layer)
+        self.hv = hv if self.groups else 0
+        self._tables: dict[int, tuple] = {}
+        self._calls = 0
+        # Capacity is fixed for the whole run; the KV cache must never outgrow it.
+        self.capacity = min(
+            layer._gdn_replay_flags.shape[0]
+            for layers in self.groups.values()
+            for layer in layers
+        )
+        self.num_layers = sum(len(v) for v in self.groups.values())
+        logger.info_once(
+            "GDN replay (state checkpoint + replay) enabled for %d layers",
+            self.num_layers,
+        )
+
+    def _group_tables(self, gid: int):
+        layers = self.groups[gid]
+        ptrs = tuple(layer.kv_cache[1].data_ptr() for layer in layers)
+        cached = self._tables.get(gid)
+        if cached is not None and cached[0] == ptrs:
+            return cached[1], cached[2], cached[3]
+        dev = layers[0].kv_cache[1].device
+        stride = layers[0].kv_cache[1].stride(0)
+        sp = torch.tensor(ptrs, dtype=torch.int64, device=dev)
+        fp = torch.tensor(
+            [layer._gdn_replay_flags.data_ptr() for layer in layers],
+            dtype=torch.int64,
+            device=dev,
+        )
+        self._tables[gid] = (ptrs, sp, fp, stride)
+        return sp, fp, stride
+
+    def flush(
+        self,
+        mode: int,
+        block_tables: dict[int, torch.Tensor],
+        idx_mapping: torch.Tensor,
+        num_reqs: int,
+        p0: torch.Tensor,
+        p1: torch.Tensor,
+        p2: torch.Tensor,
+        block_size: int,
+    ) -> None:
+        if num_reqs == 0:
+            return
+        for layers in self.groups.values():
+            assert layers[0].kv_cache[1].shape[0] <= self.capacity, (
+                "GDN replay flag capacity exceeded by the KV cache"
+            )
+        if idx_mapping.dtype != torch.int32:
+            idx_mapping = idx_mapping.to(torch.int32)
+        for gid in self.groups:
+            sp, fp, stride = self._group_tables(gid)
+            torch.ops._C.gdn_replay_flush(
+                sp,
+                fp,
+                stride,
+                self.hv,
+                block_tables[gid],
+                idx_mapping,
+                p0,
+                p1,
+                p2,
+                num_reqs,
+                mode | gdn_red8_flush_bit() | (32 if gdn_two_slot() else 0),
+                block_size,
+                1,
+                get_stats_tensor(sp.device),
+            )
+        self._calls += 1
+        if stats_enabled() and mode == 1 and self._calls % 20 == 0:
+            logger.info("GDN replay flush stats [pre,post,layer_spec,layer_clear]: %s",
+                        get_stats_tensor(idx_mapping.device).tolist())
+
+    def flush_pre(self, block_tables, idx_mapping, num_reqs, src_col, state_idx,
+                  src_off, block_size) -> None:
+        self.flush(0, block_tables, idx_mapping, num_reqs, src_col, state_idx,
+                   src_off, block_size)
+
+    def flush_post(self, block_tables, idx_mapping, num_reqs, num_accepted,
+                   state_idx, new_num_computed, block_size) -> None:
+        self.flush(1, block_tables, idx_mapping, num_reqs, num_accepted,
+                   state_idx, new_num_computed, block_size)
+
+
+def get_registry(forward_context: dict, kv_cache_config=None):
+    if not gdn_replay_requested() or not gdn_replay_op_available():
+        return None
+    reg = GdnReplayRegistry(forward_context, kv_cache_config)
+    if reg.num_layers > 0:
+        logger.info_once("GDN replay lazy checkpoint: log cap %d tokens%s; red8 layout %s",
+                         gdn_lazy_log_cap(),
+                         " (off: commit every step)" if gdn_lazy_log_cap() == 0 else "",
+                         "on" if gdn_red8() else "off")
+    return reg if reg.num_layers > 0 else None
diff --git a/vllm/model_executor/layers/mamba/gdn/t32_cap.py b/vllm/model_executor/layers/mamba/gdn/t32_cap.py
new file mode 100644
index 0000000000..5a837456e8
--- /dev/null
+++ b/vllm/model_executor/layers/mamba/gdn/t32_cap.py
@@ -0,0 +1,256 @@
+# T32 (leader-32.w1): CUDA-graph capture of the eager GDN prefill block of a step, per layer and per exact
+# (N non-spec sequences, NT chunks of 64) key. The block = replay flush (non-spec rows) + causal_conv1d_fn +
+# fused_post_conv_prep + fla chunk_gated_delta_rule + ssm-state write. Kernels are the stock ones; only the
+# launch method changes (bitwise equal, checked in the standalone bench agents/leader-32.w1/cap2.py).
+# Flag T32_GDN_CAP (default on since T52; 0 = off). T32_CAP_NMAX / T32_CAP_NTMAX bound the key set. T32_CHECK=K compares the
+# first K captured calls per layer against the same body run eagerly.
+import os
+import time
+
+import numpy as np
+import torch
+
+from vllm.logger import init_logger
+from vllm.utils.torch_utils import async_tensor_h2d
+
+logger = init_logger(__name__)
+
+ENABLED = os.environ.get("T32_GDN_CAP", "1") == "1"  # T52: on by default (0 = off)
+NMAX = int(os.environ.get("T32_CAP_NMAX", "3"))
+NTMAX = int(os.environ.get("T32_CAP_NTMAX", "16"))  # T52: waves of a 2048-token step fit
+CHECK = int(os.environ.get("T32_CHECK_BODY", "0"))   # captured vs the same body run eagerly
+CHECK_STOCK = int(os.environ.get("T32_CHECK", "0"))   # captured vs the STOCK eager path (pure-prefill steps)
+BM = 8  # causal_conv1d BLOCK_M
+PAD = -1
+
+# fixed layout of the per-step int32 metadata buffer (offsets independent of the key)
+_O_CU = 0
+_O_CI = _O_CU + NMAX + 1
+_O_CO = _O_CI + 2 * NTMAX
+_O_IDX = _O_CO + NMAX + 1
+_O_HI = _O_IDX + NMAX
+_O_ML = _O_HI + NMAX
+_O_OFF = _O_ML + BM * NTMAX
+_META_LEN = _O_OFF + BM * NTMAX
+
+
+class _Shared:
+    meta: torch.Tensor | None = None
+    qkv: torch.Tensor | None = None
+    a: torch.Tensor | None = None
+    b: torch.Tensor | None = None
+    out: torch.Tensor | None = None
+    pool = None
+    dims: tuple | None = None
+
+
+S = _Shared()
+
+
+def _ensure_shared(dev, qkv_dim, hv, dv, dtype):
+    if S.meta is None:
+        tmax = NTMAX * 64
+        S.meta = torch.zeros(_META_LEN, dtype=torch.int32, device=dev)
+        S.qkv = torch.zeros(tmax, qkv_dim, dtype=dtype, device=dev)
+        S.a = torch.zeros(tmax, hv, dtype=dtype, device=dev)
+        S.b = torch.zeros(tmax, hv, dtype=dtype, device=dev)
+        S.out = torch.zeros(tmax, hv, dv, dtype=dtype, device=dev)
+        S.pool = torch.cuda.graph_pool_handle()
+        S.dims = (qkv_dim, hv, dv)
+
+
+def _host_meta(lens: np.ndarray):
+    n = len(lens)
+    cnt = -(-lens // 64)
+    nt = int(cnt.sum())
+    h = np.zeros(_META_LEN, np.int32)
+    cu = np.zeros(n + 1, np.int32)
+    cu[1:] = np.cumsum(lens)
+    h[_O_CU:_O_CU + n + 1] = cu
+    ci = np.stack(
+        [np.repeat(np.arange(n), cnt), np.concatenate([np.arange(c) for c in cnt])], 1
+    ).astype(np.int32)
+    h[_O_CI:_O_CI + 2 * nt] = ci.reshape(-1)
+    co = np.zeros(n + 1, np.int32)
+    co[1:] = np.cumsum(cnt)
+    h[_O_CO:_O_CO + n + 1] = co
+    nums = -(-lens // BM)
+    tot = int(nums.sum())
+    totpad = BM * nt
+    ml = np.full(totpad, PAD, np.int32)
+    ml[:tot] = np.repeat(np.arange(n), nums)
+    off = np.full(totpad, PAD, np.int32)
+    off[:tot] = np.concatenate([np.arange(k) for k in nums])
+    h[_O_ML:_O_ML + totpad] = ml
+    h[_O_OFF:_O_OFF + totpad] = off
+    return h, nt
+
+
+def prepare_step(non_spec_cu_cpu, state_idx, has_init):
+    """Builder hook (once per step, shared by all layers). Returns (N, NT, T) or None if not capturable.
+    Writes the static metadata buffer: one pinned H2D + two D2D copies, all on the current stream."""
+    if S.meta is None:
+        return None
+    n = non_spec_cu_cpu.numel() - 1
+    if n < 1 or n > NMAX or state_idx is None or has_init is None:
+        return None
+    lens = non_spec_cu_cpu.diff().numpy().astype(np.int64)
+    if (lens <= 0).any():
+        return None
+    nt = int((-(-lens // 64)).sum())
+    if nt > NTMAX:
+        return None
+    h, nt = _host_meta(lens)
+    # T52: a private copy per metadata build (the waves build one per wave + one for the full step);
+    # LayerCap.run copies it into the static S.meta on the stream before each replay.
+    m = async_tensor_h2d(torch.from_numpy(h), device=S.meta.device)
+    m[_O_HI:_O_HI + n].copy_(has_init[:n])
+    return (n, nt, int(lens.sum()), m)
+
+
+def _views(n, nt):
+    m = S.meta
+    return dict(
+        cu=m[_O_CU:_O_CU + n + 1],
+        ci=m[_O_CI:_O_CI + 2 * nt].view(nt, 2),
+        co=m[_O_CO:_O_CO + n + 1],
+        idx=m[_O_IDX:_O_IDX + n],
+        hi=m[_O_HI:_O_HI + n],
+        ml=m[_O_ML:_O_ML + BM * nt],
+        off=m[_O_OFF:_O_OFF + BM * nt],
+    )
+
+
+class LayerCap:
+    def __init__(self, layer):
+        self.layer = layer
+        self.graphs: dict = {}
+        self.checked = 0
+        self.stock_checked = 0
+
+    # the eager body (also what is captured). ``where`` form instead of the boolean-mask zeroing (no host sync).
+    def _body(self, n, nt, with_out=True):
+        from vllm.model_executor.layers.mamba.gdn.qwen_gdn_linear_attn import fla_chunk_gated_delta_rule
+        from vllm.model_executor.layers.mamba.ops.causal_conv1d import causal_conv1d_fn
+        from vllm.third_party.flash_linear_attention.ops.fused_gdn_prefill_post_conv import fused_post_conv_prep
+        from types import SimpleNamespace
+        L = self.layer
+        v = _views(n, nt)
+        tc = nt * 64
+        kv = L.kv_cache
+        from vllm.model_executor.layers.mamba.gdn.qwen_gdn_linear_attn import is_conv_state_dim_first
+        conv_state = kv[0] if is_conv_state_dim_first() else kv[0].transpose(-1, -2)
+        ssm = kv[1]
+        if L._gdn_replay_flags is not None:
+            L._gdn_replay_flush_keys(v["idx"])
+        md = SimpleNamespace(
+            nums_dict={BM: dict(tot=BM * nt, mlist=None, mlist_len=BM * nt, offsetlist=None,
+                                batch_ptr=v["ml"], token_chunk_offset_ptr=v["off"])},
+            batch_ptr=v["ml"], token_chunk_offset_ptr=v["off"])
+        x = S.qkv[:tc]
+        w = L.conv1d.weight.view(L.conv1d.weight.size(0), L.conv1d.weight.size(2))
+        conv_out = causal_conv1d_fn(
+            x.transpose(0, 1), w, L.conv1d.bias, activation=L.activation, conv_states=conv_state,
+            has_initial_state=v["hi"].bool(), cache_indices=v["idx"], query_start_loc=v["cu"], metadata=md,
+            out=torch.empty(x.shape, dtype=x.dtype, device=x.device).transpose(0, 1),
+        ).transpose(0, 1)
+        q, k, vv, g, beta = fused_post_conv_prep(
+            conv_output=conv_out, a=S.a[:tc], b=S.b[:tc], A_log=L.A_log, dt_bias=L.dt_bias,
+            num_k_heads=L.num_k_heads // L.tp_size, head_k_dim=L.head_k_dim, head_v_dim=L.head_v_dim,
+            apply_l2norm=True, output_g_exp=False)
+        q, k, vv, g, beta = (t.unsqueeze(0) for t in (q, k, vv, g, beta))
+        init = ssm[v["idx"]]
+        init = torch.where(v["hi"].bool()[:, None, None, None], init, torch.zeros((), dtype=init.dtype, device=init.device))
+        o, fs = fla_chunk_gated_delta_rule(
+            q=q, k=k, v=vv, g=g, beta=beta, initial_state=init, output_final_state=True,
+            cu_seqlens=v["cu"], chunk_indices=v["ci"], chunk_offsets=v["co"], use_qk_l2norm_in_kernel=False,
+            core_attn_out=S.out[:tc].reshape(-1) if with_out else None)
+        ssm[v["idx"]] = fs.to(ssm.dtype)
+        return o
+
+    def capture(self, n, nt):
+        # benign metadata: n sequences, all state rows = slot 0 (null block), no initial state
+        lens = np.full(n, 64, np.int64)
+        lens[0] = 64 * (nt - n + 1)
+        h, _ = _host_meta(lens)
+        S.meta.copy_(torch.from_numpy(h).to(S.meta.device))
+        self.layer._gdn_replay_tables()
+        torch.cuda.synchronize()
+        self._body(n, nt)
+        torch.cuda.synchronize()
+        g = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(g, pool=S.pool):
+            self._body(n, nt)
+        self.graphs[(n, nt)] = g
+
+    def run(self, key, mixed_qkv, a, b, core_attn_out, n0, n1, state_idx, meta=None):
+        t = n1 - n0
+        if meta is not None:
+            S.meta.copy_(meta)
+        # state slots are per KV-cache group (= per layer position), the other metadata is shared
+        S.meta[_O_IDX:_O_IDX + key[0]].copy_(state_idx[:key[0]])
+        qd = S.qkv.shape[1]
+        S.qkv[:t].copy_(mixed_qkv[n0:n1, :qd])
+        S.a[:t].copy_(a[n0:n1])
+        S.b[:t].copy_(b[n0:n1])
+        if CHECK and self.checked < CHECK:
+            self._checked_replay(key, t)
+        else:
+            self.graphs[key].replay()
+        core_attn_out[n0:n1].copy_(S.out[:t])
+
+    def _checked_replay(self, key, t):
+        n, nt = key
+        kv = self.layer.kv_cache
+        v = _views(n, nt)
+        rows = v["idx"].long()
+        ssm0 = kv[1][rows].clone(); conv0 = kv[0][rows].clone()
+        self.graphs[key].replay()
+        og = S.out[:t].clone(); ssm_g = kv[1][rows].clone(); conv_g = kv[0][rows].clone()
+        kv[1][rows] = ssm0; kv[0][rows] = conv0
+        if self.layer._gdn_replay_flags is not None:
+            pass
+        self._body(n, nt)
+        oe = S.out[:t].clone(); ssm_e = kv[1][rows].clone(); conv_e = kv[0][rows].clone()
+        torch.cuda.synchronize()
+        ok = bool(torch.equal(og, oe) and torch.equal(ssm_g, ssm_e) and torch.equal(conv_g, conv_e))
+        self.checked += 1
+        logger.info("T32_CHECK %s key=%s t=%d bitwise=%s", self.layer.prefix, key, t, ok)
+        if not ok:
+            logger.error("T32_CHECK MISMATCH %s key=%s maxdiff out=%g", self.layer.prefix, key,
+                         float((og.float() - oe.float()).abs().max()))
+
+
+def keys():
+    return [(n, nt) for n in range(1, NMAX + 1) for nt in range(n, NTMAX + 1)]
+
+
+def capture_all(model):
+    """Worker hook, after the model runner's own graph capture. One graph set per GDN layer."""
+    if not ENABLED:
+        return
+    from vllm.model_executor.layers.mamba.gdn.qwen_gdn_linear_attn import QwenGatedDeltaNetAttention
+    layers = [m for m in model.modules() if isinstance(m, QwenGatedDeltaNetAttention) and hasattr(m, "kv_cache")]
+    if not layers:
+        logger.warning("T32_GDN_CAP: no GDN layers found")
+        return
+    dev = torch.device("cuda")
+    l0 = layers[0]
+    free0 = torch.cuda.mem_get_info()[0]
+    t0 = time.perf_counter()
+    _ensure_shared(dev, l0.conv1d.weight.size(0), l0.num_v_heads // l0.tp_size, l0.head_v_dim, torch.bfloat16)
+    ks = keys()
+    cnt = 0
+    for L in layers:
+        if L.gdn_prefill_backend != "triton" or L.kv_cache[0].dtype != torch.bfloat16:
+            continue
+        lc = LayerCap(L)
+        for (n, nt) in ks:
+            lc.capture(n, nt)
+            cnt += 1
+        L._t32 = lc
+    torch.cuda.synchronize()
+    free1 = torch.cuda.mem_get_info()[0]
+    logger.info("T32_GDN_CAP: captured %d graphs (%d layers x %d keys, NMAX=%d NTMAX=%d) in %.1f s, "
+                "free GPU memory %.2f -> %.2f GiB (%.0f MiB used)", cnt, len(layers), len(ks), NMAX, NTMAX,
+                time.perf_counter() - t0, free0 / 2**30, free1 / 2**30, (free0 - free1) / 2**20)
