+        self.max_bytes = min(MAX_ROWS * MAX_ROW_BYTES, self.ext.max_payload_bytes())
+        self.disabled = False
+        logger.info(
+            "Host-mapped all-reduce enabled (rank %d, %d MiB pinned).",
+            self.rank,
+            total >> 20,
+        )
+        stats = os.environ.get("VLLM_HOST_MAPPED_AR_STATS")
+        if stats:
+            self._start_stats_thread(f"{stats}.rank{self.rank}")
