+    def _peer_p2p_ok(self) -> bool:
+        """True if the GPUs of the group can access each other (then NCCL P2P /
+        custom all-reduce is the better path)."""
+        try:
+            mine = current_platform.logical_device_id_to_visible_device_id(
+                self.device.index
+            )
+        except Exception:  # noqa: BLE001
+            mine = self.device.index
