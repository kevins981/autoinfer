+  fused_gdn_decode_post_conv_mtp_impl(
+      mixed_qkv, a, b, a_log, dt_bias, state_indices, cu_seqlens,
+      num_accepted_tokens, state, output_gate, norm_weight, out, scale,
+      norm_eps, output_gate_activation, nullptr);
+}
+
+// Replay variant: one state write per step; see gdn_replay_flush_kernel.
+void fused_gdn_decode_post_conv_mtp_replay(
+    torch::stable::Tensor const& mixed_qkv, torch::stable::Tensor const& a,
+    torch::stable::Tensor const& b, torch::stable::Tensor const& a_log,
+    torch::stable::Tensor const& dt_bias,
+    torch::stable::Tensor const& state_indices,
+    torch::stable::Tensor const& cu_seqlens,
+    torch::stable::Tensor const& num_accepted_tokens,
+    torch::stable::Tensor& state, torch::stable::Tensor const& output_gate,
+    torch::stable::Tensor const& norm_weight, torch::stable::Tensor& out,
+    torch::stable::Tensor const& replay_flags, double scale, double norm_eps,
+    const std::string& output_gate_activation) {
+  fused_gdn_decode_post_conv_mtp_impl(
+      mixed_qkv, a, b, a_log, dt_bias, state_indices, cu_seqlens,
+      num_accepted_tokens, state, output_gate, norm_weight, out, scale,
+      norm_eps, output_gate_activation, &replay_flags);
+}
+
+void gdn_replay_flush(torch::stable::Tensor const& state_indices,
+                      torch::stable::Tensor const& num_accepted_tokens,
+                      torch::stable::Tensor const& replay_flags,
+                      torch::stable::Tensor& state, int64_t dst_acc_slot) {
+  using torch::headeronly::ScalarType;
+  STD_TORCH_CHECK(state.scalar_type() == ScalarType::Float ||
+                      state.scalar_type() == ScalarType::BFloat16,
+                  "state must be float32 or bfloat16");
+  STD_TORCH_CHECK(state_indices.is_cuda() && state_indices.dim() == 2 &&
+                      state_indices.size(1) >= 2 &&
+                      state_indices.size(1) <= kReplayMaxRows &&
+                      state_indices.is_contiguous() &&
+                      state_indices.scalar_type() == ScalarType::Int,
+                  "state_indices must be contiguous int32 [N, 2..3]");
+  STD_TORCH_CHECK(num_accepted_tokens.is_cuda() &&
+                      num_accepted_tokens.scalar_type() == ScalarType::Int &&
+                      num_accepted_tokens.numel() >= state_indices.size(0),
+                  "num_accepted_tokens must be CUDA int32 [>=N]");
+  STD_TORCH_CHECK(replay_flags.is_cuda() &&
+                      replay_flags.scalar_type() == ScalarType::Int &&
+                      replay_flags.numel() >= state_indices.size(0),
+                  "replay_flags must be CUDA int32 [>=N]");
+  STD_TORCH_CHECK(state.dim() == 4 && state.size(2) == kDimV &&
+                      state.size(3) == kDimK,
+                  "state must have shape [slots, HV, 128, 128]");
+  const int num_requests = static_cast<int>(state_indices.size(0));
+  if (num_requests == 0) return;
+  const int hv = static_cast<int>(state.size(1));
+  torch::stable::accelerator::DeviceGuard const device_guard(
+      state.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream(state.get_device_index());
+  const dim3 grid(num_requests, hv);
+  if (state.scalar_type() == ScalarType::Float) {
+    gdn_replay_flush_kernel<float><<<grid, kThreads, 0, stream>>>(
+        static_cast<const int*>(state_indices.data_ptr()),
+        static_cast<const int*>(num_accepted_tokens.data_ptr()),
+        static_cast<const int*>(replay_flags.data_ptr()),
+        static_cast<float*>(state.data_ptr()), static_cast<int>(dst_acc_slot),
+        static_cast<int>(state_indices.size(1)), state.stride(0));
+  } else {
+    gdn_replay_flush_kernel<__nv_bfloat16><<<grid, kThreads, 0, stream>>>(
+        static_cast<const int*>(state_indices.data_ptr()),
+        static_cast<const int*>(num_accepted_tokens.data_ptr()),
+        static_cast<const int*>(replay_flags.data_ptr()),
+        static_cast<__nv_bfloat16*>(state.data_ptr()),
+        static_cast<int>(dst_acc_slot),
+        static_cast<int>(state_indices.size(1)), state.stride(0));
+  }
+  const cudaError_t error = cudaGetLastError();
+  STD_TORCH_CHECK(error == cudaSuccess, "GDN replay flush launch failed: ",
+                  cudaGetErrorString(error));
+}
diff --git a/csrc/host_all_reduce.cu b/csrc/host_all_reduce.cu
new file mode 100644
index 0000000000..31c501c672
--- /dev/null
+++ b/csrc/host_all_reduce.cu
@@ -0,0 +1,240 @@
+// One-shot 2-rank all-reduce through pinned host memory (for machines without GPU P2P).
+// Each rank writes its input to its slot in a shared (cudaHostRegister'ed) host buffer, publishes
+// a per-block sequence flag, waits for the peer's flag, then reads the peer slot and sums.
+// Slots are double-buffered by sequence parity; the sequence counter lives on the device (one per
+// block, advanced by the kernel itself), so the kernel is CUDA-graph capturable and replayable.
+#include "torch_utils.h"
+
+#include <torch/csrc/stable/macros.h>
+#include <torch/csrc/stable/accelerator.h>
+#include <torch/csrc/stable/tensor.h>
+#include <torch/csrc/stable/ops.h>
+#include <torch/headeronly/core/ScalarType.h>
+#include <torch/csrc/stable/device.h>
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+namespace {
+constexpr int kHostArMaxBlocks = 256;
+constexpr int kHostArGrid = 4;  // grid must be constant across calls (see kernel)
+constexpr int kHostArFlagStride = 8;  // uint32 words per flag (32 B)
+
+__device__ __forceinline__ uint4 ldcv(const uint4* p) {
+  uint4 r;
+  asm volatile("ld.global.cv.v4.u32 {%0,%1,%2,%3}, [%4];"
+               : "=r"(r.x), "=r"(r.y), "=r"(r.z), "=r"(r.w)
+               : "l"(p));
+  return r;
+}
+
+template <typename T2> struct Add2;
+template <> struct Add2<__nv_bfloat162> {
+  static __device__ __forceinline__ uint32_t run(uint32_t a, uint32_t b) {
+    __nv_bfloat162 x = *reinterpret_cast<__nv_bfloat162*>(&a);
+    __nv_bfloat162 y = *reinterpret_cast<__nv_bfloat162*>(&b);
+    float2 fx = __bfloat1622float2(x), fy = __bfloat1622float2(y);
+    __nv_bfloat162 r = __floats2bfloat162_rn(fx.x + fy.x, fx.y + fy.y);
+    return *reinterpret_cast<uint32_t*>(&r);
+  }
+};
+template <> struct Add2<__half2> {
+  static __device__ __forceinline__ uint32_t run(uint32_t a, uint32_t b) {
+    __half2 x = *reinterpret_cast<__half2*>(&a);
+    __half2 y = *reinterpret_cast<__half2*>(&b);
+    float2 fx = __half22float2(x), fy = __half22float2(y);
+    __half2 r = __floats2half2_rn(fx.x + fy.x, fx.y + fy.y);
+    return *reinterpret_cast<uint32_t*>(&r);
+  }
+};
+
+template <typename T2>
+__global__ void host_ar_kernel(const uint4* in, uint4* out, uint4* host_data,
+                               volatile uint32_t* flags, uint32_t* ctr,
+                               int rank, int n16, long slot16) {
+  int b = blockIdx.x;
+  uint32_t seq = ctr[b] + 1;
+  int par = seq & 1;
+  uint4* mine = host_data + (long)(par * 2 + rank) * slot16;
+  const uint4* peer = host_data + (long)(par * 2 + (1 - rank)) * slot16;
+  int cs = (n16 + gridDim.x - 1) / gridDim.x;
+  int lo = b * cs, hi = min(n16, lo + cs);
+  for (int i = lo + threadIdx.x; i < hi; i += blockDim.x) mine[i] = in[i];
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    __threadfence_system();
+    flags[(rank * kHostArMaxBlocks + b) * kHostArFlagStride] = seq;
+    while ((int)(flags[((1 - rank) * kHostArMaxBlocks + b) * kHostArFlagStride] -
+                 seq) < 0) {
+    }
+    __threadfence_system();
+    ctr[b] = seq;
+  }
+  __syncthreads();
+  for (int i = lo + threadIdx.x; i < hi; i += blockDim.x) {
+    uint4 p = ldcv(peer + i);
+    uint4 a = in[i];
+    uint4 r;
+    r.x = Add2<T2>::run(a.x, p.x);
+    r.y = Add2<T2>::run(a.y, p.y);
+    r.z = Add2<T2>::run(a.z, p.z);
+    r.w = Add2<T2>::run(a.w, p.w);
+    out[i] = r;
+  }
+}
+
+// ---- Pipelined variant (v2) ----
+// Data is cut into fixed 16 KB chunks; chunk c is always handled by block c % gridDim. A block
+// writes its chunk to host memory, publishes a per-chunk flag, and reads the peer's chunk
+// (lagged by one chunk) as soon as the peer's flag shows, so PCIe up and down overlap.
+// A per-block "done" flag (peer finished reading call seq) protects slot reuse (parity).
+constexpr int kAr2Chunk16 = 1024;        // uint4 per chunk (16 KB)
+constexpr int kAr2MaxChunks = 8192;      // per rank
+constexpr int kAr2ChunkFlagBase = 8192;  // word offset (clear of v1 flags)
+constexpr int kAr2DoneBase = kAr2ChunkFlagBase + 2 * kAr2MaxChunks * kHostArFlagStride;
+
+template <typename T2>
+__device__ __forceinline__ void ar2_read(const uint4* in, uint4* out, const uint4* peer,
+                                         volatile uint32_t* flags, int rank, int c,
+                                         uint32_t seq, int n16) {
+  if (threadIdx.x == 0) {
+    while ((int)(flags[kAr2ChunkFlagBase +
+                       ((1 - rank) * kAr2MaxChunks + c) * kHostArFlagStride] - seq) < 0) {
+    }
+    __threadfence_system();
+  }
+  __syncthreads();
+  int lo = c * kAr2Chunk16, hi = min(n16, lo + kAr2Chunk16);
+  for (int i = lo + threadIdx.x; i < hi; i += blockDim.x) {
+    uint4 p = ldcv(peer + i);
+    uint4 a = in[i];
+    uint4 r;
+    r.x = Add2<T2>::run(a.x, p.x);
+    r.y = Add2<T2>::run(a.y, p.y);
+    r.z = Add2<T2>::run(a.z, p.z);
+    r.w = Add2<T2>::run(a.w, p.w);
+    out[i] = r;
+  }
+}
+
+template <typename T2>
+__global__ void host_ar2_kernel(const uint4* in, uint4* out, uint4* host_data,
+                                volatile uint32_t* flags, uint32_t* ctr,
+                                int rank, int n16, long slot16) {
+  int b = blockIdx.x;
+  uint32_t seq = ctr[b] + 1;
+  int par = seq & 1;
+  uint4* mine = host_data + (long)(par * 2 + rank) * slot16;
+  const uint4* peer = host_data + (long)(par * 2 + (1 - rank)) * slot16;
+  if (threadIdx.x == 0) {
+    while ((int)(flags[kAr2DoneBase + ((1 - rank) * 256 + b) * kHostArFlagStride] -
+                 (seq - 2)) < 0) {
+    }
+  }
+  __syncthreads();
+  int nch = (n16 + kAr2Chunk16 - 1) / kAr2Chunk16;
+  int prev = -1;
+  for (int c = b; c < nch; c += gridDim.x) {
+    int lo = c * kAr2Chunk16, hi = min(n16, lo + kAr2Chunk16);
+    for (int i = lo + threadIdx.x; i < hi; i += blockDim.x) mine[i] = in[i];
+    __syncthreads();
+    if (threadIdx.x == 0) {
+      __threadfence_system();
+      flags[kAr2ChunkFlagBase + (rank * kAr2MaxChunks + c) * kHostArFlagStride] = seq;
+    }
+    if (prev >= 0) ar2_read<T2>(in, out, peer, flags, rank, prev, seq, n16);
+    prev = c;
+  }
+  if (prev >= 0) ar2_read<T2>(in, out, peer, flags, rank, prev, seq, n16);
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    __threadfence_system();
+    flags[kAr2DoneBase + (rank * 256 + b) * kHostArFlagStride] = seq;
+    ctr[b] = seq;
+  }
+}
+}  // namespace
+
+// Registers [ptr, ptr+size) (page-aligned mmap) as mapped pinned memory; returns device pointer.
+int64_t host_ar_register(int64_t ptr, int64_t size) {
+  cudaError_t e = cudaHostRegister(reinterpret_cast<void*>(ptr), size,
+                                   cudaHostRegisterMapped | cudaHostRegisterPortable);
+  STD_TORCH_CHECK(e == cudaSuccess, "cudaHostRegister failed: ",
+                  cudaGetErrorString(e));
+  void* d = nullptr;
+  e = cudaHostGetDevicePointer(&d, reinterpret_cast<void*>(ptr), 0);
+  STD_TORCH_CHECK(e == cudaSuccess, "cudaHostGetDevicePointer failed: ",
+                  cudaGetErrorString(e));
+  return reinterpret_cast<int64_t>(d);
+}
+
+void host_ar_unregister(int64_t ptr) {
+  cudaHostUnregister(reinterpret_cast<void*>(ptr));
+}
+
+// Host buffer layout: [flags: 1 MiB][data: 4 slots of slot_bytes] (slot index = parity*2 + rank).
+void host_ar_all_reduce(torch::stable::Tensor& inp, torch::stable::Tensor& out,
+                        int64_t dev_base, int64_t data_off, int64_t slot_bytes,
+                        torch::stable::Tensor& ctr, int64_t rank, int64_t grid,
+                        int64_t threads) {
+  const torch::stable::accelerator::DeviceGuard device_guard(
+      inp.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream(inp.get_device_index());
+  STD_TORCH_CHECK(inp.is_contiguous() && out.is_contiguous());
+  STD_TORCH_CHECK(inp.scalar_type() == out.scalar_type());
+  STD_TORCH_CHECK(inp.numel() == out.numel());
+  int64_t nbytes = inp.numel() * inp.element_size();
+  STD_TORCH_CHECK(nbytes % 16 == 0 && nbytes <= slot_bytes,
+                  "host_ar: bad size ", nbytes);
+  // Slot parity comes from the per-block counters, so every call must use the same grid:
+  // otherwise block ranges differ between calls and a rank can overwrite slot bytes the peer
+  // is still reading.
+  STD_TORCH_CHECK(grid == kHostArGrid, "host_ar: grid must be ", kHostArGrid);
+  int n16 = nbytes / 16;
+  auto* data = reinterpret_cast<uint4*>(dev_base + data_off);
+  auto* flags = reinterpret_cast<volatile uint32_t*>(dev_base);
+  auto* c = reinterpret_cast<uint32_t*>(ctr.mutable_data_ptr());
+  auto* ip = reinterpret_cast<const uint4*>(inp.const_data_ptr());
+  auto* op = reinterpret_cast<uint4*>(out.mutable_data_ptr());
+  if (inp.scalar_type() == torch::headeronly::ScalarType::BFloat16) {
+    host_ar_kernel<__nv_bfloat162><<<grid, threads, 0, stream>>>(
+        ip, op, data, flags, c, (int)rank, n16, slot_bytes / 16);
+  } else if (inp.scalar_type() == torch::headeronly::ScalarType::Half) {
+    host_ar_kernel<__half2><<<grid, threads, 0, stream>>>(
+        ip, op, data, flags, c, (int)rank, n16, slot_bytes / 16);
+  } else {
+    STD_TORCH_CHECK(false, "host_ar supports bf16/fp16 only");
+  }
+}
+
+void host_ar2_all_reduce(torch::stable::Tensor& inp, torch::stable::Tensor& out,
+                         int64_t dev_base, int64_t data_off, int64_t slot_bytes,
+                         torch::stable::Tensor& ctr, int64_t rank, int64_t grid,
+                         int64_t threads) {
+  const torch::stable::accelerator::DeviceGuard device_guard(inp.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream(inp.get_device_index());
+  STD_TORCH_CHECK(inp.is_contiguous() && out.is_contiguous());
+  STD_TORCH_CHECK(inp.scalar_type() == out.scalar_type());
+  STD_TORCH_CHECK(inp.numel() == out.numel());
+  int64_t nbytes = inp.numel() * inp.element_size();
+  STD_TORCH_CHECK(nbytes % 16 == 0 && nbytes <= slot_bytes, "host_ar2: bad size ", nbytes);
+  STD_TORCH_CHECK(nbytes / 16 <= (int64_t)kAr2MaxChunks * kAr2Chunk16, "host_ar2: too big");
+  STD_TORCH_CHECK(grid >= 1 && grid <= 256, "host_ar2: bad grid");
+  int n16 = nbytes / 16;
+  auto* data = reinterpret_cast<uint4*>(dev_base + data_off);
+  auto* flags = reinterpret_cast<volatile uint32_t*>(dev_base);
+  auto* c = reinterpret_cast<uint32_t*>(ctr.mutable_data_ptr());
+  auto* ip = reinterpret_cast<const uint4*>(inp.const_data_ptr());
+  auto* op = reinterpret_cast<uint4*>(out.mutable_data_ptr());
+  if (inp.scalar_type() == torch::headeronly::ScalarType::BFloat16) {
+    host_ar2_kernel<__nv_bfloat162><<<grid, threads, 0, stream>>>(
+        ip, op, data, flags, c, (int)rank, n16, slot_bytes / 16);
+  } else if (inp.scalar_type() == torch::headeronly::ScalarType::Half) {
+    host_ar2_kernel<__half2><<<grid, threads, 0, stream>>>(
+        ip, op, data, flags, c, (int)rank, n16, slot_bytes / 16);
+  } else {
+    STD_TORCH_CHECK(false, "host_ar2 supports bf16/fp16 only");
+  }
+}
