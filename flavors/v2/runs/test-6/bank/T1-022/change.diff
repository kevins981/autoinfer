diff --git a/csrc/gdn/fused_gdn_decode_kernel.cu b/csrc/gdn/fused_gdn_decode_kernel.cu
index 5e606ffd7f..6a0184167a 100644
--- a/csrc/gdn/fused_gdn_decode_kernel.cu
+++ b/csrc/gdn/fused_gdn_decode_kernel.cu
