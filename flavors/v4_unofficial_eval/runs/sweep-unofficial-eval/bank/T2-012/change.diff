diff --git a/csrc/host_all_reduce.cu b/csrc/host_all_reduce.cu
new file mode 100644
index 0000000000..d766e0d349
--- /dev/null
+++ b/csrc/host_all_reduce.cu
@@ -0,0 +1,139 @@
+// One-shot 2-rank all-reduce through pinned host memory (for machines without GPU P2P).
+// Each rank writes its input to its slot in a shared (cudaHostRegister'ed) host buffer, publishes
+// a per-block sequence flag, waits for the peer's flag, then reads the peer slot and sums.
+// Slots are double-buffered by sequence parity; the sequence counter lives on the device (one per
+// block, advanced by the kernel itself), so the kernel is CUDA-graph capturable and replayable.
+#include "torch_utils.h"
+
+#include <torch/csrc/stable/macros.h>
+#include <torch/csrc/stable/accelerator.h>
+#include <torch/csrc/stable/tensor.h>
+#include <torch/csrc/stable/ops.h>
+#include <torch/headeronly/core/ScalarType.h>
+#include <torch/csrc/stable/device.h>
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+namespace {
+constexpr int kHostArMaxBlocks = 256;
+constexpr int kHostArGrid = 4;  // grid must be constant across calls (see kernel)
+constexpr int kHostArFlagStride = 8;  // uint32 words per flag (32 B)
+
+__device__ __forceinline__ uint4 ldcv(const uint4* p) {
+  uint4 r;
+  asm volatile("ld.global.cv.v4.u32 {%0,%1,%2,%3}, [%4];"
+               : "=r"(r.x), "=r"(r.y), "=r"(r.z), "=r"(r.w)
+               : "l"(p));
+  return r;
+}
+
+template <typename T2> struct Add2;
+template <> struct Add2<__nv_bfloat162> {
+  static __device__ __forceinline__ uint32_t run(uint32_t a, uint32_t b) {
+    __nv_bfloat162 x = *reinterpret_cast<__nv_bfloat162*>(&a);
+    __nv_bfloat162 y = *reinterpret_cast<__nv_bfloat162*>(&b);
+    float2 fx = __bfloat1622float2(x), fy = __bfloat1622float2(y);
+    __nv_bfloat162 r = __floats2bfloat162_rn(fx.x + fy.x, fx.y + fy.y);
+    return *reinterpret_cast<uint32_t*>(&r);
+  }
+};
+template <> struct Add2<__half2> {
+  static __device__ __forceinline__ uint32_t run(uint32_t a, uint32_t b) {
+    __half2 x = *reinterpret_cast<__half2*>(&a);
+    __half2 y = *reinterpret_cast<__half2*>(&b);
+    float2 fx = __half22float2(x), fy = __half22float2(y);
+    __half2 r = __floats2half2_rn(fx.x + fy.x, fx.y + fy.y);
+    return *reinterpret_cast<uint32_t*>(&r);
+  }
+};
+
+template <typename T2>
+__global__ void host_ar_kernel(const uint4* in, uint4* out, uint4* host_data,
+                               volatile uint32_t* flags, uint32_t* ctr,
+                               int rank, int n16, long slot16) {
+  int b = blockIdx.x;
+  uint32_t seq = ctr[b] + 1;
+  int par = seq & 1;
+  uint4* mine = host_data + (long)(par * 2 + rank) * slot16;
+  const uint4* peer = host_data + (long)(par * 2 + (1 - rank)) * slot16;
+  int cs = (n16 + gridDim.x - 1) / gridDim.x;
+  int lo = b * cs, hi = min(n16, lo + cs);
+  for (int i = lo + threadIdx.x; i < hi; i += blockDim.x) mine[i] = in[i];
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    __threadfence_system();
+    flags[(rank * kHostArMaxBlocks + b) * kHostArFlagStride] = seq;
+    while ((int)(flags[((1 - rank) * kHostArMaxBlocks + b) * kHostArFlagStride] -
+                 seq) < 0) {
+    }
+    __threadfence_system();
+    ctr[b] = seq;
+  }
+  __syncthreads();
+  for (int i = lo + threadIdx.x; i < hi; i += blockDim.x) {
+    uint4 p = ldcv(peer + i);
+    uint4 a = in[i];
+    uint4 r;
+    r.x = Add2<T2>::run(a.x, p.x);
+    r.y = Add2<T2>::run(a.y, p.y);
+    r.z = Add2<T2>::run(a.z, p.z);
+    r.w = Add2<T2>::run(a.w, p.w);
+    out[i] = r;
+  }
+}
+}  // namespace
+
+// Registers [ptr, ptr+size) (page-aligned mmap) as mapped pinned memory; returns device pointer.
+int64_t host_ar_register(int64_t ptr, int64_t size) {
+  cudaError_t e = cudaHostRegister(reinterpret_cast<void*>(ptr), size,
+                                   cudaHostRegisterMapped | cudaHostRegisterPortable);
+  STD_TORCH_CHECK(e == cudaSuccess, "cudaHostRegister failed: ",
+                  cudaGetErrorString(e));
+  void* d = nullptr;
+  e = cudaHostGetDevicePointer(&d, reinterpret_cast<void*>(ptr), 0);
+  STD_TORCH_CHECK(e == cudaSuccess, "cudaHostGetDevicePointer failed: ",
+                  cudaGetErrorString(e));
+  return reinterpret_cast<int64_t>(d);
+}
+
+void host_ar_unregister(int64_t ptr) {
+  cudaHostUnregister(reinterpret_cast<void*>(ptr));
+}
+
+// Host buffer layout: [flags: 1 MiB][data: 4 slots of slot_bytes] (slot index = parity*2 + rank).
+void host_ar_all_reduce(torch::stable::Tensor& inp, torch::stable::Tensor& out,
+                        int64_t dev_base, int64_t data_off, int64_t slot_bytes,
+                        torch::stable::Tensor& ctr, int64_t rank, int64_t grid,
+                        int64_t threads) {
+  const torch::stable::accelerator::DeviceGuard device_guard(
+      inp.get_device_index());
+  const cudaStream_t stream = get_current_cuda_stream(inp.get_device_index());
+  STD_TORCH_CHECK(inp.is_contiguous() && out.is_contiguous());
+  STD_TORCH_CHECK(inp.scalar_type() == out.scalar_type());
+  STD_TORCH_CHECK(inp.numel() == out.numel());
+  int64_t nbytes = inp.numel() * inp.element_size();
+  STD_TORCH_CHECK(nbytes % 16 == 0 && nbytes <= slot_bytes,
+                  "host_ar: bad size ", nbytes);
+  // Slot parity comes from the per-block counters, so every call must use the same grid:
+  // otherwise block ranges differ between calls and a rank can overwrite slot bytes the peer
+  // is still reading.
+  STD_TORCH_CHECK(grid == kHostArGrid, "host_ar: grid must be ", kHostArGrid);
+  int n16 = nbytes / 16;
+  auto* data = reinterpret_cast<uint4*>(dev_base + data_off);
+  auto* flags = reinterpret_cast<volatile uint32_t*>(dev_base);
+  auto* c = reinterpret_cast<uint32_t*>(ctr.mutable_data_ptr());
+  auto* ip = reinterpret_cast<const uint4*>(inp.const_data_ptr());
+  auto* op = reinterpret_cast<uint4*>(out.mutable_data_ptr());
+  if (inp.scalar_type() == torch::headeronly::ScalarType::BFloat16) {
+    host_ar_kernel<__nv_bfloat162><<<grid, threads, 0, stream>>>(
+        ip, op, data, flags, c, (int)rank, n16, slot_bytes / 16);
+  } else if (inp.scalar_type() == torch::headeronly::ScalarType::Half) {
+    host_ar_kernel<__half2><<<grid, threads, 0, stream>>>(
+        ip, op, data, flags, c, (int)rank, n16, slot_bytes / 16);
+  } else {
+    STD_TORCH_CHECK(false, "host_ar supports bf16/fp16 only");
+  }
+}
