+    from vllm.model_executor.layers.vocab_parallel_embedding import ParallelLMHead
+
+    tp = get_tp_group()
+    tp_size, rank = tp.world_size, tp.rank_in_group
+    assert total_k % (64 * tp_size) == 0
+    w = target_lm_head.weight
+    dev = w.device
+    n_prefix = total_k - len(added_ids)
+    ids = torch.cat([
+        torch.arange(n_prefix, dtype=torch.int64),
+        torch.tensor(added_ids, dtype=torch.int64),
+    ]).to(dev)
+    si = target_lm_head.shard_indices
+    lo, hi = si.org_vocab_start_index, si.org_vocab_end_index
+    per = total_k // tp_size
+    local = torch.empty(per, w.shape[1], dtype=w.dtype, device=dev)
+    # Assemble this rank's rows chunk by chunk: zero-padded all-reduce (x + 0 = x,
+    # exact) of the rows each rank owns.
+    chunk = 8192
