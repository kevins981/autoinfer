+logger = init_logger(__name__)
+
+# Draft-only argmax over the first N token ids. Byte-level BPE ids follow merge
+# order, a frequency proxy of the tokenizer's own training data (not of any
+# benchmark): for Qwen3.5+ tokenizers, ids < 98304 are the base vocabulary
+# (99.6% of tokens of vLLM's docs, 99.95% of its Python sources); 98K-151K are
+# CJK merges. Drafts only propose: verification stays full-vocab and exact, so
+# a draft outside the subset just costs an acceptance. 0 disables.
+_DRAFT_TOP_VOCAB = int(os.environ.get("VLLM_DRAFT_TOP_VOCAB", "98304"))
+
+
+@torch.no_grad()
+def reduced_draft_top_head(
+    target_lm_head: nn.Module, num_rows: int, quantization: str | None
+) -> nn.Module | None:
+    """A TP-sharded lm_head over global token ids [0, num_rows), quantized like
+    the draft head. Used only for the drafter's local-argmax (greedy) path.
+
+    Rows each rank needs may live in another rank's shard of the target head;
+    they are broadcast once from that rank at load time.
+    """
+    if not isinstance(target_lm_head, ParallelLMHead) or num_rows <= 0:
+        return None
+    if num_rows >= target_lm_head.org_vocab_size:
+        return None
+    tp = get_tp_group()
+    ws, rank = tp.world_size, tp.rank_in_group
+    if num_rows % (ws * 64):
+        return None
+    src = target_lm_head.weight.data
+    dtype, dim = src.dtype, src.shape[1]
+    tgt_start = target_lm_head.shard_indices.org_vocab_start_index
+    tgt_rows = target_lm_head.shard_indices.org_vocab_end_index - tgt_start
+    # Every rank has the same shard size of the target (padded vocab / ws).
+    per = num_rows // ws
+    owners = [(r * per) // tgt_rows for r in range(ws)]
+    if any(((r + 1) * per - 1) // tgt_rows != owners[r] for r in range(ws)):
+        return None
+    with set_default_torch_dtype(dtype), torch.device(src.device):
+        small = ParallelLMHead(
+            num_rows,
+            dim,
+            params_dtype=dtype,
+            org_num_embeddings=num_rows,
+            padding_size=64,
+            prefix="draft_top_head",
+        )
+    assert small.weight.shape[0] == per
+    for r in range(ws):
+        owner = owners[r]
+        lo = r * per - owner * tgt_rows
+        if owner == rank:
+            buf = src[lo : lo + per].contiguous()
+        else:
+            buf = torch.empty(per, dim, dtype=dtype, device=src.device)
+        if owner != r:
+            tp.broadcast(buf, src=owner)
+        if r == rank:
+            small.weight.data.copy_(buf)
+        del buf
+    with torch.device(src.device):
+        head = small if quantization is None else _quantize_copy(small, quantization)
+    logger.info(
+        "Draft argmax over token ids [0, %d) (%d rows per rank, %s).",
+        num_rows,
+        per,
+        quantization or "unquantized",
+    )
+    return head
+
