+  X(3, 1, 4, 64, 32, 2, 128)    \
+  X(4, 1, 4, 64, 32, 3, 128)    \
+  X(5, 2, 2, 64, 32, 4, 64)     \
+  X(6, 2, 2, 64, 32, 3, 128)    \
+  X(7, 2, 2, 32, 32, 4, 64)     \
+  X(8, 2, 2, 32, 32, 6, 64)     \
+  X(9, 2, 2, 32, 32, 3, 128)    \
+  X(10, 2, 2, 32, 32, 4, 128)   \
+  X(11, 2, 2, 32, 32, 6, 128)   \
+  X(12, 1, 4, 32, 32, 5, 64)    \
+  X(13, 1, 4, 32, 32, 3, 128)   \
+  X(14, 1, 2, 32, 32, 6, 64)    \
+  X(15, 1, 2, 32, 32, 3, 128)   \
+  X(16, 1, 2, 32, 32, 6, 128)   \
+  X(17, 4, 2, 32, 32, 4, 64)    \
+  X(18, 4, 2, 32, 32, 3, 128)   \
+  X(19, 2, 4, 32, 32, 4, 64)    \
+  X(20, 2, 4, 32, 32, 3, 128)   \
+  X(21, 3, 4, 32, 32, 4, 64)    \
+  X(22, 4, 4, 32, 32, 3, 128)   \
+  X(23, 1, 4, 16, 32, 4, 128)   \
+  X(24, 2, 4, 64, 32, 2, 128)   \
+  X(25, 4, 4, 32, 32, 2, 128)   \
+  X(26, 2, 4, 32, 32, 2, 128)   \
+  X(27, 2, 2, 32, 32, 2, 128)   \
+  X(28, 2, 2, 64, 32, 2, 128)   \
+  X(29, 1, 2, 64, 32, 2, 128)   \
+  X(30, 1, 4, 64, 32, 3, 64)    \
