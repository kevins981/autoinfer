+                nb_np = (sl_cpu + (page_size - 1)) // page_size
+                ip_np = np.concatenate([[0], np.cumsum(nb_np)]).astype(np.int32)
+                lp_np = sl_cpu % page_size
+                lp_np = np.where((lp_np == 0) & (sl_cpu != 0), page_size, lp_np)
+                ok = bool(
+                    np.array_equal(indptr.cpu().numpy(), ip_np)
+                    and np.array_equal(
+                        self.paged_kv_last_page_len.gpu[:num_reqs].cpu().numpy(),
+                        lp_np.astype(np.int32),
+                    )
+                )
+                # indices: compare against block_table rows
+                tot = int(ip_np[-1])
