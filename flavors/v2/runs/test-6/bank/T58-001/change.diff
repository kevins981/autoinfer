+        if project:
+            p0 = out_proj(x[:c0])[0]
+            ar_dma = dma.all_reduce(p0)
+            ar_host = tensor_model_parallel_all_reduce(p0)
+            ar_neq = (ar_dma.view(torch.int16) != ar_host.view(torch.int16)).sum().item()
+    aux.wait_stream(cur)
+    chunk(0, c0, True)
+    with torch.cuda.stream(aux):
+        chunk(c0, num_tokens, False)
+    cur.wait_stream(aux)
+    self.output_reduced = True
+    if pp:
+        self.pre_for_next = SimpleNamespace(**bufs)
+        if chk is not None:
+            _pp_check(next_layer, nxt_gdn, chk, residual, bufs, c0 + c1)
+    if check:
+        xr = out_proj(x)[0] if project else x
+        mlp_in, h, res_ref = self.post_attention_layernorm.forward_fused(
+            xr, res_in, gate_up
+        )
+        ref = tensor_model_parallel_all_reduce(
+            self.mlp(h if mlp_in is None else mlp_in)
+        )
+        _split_check_n[0] += 1
+        if _split_check_n[0] <= 400 and torch.distributed.get_rank() == 0:
+            d_out = (out.float() - ref.float()).abs()
+            d_res = (residual.float() - res_ref.float()).abs()
+            logger.info(
+                "SPLITCHECK layer=%d M=%d split=%s dma_vs_host_AR_neq=%s "
+                "out: maxdiff %.4g (max|ref| %.4g, neq %d/%d) "
+                "resid: maxdiff %.4g (max|ref| %.4g, neq %d)",
+                self.layer_idx, num_tokens, split,
+                ar_neq if project else "n/a",
+                d_out.max().item(), ref.float().abs().max().item(),
+                (out != ref).sum().item(), out.numel(),
+                d_res.max().item(), res_ref.float().abs().max().item(),
+                (residual != res_ref).sum().item(),
+            )
+    return out, residual
