#!/usr/bin/env python3
"""new_run: create a baseline-flavor run and start its single agent as a background Claude session.

Usage: new_run <run name> --task <task> [--no-start]
       new_run <run name> --start
  e.g. flavors/baseline/tools/new_run base-1 --task qwen38-27b-fp8-2x4090

Creates runs/<run>/ (a copy of the task, config.md, run.json, results.tsv, folders), prepares the task
(`ws setup-task`), creates the workspace `main` with the code tree on branch autoresearch/<run>
(+ a setup commit adding an empty serve_args.txt), then starts the agent in the run folder with
program.md as its instructions. Edit runs/<run>/config.md (limits) before starting if needed:
use --no-start, edit, then --start. Talk to the agent with `claude attach <id>`. Pausing and
resuming a run are messages to the agent (CLAUDE.md, "Pausing and resuming a run").
"""
import argparse, json, os, re, shutil, subprocess, sys, uuid
from datetime import datetime, timezone
from pathlib import Path

TOOLS = Path(__file__).resolve().parent
FLAVOR = TOOLS.parent
ROOT = TOOLS.parents[2]                 # autoinfer/
GIT_ID = {"GIT_AUTHOR_NAME": "autoinfer-researcher", "GIT_AUTHOR_EMAIL": "researcher@autoinfer.local",
          "GIT_COMMITTER_NAME": "autoinfer-researcher", "GIT_COMMITTER_EMAIL": "researcher@autoinfer.local"}
HEADER = "commit\ttok_s\tgates\tstatus\texperiment\tdescription\n"


def die(msg):
    print(f"new_run: {msg}", file=sys.stderr)
    sys.exit(1)


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def git(tree, *args):
    r = subprocess.run(["git", "-C", str(tree), *args], capture_output=True, text=True)
    if r.returncode != 0:
        die(f"git {' '.join(args)} failed: {r.stderr.strip()}")
    return r.stdout.strip()


def model_of(run):
    m = re.search(r"^\s*-?\s*model:\s*(\S+)\s*/\s*(\S+)", (run / "config.md").read_text(), re.M)
    return (m.group(1), m.group(2)) if m else ("claude-opus-5-5", "medium")


QWEN38_OPT = ROOT.parent / "qwen38_opt"


def copy_task(run, task):
    """The run's own copy of the task, for agents to read (they stay in their run folder). Trusted
    tools (ws, the official eval) read the original in tasks/, found by task_source.json."""
    shutil.copytree(task, run / "task", symlinks=True)
    g = lambda *c: subprocess.run(["git", "-C", str(ROOT), *c], capture_output=True, text=True).stdout.strip()
    (run / "task_source.json").write_text(json.dumps(
        {"task": task.name, "autoinfer_commit": g("rev-parse", "HEAD"),
         "uncommitted": g("status", "--porcelain", "--", str(task.relative_to(ROOT))) or None}, indent=2) + "\n")


def confine(s, run):
    """Keep the run's agents (the manager or researcher included) away from what would leak
    answers: answer keys, evaluations, design notes, other runs, and qwen38_opt's findings and
    optimized code. Two layers: deny rules (hard for the Read/Edit tools and for shell commands
    that name these paths) and an auto-mode classifier rule (catches python, git show, ...).
    "$defaults" keeps the classifier's built-in rules (a soft_deny list replaces them otherwise)."""
    own = run.resolve()
    dirs = [ROOT / d for d in ("answer_keys", "evals", "design", ".claude", ".git")]
    # flavor folders: everything but what agents use (design/, notes such as observations.md, ...)
    keep = {"agents", "tools", "runs", "config_default.md", "program.md", ".claude"}
    flav = sorted(e for f in (ROOT / "flavors").iterdir() if f.is_dir() for e in f.iterdir() if e.name not in keep)
    dirs += [e for e in flav if e.is_dir()]
    dirs += sorted(r for f in (ROOT / "flavors").iterdir() if (f / "runs").is_dir()
                   for r in (f / "runs").iterdir() if r.is_dir() and r.resolve() != own)
    dirs += [QWEN38_OPT / d for d in ("results", "logs", "ext", "vllm", "build")]
    # the shared cache: only the engine trees, build cache and downloads are for runs (runtime
    # caches are per run since 2026-11-07; the shared ones hold older runs' generated kernels)
    shared_ok = {"tasks", "ccache", "huggingface", "pip", "uv", "conda-pkgs"}
    dirs += sorted(d for d in (ROOT / ".cache").iterdir() if d.is_dir() and d.name not in shared_ok)
    files = [ROOT / "EVAL.md", ROOT / "CLAUDE.md"] + [e for e in flav if not e.is_dir()] + [QWEN38_OPT / f for f in ("FINDINGS.md", "TODO.md", "CLAUDE.md")]
    # Claude Code's per-session folders (transcripts, memory, background-job output, scratchpads),
    # named after each session's working directory: deny all that exist at launch except this run's
    # own (its agents read their own job output there). Other runs, the designer and the judges.
    enc = lambda p: re.sub(r"[^A-Za-z0-9]", "-", str(p))
    mine = enc(own)
    others = {enc(r) for f in (ROOT / "flavors").iterdir() if (f / "runs").is_dir()
              for r in (f / "runs").iterdir() if r.is_dir() and r.resolve() != own}
    def is_mine(n):   # this run's folders, not another run whose name starts with ours (test-5-b)
        return (n == mine or n.startswith(mine + "-")) and not any(
            n == o or n.startswith(o + "-") for o in others if o.startswith(mine + "-"))
    sess_roots = [Path.home() / ".claude" / "projects", Path(f"/tmp/claude-{os.getuid()}")]
    dirs += sorted(d for r in sess_roots if r.is_dir() for d in r.iterdir()
                   if d.is_dir() and d.name.startswith("-") and not is_mine(d.name))
    pats = [f"/{d}/**" for d in dirs] + [f"/{f}" for f in files]
    ro = [f"/{ROOT / 'tasks'}/**", f"/{run / 'task'}/**"]   # the task is read-only to agents
    deny = s["permissions"]["deny"]
    deny += [f"{tool}({p})" for p in pats for tool in ("Read", "Edit")]   # Edit covers every file-writing tool
    deny += [f"Edit({p})" for p in ro]
    off = ", ".join(str(p) for p in dirs + files if p.parent.name != "runs" and QWEN38_OPT not in p.parents
                    and not any(r in p.parents for r in sess_roots))
    # Hard rule for messaging (the classifier rule alone let a probe message a session outside the run)
    s.setdefault("hooks", {}).setdefault("PreToolUse", []).append({"matcher": "SendMessage", "hooks": [
        {"type": "command", "command": f"python3 {TOOLS / '_msg_guard.py'} {run.name}"}]})
    s["includeGitInstructions"] = False   # else the system prompt holds the autoinfer repo's recent commits
    s["autoMode"] = {"soft_deny": ["$defaults", (
        f"Leaving the run: this agent belongs to one AutoInfer optimization run, folder {run}. "
        f"Never read, list, search, copy or print the following, by any method (Read, cat, grep, find, "
        f"python, symlinks, git log/show/grep/diff on the {ROOT} repository or reading its .git): {off}; any other AutoInfer "
        f"run's folder (other runs under {ROOT}/flavors/*/runs/, or anywhere else); and {QWEN38_OPT}'s "
        f"notes, results, logs and code (FINDINGS.md, TODO.md, results/, logs/, ext/, vllm/, build/); "
        f"other Claude sessions' transcripts, memory and scratch folders (under ~/.claude/projects/ and "
        f"/tmp/claude-{os.getuid()}/, every folder except this run's own); and the autoinfer repository "
        f"on GitHub (kevins981/autoinfer: no gh, git clone, curl or web fetches of it or its files; "
        f"other GitHub use, e.g. vLLM issues and PRs, is fine). Never message or contact agents or Claude "
        f"sessions outside this run (SendMessage, agent tool or anything else): only this run's agents, "
        f"listed by `agent list` (the human may also message you; answer). They hold "
        f"the evaluators' answers and grades, design notes, or other runs' results; using them invalidates "
        f"the experiment. Allowed outside the run: running the run's tools; reading the flavor's agents/ "
        f"and tools/; the engine code, build cache and downloads under {ROOT}/.cache (tasks/, ccache/, "
        f"huggingface/, pip/, uv/); this run's own .cache/; {QWEN38_OPT}/env (the conda env) "
        f"and {QWEN38_OPT}/.cache (model weights); git inside the agent's own workspaces; installed "
        f"system software and documentation.")]}
    return s


def write_settings(run):
    s = confine(json.loads((TOOLS / "agent_settings.json").read_text()), run)
    s["claudeMdExcludes"] = [str(ROOT / "CLAUDE.md"), str(FLAVOR / "CLAUDE.md")]
    # `claude --bg` may hand the session to a pre-started process with the daemon's environment,
    # so the run's env must live in the settings.
    s["env"] = {"AUTOINFER_RUN": str(run), "AUTOINFER_AGENT": "researcher",
                "AUTOINFER_ROLE": "researcher", "AUTOINFER_TEAM": "",
                **GIT_ID,
                "PATH": f"{TOOLS}:{os.environ.get('PATH', '')}"}
    (run / "agent_settings.json").write_text(json.dumps(s, indent=2) + "\n")


def create(run, task_name):
    task = ROOT / "tasks" / task_name
    if not task.is_dir():
        die(f"no task {task}")
    if run.exists():
        die(f"{run} already exists")
    run.mkdir(parents=True)
    copy_task(run, task)
    for d in ("experiments", "gpu", "agents/researcher", "scratch", "workspaces"):
        (run / d).mkdir(parents=True)
    shutil.copy(FLAVOR / "config_default.md", run / "config.md")
    (run / "results.tsv").write_text(HEADER)
    (run / "run.json").write_text(json.dumps({"flavor": "baseline", "run": run.name, "task": task_name,
                                              "created": now(), "started": None}, indent=2) + "\n")
    env = dict(os.environ, AUTOINFER_RUN=str(run))
    for cmd in (["setup-task"], ["create", "main"]):
        r = subprocess.run([str(TOOLS / "ws"), *cmd], env=env, capture_output=True, text=True)
        print(r.stdout.strip())
        if r.returncode != 0:
            die(f"ws {' '.join(cmd)} failed:\n{r.stderr}")
    tree = run / "workspaces" / "main" / "vllm"
    git(tree, "checkout", "-q", "-b", f"autoresearch/{run.name}")
    (tree / "serve_args.txt").write_text("")
    git(tree, "add", "serve_args.txt")
    git(tree, "-c", "user.name=autoinfer-researcher", "-c", "user.email=researcher@autoinfer.local",
        "commit", "-q", "-m", "setup: empty serve_args.txt (extra vllm serve flags)")
    print(f"created run folder {run} (code tree {tree}, branch autoresearch/{run.name})")


def main():
    p = argparse.ArgumentParser(prog="new_run", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("run")
    p.add_argument("--task", help="task name in tasks/ (required for a new run)")
    p.add_argument("--no-start", action="store_true", help="only create the folder")
    p.add_argument("--start", action="store_true", help="start the agent on a run created with --no-start")
    a = p.parse_args()
    run = FLAVOR / "runs" / a.run

    if a.start:
        if not run.is_dir():
            die(f"no run {run}")
        if (run / "agents" / "researcher" / "meta.json").exists():
            die(f"{run.name} already has its agent; talk to it (CLAUDE.md, 'Pausing and resuming a run')")
    else:
        if not a.task:
            die("--task is required for a new run")
        create(run, a.task)
        if a.no_start:
            print(f"edit {run / 'config.md'} if needed, then: {TOOLS / 'new_run'} {a.run} --start")
            return
    first = (f"Run folder: {run} (AUTOINFER_RUN is set). Task: {json.loads((run / 'run.json').read_text())['task']}. "
             f"Setup is done: check it (program.md, Setup), then start the experiment loop with the baseline run.")

    info = json.loads((run / "run.json").read_text())
    if not info.get("started"):
        info["started"] = now()
        (run / "run.json").write_text(json.dumps(info, indent=2) + "\n")
    write_settings(run)
    model, effort = model_of(run)
    sid = str(uuid.uuid4())                  # recorded: resources.py, and recovery of a dead session
    meta = {"name": "researcher", "role": "researcher", "model": model, "effort": effort,
            "session_id": sid, "started": info["started"], "stopped": None}
    (run / "agents" / "researcher" / "meta.json").write_text(json.dumps(meta, indent=2) + "\n")
    g = lambda *c: subprocess.run(["git", "-C", str(ROOT), *c], capture_output=True, text=True).stdout.strip()
    dirty = g("status", "--porcelain", "--", str(FLAVOR.relative_to(ROOT)),
              f":(exclude){FLAVOR.relative_to(ROOT)}/runs")
    (run / "flavor_commit.txt").write_text(f"{g('rev-parse', 'HEAD')}\n" +
                                           (f"uncommitted flavor changes:\n{dirty}\n" if dirty else ""))
    prompt = (FLAVOR / "program.md").read_text()
    prompt += f"\n\n# This run\nRun `{a.run}`; run folder {run}; task {info['task']}.\n"
    env = dict(os.environ, AUTOINFER_RUN=str(run), AUTOINFER_AGENT="researcher",
               AUTOINFER_ROLE="researcher", PATH=f"{TOOLS}:{os.environ.get('PATH', '')}", **GIT_ID)
    env.pop("AUTOINFER_TEAM", None)
    print(f"researcher: {model} / {effort} (config.md); session {sid}")
    r = subprocess.run(["claude", "--bg", "--name", f"researcher-{a.run}", "--session-id", sid,
                        "--permission-mode", "auto", "--model", model, "--effort", effort,
                        "--autocompact", os.environ.get("AUTOINFER_AUTOCOMPACT", "400000"),
                        "--settings", str(run / "agent_settings.json"),
                        "--append-system-prompt", prompt, first],
                       cwd=run, env=env, capture_output=True, text=True)
    print(r.stdout.strip() or r.stderr.strip())
    # `claude --bg` assigns its own session id (it ignores --session-id): record the one it prints,
    # a prefix of the transcript's file name (resources.py matches by prefix)
    m = re.search(r"backgrounded\s*\S\s*([0-9a-f]{8})", r.stdout)
    if m:
        meta["session_id"] = m.group(1)
        (run / "agents" / "researcher" / "meta.json").write_text(json.dumps(meta, indent=2) + "\n")
    if r.returncode != 0:
        die("could not start the agent (see above). The folder is ready; fix and use --start.")


if __name__ == "__main__":
    main()
