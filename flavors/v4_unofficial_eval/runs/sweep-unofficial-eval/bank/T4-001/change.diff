+__device__ __forceinline__ void load_pending_rows(
+    const unsigned char* rows_base, int flags, int c0, int c1, int tid,
+    float (*replay_k)[kDimK], __nv_bfloat16 (*replay_v)[kDimV],
+    float* replay_decay, float* replay_beta) {
