+
+  // ---- T28 Marlin-e4m3: raw e4m3 B words x e4m3 A (pi-permuted), block-scaled in fp32 ----
+  // Called for every k (k16 sub-tile index in the stage); acts on even k only: tiles k and k+1 form one k32 step.
+  // frag_b_quant[0] = tile k, frag_b_quant[1] = tile k+1 (both loaded by the time matmul(k) runs, see main loop).
+  // Each step's int32 accumulator-free MMA result is scaled and added to frag_c in fp32 (block-local = one k32 step,
+  // always inside a single 128-k group: a warp's b_sh_wr_iters tiles of a stage never straddle a group).
+  int kt_cur = 0;                    // absolute stage index (units of thread_k_blocks k16 tiles) being computed
+  float sc[thread_m_blocks][2];      // As[row]*Bs for rows g, g+8 of each m block (current group)
+  const float* As_f = global_scale_ptr;
+  const float* Bs_f = reinterpret_cast<const float*>(scales_ptr);
+  auto matmul_fp8 = [&](int k) {
+    if ((k & 1) == 0) {
