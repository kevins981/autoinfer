+    if (!(MODE & 4)) {
+#pragma unroll
+      for (int j = 0; j < 4; ++j) {
+        uint32_t af[MT][4];
+#pragma unroll
+        for (int mt = 0; mt < MT; ++mt) {
+          const int r = mt * 16 + a_r, c = j * 2 + a_c;
+          ldsm_x4(a_base + r * 128 + ((c ^ (r & 7)) << 4), af[mt][0], af[mt][1], af[mt][2], af[mt][3]);
+        }
+        const uint32_t b0r[4] = {wc[2 * j].x, wc[2 * j].y, wc[2 * j].z, wc[2 * j].w};
+        const uint32_t b1r[4] = {wc[2 * j + 1].x, wc[2 * j + 1].y, wc[2 * j + 1].z, wc[2 * j + 1].w};
+#pragma unroll
+        for (int mt = 0; mt < MT; ++mt)
+#pragma unroll
+          for (int nt = 0; nt < 4; ++nt) mma_fp8(tmp[mt][nt], af[mt], b0r[nt], b1r[nt]);
+      }
+#pragma unroll
+      for (int mt = 0; mt < MT; ++mt) {
+        const float s0 = sa[mt][0] * sb, s1 = sa[mt][1] * sb;
+#pragma unroll
+        for (int nt = 0; nt < 4; ++nt) {
+          acc[mt][nt][0] = fmaf(tmp[mt][nt][0], s0, acc[mt][nt][0]);
+          acc[mt][nt][1] = fmaf(tmp[mt][nt][1], s0, acc[mt][nt][1]);
+          acc[mt][nt][2] = fmaf(tmp[mt][nt][2], s1, acc[mt][nt][2]);
+          acc[mt][nt][3] = fmaf(tmp[mt][nt][3], s1, acc[mt][nt][3]);
+          tmp[mt][nt][0] = tmp[mt][nt][1] = tmp[mt][nt][2] = tmp[mt][nt][3] = 0.f;
+        }
+      }
+    } else {
