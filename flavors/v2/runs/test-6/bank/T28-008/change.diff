index 0000000000..bd907d37bf
--- /dev/null
+++ b/vllm/model_executor/layers/quantization/utils/t29_bs_gemm/t29_norm_quant.cu
@@ -0,0 +1,196 @@
+// T29: Gemma RMSNorm (+ fused residual add) with the W8A8 activation quant fused in.
+//
+// The norm reproduces flashinfer's CuTe-DSL RMSNormKernel / FusedAddRMSNormKernel (the ones the
+// server runs on sm_89) operation by operation, so y (and the residual) are bitwise equal to it:
+//   CTA = 128 threads = 2 rows x 64 threads; thread t of a row holds cols b*512 + t*8 + v
+//   (b < H/512, v < 8); h = float(x) [+ float(r)] in fp32 (residual stored as bf16(h), the norm
+//   uses the unrounded h); per-thread sum of h*h, warp butterfly (xor 1,2,...,16), sum of the
+//   row's 2 warp partials; rstd = rsqrt.approx(sum / H + eps); y = bf16((h * rstd) * (w + 1)).
+// Details the DSL source leaves open (in-thread order, fma contraction of h*h + acc, IEEE or
+// approximate division) are template switches; the probe picks the variant that is bitwise.
+//
+// Quant (same math as vLLM's per_token_group_quant_fp8, use_ue8m0=False): per 128-col group,
+// absmax = max(1e-10, max|y|), s = absmax / 448, inv = 1 / s (IEEE), q = e4m3_rn(clamp(y * inv)).
+// PERM: inside each 32-col block, stored col blk*32 + s holds y[blk*32 + PI[s]] (PI_SPEC).
+// Scales: fp32 [M, H/128], groups not permuted.
+#include <torch/extension.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <cuda_bf16.h>
+#include <cuda_fp8.h>
+
+namespace {
+
+constexpr int TPR = 64;   // threads per row (flashinfer: 3072 < H <= 6144)
+constexpr int ROWS = 2;   // rows per CTA (128 threads)
+
+__device__ __forceinline__ float rsqrt_approx(float x) {
+  float y;
+  asm("rsqrt.approx.ftz.f32 %0, %1;" : "=f"(y) : "f"(x));
+  return y;
+}
+
+// RED: 0 = sequential, b outer / v inner (fragment order); 1 = sequential, v outer / b inner
+// FMA: acc = fma(h, h, acc) vs acc + rn(h*h);  DIVA: sum / H as div.approx vs div.rn
+template <int NB, int RED, bool FMA, bool DIVA, bool HAS_RES>
+__global__ void __launch_bounds__(128) norm_quant_kernel(
+    const __nv_bfloat16* __restrict__ x, __nv_bfloat16* __restrict__ r,
+    const __nv_bfloat16* __restrict__ w, __nv_bfloat16* __restrict__ y,
+    uint8_t* __restrict__ q, float* __restrict__ s, int M, int64_t sx, int64_t sr, int64_t sy,
+    int64_t sq, int64_t ss, float eps, bool write_y, bool quant, bool perm) {
+  constexpr int H = NB * 512;
+  const int tid = threadIdx.x;
+  const int rr = tid / TPR, t = tid % TPR, lane = tid % 32, warp = tid / 32;
+  const int64_t m = (int64_t)blockIdx.x * ROWS + rr;
+  const bool ok = m < M;
+  __shared__ float red[ROWS][2];
+
+  float h[NB][8];
+#pragma unroll
+  for (int b = 0; b < NB; b++) {
+    const int c = b * 512 + t * 8;
+    uint4 xv = make_uint4(0, 0, 0, 0), rv = make_uint4(0, 0, 0, 0);
+    if (ok) {
+      xv = *reinterpret_cast<const uint4*>(x + m * sx + c);
+      if (HAS_RES) rv = *reinterpret_cast<const uint4*>(r + m * sr + c);
+    }
+    const __nv_bfloat16* xe = reinterpret_cast<const __nv_bfloat16*>(&xv);
+    const __nv_bfloat16* re = reinterpret_cast<const __nv_bfloat16*>(&rv);
+    uint4 ov;
+    __nv_bfloat16* oe = reinterpret_cast<__nv_bfloat16*>(&ov);
+#pragma unroll
+    for (int v = 0; v < 8; v++) {
+      float hv = __bfloat162float(xe[v]);
+      if (HAS_RES) hv = __fadd_rn(hv, __bfloat162float(re[v]));
+      h[b][v] = hv;
+      oe[v] = __float2bfloat16_rn(hv);
+    }
+    if (HAS_RES && ok) *reinterpret_cast<uint4*>(r + m * sr + c) = ov;
+  }
+
+  float acc = 0.f;
+  if (RED == 0) {
+#pragma unroll
+    for (int b = 0; b < NB; b++)
+#pragma unroll
+      for (int v = 0; v < 8; v++)
+        acc = FMA ? __fmaf_rn(h[b][v], h[b][v], acc) : __fadd_rn(acc, __fmul_rn(h[b][v], h[b][v]));
+  } else {
+#pragma unroll
+    for (int v = 0; v < 8; v++)
+#pragma unroll
+      for (int b = 0; b < NB; b++)
+        acc = FMA ? __fmaf_rn(h[b][v], h[b][v], acc) : __fadd_rn(acc, __fmul_rn(h[b][v], h[b][v]));
+  }
+#pragma unroll
+  for (int off = 1; off < 32; off <<= 1) acc = __fadd_rn(acc, __shfl_xor_sync(0xffffffffu, acc, off));
+  if (lane == 0) red[rr][warp % 2] = acc;
+  __syncthreads();
+  float tot = lane < 2 ? red[rr][lane] : 0.f;
+#pragma unroll
+  for (int off = 1; off < 32; off <<= 1) tot = __fadd_rn(tot, __shfl_xor_sync(0xffffffffu, tot, off));
+  const float mean = DIVA ? __fdividef(tot, (float)H) : __fdiv_rn(tot, (float)H);
+  const float rstd = rsqrt_approx(__fadd_rn(mean, eps));
+
+#pragma unroll
+  for (int b = 0; b < NB; b++) {
+    const int c = b * 512 + t * 8;
+    uint4 wv = *reinterpret_cast<const uint4*>(w + c);
+    const __nv_bfloat16* we = reinterpret_cast<const __nv_bfloat16*>(&wv);
+    uint4 ov;
+    __nv_bfloat16* oe = reinterpret_cast<__nv_bfloat16*>(&ov);
+    float yf[8];
+    float amax = 1e-10f;
+#pragma unroll
+    for (int v = 0; v < 8; v++) {
+      const float wf = __fadd_rn(__bfloat162float(we[v]), 1.f);
+      oe[v] = __float2bfloat16_rn(__fmul_rn(__fmul_rn(h[b][v], rstd), wf));
+      yf[v] = __bfloat162float(oe[v]);
+      amax = fmaxf(amax, fabsf(yf[v]));
+    }
+    if (write_y && ok) *reinterpret_cast<uint4*>(y + m * sy + c) = ov;
+    if (quant) {
+      // a 128-col group = 16 consecutive threads of one warp
+#pragma unroll
+      for (int off = 8; off > 0; off >>= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, off));
+      const float sc = __fdiv_rn(amax, 448.f);
+      const float inv = __fdiv_rn(1.f, sc);
+      uint2 pv;
+      uint8_t* pe = reinterpret_cast<uint8_t*>(&pv);
+#pragma unroll
+      for (int v = 0; v < 8; v++)
+        pe[v] = __nv_fp8_e4m3(fminf(fmaxf(__fmul_rn(yf[v], inv), -448.f), 448.f)).__x;
+      if (perm) {
+        // PI inside a 32-col block: thread k = t % 4 holds cols 8k..8k+7, which go to stored
+        // positions 16*(k/2) + (k%2) + 2v. Lanes k, k^1 swap their 8 bytes; the even one writes the
+        // interleaved 16 bytes. (warps never span rows, so the shuffle is warp-uniform)
+        const uint32_t olo = __shfl_xor_sync(0xffffffffu, pv.x, 1);
+        const uint32_t ohi = __shfl_xor_sync(0xffffffffu, pv.y, 1);
+        if (ok && (t % 2) == 0) {
+          uint4 o;
+          o.x = __byte_perm(pv.x, olo, 0x5140);
+          o.y = __byte_perm(pv.x, olo, 0x7362);
+          o.z = __byte_perm(pv.y, ohi, 0x5140);
+          o.w = __byte_perm(pv.y, ohi, 0x7362);
+          *reinterpret_cast<uint4*>(q + m * sq + (c & ~31) + 16 * ((t % 4) / 2)) = o;
+        }
+      } else if (ok) {
+        *reinterpret_cast<uint2*>(q + m * sq + c) = pv;
+      }
+      if (ok) {
+        if ((t % 16) == 0) s[m * ss + c / 128] = sc;
+      }
+    }
+  }
+}
+
+template <int NB, int RED, bool FMA, bool DIVA>
+void launch_nb(bool has_res, dim3 grid, cudaStream_t st, const __nv_bfloat16* x, __nv_bfloat16* r,
+               const __nv_bfloat16* w, __nv_bfloat16* y, uint8_t* q, float* s, int M, int64_t sx,
+               int64_t sr, int64_t sy, int64_t sq, int64_t ss, float eps, bool wy, bool qu, bool pe) {
+  if (has_res)
+    norm_quant_kernel<NB, RED, FMA, DIVA, true><<<grid, 128, 0, st>>>(x, r, w, y, q, s, M, sx, sr, sy, sq, ss, eps, wy, qu, pe);
+  else
+    norm_quant_kernel<NB, RED, FMA, DIVA, false><<<grid, 128, 0, st>>>(x, r, w, y, q, s, M, sx, sr, sy, sq, ss, eps, wy, qu, pe);
+}
+
+}  // namespace
+
+// x [M,H] bf16 (row stride sx, unit col stride); residual [M,H] bf16 or empty (updated in place);
+// y [M,H] bf16 or empty; q [M,H] e4m3 or empty; s fp32 [M,H/128] or empty. variant = RED + 2*FMA + 4*DIVA.
+void t29_norm_quant(torch::Tensor x, torch::Tensor residual, torch::Tensor weight, torch::Tensor y,
+                    torch::Tensor q, torch::Tensor s, double eps, bool perm, int64_t variant) {
+  const int64_t M = x.size(0), H = x.size(1);
+  TORCH_CHECK(x.scalar_type() == at::kBFloat16 && weight.scalar_type() == at::kBFloat16, "bf16");
+  TORCH_CHECK(x.stride(1) == 1 && weight.is_contiguous() && weight.numel() == H, "layout");
+  TORCH_CHECK(H == 5120, "H == 5120 only (flashinfer thread map: 64 threads/row, 10 x 512 cols)");
+  const bool has_res = residual.numel() > 0, wy = y.numel() > 0, qu = q.numel() > 0;
+  if (has_res) TORCH_CHECK(residual.stride(1) == 1 && residual.size(0) == M && residual.size(1) == H, "residual");
+  if (wy) TORCH_CHECK(y.stride(1) == 1 && y.size(0) == M && y.size(1) == H, "y");
+  if (qu) TORCH_CHECK(q.element_size() == 1 && q.stride(1) == 1 && q.size(1) == H && s.size(1) == H / 128 &&
+                      s.stride(1) == 1 && s.scalar_type() == at::kFloat, "q/s");
+  if (M == 0) return;
+  const at::cuda::OptionalCUDAGuard guard(x.device());
+  cudaStream_t st = at::cuda::getCurrentCUDAStream();
+  dim3 grid((unsigned)((M + ROWS - 1) / ROWS));
+  auto* xp = reinterpret_cast<const __nv_bfloat16*>(x.data_ptr());
+  auto* rp = has_res ? reinterpret_cast<__nv_bfloat16*>(residual.data_ptr()) : nullptr;
+  auto* wp = reinterpret_cast<const __nv_bfloat16*>(weight.data_ptr());
+  auto* yp = wy ? reinterpret_cast<__nv_bfloat16*>(y.data_ptr()) : nullptr;
+  auto* qp = qu ? reinterpret_cast<uint8_t*>(q.data_ptr()) : nullptr;
+  auto* sp = qu ? s.data_ptr<float>() : nullptr;
+  const int64_t sx = x.stride(0), sr = has_res ? residual.stride(0) : 0, sy = wy ? y.stride(0) : 0;
+  const int64_t sq = qu ? q.stride(0) : 0, ss = qu ? s.stride(0) : 0;
+  const float e = (float)eps;
+#define L(V, RED, FMA, DIVA) \
+  case V: launch_nb<10, RED, FMA, DIVA>(has_res, grid, st, xp, rp, wp, yp, qp, sp, (int)M, sx, sr, sy, sq, ss, e, wy, qu, perm); break;
+  switch (variant) {
+    L(0, 0, false, false) L(1, 1, false, false) L(2, 0, true, false) L(3, 1, true, false)
+    L(4, 0, false, true) L(5, 1, false, true) L(6, 0, true, true) L(7, 1, true, true)
+    default: TORCH_CHECK(false, "bad variant");
+  }
+#undef L
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("t29_norm_quant", &t29_norm_quant); }
diff --git a/vllm/model_executor/layers/quantization/utils/t29_fused.py b/vllm/model_executor/layers/quantization/utils/t29_fused.py
new file mode 100644
index 0000000000..a2b63e8c7d
--- /dev/null
+++ b/vllm/model_executor/layers/quantization/utils/t29_fused.py
@@ -0,0 +1,295 @@
+# SPDX-License-Identifier: Apache-2.0
+"""T29_FUSED (default 1; 0 = T29-004 path): fused producers of the T29 W8A8 activation (on top of T29_W8A8=2).
+
+The activation that t29_marlin_w8a8's GEMM consumes (dynamic per-token-group-128 e4m3, columns
+PI-permuted inside each 32-block, fp32 scales [M, K/128]) is produced directly by the op before the
+linear instead of by a separate quant_perm pass:
+  - Gemma RMSNorm (+ residual add) -> qkvz / attn qkv / gate_up  (t29_norm_quant.cu; the norm is
+    flashinfer's CuTe-DSL kernel reproduced bitwise, see the .cu header)
+  - silu_and_mul -> down  (Triton; same math as vLLM's silu_and_mul + per_token_group_quant_fp8)
+Both are bitwise equal to the unfused path (flashinfer norm / vLLM silu_and_mul, then quant_perm).
+
+A linear that can consume it advertises T29_PI_KEY (layer._input_quant_key, the existing
+QuantizedActivation mechanism); producers emit it only when wants_q(M): M > 96 by default (M <= 96
+keeps the exact bf16 Marlin path), every M with T29_FUSED_ALL_M=1 (for T28's Marlin-e4m3 decode).
+"""
+
+import os
+from dataclasses import dataclass
+
+import torch
+
+from vllm.model_executor.layers.fusion.quant_activation import QuantizedActivation
+from vllm.model_executor.layers.quantization.utils import t29_marlin_w8a8 as W
+from vllm.model_executor.layers.quantization.utils.quant_utils import (
+    QuantKey,
+    kFp8Dynamic128Sym,
+)
+from vllm.triton_utils import tl, triton
+
+FUSED = W.ENABLED and os.environ.get("T29_FUSED", "1") == "1"
+CAPTURE = os.environ.get("T29_CAPTURE", "") if W.ENABLED else ""
+FUSED_ALL_M = FUSED and os.environ.get("T29_FUSED_ALL_M", "0") == "1"
+# t29_norm_quant.cu variant that is bitwise vs flashinfer's CuTe norms (probe job 225: of the 8,
+# only RED=0 (b outer, v inner), FMA, IEEE division matched y/residual/q/s at every tested M)
+NORM_VARIANT = 2
+NORM_FUSED = FUSED and os.environ.get("T29_FUSED_NORM", "1") == "1"
+# smallest M for the fused norm at the default (M > 96) gate: below it the unfused norm + quant_perm
+# is faster (both bitwise the same values; pure performance choice)
+NORM_MIN_M = int(os.environ.get("T29_FUSED_NORM_MIN_M", "256"))  # job 226: fused 8.1 vs 8.2 us at 256, slower below
+
+
+@dataclass(frozen=True)
+class T29PiKey(QuantKey):
+    """Group-128 dynamic e4m3 with the PI column permutation: a distinct class, so it never
+    compares equal to kFp8Dynamic128Sym (dataclass __eq__ checks the class)."""
+
+
+T29_PI_KEY = T29PiKey(kFp8Dynamic128Sym.dtype, kFp8Dynamic128Sym.scale, symmetric=True)
+
+
+def wants_q(m: int) -> bool:
+    return FUSED_ALL_M or m > W.MAX_MARLIN_M
+
+
+def qa(q: torch.Tensor, s: torch.Tensor, x_like: torch.Tensor) -> QuantizedActivation:
+    return QuantizedActivation(data=q, scale=s, orig_dtype=x_like.dtype, orig_shape=x_like.shape,
+                               quant_key=T29_PI_KEY)
+
+
+def norm_quant(x: torch.Tensor, residual: torch.Tensor | None, weight: torch.Tensor, eps: float,
+               write_y: bool):
+    """[residual += x (bf16)]; y = GemmaRMSNorm(x or residual) (bitwise flashinfer);
+    returns (QuantizedActivation of y, y or None)."""
+    M, H = x.shape
+    q = torch.empty((M, H), device=x.device, dtype=torch.float8_e4m3fn)
+    s = torch.empty((M, H // 128), device=x.device, dtype=torch.float32)
+    y = torch.empty_like(x) if write_y else x.new_empty(0)
+    W.nq_ext().t29_norm_quant(x, residual if residual is not None else x.new_empty(0), weight,
+                              y, q, s, float(eps), True, NORM_VARIANT)
+    return qa(q, s, x), (y if write_y else None)
+
+
+def _rows_ok(t: torch.Tensor) -> bool:
+    # the kernel reads 16-byte vectors per row
+    return (t.dim() == 2 and t.dtype == torch.bfloat16 and t.shape[1] == 5120 and t.stride(1) == 1
+            and t.stride(0) % 8 == 0 and t.data_ptr() % 16 == 0)
+
+
+def norm_quant_ok(x: torch.Tensor, residual: torch.Tensor | None, linear) -> bool:
+    from vllm.model_executor.layers.fusion.quant_activation import get_input_quant_key
+
+    return (NORM_FUSED and linear is not None and get_input_quant_key(linear) == T29_PI_KEY
+            and isinstance(x, torch.Tensor) and _rows_ok(x)
+            and (residual is None or (_rows_ok(residual) and residual.shape[0] == x.shape[0]))
+            and wants_q(x.shape[0]) and (FUSED_ALL_M or x.shape[0] >= NORM_MIN_M))
+
+
+# ---------------- silu_and_mul -> e4m3 (+PI) ----------------
+@triton.jit
+def _quant_store_groups(v, rows_q_ptr, rows_s_ptr, g0, NG, GB: tl.constexpr):
+    # v: fp32 [GB, 128] (values already rounded to bf16); vLLM's per_token_group_quant_fp8 math
+    gi = g0 + tl.arange(0, GB)
+    ci = tl.arange(0, 128)
+    gmask = gi < NG
+    amax = tl.maximum(tl.max(tl.abs(v), axis=1), 1e-10)
+    s = tl.math.div_rn(amax, 448.0)
+    inv = tl.math.div_rn(tl.full(s.shape, 1.0, tl.float32), s)
+    q = tl.minimum(tl.maximum(v * inv[:, None], -448.0), 448.0)
+    # round to the e4m3 grid in fp32 first (RNE): Triton's fp32->e4m3 goes via f16 on sm_89
+    e = ((q.to(tl.int32, bitcast=True) >> 23) & 0xFF) - 127
+    e = tl.maximum(e, -6)
+    quantum = ((e - 3 + 127) << 23).to(tl.float32, bitcast=True)
+    inv_quantum = ((127 - (e - 3)) << 23).to(tl.float32, bitcast=True)
+    q = tl.extra.cuda.libdevice.rint(q * inv_quantum) * quantum
+    cols = gi[:, None] * 128 + ci[None, :]
+    j = cols % 32  # PI: stored col of original col j inside its 32-block
+    cols = cols - j + 16 * (j // 16) + 4 * ((j // 2) % 4) + 2 * (j % 2) + (j // 8) % 2
+    tl.store(rows_q_ptr + cols, q.to(rows_q_ptr.dtype.element_ty), mask=gmask[:, None])
+    tl.store(rows_s_ptr + gi, s, mask=gmask)
+
+
+@triton.jit
+def _silu_mul_quant_kernel(gu_ptr, q_ptr, s_ptr, I, NG, sg, sq, ss, GB: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    gb = tl.program_id(1)
+    offs = tl.arange(0, GB)[:, None] * 128 + tl.arange(0, 128)[None, :]
+    cols = gb * GB * 128 + offs
+    m = cols < I
+    a = tl.load(gu_ptr + row * sg + cols, mask=m, other=0.0).to(tl.float32)
+    b = tl.load(gu_ptr + row * sg + I + cols, mask=m, other=0.0).to(tl.float32)
+    # as vLLM's act_and_mul (silu): bf16(x / (1 + expf(-x))) * y in fp32, rounded to bf16
+    e = tl.extra.cuda.libdevice.exp(-a)
+    sl = tl.math.div_rn(a, 1.0 + e).to(gu_ptr.dtype.element_ty).to(tl.float32)
+    v = (sl * b).to(gu_ptr.dtype.element_ty).to(tl.float32)
+    _quant_store_groups(v, q_ptr + row * sq, s_ptr + row * ss, gb * GB, NG, GB)
+
+
+def silu_mul_quant(gate_up: torch.Tensor, gb: int = 2):
+    M, I2 = gate_up.shape
+    I = I2 // 2
+    q = torch.empty((M, I), device=gate_up.device, dtype=torch.float8_e4m3fn)
+    s = torch.empty((M, I // 128), device=gate_up.device, dtype=torch.float32)
+    _silu_mul_quant_kernel[(M, triton.cdiv(I // 128, gb))](
+        gate_up, q, s, I, I // 128, gate_up.stride(0), q.stride(0), s.stride(0), GB=gb,
+        num_warps=4)
+    return q, s
+
+
+_CHECK = os.environ.get("T28_E4M3_CHECK_QUANT", "0") == "1"
+_checked: set = set()
+
+
+def _check_vs_own_quant(x: torch.Tensor, q: torch.Tensor, s: torch.Tensor) -> None:
+    """T28_E4M3_CHECK_QUANT=1: first eager call per (M, width): compare the fused silu+quant output with
+    silu_and_mul (the unfused op) followed by our own quant_perm; logs max |diff| of the e4m3 bytes and the scales
+    (expected 0). Never inside CUDA graph capture. Norm producers are not checked (T29_FUSED_NORM=0 is our config)."""
+    key = (x.shape[0], x.shape[1])
+    if key in _checked or torch.cuda.is_current_stream_capturing():
+        return
+    _checked.add(key)
+    from vllm.logger import init_logger
+
+    act = torch.empty((x.shape[0], x.shape[1] // 2), device=x.device, dtype=x.dtype)
+    torch.ops._C.silu_and_mul(act, x)
+    rq, rs = W.quant_perm(act)
+    dq = (q.view(torch.uint8).to(torch.int32) - rq.view(torch.uint8).to(torch.int32)).abs().max().item()
+    ds = (s - rs).abs().max().item()
+    init_logger(__name__).info("T28_E4M3_CHECK_QUANT silu M=%d: max|dq bytes|=%d max|d scale|=%g", x.shape[0], dq, ds)
+
+
+def _silu_producer(x: torch.Tensor, linear) -> QuantizedActivation:
+    q, s = silu_mul_quant(x)
+    if _CHECK:
+        _check_vs_own_quant(x, q, s)
+    return QuantizedActivation(data=q, scale=s, orig_dtype=x.dtype,
+                               orig_shape=torch.Size((x.shape[0], x.shape[1] // 2)),
+                               quant_key=T29_PI_KEY)
+
+
+def _silu_supported(act_fn, x: torch.Tensor, linear) -> bool:
+    return (x.dim() == 2 and x.dtype == torch.bfloat16 and x.stride(1) == 1
+            and x.shape[1] % 256 == 0 and wants_q(x.shape[0]))
+
+
+def register_act_quant() -> None:
+    from vllm.model_executor.layers.activation import SiluAndMul
+    from vllm.model_executor.layers.fusion import fused_act_quant as F
+
+    F._FUSED_ACT_QUANT[(SiluAndMul, T29_PI_KEY)] = _silu_producer
+    F._FUSED_ACT_QUANT_SUPPORT[(SiluAndMul, T29_PI_KEY)] = _silu_supported
+
+
+if FUSED:
+    register_act_quant()
+
+
+_warm = set()
+
+
+def warmup_once(dev: torch.device) -> None:
+    if dev not in _warm:
+        _warm.add(dev)
+        warmup(dev)
+
+
+def warmup(dev: torch.device) -> None:
+    """Compile/load the producers at load time (no JIT while serving): Triton specializes on
+    M % 16 and the extension loads once."""
+    for m in sorted({W.MAX_MARLIN_M + 1, W.MAX_MARLIN_M + 16, 128, 2048, 1, 16, 17}):
+        gu = torch.zeros(m, 2 * 8704, device=dev, dtype=torch.bfloat16)
+        silu_mul_quant(gu)
+        if NORM_FUSED:
+            x = torch.zeros(m, 5120, device=dev, dtype=torch.bfloat16)
+            w = torch.zeros(5120, device=dev, dtype=torch.bfloat16)
+            norm_quant(x, x.clone(), w, 1e-6, True)
+            norm_quant(x, None, w, 1e-6, False)
+
+
+# ---------------- validation capture (T29_CAPTURE=<dir>; test-only, eager server) ----------------
+# With T29_CAPTURE set, the producer sites run the UNFUSED path (exactly the T29_FUSED=0 kernels) and
+# rank 0 saves their real inputs and outputs (a few per site kind and M bucket), so an offline job
+# can check the fused kernels bitwise against them. The GEMM path also compares the bs_gemm config
+# table in use against T29_CAPTURE_REF_TABLE (another configs.json) on the live activations.
+_CAP_MAX = int(os.environ.get("T29_CAPTURE_PER_KEY", "3"))
+_cap_n: dict = {}
+_cap_total = [0]
+_BUCKETS = (16, 96, 128, 255, 511, 1023, 1536, 1 << 30)
+
+
+def _cap_rank0() -> bool:
+    try:
+        return torch.distributed.get_rank() == 0
+    except Exception:
+        return True
+
+
+def capture_take(kind: str, m: int) -> bool:
+    if not CAPTURE or torch.cuda.is_current_stream_capturing() or not _cap_rank0():
+        return False
+    b = next(i for i, hi in enumerate(_BUCKETS) if m <= hi)
+    k = (kind, b)
+    if _cap_n.get(k, 0) >= _CAP_MAX:
+        return False
+    _cap_n[k] = _cap_n.get(k, 0) + 1
+    return True
+
+
+def capture_save(rec: dict) -> None:
+    os.makedirs(CAPTURE, exist_ok=True)
+    _cap_total[0] += 1
+    rec = {k: (v.detach().cpu().clone() if isinstance(v, torch.Tensor) else v) for k, v in rec.items()}
+    torch.save(rec, os.path.join(CAPTURE, f"cap_{_cap_total[0]:05d}.pt"))
+
+
+def capture_ok(x, residual, linear) -> bool:
+    from vllm.model_executor.layers.fusion.quant_activation import get_input_quant_key
+
+    return (bool(CAPTURE) and linear is not None and get_input_quant_key(linear) == T29_PI_KEY
+            and isinstance(x, torch.Tensor) and _rows_ok(x)
+            and (residual is None or (_rows_ok(residual) and residual.shape[0] == x.shape[0])))
+
+
+def _silu_capture_producer(x: torch.Tensor, linear):
+    out = torch.empty((x.shape[0], x.shape[1] // 2), device=x.device, dtype=x.dtype)
+    torch.ops._C.silu_and_mul(out, x)
+    if capture_take("silu", x.shape[0]):
+        capture_save({"kind": "silu", "prefix": getattr(linear, "prefix", ""), "gate_up": x, "out": out})
+    return out
+
+
+if CAPTURE:
+    from vllm.model_executor.layers.activation import SiluAndMul as _S
+    from vllm.model_executor.layers.fusion import fused_act_quant as _F
+
+    _F._FUSED_ACT_QUANT[(_S, T29_PI_KEY)] = _silu_capture_producer
+    _F._FUSED_ACT_QUANT_SUPPORT[(_S, T29_PI_KEY)] = lambda a, x, l: x.dim() == 2
+
+_ref_table = None
+gemm_cmp: dict = {}
+
+
+def capture_gemm_compare(xq, xs, qweight, ws, out, N, K) -> None:
+    """Re-run the GEMM with the reference table's config; count differing outputs (rank 0, eager)."""
+    global _ref_table
+    p = os.environ.get("T29_CAPTURE_REF_TABLE", "")
+    if not p or not CAPTURE or torch.cuda.is_current_stream_capturing() or not _cap_rank0():
+        return
+    if _ref_table is None:
+        import json
+
+        _ref_table = {k: {int(m): v[0] for m, v in d.items()} for k, d in json.load(open(p)).items()}
+    d = _ref_table.get(f"{N}x{K}", {})
+    M = xq.shape[0]
+    cfg_ref = next((d[m] for m in sorted(d) if M <= m), d[max(d)] if d else 7)
+    cfg = W.pick(N, K, M)
+    ref = torch.empty_like(out)
+    a, c = W._dummies(xq.device)
+    W.ext().bs_gemm_marlin(xq, qweight, xs, ws, ref, cfg_ref, 1, a, c)
+    ne = int((ref != out).sum().item())
+    mx = (ref.float() - out.float()).abs().max().item()
+    k = (f"{N}x{K}", M, cfg, cfg_ref)
+    t = gemm_cmp.setdefault(k, [0, 0, 0.0])
+    t[0] += ne; t[1] += out.numel(); t[2] = max(t[2], mx)
+    with open(os.path.join(CAPTURE, "gemm_v2_vs_ref.txt"), "a") as f:
+        f.write(f"{N}x{K} M={M} cfg={cfg} ref_cfg={cfg_ref} differ={ne}/{out.numel()} maxabs={mx:.4g}\n")
