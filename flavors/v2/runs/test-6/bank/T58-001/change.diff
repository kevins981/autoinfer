@@ -0,0 +1,151 @@
+# SPDX-License-Identifier: Apache-2.0
+"""T57_FCTAB: precomputed drafter fc-embedding table in pinned host memory (AutoInfer T57, T56's idea).
+
+The MTP drafter computes  fc(cat(norm_e(E[x]), norm_h(h)))  with fc a ColumnParallelLinear (gather_output)
+whose weight per rank is W_r [N/tp, 2H].  Linearity gives
+
+    out_r = norm_e(E[x]) @ W_r[:, :H]^T + norm_h(h) @ W_r[:, H:]^T = T_r[x] + norm_h(h) @ W_r[:, H:]^T
+
+with T_r[v] = norm_e(E[v]) @ W_r[:, :H]^T built once at load (fp32 accumulation, rounded once to bf16) for every vocab id
+and kept in host memory (registered, mapped: read by a zero-copy gather inside the graph, KB125).  This drops the
+drafter's vocab-parallel embedding lookup + all-reduce and halves the fc GEMM.  Drafter-only: every drafted token is
+verified by the target, so outputs are unchanged; the numerics differ from the stock path by one extra bf16 rounding
+of the E-part (the h-part is accumulated in fp32 and added before the single final rounding).
+
+Switch: T57_FCTAB (default "1"; "0" = stock path).  T57_FCTAB_CHUNK = build chunk rows (4096).
+"""
+import os
+
+import torch
+
+from vllm.logger import init_logger
+from vllm.triton_utils import tl, triton
+
+logger = init_logger(__name__)
+
+ENABLED = os.environ.get("T57_FCTAB", "1") != "0"
+CHUNK = int(os.environ.get("T57_FCTAB_CHUNK", "4096"))
+LO = os.environ.get("T57_FCTAB_LO", "0") == "1"  # table = bf16 hi + bf16 lo (~fp32): one final rounding like the stock path
+
+
+@triton.jit
+def _norm_h_kernel(h_ptr, h_stride, w_ptr, eps, out_ptr, out_stride, H: tl.constexpr, BLOCK: tl.constexpr):
+    # identical math to fused_pre_fc_norms' hidden half (Gemma RMSNorm, fp32, cast on store)
+    tok = tl.program_id(0)
+    off = tl.arange(0, BLOCK)
+    mask = off < H
+    x = tl.load(h_ptr + tok * h_stride + off, mask=mask, other=0.0).to(tl.float32)
+    mean_sq = tl.sum(x * x, axis=0) / H
+    rrms = tl.rsqrt(mean_sq + eps)
+    w = tl.load(w_ptr + off, mask=mask).to(tl.float32) + 1.0
+    tl.store(out_ptr + tok * out_stride + off, (x * rrms) * w, mask=mask)
+
+
+@triton.jit
+def _gather_add_kernel(y_ptr, ids_ptr, tab_addr, out_ptr, V, N: tl.constexpr, BLOCK: tl.constexpr, LO: tl.constexpr):
+    m = tl.program_id(0)
+    nb = tl.program_id(1)
+    tid = tl.load(ids_ptr + m).to(tl.int64)
+    tid = tl.minimum(tl.maximum(tid, 0), V - 1)
+    tp = tab_addr.to(tl.pointer_type(tl.bfloat16))
+    off = nb * BLOCK + tl.arange(0, BLOCK)
+    mask = off < N
+    ROW: tl.constexpr = 2 * N if LO else N
+    t = tl.load(tp + tid * ROW + off, mask=mask, other=0.0).to(tl.float32)
+    if LO:
+        t = t + tl.load(tp + tid * ROW + N + off, mask=mask, other=0.0).to(tl.float32)
+    y = tl.load(y_ptr + m * N + off, mask=mask, other=0.0)
+    tl.store(out_ptr + m * N + off, (y + t).to(tl.bfloat16), mask=mask)
+
+
+class FcTab:
+    def __init__(self, inner, tab_host, tab_addr, V, N, wh, w_h_norm, eps, tp):
+        self.inner = inner
+        self.tab_host = tab_host
+        self.tab_addr = tab_addr
+        self.V, self.N = V, N
+        self.wh = wh          # [N, H] view of W_r[:, H:]  (stride (2H, 1))
+        self.wnorm = w_h_norm  # pre_fc_norm_hidden.weight
+        self.eps = eps
+        self.tp = tp
+
+    def fc(self, input_ids: torch.Tensor, hidden: torch.Tensor) -> torch.Tensor:
+        M, H = hidden.shape
+        hn = torch.empty(M, H, dtype=hidden.dtype, device=hidden.device)
+        _norm_h_kernel[(M,)](hidden, hidden.stride(0), self.wnorm, self.eps, hn, hn.stride(0), H,
+                             triton.next_power_of_2(H))
+        y = torch.mm(hn, self.wh.t(), out_dtype=torch.float32)  # [M, N] fp32 accumulate over K=H
+        out = torch.empty(M, self.N, dtype=hidden.dtype, device=hidden.device)
+        _gather_add_kernel[(M, triton.cdiv(self.N, 1024))](y, input_ids, self.tab_addr, out, self.V, self.N, 1024, LO)
+        if self.tp > 1:
+            from vllm.distributed import tensor_model_parallel_all_gather
+            out = tensor_model_parallel_all_gather(out, dim=-1)
+        return out
+
+
