+#pragma unroll
+  for (int mt = 0; mt < MT; ++mt)
+#pragma unroll
+    for (int h = 0; h < 2; ++h) {
+      const int r = m0 + mt * 16 + (lane >> 2) + h * 8;
+      arow[mt][h] = r < M ? r : -1;
+    }
