+@triton.jit
+def _greedy_verify_kernel(
+    # [num_reqs, num_speculative_steps + 1]
+    sampled_ptr,
+    sampled_stride,
+    # [num_reqs]
+    num_sampled_ptr,
+    # [num_logits] target argmax of each logits row
+    target_tokens_ptr,
+    # [num_logits] (row j holds the draft token that row j-1 verifies)
+    draft_sampled_ptr,
+    # [num_reqs + 1]
+    cu_num_logits_ptr,
+):
+    req_idx = tl.program_id(0)
+    start_idx = tl.load(cu_num_logits_ptr + req_idx).to(tl.int64)
+    end_idx = tl.load(cu_num_logits_ptr + req_idx + 1).to(tl.int64)
+    num_draft_tokens = end_idx - start_idx - 1
+    running = tl.full((), 1, tl.int32)
+    accepted = tl.full((), 0, tl.int32)
+    for i in range(num_draft_tokens):
+        target = tl.load(target_tokens_ptr + start_idx + i).to(tl.int64)
+        draft = tl.load(draft_sampled_ptr + start_idx + i + 1).to(tl.int64)
+        # -1 placeholders are never accepted (draft >= 0 fails).
+        ok = ((target == draft) & (draft >= 0)).to(tl.int32)
+        running = running * ok
+        accepted += running
+        # Accepted slots equal the target argmax; the first rejected slot is
+        # the target argmax too, so every slot up to the bonus holds it.
+        tl.store(sampled_ptr + req_idx * sampled_stride + i, target)
+    bonus = tl.load(target_tokens_ptr + start_idx + num_draft_tokens).to(tl.int64)
+    tl.store(sampled_ptr + req_idx * sampled_stride + num_draft_tokens, bonus)
+    tl.store(num_sampled_ptr + req_idx, accepted + 1)
