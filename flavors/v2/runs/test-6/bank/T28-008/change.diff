+// A: e4m3 [M,K] with columns permuted by PI inside each 32-block; As fp32 [M,K/128] (unpermuted groups);
+// Bm: Marlin fp8 qweight (int32 [K/16, N*4]); Bs fp32 [N/128, K/128]; C bf16 [M,N]
+void bs_gemm_marlin(torch::Tensor A, torch::Tensor Bm, torch::Tensor As, torch::Tensor Bs, torch::Tensor C,
+                    int64_t cfg, int64_t split, torch::Tensor ws, torch::Tensor cnt) {
+  TORCH_CHECK(A.is_cuda() && A.element_size() == 1 && A.stride(1) == 1 && C.stride(1) == 1, "A/C layout");
+  TORCH_CHECK(Bm.is_contiguous() && As.stride(1) == 1 && Bs.stride(1) == 1, "B/scales layout");
+  TORCH_CHECK(C.scalar_type() == at::kBFloat16, "bf16 out");
+  const int64_t M = A.size(0), K = A.size(1), N = C.size(1);
+  TORCH_CHECK(K % 128 == 0 && N % 128 == 0 && C.size(0) == M, "K, N multiples of 128 (no Marlin padding)");
+  TORCH_CHECK(Bm.numel() * Bm.element_size() == N * K, "Marlin qweight size != N*K (padded?)");
+  TORCH_CHECK(Bs.size(0) == N / 128 && Bs.size(1) == K / 128 && As.size(1) == K / 128, "scale shapes");
+  const at::cuda::OptionalCUDAGuard guard(A.device());
+  cudaStream_t st = at::cuda::getCurrentCUDAStream();
+  float* wsp = split > 1 ? ws.data_ptr<float>() : nullptr;
+  int* cp = split > 1 ? cnt.data_ptr<int>() : nullptr;
+  if (split > 1) TORCH_CHECK(ws.numel() >= split * M * N, "workspace too small");
+  switch (cfg) {
+#define X(id, a, b, c, d, e, f) \
+  case id: launch<a, b, c, d, e, f, true>(A, Bm, As, Bs, C, (int)split, wsp, cp, st); break;
+    MCFG_LIST(X)
+#undef X
+#define X(id, a, b, c, d, e, f) \
+  case id: launch<a, b, c, d, e, f, true, true>(A, Bm, As, Bs, C, (int)split, wsp, cp, st); break;
+    MCFG_EPI_LIST(X)
+#undef X
+    default: TORCH_CHECK(false, "bad cfg");
+  }
+}
+
+std::vector<int64_t> mcfg_info(int64_t cfg) {
+  switch (cfg) {
+#define X(id, a, b, c, d, e, f) \
+  case id: return {a * c, b * d, a * b * 32, e * (a * c + b * d) * f};
+    MCFG_LIST(X)
+    MCFG_EPI_LIST(X)
+#undef X
+  }
+  return {};
+}
+
+std::vector<int64_t> cfg_info(int64_t cfg) {
+  switch (cfg) {
+#define X(id, a, b, c, d, e, f) \
+  case id: return {a * c, b * d, a * b * 32, e * (a * c + b * d) * f};
+    CFG_LIST(X)
+#undef X
+  }
+  return {};
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.def("bs_gemm", &bs_gemm);
+  m.def("cfg_info", &cfg_info);
+  m.def("bs_gemm_marlin", &bs_gemm_marlin);
+  m.def("mcfg_info", &mcfg_info);
+}
