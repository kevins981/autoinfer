+def combine_local_argmax(
+    gathered: torch.Tensor, batch: int, tp_size: int
+) -> torch.Tensor:
+    """Combine all-gathered per-rank (max value, global index) pairs.
+
+    ``gathered`` is [batch, 2 * tp_size] (rank-major pairs). The largest value
+    wins; ties go to the lowest rank, whose vocab shard holds the lowest global
+    indices, so the result equals ``torch.argmax`` over the full logits (first
+    max).
+    """
+    gathered = gathered.view(batch, tp_size, 2)
+    max_rank_idx = gathered[:, :, 0].argmax(dim=-1, keepdim=True)
+    top_tokens = gathered[:, :, 1].gather(dim=-1, index=max_rank_idx)
+    return top_tokens.squeeze(-1).to(torch.int64)
+
