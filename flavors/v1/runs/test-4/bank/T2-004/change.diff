+    def can_use_greedy_fastpath(
+        self,
+        input_batch: InputBatch,
+        draft_logits: DraftLogitsCache | None,
+        grammar_output: Any,
+    ) -> bool:
+        """Whether verification needs nothing but the target argmax per row:
+        every request is greedy and nothing reads or edits the full logits."""
+        sampler = self.sampler
+        idx = input_batch.idx_mapping_np
+        return (
+            draft_logits is None
+            and grammar_output is None
+            and self.watermark_key is None
+            and self.synthetic_conditional_rates is None
+            and not self.use_block_verification
+            and self.fly_window_size == 0
