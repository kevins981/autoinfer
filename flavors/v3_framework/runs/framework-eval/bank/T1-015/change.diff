new file mode 100644
index 0000000000..428151fa74
--- /dev/null
+++ b/vllm/models/qwen3_5/nvidia/rowsplit.py
@@ -0,0 +1,65 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Row-split pipelining of the TP all-reduces in large (mixed/prefill) steps.
+
+The all-reduce of a row-parallel GEMM output is split by rows into two halves;
+each half is reduced on a side stream while the main stream runs the GEMMs of
+the other half. Everything between all-reduces is row-independent, so results
+are exactly the unsplit ones up to the all-reduce's own rounding (identical).
+"""
+
+import os
+
+import torch
+
+from vllm.distributed import tensor_model_parallel_all_reduce
+
+ROWSPLIT = os.environ.get("VLLM_ROWSPLIT", "1") == "1"
+ROWSPLIT_MIN_TOKENS = int(os.environ.get("VLLM_ROWSPLIT_MIN_TOKENS", "256"))
+# Upper bound of steps that take the split (the scheduler caps a step at 2048 tokens; eager steps above the captured 512 gain 5-17%).
+ROWSPLIT_MAX_TOKENS = int(os.environ.get("VLLM_ROWSPLIT_MAX_TOKENS", "2048"))
+FORCE_NCCL = os.environ.get("VLLM_ROWSPLIT_NCCL", "1") == "1"
+
+_side: torch.cuda.Stream | None = None
+
+
+def side_stream() -> torch.cuda.Stream:
+    global _side
+    if _side is None:
+        _side = torch.cuda.Stream()
+    return _side
+
+
+def split_point(n: int) -> int:
+    a = (n // 2 + 7) // 8 * 8
+    return min(max(a, 1), n - 1)
+
+
+def async_all_reduce(t: torch.Tensor) -> tuple[torch.Tensor, torch.cuda.Event]:
+    """All-reduce ``t`` (produced on the current stream) on the side stream.
+    Returns (result, event); the consumer must ``wait_event`` before using it."""
+    main = torch.cuda.current_stream()
+    side = side_stream()
+    ready = torch.cuda.Event()
+    ready.record(main)
+    done = torch.cuda.Event()
+    with torch.cuda.stream(side):
+        side.wait_event(ready)
+        from vllm.distributed.device_communicators import hostmem_all_reduce as hm
+
+        hm.FORCE_NCCL = FORCE_NCCL
+        try:
+            out = tensor_model_parallel_all_reduce(t)
+        finally:
+            hm.FORCE_NCCL = False
+        done.record(side)
+    # t is read on the side stream, out is written there.
+    t.record_stream(side)
+    return out, done
+
+
+def consume(out: torch.Tensor, ev: torch.cuda.Event | None) -> torch.Tensor:
+    main = torch.cuda.current_stream()
+    if ev is not None:
+        main.wait_event(ev)
+        out.record_stream(main)
+    return out
