+def _t29_warmup(weight, weight_scale, block_size, out_dtype) -> None:
+    """T29_W8A8: compile every Triton variant the server can hit, at load time.
+
+    Triton specializes the M argument on M % 16 == 0 (and M == 1). The config
+    is the nearest M key of the per-(N, K) table, and captured sizes in a key's
+    range may all be multiples of 16, so an eager step (e.g. > the largest
+    captured size, or a token-split chunk) with M % 16 != 0 would JIT-compile
+    during inference. Run each table config at M = key and key + 1 (plus
