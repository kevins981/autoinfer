@@ -0,0 +1,93 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Greedy speculative verification without the full-vocab logits all-gather.
+
+Each TP rank takes the (max, argmax) of its local lm_head shard, the pairs are
+exchanged (O(rows * 2 * tp) instead of O(rows * vocab)) and reduced to the
+global argmax, lowest global index on ties (what argmax over the gathered row
+returns). Draft tokens are then verified against it exactly like the greedy
+branch of `rejection_sample`.
+"""
+
+import torch
+
+from vllm.distributed import tensor_model_parallel_all_gather
+from vllm.triton_utils import tl, triton
+
+
+def vocab_parallel_argmax(
+    local_logits: torch.Tensor,
+    vocab_start: int,
+    tp_size: int,
+) -> torch.Tensor:
+    """Global argmax over vocab-sharded logits.
+
+    `local_logits` [n, shard] (bf16/fp16/fp32) must already have padding / rows
+    past the real vocab set to -inf. Returns int64 [n] global token ids.
+    """
+    local_max, local_idx = local_logits.max(dim=-1)  # lowest index on ties
+    global_idx = local_idx + vocab_start
+    if tp_size == 1:
+        return global_idx
+    # float32 holds token ids < 2^24 exactly; values are upcast losslessly.
+    pair = torch.stack([local_max.float(), global_idx.float()], dim=-1)
+    gathered = tensor_model_parallel_all_gather(pair, dim=-1)
+    gathered = gathered.view(local_logits.shape[0], tp_size, 2)
+    # argmax over ranks: first (lowest rank == lowest vocab range) on ties.
+    best_rank = gathered[:, :, 0].argmax(dim=-1, keepdim=True)
+    return gathered[:, :, 1].gather(-1, best_rank).squeeze(-1).to(torch.int64)
+
+
+@triton.jit
+def _greedy_verify_kernel(
+    sampled_ptr,  # [num_reqs, S + 1]
+    sampled_stride,
+    num_accepted_ptr,  # [num_reqs]
+    target_ptr,  # [num_logits] target argmax per logit row
+    draft_ptr,  # [num_logits] input token of each row (-1: placeholder)
+    cu_num_logits_ptr,  # [num_reqs + 1]
+):
+    req_idx = tl.program_id(0)
+    start = tl.load(cu_num_logits_ptr + req_idx).to(tl.int64)
+    end = tl.load(cu_num_logits_ptr + req_idx + 1)
+    num_draft = end - start - 1
+    accepted_length = tl.zeros((), tl.int64)
+    verifying = True
+    for i in range(num_draft):
+        t = tl.load(target_ptr + start + i).to(tl.int64)
+        d = tl.load(draft_ptr + start + i + 1).to(tl.int64)
+        if verifying:
+            accepted = (t == d) & (d >= 0)
+            verifying = accepted
+            accepted_length += accepted
+            # Accepted: draft == target. Rejected: store the target argmax.
+            tl.store(sampled_ptr + req_idx * sampled_stride + i, t)
+    # Bonus token (all accepted) or the target argmax at the first rejection
+    # was stored above; the bonus row is the last one.
+    last = tl.load(target_ptr + start + accepted_length).to(tl.int64)
+    tl.store(sampled_ptr + req_idx * sampled_stride + accepted_length, last)
+    tl.store(num_accepted_ptr + req_idx, accepted_length)
+
+
+def greedy_verify(
+    target_ids: torch.Tensor,
+    draft_sampled: torch.Tensor,
+    cu_num_logits: torch.Tensor,
+    num_speculative_steps: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Returns (sampled [num_reqs, S+1] int64, num_sampled [num_reqs] int32)."""
+    num_reqs = cu_num_logits.shape[0] - 1
+    sampled = torch.zeros(
+        num_reqs, num_speculative_steps + 1, dtype=torch.int64, device=target_ids.device
+    )
+    num_accepted = torch.empty(num_reqs, dtype=torch.int64, device=target_ids.device)
+    _greedy_verify_kernel[(num_reqs,)](
+        sampled,
+        sampled.stride(0),
+        num_accepted,
+        target_ids,
+        draft_sampled,
+        cu_num_logits,
+        num_warps=1,
+    )
+    return sampled, (num_accepted + 1).to(torch.int32)
