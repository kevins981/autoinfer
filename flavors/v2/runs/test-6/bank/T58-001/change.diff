+template <int MT, int UN, int KS, int MODE>
+static int launch(const void* A, const void* B, void* C, const float* As, const float* Bs, int M, int N, int K, int kseg,
+                  float* ws, int* cnt, cudaStream_t st) {
+  constexpr int NS = KS >= 8 ? 2 : 4;
+  constexpr int SM = smem_bytes<MT, UN, KS, NS>();
+  auto k = t31b_kernel<MT, UN, KS, NS, MODE>;
+  cudaFuncSetAttribute(k, cudaFuncAttributeMaxDynamicSharedMemorySize, SM);
+  if (N % (32 * UN)) return -2;
+  dim3 grid(N / (32 * UN), kseg, (M + MT * 16 - 1) / (MT * 16));
+  k<<<grid, UN * KS * 32, SM, st>>>((const uint8_t*)A, (const uint8_t*)B, (__nv_bfloat16*)C, As, Bs, M, N, K, ws, cnt);
+  return (int)cudaGetLastError();
+}
+template <int UN, int KS, int MODE>
+static int launch_mt(int mt, const void* A, const void* B, void* C, const float* As, const float* Bs, int M, int N, int K, int kseg,
+                     float* ws, int* cnt, cudaStream_t st) {
+  switch (mt) {
+    case 1: return launch<1, UN, KS, MODE>(A, B, C, As, Bs, M, N, K, kseg, ws, cnt, st);
+    case 2: return launch<2, UN, KS, MODE>(A, B, C, As, Bs, M, N, K, kseg, ws, cnt, st);
+    case 3: return launch<3, UN, KS, MODE>(A, B, C, As, Bs, M, N, K, kseg, ws, cnt, st);
+  }
+  return -4;
+}
+template <int MODE>
+static int launch_un(int un, int ks, int mt, const void* A, const void* B, void* C, const float* As, const float* Bs, int M, int N,
+                     int K, int kseg, float* ws, int* cnt, cudaStream_t st) {
+#define C_(U, KSV) if (un == U && ks == KSV) return launch_mt<U, KSV, MODE>(mt, A, B, C, As, Bs, M, N, K, kseg, ws, cnt, st);
+  C_(4, 1) C_(2, 2) C_(1, 4) C_(4, 2) C_(2, 4) C_(1, 8)
+#undef C_
+  return -3;
+}
+
+// cfg (>= 0): bits 0-3 un, 4-7 ks, 8-11 kseg (1..10), bit 12 = deep weight ring (MODE 16), bits 13-14 mt override (0 = auto).
+// a: e4m3 [M,K] PI-permuted per 32; a_scales: fp32 [M,K/128]; b_q_weight: Marlin fp8 repack (N*K bytes); b_scales: fp32 [N/128,K/128];
+// ws: fp32 workspace (cross-CTA partials, only touched when kseg>1), cnt: int32 zeros (>= 4096, self-resetting). Not safe for two
+// concurrent launches sharing ws/cnt. Returns a new bf16 [M,N].
+torch::stable::Tensor t31_gemm_e4m3(torch::stable::Tensor& a, torch::stable::Tensor& a_scales, torch::stable::Tensor& b_q_weight,
+                                    torch::stable::Tensor& b_scales, torch::stable::Tensor& ws, torch::stable::Tensor& cnt,
+                                    int64_t size_m, int64_t size_n, int64_t size_k, int64_t cfg) {
+  STD_TORCH_CHECK(a.scalar_type() == torch::headeronly::ScalarType::Float8_e4m3fn, "a must be float8_e4m3fn");
+  STD_TORCH_CHECK(a_scales.scalar_type() == torch::headeronly::ScalarType::Float && b_scales.scalar_type() == torch::headeronly::ScalarType::Float &&
+                  ws.scalar_type() == torch::headeronly::ScalarType::Float, "scales / ws must be float32");
+  STD_TORCH_CHECK(cnt.scalar_type() == torch::headeronly::ScalarType::Int && cnt.numel() >= 4096, "cnt must be int32 [>=4096] zeros");
+  STD_TORCH_CHECK(a.stride(1) == 1 && a.stride(0) == size_k && a.size(0) == size_m && a.size(1) == size_k, "a must be contiguous [M,K]");
+  STD_TORCH_CHECK(size_k % 128 == 0 && size_n % 128 == 0, "K and N must be multiples of 128");
+  STD_TORCH_CHECK(a_scales.is_contiguous() && a_scales.size(0) == size_m && a_scales.size(1) == size_k / 128, "a_scales must be [M,K/128]");
+  STD_TORCH_CHECK(b_scales.is_contiguous() && b_scales.size(0) == size_n / 128 && b_scales.size(1) == size_k / 128, "b_scales must be [N/128,K/128]");
+  STD_TORCH_CHECK(b_q_weight.is_contiguous() && b_q_weight.numel() * 4 == size_n * size_k, "b_q_weight must be the unpadded Marlin repack");
+  STD_TORCH_CHECK(size_m >= 1 && size_m <= 96, "M out of range (1..96)");
+  STD_TORCH_CHECK(cfg >= 0, "cfg must be >= 0");
+  const int un = cfg & 15, ks = (cfg >> 4) & 15, kseg = (cfg >> 8) & 15, deep = (cfg >> 12) & 1;
+  int mt = (cfg >> 13) & 3;
+  if (mt == 0) mt = size_m <= 48 ? (int)((size_m + 15) / 16) : (size_m <= 64 ? 2 : 3);
+  STD_TORCH_CHECK(kseg >= 1 && kseg <= 10 && (size_k / 128) >= ks * kseg && size_n % (32 * un) == 0, "bad cfg for this shape");
+  const int64_t z = (size_m + mt * 16 - 1) / (mt * 16);
+  if (kseg > 1)
+    STD_TORCH_CHECK(ws.numel() >= z * (size_n / (32 * un)) * kseg * un * mt * 16 * 32, "ws too small for this cfg");
+  STD_TORCH_CHECK(z * (size_n / (32 * un)) <= 4096, "cnt too small");
+  torch::stable::Tensor c = torch::stable::empty({size_m, size_n}, torch::headeronly::ScalarType::BFloat16, std::nullopt, a.device());
+  const int dev = a.get_device_index();
+  const int rc = deep ? launch_un<16>(un, ks, mt, a.const_data_ptr(), b_q_weight.const_data_ptr(), c.mutable_data_ptr(),
+                                      (const float*)a_scales.const_data_ptr(), (const float*)b_scales.const_data_ptr(), (int)size_m, (int)size_n,
+                                      (int)size_k, kseg, (float*)ws.mutable_data_ptr(), (int*)cnt.mutable_data_ptr(), get_current_cuda_stream(dev))
+                      : launch_un<0>(un, ks, mt, a.const_data_ptr(), b_q_weight.const_data_ptr(), c.mutable_data_ptr(),
+                                     (const float*)a_scales.const_data_ptr(), (const float*)b_scales.const_data_ptr(), (int)size_m, (int)size_n,
+                                     (int)size_k, kseg, (float*)ws.mutable_data_ptr(), (int*)cnt.mutable_data_ptr(), get_current_cuda_stream(dev));
+  STD_TORCH_CHECK(rc == 0, "t31_gemm_e4m3 launch failed (bad un/ks/mt combination?)");
+  return c;
+}
