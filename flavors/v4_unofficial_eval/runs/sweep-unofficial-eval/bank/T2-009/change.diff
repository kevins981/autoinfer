+template <typename StateT>
+__device__ __forceinline__ unsigned char* replay_rows_base(
+    StateT* state, int col1_slot, int value_head, int64_t state_slot_stride) {
+  return reinterpret_cast<unsigned char*>(
+      state + static_cast<int64_t>(col1_slot) * state_slot_stride +
