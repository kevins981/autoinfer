  "baseline_commit": "4527515cd7",
  "env_script": "env.sh",
  "python_package_dir": "vllm",
  "prebuilt_from": "/scratch/kevinsong/learning/qwen38_opt/vllm",
  "build": {
    "cmake_args": ["-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release", "-DVLLM_TARGET_DEVICE=cuda",
