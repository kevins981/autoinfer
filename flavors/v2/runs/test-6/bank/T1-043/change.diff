new file mode 100644
index 0000000000..36e5cddc10
--- /dev/null
+++ b/vllm/model_executor/layers/mamba/gdn/replay.py
@@ -0,0 +1,228 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GDN spec-decode "checkpoint + replay" bookkeeping.
+
+The fused spec-decode kernel (``fused_gdn_decode_post_conv_mtp_replay``) keeps one
+committed recurrent state per request (block-table slot S[0]) plus a log of the
+last step's per-token recurrence inputs (slot S[1]) instead of storing the state
+after every token. The state that stock code expects at slot S[accepted - 1] is
+only materialized on demand by ``gdn_replay_flush``: before any code outside the
+fused kernel reads or copies the state (prefix-cache align copies, the non-fused
+GDN paths).  A per-(block, value head) byte holds the number of logged tokens
+(0 = no valid log).
+
+Lazy checkpoint (R12-A): the flag byte is ``pending << 3 | last``. The log may
+hold ``pending`` accepted tokens not yet applied to S[0], followed by the last
+step's ``last`` tokens; the kernel stores S[0] only when the next step's tokens
+would not fit in the log (``VLLM_GDN_LAZY_CAP`` tokens, default 8; 0 = store
+every step as before). Every flush replays the pending tokens first.
+"""
+
+import os
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+# Upper bound on the number of state blocks (the KV cache may grow after CUDA
+# graph capture, so the flag arrays are sized once, generously).
+FLAGS_CAPACITY_BLOCKS = 8192
+
+
+_STATS: dict = {}
+
+
+def stats_enabled() -> bool:
+    return os.environ.get("VLLM_GDN_REPLAY_STATS", "0") == "1"
+
+
+def get_stats_tensor(device) -> torch.Tensor:
+    """int64[4] counters of flush blocks that materialized something, per mode
+    (0 pre-copy, 1 post-copy, 2 layer-spec, 3 layer-clear of a live log). Empty
+    tensor (= disabled) unless VLLM_GDN_REPLAY_STATS=1."""
+    t = _STATS.get(device)
+    if t is None:
+        t = torch.zeros(4 if stats_enabled() else 0, dtype=torch.int64, device=device)
+        _STATS[device] = t
+    return t
+
+
+_LAZY_CAP: list = []
+
+
+def gdn_lazy_log_cap() -> int:
+    """Log capacity (pending + new tokens) of the lazy checkpoint; 0 = off."""
+    if not _LAZY_CAP:
+        cap = int(os.environ.get("VLLM_GDN_LAZY_CAP", "8"))
+        if os.environ.get("VLLM_GDN_LAZY", "1") in ("0", "false", "False"):
+            cap = 0
+        assert 0 <= cap <= 8, "VLLM_GDN_LAZY_CAP must be in [0, 8]"
+        _LAZY_CAP.append(cap)
+    return _LAZY_CAP[0]
+
+
+_RED8: list = []
+
+
+def gdn_red8() -> int:
+    """RED8 layout of the replay/flush kernels: 8 lanes per state row (3-step
+    shuffle reductions instead of 5-step x 4 rows). Same math, fp32 dot order
+    differs. VLLM_GDN_RED8=0 restores the 32-lane layout; 1 = smem staging,
+    2 = register prefetch 1 chunk ahead (3 CTAs/SM), 3 = registers 2 chunks ahead
+    4 = 1 + batched prologue loads, 5 = 4 + warp-private staging without
+    per-chunk CTA barriers (1-5 are bitwise identical; default 5). Replay and flush kernels
+    always use the same layout (lazy replay stays bitwise self-consistent)."""
+    if not _RED8:
+        v = os.environ.get("VLLM_GDN_RED8", "5")
+        v = "0" if v in ("false", "False") else v
+        assert v in ("0", "1", "2", "3", "4", "5"), "VLLM_GDN_RED8 must be 0-5"
+        _RED8.append(int(v))
+    return _RED8[0]
+
+
+def gdn_red8_flush_bit() -> int:
+    """flush-kernel mode bit 4: RED8 order iff any RED8 variant is on."""
+    return (1 if gdn_red8() else 0) << 4
+
+
+def gdn_replay_requested() -> bool:
+    return os.environ.get("VLLM_GDN_REPLAY", "1") not in ("0", "false", "False")
+
+
+def gdn_mixed_replay_requested() -> bool:
+    """Replay kernel also for the spec requests of mixed (prefill-containing)
+    steps. Default on; VLLM_GDN_MIXED_REPLAY=0 restores mode-2 flush + Triton."""
+    return os.environ.get("VLLM_GDN_MIXED_REPLAY", "1") not in ("0", "false", "False")
+
+
+def gdn_replay_op_available() -> bool:
+    return hasattr(torch.ops._C, "gdn_replay_flush") and hasattr(
+        torch.ops._C, "fused_gdn_decode_post_conv_mtp_replay"
+    )
+
+
+def _is_gdn_layer(layer: object) -> bool:
+    return hasattr(layer, "_gdn_replay_capable") and layer._gdn_replay_capable
+
+
+class GdnReplayRegistry:
+    """Flag arrays + batched flush over all replay-capable GDN layers."""
+
+    def __init__(self, forward_context: dict, kv_cache_config=None) -> None:
+        # Group layers by KV cache group (each group has its own block table).
+        name_to_group: dict[str, int] = {}
+        if kv_cache_config is not None:
+            for gid, group in enumerate(kv_cache_config.kv_cache_groups):
+                for name in group.layer_names:
+                    name_to_group[name] = gid
+        self.groups: dict[int, list] = {}
+        for name, layer in forward_context.items():
+            if not _is_gdn_layer(layer) or not hasattr(layer, "kv_cache"):
+                continue
+            state = layer.kv_cache[1]
+            hv = state.shape[1]
+            if layer._gdn_replay_flags is None:
+                layer._gdn_replay_flags = torch.zeros(
+                    max(FLAGS_CAPACITY_BLOCKS, state.shape[0]),
+                    hv,
+                    dtype=torch.uint8,
+                    device=state.device,
+                )
+            self.groups.setdefault(name_to_group.get(name, 0), []).append(layer)
+        self.hv = hv if self.groups else 0
+        self._tables: dict[int, tuple] = {}
+        self._calls = 0
+        # Capacity is fixed for the whole run; the KV cache must never outgrow it.
+        self.capacity = min(
+            layer._gdn_replay_flags.shape[0]
+            for layers in self.groups.values()
+            for layer in layers
+        )
+        self.num_layers = sum(len(v) for v in self.groups.values())
+        logger.info_once(
+            "GDN replay (state checkpoint + replay) enabled for %d layers",
+            self.num_layers,
+        )
+
+    def _group_tables(self, gid: int):
+        layers = self.groups[gid]
+        ptrs = tuple(layer.kv_cache[1].data_ptr() for layer in layers)
+        cached = self._tables.get(gid)
+        if cached is not None and cached[0] == ptrs:
+            return cached[1], cached[2], cached[3]
+        dev = layers[0].kv_cache[1].device
+        stride = layers[0].kv_cache[1].stride(0)
+        sp = torch.tensor(ptrs, dtype=torch.int64, device=dev)
+        fp = torch.tensor(
+            [layer._gdn_replay_flags.data_ptr() for layer in layers],
+            dtype=torch.int64,
+            device=dev,
+        )
+        self._tables[gid] = (ptrs, sp, fp, stride)
+        return sp, fp, stride
+
+    def flush(
+        self,
+        mode: int,
+        block_tables: dict[int, torch.Tensor],
+        idx_mapping: torch.Tensor,
+        num_reqs: int,
+        p0: torch.Tensor,
+        p1: torch.Tensor,
+        p2: torch.Tensor,
+        block_size: int,
+    ) -> None:
+        if num_reqs == 0:
+            return
+        for layers in self.groups.values():
+            assert layers[0].kv_cache[1].shape[0] <= self.capacity, (
+                "GDN replay flag capacity exceeded by the KV cache"
+            )
+        if idx_mapping.dtype != torch.int32:
+            idx_mapping = idx_mapping.to(torch.int32)
+        for gid in self.groups:
+            sp, fp, stride = self._group_tables(gid)
+            torch.ops._C.gdn_replay_flush(
+                sp,
+                fp,
+                stride,
+                self.hv,
+                block_tables[gid],
+                idx_mapping,
+                p0,
+                p1,
+                p2,
+                num_reqs,
+                mode | gdn_red8_flush_bit(),
+                block_size,
+                1,
+                get_stats_tensor(sp.device),
+            )
+        self._calls += 1
+        if stats_enabled() and mode == 1 and self._calls % 20 == 0:
+            logger.info("GDN replay flush stats [pre,post,layer_spec,layer_clear]: %s",
+                        get_stats_tensor(idx_mapping.device).tolist())
+
+    def flush_pre(self, block_tables, idx_mapping, num_reqs, src_col, state_idx,
+                  src_off, block_size) -> None:
+        self.flush(0, block_tables, idx_mapping, num_reqs, src_col, state_idx,
+                   src_off, block_size)
+
+    def flush_post(self, block_tables, idx_mapping, num_reqs, num_accepted,
+                   state_idx, new_num_computed, block_size) -> None:
+        self.flush(1, block_tables, idx_mapping, num_reqs, num_accepted,
+                   state_idx, new_num_computed, block_size)
+
+
+def get_registry(forward_context: dict, kv_cache_config=None):
+    if not gdn_replay_requested() or not gdn_replay_op_available():
+        return None
+    reg = GdnReplayRegistry(forward_context, kv_cache_config)
+    if reg.num_layers > 0:
+        logger.info_once("GDN replay lazy checkpoint: log cap %d tokens%s; red8 layout %s",
+                         gdn_lazy_log_cap(),
+                         " (off: commit every step)" if gdn_lazy_log_cap() == 0 else "",
+                         "on" if gdn_red8() else "off")
+    return reg if reg.num_layers > 0 else None
